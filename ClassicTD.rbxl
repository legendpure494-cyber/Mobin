local List = Shop:WaitForChild("List")
local Template = Shop:WaitForChild("RowTemplate")
local function refreshShop()
	for _, c in ipairs(List:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
	local owned = {}
	for k in string.gmatch(lp:GetAttribute("Owned") or "", "[^,]+") do owned[k] = true end
	local inBar = {}
	for k in string.gmatch(lp:GetAttribute("Loadout") or "", "[^,]+") do inBar[k] = true end
	for i, key in ipairs(C.ORDER) do
		local cfg = C.TOWERS[key]
		if cfg then
			local row = Template:Clone()
			row.Name = key
			row.Visible = true
			row.LayoutOrder = i
			row.TowerName.Text = cfg.name
			row.Desc.Text = cfg.desc
			row.Stats.Text = cfg.kind == "farm" and ("$" .. cfg.income[1] .. " per wave · place $" .. cfg.cost) or ("DMG " .. cfg.dmg[1] .. " · RNG " .. cfg.range[1] .. " · $" .. cfg.cost)
			row.Buy.Visible = not owned[key]
			row.Buy.Text = "BUY " .. fmt(cfg.unlock)
			row.Equip.Visible = owned[key] == true
			row.Equip.Text = inBar[key] and "UNEQUIP" or "EQUIP"
			row.Equip.BackgroundColor3 = inBar[key] and C3(200, 80, 60) or C3(75, 175, 75)
			row.Parent = List
			picture(row.View, key)
			row.Buy.MouseButton1Click:Connect(function() click() REM.Buy:FireServer(key) end)
			row.Equip.MouseButton1Click:Connect(function() click() REM.Equip:FireServer(key) end)
		end
	end
end
ShopB.MouseButton1Click:Connect(function()
	click()
	Shop.Visible = not Shop.Visible
	if Shop.Visible then refreshShop() end
end)
Shop:WaitForChild("Close").MouseButton1Click:Connect(function() click() Shop.Visible = false end)
for _, a in ipairs({"Owned", "Loadout", "Coins"}) do lp:GetAttributeChangedSignal(a):Connect(function() if Shop.Visible then refreshShop() end end) end

