80</XO><YS>0</YS><YO>210</YO></UDim2><float name="BackgroundTransparency">0.1</float><UDim2 name="Position"><XS>0.5</XS><XO>0</XO><YS>0.45</YS><YO>0</YO></UDim2><bool name="Visible">false</bool><Color3 name="BackgroundColor3"><R>0.23529</R><G>0.23529</G><B>0.23529</B></Color3></Properties><Item class="TextLabel" referent="RBXD995"><Properties><string name="Name">Title</string><float name="TextStrokeTransparency">0</float><UDim2 name="Size"><XS>1</XS><XO>-20</XO><YS>0</YS><YO>54</YO></UDim2><string name="Text">VICTORY!</string><Font name="FontFace"><Family><url>rbxasset://fonts/families/SourceSansPro.json</url></Family><Weight>700</Weight><Style>Normal</Style></Font><float name="BackgroundTransparency">1</float><UDim2 name="Position"><XS>0</XS><XO>10</XO><YS>0</YS><YO>10</YO></UDim2><Color3 name="TextColor3"><R>1.0</R><G>0.86275</G><B>0.23529</B></Color3><bool name="TextScaled">true</bool></Properties></Item><Item class="TextLabel" referent="RBXD996"><Properties><string name="Name">Info</string><bool name="TextWrapped">true</bool><float name="TextStrokeTransparency">0</float><UDim2 name="Size"><XS>1</XS><XO>-20</XO><YS>0</YS><YO>80</YO></UDim2><string name="Text"></string><Font name="FontFace"><Family><url>rbxasset://fonts/families/SourceSansPro.json</url></Family><Weight>700</Weight><Style>Normal</Style></Font><float name="BackgroundTransparency">1</float><UDim2 name="Position"><XS>0</XS><XO>10</XO><YS>0</YS><YO>70</YO></UDim2><Color3 name="TextColor3"><R>1.0</R><G>1.0</G><B>1.0</B></Color3><bool name="TextScaled">true</bool></Properties></Item><Item class="TextButton" referent="RBXD997"><Properties><string name="Name">Close</string><float name="TextStrokeTransparency">0</float><int name="BorderSizePixel">2</int><UDim2 name="Size"><XS>0</XS><XO>120</XO><YS>0</YS><YO>40</YO></UDim2><string name="Text">OK</string><Font name="FontFace"><Family><url>rbxasset://fonts/families/SourceSansPro.json</url></Family><Weight>700</Weight><Style>Normal</Style></Font><UDim2 name="Position"><XS>0.5</XS><XO>-60</XO><YS>1</YS><YO>-50</YO></UDim2><Color3 name="TextColor3"><R>1.0</R><G>1.0</G><B>1.0</B></Color3><bool name="TextScaled">true</bool><Color3 name="BackgroundColor3"><R>0.0</R><G>0.63529</G><B>1.0</B></Color3></Properties></Item></Item><Item class="TextLabel" referent="RBXD998"><Properties><string name="Name">Lobby</string><float name="TextStrokeTransparency">0</float><Vector2 name="AnchorPoint"><X>0.5</X><Y>0</Y></Vector2><int name="BorderSizePixel">2</int><UDim2 name="Size"><XS>0</XS><XO>520</XO><YS>0</YS><YO>32</YO></UDim2><string name="Text">Stand on a pad to vote for a map!</string><Font name="FontFace"><Family><url>rbxasset://fonts/families/SourceSansPro.json</url></Family><Weight>700</Weight><Style>Normal</Style></Font><float name="BackgroundTransparency">0.35</float><UDim2 name="Position"><XS>0.5</XS><XO>0</XO><YS>1</YS><YO>-60</YO></UDim2><Color3 name="TextColor3"><R>1.0</R><G>1.0</G><B>1.0</B></Color3><bool name="TextScaled">true</bool><Color3 name="BackgroundColor3"><R>0.23529</R><G>0.23529</G><B>0.23529</B></Color3></Properties></Item><Item class="LocalScript" referent="RBXSTD_Client"><Properties><string name="Name">TD_Client</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[--[[
	TD_Client | StarterGui.TD_UI (LocalScript)
	Makes the interface work. The interface itself is the TD_UI ScreenGui you can see and edit in StarterGui;
	this script only finds its parts by name, so you can move / recolour them freely (keep the names).

	  * top bar: wave, timer / enemies left, base health
	  * coins, cash, SHOP window (unlock towers, choose your hotbar)
	  * hotbar: pick a tower, a see-through preview follows the mouse (green = ok, red = not allowed),
	    R rotates, Q / right click cancels, click places it
	  * click one of your towers: panel with level, stats, UPGRADE, SELL and TARGET mode, plus a range ring
	  * skip-wave button, messages, match result window, lobby hint
]]

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local Run = game:GetService("RunService")
local TS = game:GetService("TweenService")

local lp = Players.LocalPlayer
local cam = workspace.CurrentCamera
local TD = RS:WaitForChild("TD")
local C = require(TD:WaitForChild("Config"))
local REM = TD:WaitForChild("Remotes")
local TOWER_MODELS = TD:WaitForChild("Towers")
local MAPS = workspace:WaitForChild("Maps")
local TOWERS = workspace:WaitForChild("Towers")

local gui = script.Parent
local V3, CF, C3, U2 = Vector3.new, CFrame.new, Color3.fromRGB, UDim2.new

-- UI parts (by name)
local Top = gui:WaitForChild("Top")
local WaveL, InfoL = Top:WaitForChild("Wave"), Top:WaitForChild("Info")
local BaseBar = Top:WaitForChild("BaseBar")
local BaseFill, BaseText = BaseBar:WaitForChild("Fill"), BaseBar:WaitForChild("BaseText")
local CoinsL = gui:WaitForChild("Coins"):WaitForChild("Amount")
local CashF = gui:WaitForChild("Cash")
local CashL = CashF:WaitForChild("Amount")
local Hotbar = gui:WaitForChild("Hotbar")
local Hint = gui:WaitForChild("Hint")
local SkipB = gui:WaitForChild("Skip")
local MsgL = gui:WaitForChild("Message")
local Panel = gui:WaitForChild("Panel")
local Shop = gui:WaitForChild("Shop")
local ShopB = gui:WaitForChild("ShopButton")
local Result = gui:WaitForChild("Result")
local LobbyL = gui:WaitForChild("Lobby")

local function fmt(n)
	n = math.floor(n or 0)
	local s = tostring(n)
	while true do
		local k
		s, k = s:gsub("^(-?%d+)(%d%d%d)", "%1,%2")
		if k == 0 then return s end
	end
end
local function click()
	local s = Instance.new("Sound")
	s.SoundId, s.Volume, s.Parent = "rbxasset://sounds/clickfast.wav", 0.4, gui
	s:Play()
	game:GetService("Debris"):AddItem(s, 1)
end

----------------------------------------------------------------------------------------------------
-- MESSAGES
----------------------------------------------------------------------------------------------------
local msgId = 0
local function message(text, col)
	msgId += 1
	local my = msgId
	MsgL.Text = text
	MsgL.TextColor3 = col or C3(255, 255, 255)
	MsgL.TextTransparency, MsgL.TextStrokeTransparency = 0, 0
	task.delay(3, function()
		if msgId ~= my then return end
		TS:Create(MsgL, TweenInfo.new(0.5), {TextTransparency = 1, TextStrokeTransparency = 1}):Play()
	end)
end
REM:WaitForChild("Notify").OnClientEvent:Connect(function(t) message(t) end)

----------------------------------------------------------------------------------------------------
-- 3D picture of a tower inside a ViewportFrame
----------------------------------------------------------------------------------------------------
local function picture(vp, key)
	for _, c in ipairs(vp:GetChildren()) do c:Destroy() end
	local tpl = TOWER_MODELS:FindFirstChild(key)
	if not tpl then return end
	local m = tpl:Clone()
	m.Parent = vp
	local cam2 = Instance.new("Camera")
	cam2.FieldOfView = 40
	cam2.Parent = vp
	vp.CurrentCamera = cam2
	local cf, size = m:GetBoundingBox()
	local dist = math.max(size.X, size.Y, size.Z) * 1.3 + 1
	cam2.CFrame = CF(cf.Position + V3(dist * 0.5, size.Y * 0.15, -dist * 0.85), cf.Position)
end

----------------------------------------------------------------------------------------------------
-- TOP BAR / CASH / COINS / LOBBY
----------------------------------------------------------------------------------------------------
local function phase() return TD:GetAttribute("Phase") or "lobby" end
local function inMatch() return phase() == "match" end
local function refreshTop()
	local ph = phase()
	if ph == "match" or ph == "ended" then
		WaveL.Text = "WAVE " .. (TD:GetAttribute("Wave") or 0) .. " / " .. C.WAVES
		if TD:GetAttribute("Break") then InfoL.Text = "Next wave in " .. (TD:GetAttribute("Timer") or 0)
		else InfoL.Text = "Enemies: " .. (TD:GetAttribute("Remaining") or 0) end
		local hp, max = TD:GetAttribute("BaseHP") or 0, TD:GetAttribute("MaxHP") or C.BASE_HP
		BaseFill.Size = U2(math.clamp(hp / max, 0, 1), 0, 1, 0)
		BaseFill.BackgroundColor3 = hp / max > 0.5 and C3(75, 200, 75) or hp / max > 0.25 and C3(230, 180, 40) or C3(220, 50, 50)
		BaseText.Text = "Base: " .. hp .. " / " .. max
		BaseBar.Visible = true
	else
		WaveL.Text = ph == "intermission" and "INTERMISSION" or "LOBBY"
		InfoL.Text = ph == "intermission" and ("Starting in " .. (TD:GetAttribute("Timer") or 0)) or "Waiting..."
		BaseBar.Visible = false
	end
	CashF.Visible = ph == "match"
	Hotbar.Visible = ph == "match"
	LobbyL.Visible = ph == "lobby" or ph == "intermission"
	ShopB.Visible = not inMatch()
	local need = math.max(1, math.ceil(#Players:GetPlayers() / 2))
	SkipB.Visible = ph == "match" and TD:GetAttribute("Break") == true
	SkipB.Text = "SKIP WAVE (" .. (TD:GetAttribute("SkipVotes") or 0) .. "/" .. need .. ")"
end
for _, a in ipairs({"Phase", "Wave", "Timer", "Break", "BaseHP", "Remaining", "SkipVotes"}) do TD:GetAttributeChangedSignal(a):Connect(refreshTop) end
refreshTop()
local function refreshMoney()
	CoinsL.Text = "Coins: " .. fmt(lp:GetAttribute("Coins") or 0)
	CashL.Text = "$" .. fmt(lp:GetAttribute("Cash") or 0)
end
lp:GetAttributeChangedSignal("Coins"):Connect(refreshMoney)
lp:GetAttributeChangedSignal("Cash"):Connect(refreshMoney)
refreshMoney()
SkipB.MouseButton1Click:Connect(function() click() REM.Skip:FireServer() end)

