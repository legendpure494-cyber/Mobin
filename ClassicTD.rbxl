REM:WaitForChild("Result").OnClientEvent:Connect(function(won, wave, coins)
	Result.Title.Text = won and "VICTORY!" or "DEFEAT"
	Result.Title.TextColor3 = won and C3(255, 220, 60) or C3(255, 80, 80)
	Result.Info.Text = (won and "You defended the base!" or ("The base fell on wave " .. wave .. ".")) .. "\n+" .. fmt(coins) .. " coins"
	Result.Visible = true
	local s = Instance.new("Sound")
	s.SoundId, s.Volume, s.Parent = won and "rbxasset://sounds/victory.wav" or "rbxasset://sounds/uuhhh.mp3", 0.6, gui
	s:Play()
	game:GetService("Debris"):AddItem(s, 4)
end)
Result:WaitForChild("Close").MouseButton1Click:Connect(function() click() Result.Visible = false end)
