<Item class="StarterPlayer" referent="RBXP"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBXPS"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBXSTD_Render"><Properties><string name="Name">TD_Render</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[--[[
	TD_Render | StarterPlayerScripts (LocalScript)
	Draws and animates everything that moves:
	  * enemies (the server sends their positions 10x a second; here they are cloned from
	    ReplicatedStorage.TD.Enemies, moved smoothly along the path and given a health bar)
	  * ANIMATIONS for towers and enemies:
	      1) your animation ID from Config.ANIMS
	      2) or the AnimationId inside the model's Animations folder
	      3) or the built-in code animation (walk, idle, attack, place, death)
	  * attack effects (sword slash, pebbles, bullets, rockets, ice, sniper shots), cash pop-ups,
	    level tags over towers, the classic "oof" when an enemy is defeated
]]

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local Run = game:GetService("RunService")
local TS = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local lp = Players.LocalPlayer
local cam = workspace.CurrentCamera
local TD = RS:WaitForChild("TD")
local C = require(TD:WaitForChild("Config"))
local REM = TD:WaitForChild("Remotes")
local ENEMY_MODELS = TD:WaitForChild("Enemies")
local MAPS = workspace:WaitForChild("Maps")
local TOWERS = workspace:WaitForChild("Towers")

local V3, CF, A, C3 = Vector3.new, CFrame.new, CFrame.Angles, Color3.fromRGB

local view = Instance.new("Folder")
view.Name = "ClientEnemies"
view.Parent = workspace
local fxFolder = Instance.new("Folder")
fxFolder.Name = "ClientFX"
fxFolder.Parent = workspace

local function sound(file, speed, vol, at)
	local holder = fxFolder
	local p
	if at then
		p = Instance.new("Part")
		p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.Transparency, p.Size, p.Position = true, false, false, false, 1, V3(0.2, 0.2, 0.2), at
		p.Parent = fxFolder
		holder = p
	end
	local s = Instance.new("Sound")
	s.SoundId, s.PlaybackSpeed, s.Volume, s.RollOffMaxDistance = "rbxasset://sounds/" .. file, speed or 1, vol or 0.5, 150
	s.Parent = holder
	s:Play()
	Debris:AddItem(p or s, 3)
end

----------------------------------------------------------------------------------------------------
-- ANIMATIONS
----------------------------------------------------------------------------------------------------
-- find an animation id for a model (by its template name) and state ("Idle", "Attack", "Place", "Walk", "Death")
local function idFor(model, name)
	local key = model:GetAttribute("Key") or model.Name
	local list = C.ANIMS and C.ANIMS[key]
	local id = list and list[name] or ""
	if id == "" or id == nil then
		local f = model:FindFirstChild("Animations")
		local a = f and f:FindFirstChild(name)
		id = a and a:IsA("Animation") and a.AnimationId or ""
	end
	if id == "" or id == nil then return nil end
	id = tostring(id)
	if id:match("^%d+$") then id = "rbxassetid://" .. id end
	return id
end
local function animator(model)
	local ac = model:FindFirstChildOfClass("AnimationController") or model:FindFirstChildOfClass("Humanoid")
	return ac and ac:FindFirstChildOfClass("Animator")
end
-- load (and cache) a track; returns nil when there is no id
local function track(model, name, rig)
	rig.tracks = rig.tracks or {}
	if rig.tracks[name] ~= nil then return rig.tracks[name] or nil end
	local id = idFor(model, name)
	local an = animator(model)
	if not id or not an then rig.tracks[name] = false return nil end
	local a = Instance.new("Animation")
	a.AnimationId = id
	local ok, t = pcall(function() return an:LoadAnimation(a) end)
	rig.tracks[name] = ok and t or false
	return ok and t or nil
end

-- built-in code animation needs the R6 joints
local function joints(model)
	local j = {}
	for _, m in ipairs(model:GetDescendants()) do
		if m:IsA("Motor6D") then j[m.Name] = m end
	end
	return j
end
local Z = function(a) return A(0, 0, a) end
local rigs = {} -- model -> {kind = "tower"/"enemy", j = joints, t0, attackAt, ...}
local function addRig(model, kind)
	if rigs[model] then return rigs[model] end
	local r = {kind = kind, j = joints(model), ph = math.random() * 6, attackAt = -10, placeAt = os.clock(), key = model:GetAttribute("Key") or model.Name}
	rigs[model] = r
	if kind == "tower" then
		local idle = track(model, "Idle", r)
		if idle then idle.Looped = true idle:Play() end
		local place = track(model, "Place", r)
		if place then place:Play() end
	else
		local walk = track(model, "Walk", r)
		if walk then walk.Looped = true walk:Play() end
	end
	return r
end
-- how a tower's arm moves when it attacks (built-in)
local SWING = {Noob = "sword", Bacon = "throw", Guest = "gun", Rocketeer = "heavy", IceMage = "staff", Sniper = "gun"}

Run.RenderStepped:Connect(function()
	if C.NO_BUILTIN_ANIMS then return end
	local now = os.clock()
	local cp = cam.CFrame.Position
	for model, r in pairs(rigs) do
		if not model.Parent then rigs[model] = nil continue end
		local j = r.j
		if not j["Right Shoulder"] then continue end
		local root = model.PrimaryPart
		if root and (root.Position - cp).Magnitude > 160 then continue end
		local t = now + r.ph
		if r.kind == "enemy" then
			if r.dead then continue end
			if r.tracks and r.tracks.Walk then continue end
			local sp = (r.speed or 6) * 0.9 * C.WALK_ANIM_SPEED
			local sw = math.sin(t * sp) * 0.7
			j["Right Hip"].Transform = Z(-sw)
			j["Left Hip"].Transform = Z(-sw)
			-- zombies hold their arms forward
			local arm = 1.5 + math.sin(t * sp * 0.5) * 0.1
			j["Right Shoulder"].Transform = Z(arm)
			j["Left Shoulder"].Transform = Z(-arm)
			if j.RootJoint then j.RootJoint.Transform = CF(0, 0, math.abs(math.cos(t * sp)) * 0.15) end
			if j.Neck then j.Neck.Transform = Z(math.sin(t * 2) * 0.15) end
		else
			if r.tracks and r.tracks.Idle then continue end
			local breathe = math.sin(t * 2) * 0.04
			local k = math.clamp((now - r.attackAt) / 0.35, 0, 1)
			local hit = math.sin(k * math.pi)
			local style = SWING[r.key] or "gun"
			local arm = 0.25 + breathe
			if style == "sword" then arm = 0.4 + hit * 1.5
			elseif style == "throw" then arm = 0.3 + hit * 1.3
			elseif style == "heavy" then arm = 0.45 - hit * 0.25
			elseif style == "staff" then arm = 0.2 + hit * 0.9
			else arm = 1.45 - hit * 0.35 end -- guns are aimed forward
			if style == "gun" and k >= 1 then arm = 1.45 + breathe end
			j["Right Shoulder"].Transform = Z(arm)
			j["Left Shoulder"].Transform = Z(-0.05 - breathe)
			-- little hop when placed
			local pk = math.clamp((now - r.placeAt) / 0.4, 0, 1)
			if j.RootJoint then j.RootJoint.Transform = CF(0, 0, math.sin(pk * math.pi) * 1.2 + breathe * 0.5) end
			j["Right Hip"].Transform, j["Left Hip"].Transform = CFrame.identity, CFrame.identity
		end
	end
end)

----------------------------------------------------------------------------------------------------
-- TOWERS: rigs, level tags
----------------------------------------------------------------------------------------------------
local function levelTag(m)
	local root = m.PrimaryPart
	if not root then return end
	local bb = Instance.new("BillboardGui")
	bb.Name, bb.Size, bb.StudsOffsetWorldSpace, bb.MaxDistance, bb.Adornee = "LevelTag", UDim2.new(0, 60, 0, 20), V3(0, 3.6, 0), 60, root
	local t = Instance.new("TextLabel")
	t.Size, t.BackgroundTransparency, t.Font, t.TextScaled, t.TextColor3, t.TextStrokeTransparency = UDim2.fromScale(1, 1), 1, Enum.Font.SourceSansBold, true, C3(255, 220, 60), 0
	t.Parent = bb
	local function upd() t.Text = "Lv " .. (m:GetAttribute("Level") or 1) end
	upd()
	m:GetAttributeChangedSignal("Level"):Connect(upd)
	bb.Parent = fxFolder
	m.AncestryChanged:Connect(function() if not m.Parent then bb:Destroy() end end)
end
local function newTower(m)
	task.wait()
	if not m.Parent then return end
	addRig(m, "tower")
	levelTag(m)
end
TOWERS.ChildAdded:Connect(function(m) task.spawn(newTower, m) end)
for _, m in ipairs(TOWERS:GetChildren()) do task.spawn(newTower, m) end

