-- ENEMIES
----------------------------------------------------------------------------------------------------
local pts, acc, total = {}, {}, 0
local mapName = ""
local function refreshPath()
	local n = TD:GetAttribute("Map") or ""
	if n == mapName then return end
	mapName = n
	local map = MAPS:FindFirstChild(n)
	if map then pts, acc, total = C.path(map) else pts, acc, total = {}, {}, 0 end
end
TD:GetAttributeChangedSignal("Map"):Connect(refreshPath)
refreshPath()

local live = {} -- id -> {model, d (shown), target d, hp, max, bar, kind}
local function healthBar(m, boss)
	local root = m.PrimaryPart
	local bb = Instance.new("BillboardGui")
	bb.Name, bb.Size, bb.AlwaysOnTop, bb.MaxDistance, bb.Adornee = "HP", UDim2.new(0, boss and 140 or 70, 0, boss and 14 or 9), true, 120, root
	local _, size = m:GetBoundingBox()
	bb.StudsOffsetWorldSpace = V3(0, size.Y / 2 + 1, 0)
	local bg = Instance.new("Frame")
	bg.Size, bg.BackgroundColor3, bg.BorderColor3, bg.BorderSizePixel, bg.Parent = UDim2.fromScale(1, 1), C3(40, 0, 0), C3(0, 0, 0), 1, bb
	local fill = Instance.new("Frame")
	fill.Name, fill.Size, fill.BackgroundColor3, fill.BorderSizePixel, fill.Parent = "Fill", UDim2.fromScale(1, 1), boss and C3(255, 60, 60) or C3(60, 220, 60), 0, bg
	bb.Parent = m
	return fill
end
local function kill(o)
	local m = o.model
	local r = rigs[m]
	if r then r.dead = true end
	if o.bar then o.bar.Parent.Parent:Destroy() end
	local pv = m:GetPivot()
	sound("uuhhh.mp3", 1 + math.random() * 0.2, 0.25, pv.Position)
	local death = r and track(m, "Death", r)
	if death then
		if r.tracks.Walk then r.tracks.Walk:Stop() end
		death.Looped = false
		death:Play()
		task.delay(math.max(0.6, death.Length > 0 and death.Length or 0.8), function() m:Destroy() end)
	else
		-- built-in: fall over backwards and sink
		task.spawn(function()
			local t0 = os.clock()
			while os.clock() - t0 < 0.6 and m.Parent do
				local k = (os.clock() - t0) / 0.6
				m:PivotTo(pv * CF(0, -k * 1.5, 0) * A(-k * math.pi / 2, 0, 0))
				Run.RenderStepped:Wait()
			end
			m:Destroy()
		end)
	end
end
REM:WaitForChild("Sync").OnClientEvent:Connect(function(list)
	refreshPath()
	local seen = {}
	for _, e in ipairs(list) do
		local id, kind, d, hp, max, slowed = e[1], e[2], e[3], e[4], e[5], e[6]
		seen[id] = true
		local o = live[id]
		if not o then
			local tpl = ENEMY_MODELS:FindFirstChild(kind)
			if tpl then
				local m = tpl:Clone()
				m.Name = kind
				m:SetAttribute("Key", kind)
				local p = C.at(pts, acc, d)
				m:PivotTo(CF(p))
				m.Parent = view
				local cfg = C.ENEMIES[kind] or {}
				o = {model = m, d = d, goal = d, hp = hp, max = max, kind = kind, speed = cfg.speed or 6, lift = 0}
				local cf, size = m:GetBoundingBox()
				o.lift = m:GetPivot().Position.Y - (cf.Position.Y - size.Y / 2)
				o.bar = healthBar(m, cfg.boss)
				local r = addRig(m, "enemy")
				r.speed = cfg.speed
				live[id] = o
			end
		end
		if o then
			o.goal, o.hp, o.max, o.slowed = d, hp, max, slowed
			if o.bar then o.bar.Size = UDim2.fromScale(math.clamp(hp / math.max(1, max), 0, 1), 1) end
		end
	end
	for id, o in pairs(live) do
		if not seen[id] then
			live[id] = nil
			if o.d < total - 1 then kill(o) else o.model:Destroy() sound("bass.wav", 0.8, 0.5) end
		end
	end
end)
-- smooth movement between syncs
Run.RenderStepped:Connect(function(dt)
	for _, o in pairs(live) do
		local m = o.model
		if m.Parent then
			-- move toward the server distance, a little ahead to stay smooth
			local gap = o.goal - o.d
			if math.abs(gap) > 6 then o.d = o.goal else o.d += gap * math.min(1, dt * 10) + (o.slowed and 0.5 or 1) * o.speed * dt * 0.15 end
			local p, dir = C.at(pts, acc, o.d)
			local look = V3(dir.X, 0, dir.Z)
			if look.Magnitude < 0.01 then look = V3(0, 0, -1) end
			m:PivotTo(CF(p + V3(0, o.lift, 0), p + V3(0, o.lift, 0) + look))
		end
	end
end)

----------------------------------------------------------------------------------------------------
-- EFFECTS
----------------------------------------------------------------------------------------------------
local function fx(size, col, cf, shape, life, mat)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	p.Size, p.Color, p.CFrame, p.Material = size, col, cf, mat or Enum.Material.Neon
	if shape then p.Shape = shape end
	p.Parent = fxFolder
	Debris:AddItem(p, life or 0.3)
	return p
end
local function beam(a, b, col, w, life)
	local d = (b - a).Magnitude
	local p = fx(V3(w, w, d), col, CF(a, b) * CF(0, 0, -d / 2), nil, life)
	TS:Create(p, TweenInfo.new(life or 0.15), {Transparency = 1}):Play()
end
local function blast(at, col, r, life)
	local p = fx(V3(1, 1, 1), col, CF(at), Enum.PartType.Ball, life or 0.35)
	p.Transparency = 0.3
	TS:Create(p, TweenInfo.new(life or 0.35), {Size = V3(r * 2, r * 2, r * 2), Transparency = 1}):Play()
end
local function fly(from, to, size, col, time, shape, done)
	local p = fx(size, col, CF(from, to), shape, time + 0.05, Enum.Material.SmoothPlastic)
	TS:Create(p, TweenInfo.new(time, Enum.EasingStyle.Linear), {CFrame = CF(to, to + (to - from).Unit)}):Play()
	if done then task.delay(time, done) end
end
local function muzzle(model)
	-- the front-most tip of the weapon: furthest part in front of the root
	local root = model.PrimaryPart
	if not root then return model:GetPivot().Position end
	local best, bd = root.Position + V3(0, 1, 0), -1e9
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") and p ~= root and p.Transparency < 1 then
			local l = root.CFrame:PointToObjectSpace(p.Position)
			if -l.Z > bd then best, bd = p.Position, -l.Z end
		end
	end
	return best
end
local function popText(at, text, col)
	local p = fx(V3(0.2, 0.2, 0.2), col, CF(at), nil, 1.2)
	p.Transparency = 1
	local bb = Instance.new("BillboardGui")
	bb.Size, bb.AlwaysOnTop, bb.Parent = UDim2.new(0, 120, 0, 34), true, p
	local t = Instance.new("TextLabel")
	t.Size, t.BackgroundTransparency, t.Font, t.TextScaled, t.Text, t.TextColor3, t.TextStrokeTransparency = UDim2.fromScale(1, 1), 1, Enum.Font.SourceSansBold, true, text, col, 0
	t.Parent = bb
	TS:Create(p, TweenInfo.new(1.1), {CFrame = CF(at + V3(0, 4, 0))}):Play()
	TS:Create(t, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {TextTransparency = 1, TextStrokeTransparency = 1}):Play()
end
REM:WaitForChild("Fx").OnClientEvent:Connect(function(kind, model, a, b, c)
	if typeof(model) ~= "Instance" or not model.Parent then return end
	if kind == "attack" then
		local key = b
		local r = rigs[model] or addRig(model, "tower")
		r.attackAt = os.clock()
		local atk = track(model, "Attack", r)
		if atk then atk.Looped = false atk:Play() end
		local from = muzzle(model)
		local to = a + V3(0, 2, 0)
		if (from - cam.CFrame.Position).Magnitude > 180 then return end
		if key == "Noob" then
			blast(to, C3(255, 255, 255), 1.5, 0.2)
			sound("swordslash.wav", 1.1, 0.35, from)
		elseif key == "Bacon" then
			fly(from, to, V3(0.4, 0.4, 0.4), C3(130, 130, 130), 0.18, Enum.PartType.Ball)
			sound("paintball.wav", 1.6, 0.25, from)
		elseif key == "Guest" then
			beam(from, to, C3(255, 230, 120), 0.15, 0.08)
			blast(from, C3(255, 200, 80), 0.6, 0.1)
			sound("paintball.wav", 0.9, 0.35, from)
		elseif key == "Rocketeer" then
			sound("swoosh.wav", 1.2, 0.4, from)
			fly(from, to, V3(0.5, 0.5, 1.4), C3(90, 90, 90), 0.35, nil, function()
				blast(to, C3(255, 140, 40), (C.TOWERS.Rocketeer.radius[c or 1] or 4), 0.4)
				sound("collide.wav", 0.7, 0.5, to)
			end)
		elseif key == "IceMage" then
			fly(from, to, V3(0.5, 0.5, 0.5), C3(150, 230, 255), 0.25, nil, function() blast(to, C3(170, 230, 255), 2, 0.4) end)
			sound("snap.mp3", 1.8, 0.3, from)
		elseif key == "Sniper" then
			beam(from, to, C3(255, 255, 255), 0.25, 0.15)
			blast(from, C3(255, 230, 150), 1, 0.12)
			sound("snap.mp3", 0.8, 0.6, from)
		else
			beam(from, to, C3(255, 255, 255), 0.15, 0.1)
		end
	elseif kind == "place" then
		local r = addRig(model, "tower")
		r.placeAt = os.clock()
		blast(model:GetPivot().Position - V3(0, 2, 0), C3(255, 255, 255), 3, 0.35)
		sound("action_jump_land.mp3", 1, 0.5, model:GetPivot().Position)
	elseif kind == "upgrade" then
		blast(model:GetPivot().Position, C3(255, 220, 60), 3.5, 0.45)
		popText(model:GetPivot().Position + V3(0, 3, 0), "LEVEL UP!", C3(255, 220, 60))
		sound("electronicpingshort.wav", 1.2, 0.5, model:GetPivot().Position)
	elseif kind == "farm" then
		popText(model:GetPivot().Position + V3(0, 4, 0), "+$" .. tostring(a), C3(100, 255, 100))
		sound("electronicpingshort.wav", 1.6, 0.35, model:GetPivot().Position)
	end
end)
]]></ProtectedString></Properties></Item></Item></Item>
</roblox>