<Item class="ReplicatedStorage" referent="RBXR"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBXTD"><Properties><string name="Name">TD</string></Properties><Item class="ModuleScript" referent="RBXSConfig"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- TD_Config | ReplicatedStorage.TD (ModuleScript) | CLASSIC TOWER DEFENSE settings. Change numbers here; tower and enemy LOOKS are the models in ReplicatedStorage.TD.Towers and ReplicatedStorage.TD.Enemies (edit or replace them in Studio, keep the same names and a PrimaryPart). Maps are the models in Workspace.Maps (each needs Ground parts, a Waypoints folder with parts named 1, 2, 3 ..., a PlayerSpawn part and a Base part).
local C = {}

-- TOWERS
-- cost: place price · dmg / range / cd (seconds between attacks) per level · up: upgrade prices · hidden: sees hidden enemies
-- kind: "single", "splash" (radius), "slow" (slow %, seconds), "farm" (cash each wave) · limit: how many one player can place · unlock: coins in the shop (0 = free)
C.TOWERS = {
	Noob = {
		name = "Noob", desc = "Classic noob with a sword. Cheap and strong up close.", cost = 200, unlock = 0, limit = 8, kind = "single", hidden = false,
		dmg = {3, 5, 8, 14}, range = {7, 7.5, 8, 9}, cd = {1.0, 0.9, 0.8, 0.65}, up = {150, 350, 800},
	},
	Bacon = {
		name = "Bacon", desc = "Bacon hair with a slingshot. Fast pebbles from far away.", cost = 300, unlock = 0, limit = 8, kind = "single", hidden = false,
		dmg = {2, 3, 5, 8}, range = {14, 15, 16, 18}, cd = {0.6, 0.55, 0.5, 0.4}, up = {200, 450, 1000},
	},
	Guest = {
		name = "Guest", desc = "The mysterious guest with a pistol. Sees hidden enemies.", cost = 450, unlock = 500, limit = 6, kind = "single", hidden = true,
		dmg = {4, 7, 11, 18}, range = {15, 16, 17, 19}, cd = {0.9, 0.8, 0.7, 0.55}, up = {300, 700, 1500},
	},
	Rocketeer = {
		name = "Rocketeer", desc = "Rocket launcher. Blasts groups of enemies.", cost = 700, unlock = 1200, limit = 5, kind = "splash", radius = {4, 4.5, 5, 6}, hidden = false,
		dmg = {8, 13, 22, 40}, range = {16, 17, 18, 20}, cd = {2.5, 2.3, 2.1, 1.8}, up = {500, 1200, 2600},
	},
	IceMage = {
		name = "Ice Mage", desc = "Freezing staff. Slows enemies down.", cost = 600, unlock = 1500, limit = 4, kind = "slow", slow = {0.35, 0.4, 0.5, 0.6}, slowTime = 2.5, hidden = false,
		dmg = {2, 3, 5, 9}, range = {12, 13, 14, 16}, cd = {1.2, 1.1, 1.0, 0.9}, up = {400, 900, 1800},
	},
	Sniper = {
		name = "Sniper", desc = "Huge range, huge damage, slow reload. Sees hidden.", cost = 1000, unlock = 3000, limit = 4, kind = "single", hidden = true,
		dmg = {18, 30, 55, 100}, range = {35, 40, 45, 55}, cd = {3.0, 2.8, 2.5, 2.1}, up = {700, 1600, 3500},
	},
	Farm = {
		name = "Cash Farm", desc = "Makes cash at the end of every wave.", cost = 500, unlock = 2000, limit = 4, kind = "farm", hidden = false,
		income = {80, 160, 300, 550}, dmg = {0, 0, 0, 0}, range = {0, 0, 0, 0}, cd = {9, 9, 9, 9}, up = {400, 900, 1800},
	},
}
-- shop order
C.ORDER = {"Noob", "Bacon", "Guest", "Rocketeer", "IceMage", "Farm", "Sniper"}
C.SELL = 0.6 -- you get 60% of what you spent back
C.SLOTS = 5 -- towers in your hotbar
C.START_LOADOUT = {"Noob", "Bacon"}

-- ENEMIES: health, speed (studs per second), cash for the kill, armor (flat damage taken off each hit, minimum 1), dmg (base damage if it gets through), hidden, boss
C.ENEMIES = {
	Zombie = {name = "Zombie", hp = 10, speed = 9, cash = 6, armor = 0, dmg = 2},
	Runner = {name = "Runner", hp = 7, speed = 15, cash = 7, armor = 0, dmg = 2},
	Tank = {name = "Big Zombie", hp = 70, speed = 6, cash = 18, armor = 0, dmg = 8},
	Knight = {name = "Zombie Knight", hp = 45, speed = 8, cash = 16, armor = 2, dmg = 6},
	Ghost = {name = "Ghost", hp = 25, speed = 11, cash = 14, armor = 0, dmg = 4, hidden = true},
	Golem = {name = "Brick Golem", hp = 900, speed = 5, cash = 200, armor = 3, dmg = 40, boss = true},
	King = {name = "Zombie King", hp = 4500, speed = 4, cash = 0, armor = 4, dmg = 100, boss = true},
}

-- ANIMATIONS ---------------------------------------------------------------
-- Paste your animation IDs here (from the Animation Editor: right click > Publish to Roblox, copy the number).
-- Write them like "rbxassetid://1234567890" or just the number "1234567890". Leave "" to use the built-in code animation.
-- You can ALSO put IDs into the Animation objects inside each model (ReplicatedStorage.TD.Towers.Noob.Animations.Idle etc.).
-- Order: this list first, then the model's Animation object, then the built-in animation.
-- Towers: Idle (loops), Attack (plays every hit), Place (plays once when placed)
-- Enemies: Walk (loops), Death (plays once when it dies)
C.ANIMS = {
	Noob = {Idle = "", Attack = "", Place = ""},
	Bacon = {Idle = "", Attack = "", Place = ""},
	Guest = {Idle = "", Attack = "", Place = ""},
	Rocketeer = {Idle = "", Attack = "", Place = ""},
	IceMage = {Idle = "", Attack = "", Place = ""},
	Sniper = {Idle = "", Attack = "", Place = ""},
	Farm = {Idle = "", Attack = "", Place = ""},

	Zombie = {Walk = "", Death = ""},
	Runner = {Walk = "", Death = ""},
	Tank = {Walk = "", Death = ""},
	Knight = {Walk = "", Death = ""},
	Ghost = {Walk = "", Death = ""},
	Golem = {Walk = "", Death = ""},
	King = {Walk = "", Death = ""},
}
-- speed of the walk animation compared to the enemy speed (1 = normal)
C.WALK_ANIM_SPEED = 1
-- turn the built-in code animations off completely (true = only your IDs play)
C.NO_BUILTIN_ANIMS = false

-- MATCH
C.WAVES = 30
C.START_CASH = 600
C.BASE_HP = 100
C.INTERMISSION = 20 -- seconds in the lobby before a match
C.BREAK = 8 -- seconds between waves (skip vote can start the next wave sooner)
C.WAVE_BONUS = function(w) return 100 + w * 15 end
C.COINS = function(wave, won) return wave * 6 + (won and 250 or 0) end
-- HP multiplier per wave and for more players
C.HPMUL = function(w, players) return (1.06 ^ (w - 1)) * (1 + 0.6 * (players - 1)) end

-- WAVES: list of {enemy, count, gap seconds}
function C.wave(w)
	local L = {}
	local function add(k, n, gap) L[#L + 1] = {k, n, gap} end
	add("Zombie", 4 + w, 0.9)
	if w >= 3 then add("Runner", math.floor(w / 2) + 1, 0.6) end
	if w >= 6 then add("Tank", math.floor(w / 4), 1.6) end
	if w >= 8 then add("Knight", math.floor(w / 3), 1.2) end
	if w >= 12 then add("Ghost", math.floor(w / 3), 1.0) end
	if w >= 18 then add("Tank", math.floor(w / 3), 1.2) end
	if w % 10 == 0 and w < C.WAVES then add("Golem", math.floor(w / 10), 3) end
	if w == C.WAVES then add("King", 1, 2) end
	return L
end

-- PATH helpers (shared by server and client): points from a map's Waypoints folder (parts named 1, 2, 3 ...)
function C.path(map)
	local wp = map:FindFirstChild("Waypoints")
	local pts = {}
	if not wp then return pts, {}, 0 end
	local list = {}
	for _, p in ipairs(wp:GetChildren()) do local n = tonumber(p.Name) if n and p:IsA("BasePart") then list[#list + 1] = {n, p.Position} end end
	table.sort(list, function(a, b) return a[1] < b[1] end)
	for i, x in ipairs(list) do pts[i] = x[2] end
	local acc, total = {0}, 0
	for i = 2, #pts do total += (pts[i] - pts[i - 1]).Magnitude acc[i] = total end
	return pts, acc, total
end
-- position at distance d along the path
function C.at(pts, acc, d)
	if #pts == 0 then return Vector3.zero, Vector3.zAxis end
	if d <= 0 then return pts[1], (pts[2] and (pts[2] - pts[1]).Unit or Vector3.zAxis) end
	for i = 2, #pts do
		if d <= acc[i] then
			local seg = acc[i] - acc[i - 1]
			local f = seg > 0 and (d - acc[i - 1]) / seg or 0
			return pts[i - 1]:Lerp(pts[i], f), (pts[i] - pts[i - 1]).Unit
		end
	end
	return pts[#pts], (pts[#pts] - pts[#pts - 1]).Unit
end
-- distance from a point to the path (for placement)
function C.offPath(pts, p)
	local best = math.huge
	local q = Vector3.new(p.X, 0, p.Z)
	for i = 2, #pts do
		local a, b = pts[i - 1] * Vector3.new(1, 0, 1), pts[i] * Vector3.new(1, 0, 1)
		local ab = b - a
		local t = ab.Magnitude > 0 and math.clamp((q - a):Dot(ab) / ab:Dot(ab), 0, 1) or 0
		best = math.min(best, (q - (a + ab * t)).Magnitude)
	end
	return best
end
C.PATH_GAP = 4.2 -- towers must be this far from the path centre line
C.TOWER_GAP = 2.8 -- towers must be this far from each other
return C
