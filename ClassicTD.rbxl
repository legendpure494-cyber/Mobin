-- HOTBAR + PLACING
----------------------------------------------------------------------------------------------------
local loadout = {}
local slots = {}
for i = 1, C.SLOTS do slots[i] = Hotbar:FindFirstChild("Slot" .. i) end
local function refreshHotbar()
	loadout = {}
	for k in string.gmatch(lp:GetAttribute("Loadout") or "", "[^,]+") do loadout[#loadout + 1] = k end
	for i, s in ipairs(slots) do
		if s then
			local key = loadout[i]
			local cfg = key and C.TOWERS[key]
			s.Visible = cfg ~= nil
			if cfg then
				s.TowerName.Text = cfg.name
				s.Price.Text = "$" .. fmt(cfg.cost)
				picture(s.View, key)
			end
		end
	end
end
lp:GetAttributeChangedSignal("Loadout"):Connect(refreshHotbar)
refreshHotbar()
-- price colour (can I afford it?)
local function refreshAfford()
	local cashNow = lp:GetAttribute("Cash") or 0
	for i, s in ipairs(slots) do
		local cfg = s and loadout[i] and C.TOWERS[loadout[i]]
		if cfg then s.Price.TextColor3 = cashNow >= cfg.cost and C3(100, 255, 100) or C3(255, 90, 90) end
	end
end
lp:GetAttributeChangedSignal("Cash"):Connect(refreshAfford)

local placing -- {key, ghost, ring, yaw, ok, pos}
local function currentMap() return MAPS:FindFirstChild(TD:GetAttribute("Map") or "") end
local function cancelPlace()
	if placing then
		placing.ghost:Destroy()
		placing.ring:Destroy()
		placing = nil
	end
	Hint.Visible = false
end
local function ring(radius, col)
	local p = Instance.new("Part")
	p.Name, p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = "RangeRing", true, false, false, false, false
	p.Shape, p.Size, p.Material, p.Color, p.Transparency = Enum.PartType.Cylinder, V3(0.1, radius * 2, radius * 2), Enum.Material.Neon, col, 0.75
	p.Parent = workspace
	return p
end
local function startPlace(key)
	cancelPlace()
	local cfg = C.TOWERS[key]
	local tpl = TOWER_MODELS:FindFirstChild(key)
	if not cfg or not tpl or not inMatch() then return end
	local g = tpl:Clone()
	for _, p in ipairs(g:GetDescendants()) do
		if p:IsA("BasePart") then
			p.CanCollide, p.CanQuery, p.CanTouch, p.Anchored = false, false, false, true
			if p.Transparency < 1 then p.Transparency = 0.45 end
		elseif p:IsA("Script") or p:IsA("LocalScript") then p:Destroy() end
	end
	local hl = Instance.new("Highlight")
	hl.FillTransparency, hl.OutlineTransparency, hl.Parent = 0.6, 0.2, g
	g.Parent = workspace
	local cf, size = tpl:GetBoundingBox()
	local lift = tpl:GetPivot().Position.Y - (cf.Position.Y - size.Y / 2)
	placing = {key = key, cfg = cfg, ghost = g, hl = hl, ring = ring(math.max(cfg.range[1], 1.5), C3(255, 255, 255)), yaw = 0, lift = lift}
	Hint.Visible = true
end
for i, s in ipairs(slots) do
	if s then
		s.MouseButton1Click:Connect(function()
			click()
			local key = loadout[i]
			if not key then return end
			if placing and placing.key == key then cancelPlace() else startPlace(key) end
		end)
	end
end

-- where the mouse points on the map ground
-- pos from UserInputService:GetMouseLocation() (viewport) or from input.Position (screen, screen = true)
local function mouseHit(pos, screen)
	local map = currentMap()
	if not map then return nil end
	local ray = screen and cam:ScreenPointToRay(pos.X, pos.Y) or cam:ViewportPointToRay(pos.X, pos.Y)
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Include
	rp.FilterDescendantsInstances = {map}
	return workspace:Raycast(ray.Origin, ray.Direction * 500, rp)
end
local pathPts = {}
TD:GetAttributeChangedSignal("Map"):Connect(function()
	local m = currentMap()
	pathPts = m and C.path(m) or {}
	cancelPlace()
end)
local function canPlace(hit)
	if not hit or hit.Instance.Name ~= "Ground" then return false end
	if #pathPts > 1 and C.offPath(pathPts, hit.Position) < C.PATH_GAP then return false end
	for _, t in ipairs(TOWERS:GetChildren()) do
		local pv = t:GetPivot().Position
		if ((pv - hit.Position) * V3(1, 0, 1)).Magnitude < C.TOWER_GAP then return false end
	end
	return (lp:GetAttribute("Cash") or 0) >= placing.cfg.cost
end
Run.RenderStepped:Connect(function()
	if not placing then return end
	local hit = mouseHit(UIS:GetMouseLocation())
	if hit then
		local ok = canPlace(hit)
		placing.ok, placing.pos = ok, hit.Position
		placing.ghost:PivotTo(CF(hit.Position + V3(0, placing.lift, 0)) * CFrame.Angles(0, placing.yaw, 0))
		placing.ring.CFrame = CF(hit.Position + V3(0, 0.15, 0)) * CFrame.Angles(0, 0, math.rad(90))
		local col = ok and C3(90, 255, 90) or C3(255, 70, 70)
		placing.hl.FillColor, placing.hl.OutlineColor, placing.ring.Color = col, col, col
	end
end)

----------------------------------------------------------------------------------------------------
-- TOWER PANEL
----------------------------------------------------------------------------------------------------
local selected
local selRing
local function closePanel()
	selected = nil
	Panel.Visible = false
	if selRing then selRing:Destroy() selRing = nil end
end
local function refreshPanel()
	if not selected or not selected.Parent then closePanel() return end
	local key = selected:GetAttribute("Key")
	local cfg = C.TOWERS[key]
	if not cfg then closePanel() return end
	local lv = selected:GetAttribute("Level") or 1
	local mine = selected:GetAttribute("Owner") == lp.UserId
	Panel.Title.Text = cfg.name
	Panel.Level.Text = "Level " .. lv .. " / " .. (#cfg.up + 1)
	local nx = lv + 1
	local function stat(name, list, suffix)
		local now = list[lv]
		local after = list[nx]
		return name .. ": " .. tostring(now) .. (suffix or "") .. (after and after ~= now and ("  →  " .. tostring(after) .. (suffix or "")) or "")
	end
	local lines = {}
	if cfg.kind == "farm" then
		lines[#lines + 1] = stat("Cash per wave", cfg.income)
	else
		lines[#lines + 1] = stat("Damage", cfg.dmg)
		lines[#lines + 1] = stat("Range", cfg.range)
		lines[#lines + 1] = stat("Reload", cfg.cd, "s")
		if cfg.radius then lines[#lines + 1] = stat("Blast", cfg.radius) end
		if cfg.slow then lines[#lines + 1] = "Slow: " .. math.floor(cfg.slow[lv] * 100) .. "%" end
		if cfg.hidden then lines[#lines + 1] = "Sees hidden enemies" end
	end
	Panel.Stats.Text = table.concat(lines, "\n")
	local price = cfg.up[lv]
	Panel.Upgrade.Text = price and ("UPGRADE  $" .. fmt(price)) or "MAX LEVEL"
	Panel.Upgrade.Visible, Panel.Sell.Visible, Panel.Target.Visible = mine, mine, mine and cfg.kind ~= "farm"
	Panel.Sell.Text = "SELL  $" .. fmt((selected:GetAttribute("Spent") or 0) * C.SELL)
	Panel.Target.Text = "Target: " .. (selected:GetAttribute("Target") or "First")
	local owner = Players:GetPlayerByUserId(selected:GetAttribute("Owner") or 0)
	Panel.Owner.Text = owner and ("Owner: " .. owner.DisplayName) or ""
	if selRing then selRing:Destroy() end
	if cfg.kind ~= "farm" then
		selRing = ring(cfg.range[lv], C3(120, 200, 255))
		selRing.CFrame = CF(selected:GetPivot().Position * V3(1, 0, 1) + V3(0, 0.15, 0)) * CFrame.Angles(0, 0, math.rad(90))
	end
end
local function openPanel(m)
	selected = m
	Panel.Visible = true
	refreshPanel()
	m.AttributeChanged:Connect(function() if selected == m then refreshPanel() end end)
end
Panel.Close.MouseButton1Click:Connect(function() click() closePanel() end)
Panel.Upgrade.MouseButton1Click:Connect(function() click() if selected then REM.Upgrade:FireServer(selected:GetAttribute("Id")) end end)
Panel.Sell.MouseButton1Click:Connect(function() click() if selected then REM.Sell:FireServer(selected:GetAttribute("Id")) closePanel() end end)
Panel.Target.MouseButton1Click:Connect(function() click() if selected then REM.Target:FireServer(selected:GetAttribute("Id")) end end)

----------------------------------------------------------------------------------------------------
-- INPUT
----------------------------------------------------------------------------------------------------
local function towerAt(screenPos)
	local ray = cam:ScreenPointToRay(screenPos.X, screenPos.Y)
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Include
	rp.FilterDescendantsInstances = {TOWERS}
	local h = workspace:Raycast(ray.Origin, ray.Direction * 500, rp)
	if not h then return nil end
	local m = h.Instance
	while m and m.Parent ~= TOWERS do m = m.Parent end
	return m
end
UIS.InputBegan:Connect(function(input, gp)
	if gp then return end
	local t = input.UserInputType
	if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
		local pos = Vector2.new(input.Position.X, input.Position.Y)
		if placing then
			local hit = mouseHit(pos, true)
			if hit then placing.ok = canPlace(hit) placing.pos = hit.Position end
			if placing.ok then
				REM.Place:FireServer(placing.key, placing.pos, placing.yaw)
				if not UIS:IsKeyDown(Enum.KeyCode.LeftShift) then cancelPlace() end
			else
				message("You can't place there.", C3(255, 120, 120))
			end
			return
		end
		local m = towerAt(pos)
		if m then openPanel(m) elseif selected then closePanel() end
	elseif t == Enum.UserInputType.MouseButton2 then
		cancelPlace()
	elseif input.KeyCode == Enum.KeyCode.Q then
		cancelPlace()
	elseif input.KeyCode == Enum.KeyCode.R and placing then
		placing.yaw += math.rad(45)
	elseif input.KeyCode.Value >= Enum.KeyCode.One.Value and input.KeyCode.Value <= Enum.KeyCode.Five.Value then
		local i = input.KeyCode.Value - Enum.KeyCode.One.Value + 1
		if loadout[i] and inMatch() then
			if placing and placing.key == loadout[i] then cancelPlace() else startPlace(loadout[i]) end
		end
	end
end)
TD:GetAttributeChangedSignal("Phase"):Connect(function()
	if not inMatch() then cancelPlace() closePanel() end
end)
-- keep the selection ring under a tower that turned to face enemies
TOWERS.ChildRemoved:Connect(function(m) if m == selected then closePanel() end end)

