><YS>0</YS><YO>24</YO></UDim2><UDim2 name="Position"><XS>0</XS><XO>8</XO><YS>0</YS><YO>38</YO></UDim2><Color3 name="BackgroundColor3"><R>0.11765</R><G>0.11765</G><B>0.11765</B></Color3></Properties><Item class="Frame" referent="RBXD938"><Properties><string name="Name">Fill</string><int name="BorderSizePixel">0</int><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><UDim2 name="Position"><XS>0</XS><XO>0</XO><YS>0</YS><YO>0</YO></UDim2><Color3 name="BackgroundColor3"><R>0.29412</R><G>0.78431</G><B>0.29412</B></Color3></Properties></Item><Item class="TextLabel" referent="RBXD939"><Properties><string name="Name">BaseText</string><float name="TextStrokeTransparency">0</float><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><string name="Text">Base: 100 / 100</string><Font name="FontFace"><Family><url>rbxasset://fonts/families/SourceSansPro.json</url></Family><Weight>700</Weight><Style>Normal</Style></Font><float name="BackgroundTransparency">1</float><UDim2 name="Position"><XS>0</XS><XO>0</XO><YS>0</YS><YO>0</YO></UDim2><Color3 name="TextColor3"><R>1.0</R><G>1.0</G><B>1.0</B></Color3><bool name="TextScaled">true</bool></Properties></Item></Item></Item><Item class="TextButton" referent="RBXD940"><Properties><string name="Name">Skip</string><bool name="Visible">false</bool><float name="TextStrokeTransparency">0</float><Vector2 name="AnchorPoint"><X>0.5</X><Y>0</Y></Vector2><int name="BorderSizePixel">2</int><UDim2 name="Size"><XS>0</XS><XO>200</XO><YS>0</YS><YO>36</YO></UDim2><string name="Text">SKIP WAVE</string><Font name="FontFace"><Family><url>rbxasset://fonts/families/SourceSansPro.json</url></Family><Weight>700</Weight><Style>Normal</Style></Font><UDim2 name="Position"><XS>0.5</XS><XO>0</XO><YS>0</YS><YO>84</YO></UDim2><Color3 name="TextColor3"><R>1.0</R><G>1.0</G><B>1.0</B></Color3><bool name="TextScaled">true</bool><Color3 name="BackgroundColor3"><R>1.0</R><G>0.66667</G><B>0.0</B></Color3></Properties></Item><Item class="TextLabel