>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>1.8000</X><Y>3.6000</Y><Z>1.8000</Z></Vector3><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><token name="BottomSurface">4</token><token name="TopSurface">3</token></Properties></Item><Item class="Part" referent="RBXD394"><Properties><string name="Name">Left Leg</string><Color3uint8 name="Color3uint8">4282127390</Color3uint8><CoordinateFrame name="CFrame"><X>-0.9</X><Y>1.8</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>1.8000</X><Y>3.6000</Y><Z>1.8000</Z></Vector3><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><token name="BottomSurface">4</token><token name="TopSurface">3</token></Properties></Item><Item class="Part" referent="RBXD395"><Properties><string name="Name">Right Leg</string><Color3uint8 name="Color3uint8">4282127390</Color3uint8><CoordinateFrame name="CFrame"><X>0.9</X><Y>1.8</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>1.8000</X><Y>3.6000</Y><Z>1.8000</Z></Vector3><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><token name="BottomSurface">4</token><token name="TopSurface">3</token></Properties></Item><Item class="AnimationController" referent="RBXD396"><Properties><string name="Name">AnimationController</string></Properties><Item class="Animator" referent="RBXD397"><Properties><string name="Name">Animator</string></Properties></Item></Item><Item class="Part" referent="RBXD398"><Properties><string name="Name">Crown</string><Color3uint8 name="Color3uint8">4294953000</Color3uint8><CoordinateFrame name="CFrame"><X>0</X><Y>9.360000000000001</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><token name="Material">1088</token><Vector3 name="size"><X>2.5200</X><Y>0.7200</Y><Z>2.3400</Z></Vector3><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties><Item class="Weld" referent="RBXD399"><Properties><string name="Name">Glue</string><Ref name="Part1">RBXD398</Ref><CoordinateFrame name="C0"><X>0</X><Y>1.2600000000000016</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Ref name="Part0">RBXD389</Ref></Properties></Item></Item><Item class="Part" referent="RBXD400"><Properties><string name="Name">Spike</string><Color3uint8 name="Color3uint8">4294953000</Color3uint8><CoordinateFrame name="CFrame"><X>-0.81</X><Y>10.08</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><token name="Material">1088</token><Vector3 name="size"><X>0.5400</X><Y>0.7200</Y><Z>0.5400</Z></Vector3><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties><Item class="Weld" referent="RBXD401"><Properties><string name="Name">Glue</string><Ref name="Part1">RBXD400</Ref><CoordinateFrame name="C0"><X>-0.81</X><Y>1.9800000000000004</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Ref name="Part0">RBXD389</Ref></Properties></Item></Item><Item class="Part" referent="RBXD402"><Properties><string name="Name">Spike</string><Color3uint8 name="Color3uint8">4294953000</Color3uint8><CoordinateFrame name="CFrame"><X>0</X><Y>10.08</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><token name="Material">1088</token><Vector3 name="size"><X>0.5400</X><Y>0.7200</Y><Z>0.5400</Z></Vector3><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties><Item class="Weld" referent="RBXD403"><Properties><string name="Name">Glue</string><Ref name="Part1">RBXD402</Ref><CoordinateFrame name="C0"><X>0</X><Y>1.9800000000000004</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Ref name="Part0">RBXD389</Ref></Properties></Item></Item><Item class="Part" referent="RBXD404"><Properties><string name="Name">Spike</string><Color3uint8 name="Color3uint8">4294953000</Color3uint8><CoordinateFrame name="CFrame"><X>0.81</X><Y>10.08</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><token name="Material">1088</token><Vector3 name="size"><X>0.5400</X><Y>0.7200</Y><Z>0.5400</Z></Vector3><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties><Item class="Weld" referent="RBXD405"><Properties><string name="Name">Glue</string><Ref name="Part1">RBXD404</Ref><CoordinateFrame name="C0"><X>0.81</X><Y>1.9800000000000004</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Ref name="Part0">RBXD389</Ref></Properties></Item></Item><Item class="Part" referent="RBXD406"><Properties><string name="Name">Cape</string><Color3uint8 name="Color3uint8">4286054430</Color3uint8><CoordinateFrame name="CFrame"><X>0</X><Y>4.86</Y><Z>1.08</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>3.6000</X><Y>5.4000</Y><Z>0.2700</Z></Vector3><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties><Item class="Weld" referent="RBXD407"><Properties><string name="Name">Glue</string><Ref name="Part1">RBXD406</Ref><CoordinateFrame name="C0"><X>0</X><Y>-0.54</Y><Z>1.08</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Ref name="Part0">RBXD383</Ref></Properties></Item></Item><Item class="Folder" referent="RBXD408"><Properties><string name="Name">Animations</string></Properties><Item class="Animation" referent="RBXD409"><Properties><string name="Name">Walk</string></Properties></Item><Item class="Animation" referent="RBXD410"><Properties><string name="Name">Death</string></Properties></Item></Item></Item></Item></Item></Item>
<Item class="ServerScriptService" referent="RBXSS"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBXSTD_Server"><Properties><string name="Name">TD_Server</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[--[[
	TD_Server | ServerScriptService (Script)
	CLASSIC TOWER DEFENSE - all game rules run here.

	What it does:
	  * player data (coins, owned towers, hotbar loadout, wins) saved with DataStore
	  * lobby: map voting on the vote pads, intermission countdown
	  * match: teleports everyone to the chosen map, waves of enemies walk the path,
	    towers attack them, cash for kills and waves, cash farms, skip-wave votes, win / lose
	  * enemies are simulated here and sent to every client ("sync"); the clients draw and animate them
	  * towers are real models (cloned from ReplicatedStorage.TD.Towers) placed in Workspace.Towers
	  * shop: buy towers with coins, choose up to 5 for your hotbar

	Settings live in ReplicatedStorage.TD.Config. Maps are the models in Workspace.Maps.
	The Baseplate and SpawnLocation are removed; players are moved by code.
]]

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local DSS = game:GetService("DataStoreService")
local Run = game:GetService("RunService")

for _, x in ipairs(workspace:GetChildren()) do
	if x.Name == "Baseplate" or x:IsA("SpawnLocation") then x:Destroy() end
end

local TD = RS:WaitForChild("TD")
local C = require(TD:WaitForChild("Config"))
local TOWER_MODELS = TD:WaitForChild("Towers")
local LOBBY = workspace:WaitForChild("Lobby")
local MAPS = workspace:WaitForChild("Maps")

local V3, CF = Vector3.new, CFrame.new

----------------------------------------------------------------------------------------------------
-- REMOTES (made here if they are missing)
----------------------------------------------------------------------------------------------------
local remotes = TD:FindFirstChild("Remotes") or Instance.new("Folder")
remotes.Name = "Remotes"
remotes.Parent = TD
local function remote(name)
	local r = remotes:FindFirstChild(name)
	if not r then
		r = Instance.new("RemoteEvent")
		r.Name = name
		r.Parent = remotes
	end
	return r
end
local R = {
	Place = remote("Place"), Upgrade = remote("Upgrade"), Sell = remote("Sell"), Target = remote("Target"),
	Skip = remote("Skip"), Buy = remote("Buy"), Equip = remote("Equip"),
	Sync = remote("Sync"), Fx = remote("Fx"), Notify = remote("Notify"), Result = remote("Result"),
}

local towersFolder = workspace:FindFirstChild("Towers") or Instance.new("Folder")
towersFolder.Name = "Towers"
towersFolder.Parent = workspace

local function notify(p, text)
	if p then R.Notify:FireClient(p, text) else R.Notify:FireAllClients(text) end
end
local function state(k, v) TD:SetAttribute(k, v) end

----------------------------------------------------------------------------------------------------
-- PLAYER DATA
----------------------------------------------------------------------------------------------------
local okStore, store = pcall(function() return DSS:GetDataStore("ClassicTD_v1") end)
if not okStore then store = nil end
local data = {}

local function sync(p)
	local d = data[p]
	if not d then return end
	local owned = {}
	for k in pairs(d.owned) do owned[#owned + 1] = k end
	p:SetAttribute("Coins", d.coins)
	p:SetAttribute("Wins", d.wins)
	p:SetAttribute("Owned", table.concat(owned, ","))
	p:SetAttribute("Loadout", table.concat(d.loadout, ","))
	local ls = p:FindFirstChild("leaderstats")
	if ls then
		ls.Coins.Value = d.coins
		ls.Wins.Value = d.wins
	end
end
local function save(p)
	local d = data[p]
	if d and store then
		pcall(function() store:SetAsync("u" .. p.UserId, d) end)
	end
end

local function lobbySpawn()
	local s = LOBBY:FindFirstChild("LobbySpawn")
	return s and (s.CFrame + V3(0, 3, 0)) or CF(0, 5, 0)
end
local currentMap -- the map Model being played
local function spawnCF()
	if currentMap then
		local s = currentMap:FindFirstChild("PlayerSpawn")
		if s then return s.CFrame + V3(0, 3, 0) end
	end
	return lobbySpawn()
end

local function onJoin(p)
	local d
	if store then
		local ok, v = pcall(function() return store:GetAsync("u" .. p.UserId) end)
		if ok and type(v) == "table" then d = v end
	end
	d = d or {}
	d.coins = d.coins or 0
	d.wins = d.wins or 0
	d.owned = type(d.owned) == "table" and d.owned or {}
	d.loadout = type(d.loadout) == "table" and d.loadout or {}
	for k, t in pairs(C.TOWERS) do if t.unlock == 0 then d.owned[k] = true end end
	if #d.loadout == 0 then for _, k in ipairs(C.START_LOADOUT) do table.insert(d.loadout, k) end end
	-- remove towers that no longer exist in the config
	for i = #d.loadout, 1, -1 do if not C.TOWERS[d.loadout[i]] then table.remove(d.loadout, i) end end
	data[p] = d

	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local c = Instance.new("IntValue") c.Name = "Coins" c.Parent = ls
	local w = Instance.new("IntValue") w.Name = "Wins" w.Parent = ls
	ls.Parent = p
	p:SetAttribute("Cash", 0)
	sync(p)

	p.CharacterAdded:Connect(function(ch)
		task.wait(0.15)
		if ch.Parent then ch:PivotTo(spawnCF() * CF(math.random(-3, 3), 0, math.random(-3, 3))) end
	end)
	if p.Character then p.Character:PivotTo(spawnCF()) end
end
Players.PlayerAdded:Connect(onJoin)
for _, p in ipairs(Players:GetPlayers()) do task.spawn(onJoin, p) end
Players.PlayerRemoving:Connect(function(p)
	save(p)
	data[p] = nil
end)
game:BindToClose(function() for p in pairs(data) do save(p) end end)
task.spawn(function() while true do task.wait(120) for p in pairs(data) do save(p) end end end)

----------------------------------------------------------------------------------------------------
-- SHOP: buy towers, choose the hotbar
----------------------------------------------------------------------------------------------------
R.Buy.OnServerEvent:Connect(function(p, key)
	local d, t = data[p], C.TOWERS[key]
	if not d or not t then return end
	if d.owned[key] then notify(p, "You already own " .. t.name .. ".") return end
	if d.coins < t.unlock then notify(p, "You need " .. t.unlock .. " coins for " .. t.name .. ".") return end
	d.coins -= t.unlock
	d.owned[key] = true
	if #d.loadout < C.SLOTS then table.insert(d.loadout, key) end
	notify(p, "Unlocked " .. t.name .. "!")
	sync(p)
	save(p)
end)
R.Equip.OnServerEvent:Connect(function(p, key)
	local d = data[p]
	if not d or not C.TOWERS[key] or not d.owned[key] then return end
	if TD:GetAttribute("Phase") == "match" then notify(p, "Change your hotbar in the lobby.") return end
	local i = table.find(d.loadout, key)
	if i then
		if #d.loadout <= 1 then notify(p, "Keep at least one tower.") return end
		table.remove(d.loadout, i)
	elseif #d.loadout >= C.SLOTS then
		notify(p, "Your hotbar is full (" .. C.SLOTS .. "). Remove one first.")
		return
	else
		table.insert(d.loadout, key)
	end
	sync(p)
end)

----------------------------------------------------------------------------------------------------
-- MATCH STATE
----------------------------------------------------------------------------------------------------
local pts, acc, pathLen = {}, {}, 0
local enemies = {} -- list of enemy tables
local towers = {} -- id -> tower table
local nextId = 0
local baseHP = C.BASE_HP
local skipVotes = {}
local matchPlayers = {}

local function cash(p, n)
	p:SetAttribute("Cash", math.max(0, math.floor((p:GetAttribute("Cash") or 0) + n)))
end

-- spawn one enemy at the start of the path
local function spawnEnemy(kind, wave)
	local e = C.ENEMIES[kind]
	if not e then return end
	nextId += 1
	local hp = math.floor(e.hp * C.HPMUL(wave, math.max(1, #matchPlayers)) + 0.5)
	if e.boss then hp = math.floor(e.hp * (1 + 0.6 * (math.max(1, #matchPlayers) - 1))) end
	table.insert(enemies, {id = nextId, kind = kind, e = e, hp = hp, max = hp, d = 0, slowMul = 1, slowUntil = 0})
end

local function posOf(en)
	local p = C.at(pts, acc, en.d)
	return p
end

local function hurt(en, dmg, attacker)
	if en.hp <= 0 then return end
	dmg = math.max(1, dmg - (en.e.armor or 0))
	en.hp -= dmg
	if attacker then attacker.dealt = (attacker.dealt or 0) + dmg end
	if en.hp <= 0 then
		for _, p in ipairs(matchPlayers) do if p.Parent then cash(p, en.e.cash) end end
		if attacker then attacker.kills = (attacker.kills or 0) + 1 end
	end
end

-- move enemies, check the base
local lastSync = 0
Run.Heartbeat:Connect(function(dt)
	if TD:GetAttribute("Phase") ~= "match" then return end
	local now = os.clock()
	for i = #enemies, 1, -1 do
		local en = enemies[i]
		if en.hp <= 0 then
			table.remove(enemies, i)
		else
			if now > en.slowUntil then en.slowMul = 1 end
			en.d += en.e.speed * en.slowMul * dt
			if en.d >= pathLen then
				baseHP -= en.e.dmg or (en.e.boss and 50 or 2)
				state("BaseHP", math.max(0, baseHP))
				table.remove(enemies, i)
			end
		end
	end
	-- send everyone the enemy list 10 times a second
	if now - lastSync >= 0.1 then
		lastSync = now
		local list = table.create(#enemies)
		for i, en in ipairs(enemies) do list[i] = {en.id, en.kind, math.floor(en.d * 100) / 100, math.ceil(en.hp), en.max, en.slowMul < 1} end
		R.Sync:FireAllClients(list)
	end
end)

----------------------------------------------------------------------------------------------------
-- TOWERS: placing, upgrading, selling, attacking
----------------------------------------------------------------------------------------------------
-- how far the model's pivot is above its lowest point (so it stands on the ground)
local lift = {}
local function liftOf(key)
	if lift[key] then return lift[key] end
	local tpl = TOWER_MODELS:FindFirstChild(key)
	if not tpl then return 0 end
	local cf, size = tpl:GetBoundingBox()
	lift[key] = tpl:GetPivot().Position.Y - (cf.Position.Y - size.Y / 2)
	return lift[key]
end
local function countOwned(p, key)
	local n = 0
	for _, t in pairs(towers) do if t.owner == p and t.key == key then n += 1 end end
	return n
end
local function tag(t)
	t.model:SetAttribute("Level", t.level)
	t.model:SetAttribute("Target", t.target)
	t.model:SetAttribute("Spent", t.spent)
end

R.Place.OnServerEvent:Connect(function(p, key, pos, yaw)
	local d = data[p]
	local cfg = C.TOWERS[key]
	if not d or not cfg or typeof(pos) ~= "Vector3" then return end
	if TD:GetAttribute("Phase") ~= "match" or not currentMap then return end
	if not table.find(matchPlayers, p) then return end
	if not table.find(d.loadout, key) then return end
	if (p:GetAttribute("Cash") or 0) < cfg.cost then notify(p, "Not enough cash!") return end
	if countOwned(p, key) >= cfg.limit then notify(p, cfg.name .. " limit: " .. cfg.limit) return end
	-- must stand on this map's ground
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Include
	rp.FilterDescendantsInstances = {currentMap}
	local hit = workspace:Raycast(pos + V3(0, 6, 0), V3(0, -14, 0), rp)
	if not hit or hit.Instance.Name ~= "Ground" then notify(p, "You can't place there.") return end
	local at = hit.Position
	if C.offPath(pts, at) < C.PATH_GAP then notify(p, "Too close to the path.") return end
	for _, t in pairs(towers) do
		if ((t.pos - at) * V3(1, 0, 1)).Magnitude < C.TOWER_GAP then notify(p, "Too close to another tower.") return end
	end
	local tpl = TOWER_MODELS:FindFirstChild(key)
	if not tpl then notify(p, "Missing model for " .. key) return end
	cash(p, -cfg.cost)
	nextId += 1
	local m = tpl:Clone()
	m:PivotTo(CF(at + V3(0, liftOf(key), 0)) * CFrame.Angles(0, type(yaw) == "number" and yaw or 0, 0))
	m:SetAttribute("Id", nextId)
	m:SetAttribute("Key", key)
	m:SetAttribute("Owner", p.UserId)
	m.Parent = towersFolder
	local t = {id = nextId, key = key, cfg = cfg, owner = p, level = 1, model = m, pos = at, next = 0, target = "First", spent = cfg.cost}
	towers[nextId] = t
	tag(t)
	R.Fx:FireAllClients("place", m)
end)

R.Upgrade.OnServerEvent:Connect(function(p, id)
	local t = towers[id]
	if not t or t.owner ~= p then return end
	local price = t.cfg.up[t.level]
	if not price then notify(p, "Max level!") return end
	if (p:GetAttribute("Cash") or 0) < price then notify(p, "Not enough cash!") return end
	cash(p, -price)
	t.level += 1
	t.spent += price
	tag(t)
	R.Fx:FireAllClients("upgrade", t.model)
end)
R.Sell.OnServerEvent:Connect(function(p, id)
	local t = towers[id]
	if not t or t.owner ~= p then return end
	cash(p, t.spent * C.SELL)
	towers[id] = nil
	t.model:Destroy()
end)
local MODES = {"First", "Last", "Strongest", "Closest"}
R.Target.OnServerEvent:Connect(function(p, id)
	local t = towers[id]
	if not t or t.owner ~= p then return end
	local i = table.find(MODES, t.target) or 1
	t.target = MODES[i % #MODES + 1]
	tag(t)
end)

-- attack loop
local function attack(t, now)
	local cfg, lv = t.cfg, t.level
	if cfg.kind == "farm" then return end
	if now < t.next then return end
	local range = cfg.range[lv]
	local list = {}
	for _, en in ipairs(enemies) do
		if en.hp > 0 and (cfg.hidden or not en.e.hidden) then
			local ep = posOf(en)
			local dist = ((ep - t.pos) * V3(1, 0, 1)).Magnitude
			if dist <= range then list[#list + 1] = {en, ep, dist} end
		end
	end
	if #list == 0 then return end
	local mode = t.target
	table.sort(list, function(a, b)
		if mode == "Last" then return a[1].d < b[1].d
		elseif mode == "Strongest" then return a[1].hp > b[1].hp
		elseif mode == "Closest" then return a[3] < b[3] end
		return a[1].d > b[1].d
	end)
	local target, tp = list[1][1], list[1][2]
	t.next = now + cfg.cd[lv]
	-- turn to face the target
	local pv = t.model:GetPivot()
	t.model:PivotTo(CF(pv.Position, V3(tp.X, pv.Position.Y, tp.Z)))
	local dmg = cfg.dmg[lv]
	if cfg.kind == "splash" then
		local r = cfg.radius[lv]
		for _, en in ipairs(enemies) do
			if en.hp > 0 and (cfg.hidden or not en.e.hidden) and ((posOf(en) - tp) * V3(1, 0, 1)).Magnitude <= r then hurt(en, dmg, t) end
		end
	else
		hurt(target, dmg, t)
		if cfg.kind == "slow" then
			target.slowMul = math.min(target.slowMul, 1 - cfg.slow[lv])
			target.slowUntil = now + cfg.slowTime
		end
	end
	R.Fx:FireAllClients("attack", t.model, tp, t.key, lv)
end
task.spawn(function()
	while true do
		task.wait(0.05)
		if TD:GetAttribute("Phase") == "match" then
			local now = os.clock()
			for _, t in pairs(towers) do
				if t.model.Parent then attack(t, now) end
			end
		end
	end
end)

----------------------------------------------------------------------------------------------------
-- SKIP WAVE VOTES (between waves)
----------------------------------------------------------------------------------------------------
R.Skip.OnServerEvent:Connect(function(p)
	if TD:GetAttribute("Phase") ~= "match" or not TD:GetAttribute("Break") then return end
	skipVotes[p] = true
	local n = 0
	for q in pairs(skipVotes) do if q.Parent then n += 1 end end
	state("SkipVotes", n)
end)

----------------------------------------------------------------------------------------------------
-- MATCH FLOW
----------------------------------------------------------------------------------------------------
local function teleportAll(cf)
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then p.Character:PivotTo(cf * CF(math.random(-4, 4), 0, math.random(-4, 4))) end
	end
end
local function clearMatch()
	for id, t in pairs(towers) do t.model:Destroy() towers[id] = nil end
	towersFolder:ClearAllChildren()
	enemies = {}
	R.Sync:FireAllClients({})
end

local function runMatch(map)
	currentMap = map
	pts, acc, pathLen = C.path(map)
	if #pts < 2 then warn("Map " .. map.Name .. " has no Waypoints!") currentMap = nil return end
	matchPlayers = Players:GetPlayers()
	baseHP = C.BASE_HP
	state("Map", map.Name)
	state("BaseHP", baseHP)
	state("MaxHP", C.BASE_HP)
	state("Phase", "match")
	for _, p in ipairs(matchPlayers) do p:SetAttribute("Cash", C.START_CASH) end
	teleportAll(spawnCF())
	notify(nil, "Defend the base on " .. map.Name .. "!")
	local won = false
	local wave = 0
	for w = 1, C.WAVES do
		wave = w
		state("Wave", w)
		-- break before the wave (skip votes end it early)
		skipVotes = {}
		state("SkipVotes", 0)
		state("Break", true)
		local t0 = os.clock()
		local need = math.max(1, math.ceil(#Players:GetPlayers() / 2))
		while os.clock() - t0 < (w == 1 and C.BREAK + 4 or C.BREAK) do
			state("Timer", math.ceil((w == 1 and C.BREAK + 4 or C.BREAK) - (os.clock() - t0)))
			if (TD:GetAttribute("SkipVotes") or 0) >= need then break end
			task.wait(0.1)
		end
		state("Break", false)
		state("Timer", 0)
		-- spawn the wave
		local list = C.wave(w)
		local total = 0
		for _, g in ipairs(list) do total += g[2] end
		state("Remaining", total)
		local spawning = true
		task.spawn(function()
			for _, g in ipairs(list) do
				for _ = 1, g[2] do
					if TD:GetAttribute("Phase") ~= "match" then spawning = false return end
					spawnEnemy(g[1], w)
					task.wait(g[3])
				end
			end
			spawning = false
		end)
		-- wait for the wave to end
		while spawning or #enemies > 0 do
			state("Remaining", #enemies)
			if baseHP <= 0 then break end
			if #Players:GetPlayers() == 0 then baseHP = 0 break end
			task.wait(0.2)
		end
		if baseHP <= 0 then break end
		-- wave reward + cash farms
		for _, p in ipairs(matchPlayers) do if p.Parent then cash(p, C.WAVE_BONUS(w)) end end
		for _, t in pairs(towers) do
			if t.cfg.kind == "farm" and t.owner.Parent then
				cash(t.owner, t.cfg.income[t.level])
				R.Fx:FireAllClients("farm", t.model, t.cfg.income[t.level])
			end
		end
		if w == C.WAVES then won = true end
	end
	-- result
	state("Phase", "ended")
	for _, p in ipairs(matchPlayers) do
		local d = data[p]
		if d and p.Parent then
			local coins = C.COINS(wave, won)
			d.coins += coins
			if won then d.wins += 1 end
			sync(p)
			save(p)
			R.Result:FireClient(p, won, wave, coins)
		end
	end
	notify(nil, won and "VICTORY! The base is safe!" or ("The base fell on wave " .. wave .. "..."))
	task.wait(8)
	clearMatch()
	currentMap = nil
	teleportAll(lobbySpawn())
	for _, p in ipairs(Players:GetPlayers()) do p:SetAttribute("Cash", 0) end
	state("Phase", "lobby")
	state("Map", "")
end

----------------------------------------------------------------------------------------------------
-- LOBBY: votes + intermission
----------------------------------------------------------------------------------------------------
local pads = {}
for _, x in ipairs(LOBBY:GetDescendants()) do
	if x.Name == "VotePad" and x:IsA("BasePart") and x:GetAttribute("Map") then pads[#pads + 1] = x end
end
local signs = {}
for _, x in ipairs(LOBBY:GetDescendants()) do
	if x.Name == "VoteSign" and x:GetAttribute("Map") then signs[x:GetAttribute("Map")] = x:FindFirstChild("Text", true) end
end
local board = LOBBY:FindFirstChild("IntermissionBoard")
local boardText = board and board:FindFirstChild("Text", true)
local function onPad(p, pad)
	local ch = p.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	if not hrp then return false end
	local l = pad.CFrame:PointToObjectSpace(hrp.Position)
	return math.abs(l.X) <= pad.Size.X / 2 and math.abs(l.Z) <= pad.Size.Z / 2 and l.Y > -1 and l.Y < 8
end
local function countVotes()
	local votes = {}
	for _, pad in ipairs(pads) do
		local n = 0
		for _, p in ipairs(Players:GetPlayers()) do if onPad(p, pad) then n += 1 end end
		votes[pad:GetAttribute("Map")] = (votes[pad:GetAttribute("Map")] or 0) + n
	end
	for name, t in pairs(signs) do t.Text = name:upper() .. "\n" .. (votes[name] or 0) .. " vote" .. ((votes[name] or 0) == 1 and "" or "s") end
	return votes
end

state("Phase", "lobby")
state("Wave", 0)
task.spawn(function()
	while true do
		if TD:GetAttribute("Phase") == "lobby" then
			if #Players:GetPlayers() == 0 then
				if boardText then boardText.Text = "Waiting for players..." end
				task.wait(1)
			else
				state("Phase", "intermission")
				local t0 = os.clock()
				while os.clock() - t0 < C.INTERMISSION do
					countVotes()
					local left = math.ceil(C.INTERMISSION - (os.clock() - t0))
					state("Timer", left)
					if boardText then boardText.Text = "Match starts in " .. left .. "\nStand on a pad to vote!" end
					task.wait(0.25)
				end
				local votes = countVotes()
				-- pick the map with the most votes (random if tied / nobody voted)
				local best, bestN = {}, -1
				for _, map in ipairs(MAPS:GetChildren()) do
					if map:IsA("Model") then
						local n = votes[map.Name] or 0
						if n > bestN then best, bestN = {map}, n elseif n == bestN then table.insert(best, map) end
					end
				end
				local map = best[math.random(#best)]
				if boardText then boardText.Text = "Playing: " .. (map and map.Name or "?") end
				if map then runMatch(map) else state("Phase", "lobby") end
			end
		end
		task.wait(0.5)
	end
end)
