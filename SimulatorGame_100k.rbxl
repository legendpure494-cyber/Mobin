		<Item class="Script" referent="RBX6">
			<Properties>
				<string name="Name">SimulatorCoreServer</string>
				<ProtectedString name="Source">-- SimulatorCoreServer.lua
local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local DataStoreService = game:GetService(&quot;DataStoreService&quot;)
local RunService = game:GetService(&quot;RunService&quot;)

local DataStore = DataStoreService:GetDataStore(&quot;PetSim_Master_v1&quot;)

local Remotes = Instance.new(&quot;Folder&quot;)
Remotes.Name = &quot;SimRemotes&quot;
Remotes.Parent = ReplicatedStorage

local function makeRemote(name)
	local r = Instance.new(&quot;RemoteEvent&quot;)
	r.Name = name
	r.Parent = Remotes
	return r
end

local ClickEvent = makeRemote(&quot;ClickEvent&quot;)
local RebirthEvent = makeRemote(&quot;RebirthEvent&quot;)
local HatchEggEvent = makeRemote(&quot;HatchEggEvent&quot;)
local EquipPetEvent = makeRemote(&quot;EquipPetEvent&quot;)
local UpgradeEvent = makeRemote(&quot;UpgradeEvent&quot;)
local SyncDataEvent = makeRemote(&quot;SyncDataEvent&quot;)

local EggsConfig = {
	BasicEgg = {
		Cost = 50,
		Currency = &quot;Coins&quot;,
		Pets = {
			{ Name = &quot;Dog&quot;, Multiplier = 1.5, Rarity = &quot;Common&quot;, Chance = 50, Color = Color3.fromRGB(180, 140, 100) },
			{ Name = &quot;Cat&quot;, Multiplier = 2.0, Rarity = &quot;Common&quot;, Chance = 30, Color = Color3.fromRGB(220, 220, 220) },
			{ Name = &quot;Bunny&quot;, Multiplier = 3.5, Rarity = &quot;Rare&quot;, Chance = 15, Color = Color3.fromRGB(255, 180, 210) },
			{ Name = &quot;Dragon&quot;, Multiplier = 8.0, Rarity = &quot;Legendary&quot;, Chance = 5, Color = Color3.fromRGB(255, 80, 80) },
		}
	},
	GoldenEgg = {
		Cost = 500,
		Currency = &quot;Coins&quot;,
		Pets = {
			{ Name = &quot;Golden Dog&quot;, Multiplier = 5.0, Rarity = &quot;Common&quot;, Chance = 45, Color = Color3.fromRGB(255, 215, 0) },
			{ Name = &quot;Golden Cat&quot;, Multiplier = 8.0, Rarity = &quot;Rare&quot;, Chance = 35, Color = Color3.fromRGB(255, 230, 80) },
			{ Name = &quot;Cyber Fox&quot;, Multiplier = 15.0, Rarity = &quot;Epic&quot;, Chance = 15, Color = Color3.fromRGB(0, 220, 255) },
			{ Name = &quot;Galaxy Phoenix&quot;, Multiplier = 40.0, Rarity = &quot;Mythical&quot;, Chance = 5, Color = Color3.fromRGB(170, 0, 255) },
		}
	},
	VoidEgg = {
		Cost = 5000,
		Currency = &quot;Coins&quot;,
		Pets = {
			{ Name = &quot;Shadow Wolf&quot;, Multiplier = 25.0, Rarity = &quot;Rare&quot;, Chance = 45, Color = Color3.fromRGB(60, 60, 80) },
			{ Name = &quot;Void Knight&quot;, Multiplier = 55.0, Rarity = &quot;Epic&quot;, Chance = 35, Color = Color3.fromRGB(110, 0, 200) },
			{ Name = &quot;Abyss Hydra&quot;, Multiplier = 120.0, Rarity = &quot;Legendary&quot;, Chance = 15, Color = Color3.fromRGB(0, 255, 170) },
			{ Name = &quot;Omniversal Dominus&quot;, Multiplier = 350.0, Rarity = &quot;Secret&quot;, Chance = 5, Color = Color3.fromRGB(255, 50, 150) },
		}
	}
}

local UpgradesConfig = {
	ClickPower = { BaseCost = 25, Growth = 1.6, MaxLevel = 100 },
	AutoClicker = { BaseCost = 100, Growth = 2.0, MaxLevel = 50 },
	PetStorage = { BaseCost = 250, Growth = 2.2, MaxLevel = 25 },
	MaxEquipped = { BaseCost = 1000, Growth = 3.5, MaxLevel = 5 },
}

local SessionData = {}

local function getDefaultData()
	return {
		Coins = 0,
		Gems = 0,
		Rebirths = 0,
		TotalClicks = 0,
		Pets = {},
		Upgrades = {
			ClickPower = 1,
			AutoClicker = 0,
			PetStorage = 20,
			MaxEquipped = 3,
		}
	}
end

local function computeTotalMultiplier(data)
	local mult = 1 + (data.Rebirths * 2.0)
	local petBonus = 0
	for _, pet in ipairs(data.Pets) do
		if pet.Equipped then
			petBonus += (pet.Multiplier or 1)
		end
	end
	if petBonus &gt; 0 then
		mult = mult * (1 + petBonus)
	end
	local clickLvl = data.Upgrades.ClickPower or 1
	return mult * clickLvl
end

local function getUpgradeCost(upgradeName, currentLevel)
	local cfg = UpgradesConfig[upgradeName]
	if not cfg then return math.huge end
	return math.floor(cfg.BaseCost * (cfg.Growth ^ (currentLevel - 1)))
end

local function getRebirthCost(rebirths)
	return math.floor(250 * (2.75 ^ rebirths))
end

local function updateLeaderstats(player, data)
	local ls = player:FindFirstChild(&quot;leaderstats&quot;)
	if not ls then return end
	ls.Coins.Value = math.floor(data.Coins)
	ls.Rebirths.Value = data.Rebirths
end

local function syncClient(player)
	local data = SessionData[player.UserId]
	if data then
		SyncDataEvent:FireClient(player, data, computeTotalMultiplier(data))
	end
end

local function savePlayerData(player)
	local data = SessionData[player.UserId]
	if not data then return end
	pcall(function()
		DataStore:SetAsync(&quot;Player_&quot; .. tostring(player.UserId), data)
	end)
end

Players.PlayerAdded:Connect(function(player)
	local data = getDefaultData()
	pcall(function()
		local saved = DataStore:GetAsync(&quot;Player_&quot; .. tostring(player.UserId))
		if type(saved) == &quot;table&quot; then
			for k, v in pairs(saved) do
				data[k] = v
			end
		end
	end)
	SessionData[player.UserId] = data

	local ls = Instance.new(&quot;Folder&quot;)
	ls.Name = &quot;leaderstats&quot;
	ls.Parent = player

	local coins = Instance.new(&quot;NumberValue&quot;)
	coins.Name = &quot;Coins&quot;
	coins.Value = data.Coins
	coins.Parent = ls

	local rebirths = Instance.new(&quot;IntValue&quot;)
	rebirths.Name = &quot;Rebirths&quot;
	rebirths.Value = data.Rebirths
	rebirths.Parent = ls

	task.delay(1, function()
		syncClient(player)
	end)
end)

Players.PlayerRemoving:Connect(function(player)
	savePlayerData(player)
	SessionData[player.UserId] = nil
end)

game:BindToClose(function()
	for _, p in ipairs(Players:GetPlayers()) do
		savePlayerData(p)
	end
end)

local lastClick = {}
ClickEvent.OnServerEvent:Connect(function(player)
	local now = os.clock()
	if lastClick[player.UserId] and (now - lastClick[player.UserId]) &lt; 0.04 then
		return
	end
	lastClick[player.UserId] = now

	local data = SessionData[player.UserId]
	if not data then return end

	local gain = computeTotalMultiplier(data)
	data.Coins += gain
	data.TotalClicks += 1
	updateLeaderstats(player, data)
	syncClient(player)
end)

RebirthEvent.OnServerEvent:Connect(function(player)
	local data = SessionData[player.UserId]
	if not data then return end

	local cost = getRebirthCost(data.Rebirths)
	if data.Coins &gt;= cost then
		data.Coins = 0
		data.Rebirths += 1
		data.Gems += (data.Rebirths * 5)
		updateLeaderstats(player, data)
		syncClient(player)
	end
end)

HatchEggEvent.OnServerEvent:Connect(function(player, eggName)
	local data = SessionData[player.UserId]
	local egg = EggsConfig[eggName]
	if not data or not egg then return end
	if #data.Pets &gt;= (data.Upgrades.PetStorage or 20) then return end
	if data.Coins &lt; egg.Cost then return end

	data.Coins -= egg.Cost
	local roll = math.random(1, 100)
	local cumulative = 0
	local chosen = egg.Pets[1]
	for _, petInfo in ipairs(egg.Pets) do
		cumulative += petInfo.Chance
		if roll &lt;= cumulative then
			chosen = petInfo
			break
		end
	end

	local newPet = {
		Id = tostring(os.clock()) .. &quot;_&quot; .. tostring(math.random(1000, 9999)),
		Name = chosen.Name,
		Multiplier = chosen.Multiplier,
		Rarity = chosen.Rarity,
		Equipped = false
	}
	table.insert(data.Pets, newPet)
	updateLeaderstats(player, data)
	syncClient(player)
end)

EquipPetEvent.OnServerEvent:Connect(function(player, petId)
	local data = SessionData[player.UserId]
	if not data then return end

	local equippedCount = 0
	for _, p in ipairs(data.Pets) do
		if p.Equipped then
			equippedCount += 1
		end
	end

	local maxEq = data.Upgrades.MaxEquipped or 3
	for _, p in ipairs(data.Pets) do
		if p.Id == petId then
			if p.Equipped then
				p.Equipped = false
			elseif equippedCount &lt; maxEq then
				p.Equipped = true
			end
			break
		end
	end
	syncClient(player)
end)

UpgradeEvent.OnServerEvent:Connect(function(player, upgradeName)
	local data = SessionData[player.UserId]
	local cfg = UpgradesConfig[upgradeName]
	if not data or not cfg then return end

	local current = data.Upgrades[upgradeName] or 1
	if current &gt;= cfg.MaxLevel then return end

	local cost = getUpgradeCost(upgradeName, current)
	if data.Coins &gt;= cost then
		data.Coins -= cost
		data.Upgrades[upgradeName] = current + 1
		updateLeaderstats(player, data)
		syncClient(player)
	end
end)

task.spawn(function()
	while true do
		task.wait(1)
		for _, player in ipairs(Players:GetPlayers()) do
			local data = SessionData[player.UserId]
			if data and (data.Upgrades.AutoClicker or 0) &gt; 0 then
				local autoGain = computeTotalMultiplier(data) * (data.Upgrades.AutoClicker * 0.5)
				data.Coins += autoGain
				updateLeaderstats(player, data)
				syncClient(player)
			end
		end
	end
end)
</ProtectedString>
			</Properties>
		</Item>
	</Item>
	<Item class="StarterPlayer" referent="RBX7">
		<Properties>
			<string name="Name">StarterPlayer</string>
		</Properties>
		<Item class="StarterPlayerScripts" referent="RBX8">
