				<string name="Name">StarterPlayerScripts</string>
			</Properties>
			<Item class="LocalScript" referent="RBX9">
				<Properties>
					<string name="Name">SimulatorCoreClient</string>
					<ProtectedString name="Source">-- SimulatorCoreClient.lua
local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild(&quot;PlayerGui&quot;)
local Remotes = ReplicatedStorage:WaitForChild(&quot;SimRemotes&quot;)

local ClickEvent = Remotes:WaitForChild(&quot;ClickEvent&quot;)
local RebirthEvent = Remotes:WaitForChild(&quot;RebirthEvent&quot;)
local HatchEggEvent = Remotes:WaitForChild(&quot;HatchEggEvent&quot;)
local EquipPetEvent = Remotes:WaitForChild(&quot;EquipPetEvent&quot;)
local UpgradeEvent = Remotes:WaitForChild(&quot;UpgradeEvent&quot;)
local SyncDataEvent = Remotes:WaitForChild(&quot;SyncDataEvent&quot;)

local gui = Instance.new(&quot;ScreenGui&quot;)
gui.Name = &quot;SimulatorHUD&quot;
gui.ResetOnSpawn = false
gui.Parent = playerGui

local topBar = Instance.new(&quot;Frame&quot;)
topBar.Size = UDim2.new(0, 420, 0, 56)
topBar.Position = UDim2.new(0.5, -210, 0, 14)
topBar.BackgroundColor3 = Color3.fromRGB(24, 28, 36)
topBar.BorderSizePixel = 0
topBar.Parent = gui
Instance.new(&quot;UICorner&quot;, topBar).CornerRadius = UDim.new(0, 12)

local statsLabel = Instance.new(&quot;TextLabel&quot;)
statsLabel.Size = UDim2.new(1, -20, 1, 0)
statsLabel.Position = UDim2.fromOffset(10, 0)
statsLabel.BackgroundTransparency = 1
statsLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
statsLabel.Font = Enum.Font.GothamBold
statsLabel.TextSize = 15
statsLabel.Text = &quot;Coins: 0 | Rebirths: 0 | Mult: 1x&quot;
statsLabel.Parent = topBar

local bottomPanel = Instance.new(&quot;Frame&quot;)
bottomPanel.Size = UDim2.new(0, 460, 0, 130)
bottomPanel.Position = UDim2.new(0.5, -230, 1, -145)
bottomPanel.BackgroundColor3 = Color3.fromRGB(24, 28, 36)
bottomPanel.BorderSizePixel = 0
bottomPanel.Parent = gui
Instance.new(&quot;UICorner&quot;, bottomPanel).CornerRadius = UDim.new(0, 14)

local function makeBtn(text, pos, size, color)
	local b = Instance.new(&quot;TextButton&quot;)
	b.Size = size
	b.Position = pos
	b.BackgroundColor3 = color
	b.TextColor3 = Color3.fromRGB(255, 255, 255)
	b.Font = Enum.Font.GothamBold
	b.TextSize = 14
	b.Text = text
	b.Parent = bottomPanel
	Instance.new(&quot;UICorner&quot;, b).CornerRadius = UDim.new(0, 10)
	return b
end

local clickBtn = makeBtn(&quot;CLICK (+Coins)&quot;, UDim2.fromOffset(12, 12), UDim2.fromOffset(212, 48), Color3.fromRGB(0, 165, 255))
local rebirthBtn = makeBtn(&quot;REBIRTH (250)&quot;, UDim2.fromOffset(236, 12), UDim2.fromOffset(212, 48), Color3.fromRGB(255, 135, 0))
local basicEggBtn = makeBtn(&quot;Basic Egg (50)&quot;, UDim2.fromOffset(12, 70), UDim2.fromOffset(140, 46), Color3.fromRGB(60, 190, 110))
local goldEggBtn = makeBtn(&quot;Golden Egg (500)&quot;, UDim2.fromOffset(160, 70), UDim2.fromOffset(140, 46), Color3.fromRGB(235, 180, 20))
local upgClickBtn = makeBtn(&quot;Upgrade Click (25)&quot;, UDim2.fromOffset(308, 70), UDim2.fromOffset(140, 46), Color3.fromRGB(150, 80, 255))

clickBtn.MouseButton1Click:Connect(function()
	ClickEvent:FireServer()
end)

rebirthBtn.MouseButton1Click:Connect(function()
	RebirthEvent:FireServer()
end)

basicEggBtn.MouseButton1Click:Connect(function()
	HatchEggEvent:FireServer(&quot;BasicEgg&quot;)
end)

goldEggBtn.MouseButton1Click:Connect(function()
	HatchEggEvent:FireServer(&quot;GoldenEgg&quot;)
end)

upgClickBtn.MouseButton1Click:Connect(function()
	UpgradeEvent:FireServer(&quot;ClickPower&quot;)
end)

SyncDataEvent.OnClientEvent:Connect(function(data, mult)
	statsLabel.Text = string.format(&quot;Coins: %d | Rebirths: %d | Mult: %.1fx | Pets: %d&quot;, math.floor(data.Coins), data.Rebirths, mult, #data.Pets)
	local rCost = math.floor(250 * (2.75 ^ data.Rebirths))
	rebirthBtn.Text = &quot;REBIRTH (&quot; .. tostring(rCost) .. &quot;)&quot;
	local uCost = math.floor(25 * (1.6 ^ ((data.Upgrades.ClickPower or 1) - 1)))
	upgClickBtn.Text = &quot;Click Lv.&quot; .. tostring(data.Upgrades.ClickPower or 1) .. &quot; (&quot; .. tostring(uCost) .. &quot;)&quot;
end)
</ProtectedString>
