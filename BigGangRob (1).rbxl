<Item class="Lighting" referent="RBXL"><Properties><string name="Name">Lighting</string><token name="Technology">4</token><float name="ClockTime">17.6</float><float name="GeographicLatitude">26</float><float name="Brightness">2.6</float><Color3 name="OutdoorAmbient"><R>0.66</R><G>0.5</G><B>0.47</B></Color3><float name="EnvironmentDiffuseScale">1</float><float name="EnvironmentSpecularScale">1</float><bool name="GlobalShadows">true</bool></Properties><Item class="Atmosphere" referent="RBXAT"><Properties><string name="Name">Atmosphere</string><float name="Density">0.34</float><float name="Haze">2</float><Color3 name="Color"><R>1</R><G>0.7</G><B>0.52</B></Color3><Color3 name="Decay"><R>1</R><G>0.43</G><B>0.47</B></Color3><float name="Glare">1</float><float name="Offset">0.12</float></Properties></Item><Item class="BloomEffect" referent="RBXBL"><Properties><string name="Name">Bloom</string><float name="Intensity">0.9</float><float name="Size">28</float><float name="Threshold">1.2</float></Properties></Item><Item class="ColorCorrectionEffect" referent="RBXCC"><Properties><string name="Name">ColorCorrection</string><float name="Saturation">0.22</float><float name="Contrast">0.14</float><Color3 name="TintColor"><R>1</R><G>0.84</G><B>0.71</B></Color3></Properties></Item><Item class="SunRaysEffect" referent="RBXSR"><Properties><string name="Name">SunRays</string><float name="Intensity">0.2</float><float name="Spread">0.6</float></Properties></Item><Item class="Sky" referent="RBXSKY"><Properties><string name="Name">Sky</string><float name="SunAngularSize">14</float><int name="StarCount">4000</int></Properties></Item></Item>
<Item class="ReplicatedStorage" referent="RBXR"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBXSB"><Properties><string name="Name">SunsetBay</string></Properties><Item class="ModuleScript" referent="RBXSConfig"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[--[[
	SB_Config | ReplicatedStorage.SunsetBay (ModuleScript)
	SUNSET BAY - every setting of the game in one place.

	  * MAP: the street grid, districts, the bridge and the island (the generator and the traffic use the same numbers)
	  * CARS: name, price, speed, handling, colours (looks = models in ReplicatedStorage.SunsetBay.Cars)
	  * SOUNDS: put your own sound IDs here (leave "" to use the built-in Roblox sound or silence)
	  * GRAPHICS: lighting presets for sunrise / day / sunset / night, weather, quality levels
	  * JOBS: taxi, delivery, races, stunt jumps, hidden packages
	  * MONEY: start cash, properties, repair / paint prices
]]

local C = {}
local V3, C3 = Vector3.new, Color3.fromRGB

----------------------------------------------------------------------------------------------------
-- MAP
----------------------------------------------------------------------------------------------------
C.MAP = {
	-- street grid (centre lines). Roads run along these X and Z values.
	-- 8x the old city: the grid now runs from the airport in the far west to the beach in the east
	X = {-3000, -2760, -2520, -2280, -2040, -1800, -1560, -1320, -1080, -840, -600, -360, -120, 120, 360},
	Z = {-2520, -2280, -2040, -1800, -1560, -1320, -1080, -840, -600, -360, -120, 120, 360, 600},
	-- areas without streets inside (the edge roads stay): airport, wetlands, golf course
	NO_ROAD = {
		{name = "Bay International Airport", kind = "airport", x = {-3000, -2040}, z = {-2520, -1320}},
		{name = "Everglow Wetlands", kind = "wetlands", x = {-3000, -2040}, z = {-840, 600}},
		{name = "Royal Palm Golf Club", kind = "golf", x = {-1800, -1080}, z = {-2520, -1800}},
	},
	OCEAN_DRIVE = 520, -- the beach boulevard (runs north - south)
	ROAD_W = 30, -- road width (2 lanes each way)
	LANE = 7.5, -- distance of a lane centre from the road centre line (right hand traffic)
	WALK_W = 8, -- sidewalk width
	CURB = 0.5, -- sidewalk height
	BEACH_X = {560, 720}, -- sand from .. to
	SEA_X = 700, -- the ocean starts here (east)
	SEA_Y = -2.6, -- water surface height
	DOCKS_Z = 780, -- docks water south of this
	BRIDGE = {z = -120, x1 = 520, x2 = 1010, y = 0}, -- causeway to Star Island
	ISLAND = {cx = 1180, cz = -120, r = 230}, -- Star Island (round)
	SPAWN = V3(549, 4, 280), -- first spawn: on the promenade in front of the beach apartment
}
-- districts (decides what the generator builds in a block). Checked in order, first match wins.
C.DISTRICTS = {
	{name = "Downtown", x = {-360, 120}, z = {-840, -120}, kind = "towers"},
	{name = "Financial District", x = {-600, 120}, z = {-1800, -840}, kind = "towers"},
	{name = "Ocean Beach", x = {360, 520}, z = {-2520, 600}, kind = "deco"},
	{name = "Coral Gardens", x = {120, 360}, z = {-2520, -1320}, kind = "villas"},
	{name = "Vista Hills", x = {120, 360}, z = {-1320, -120}, kind = "mid"},
	{name = "Neon Strip", x = {-1080, -600}, z = {-1800, -840}, kind = "club"},
	{name = "Little Havana", x = {-840, -360}, z = {-840, 600}, kind = "houses"},
	{name = "Midtown", x = {-360, 360}, z = {-120, 600}, kind = "shops"},
	{name = "Uptown", x = {-600, 120}, z = {-2520, -1800}, kind = "mid"},
	{name = "Westgate Industrial", x = {-3000, -600}, z = {-2520, -1800}, kind = "industrial"},
	{name = "Westgate Industrial", x = {-3000, -2040}, z = {-1320, -840}, kind = "industrial"},
	{name = "Palm Heights", x = {-2040, -840}, z = {-1800, 600}, kind = "houses"},
}

----------------------------------------------------------------------------------------------------
-- CARS (looks: ReplicatedStorage.SunsetBay.Cars.<key>)
-- speed: top speed (studs/s) · accel: studs/s per second · brake · turn: steering strength · grip: 0..1 (low = drifts)
-- price: dealership price (0 = not for sale) · seats · colours: paint choices
----------------------------------------------------------------------------------------------------
C.CARS = {
	Vortex = {name = "Vortex GT", class = "Super", price = 120000, speed = 165, accel = 62, brake = 120, turn = 1.15, grip = 0.82, nitro = true,
		colours = {C3(255, 40, 120), C3(250, 250, 250), C3(20, 20, 25), C3(255, 200, 0), C3(0, 200, 255)}},
