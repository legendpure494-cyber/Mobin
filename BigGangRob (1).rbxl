C.CAR_ORDER = {"Glide", "Hauler", "Rancher", "Stallion", "Coastline", "Vortex"}
C.START_CAR = "Glide"
C.MAX_HEALTH = 1000 -- car health; crashes take some away; 0 = smoking wreck
