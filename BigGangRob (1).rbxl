	Horn = "rbxasset://sounds/electronicpingshort.wav", Crash = "rbxasset://sounds/collide.wav", Nitro = "rbxasset://sounds/swoosh.wav",
	DoorOpen = "rbxasset://sounds/button.wav", DoorClose = "rbxasset://sounds/button.wav", Ocean = "rbxasset://sounds/impact_water.mp3",
