ght>400</Weight><Style>Normal</Style></Font><float name="BackgroundTransparency">1</float><Color3 name="TextColor3"><R>1.0</R><G>0.23529</G><B>0.47059</B></Color3><bool name="TextScaled">true</bool></Properties></Item></Item></Item><Item class="Part" referent="RBXD106582"><Properties><string name="Name">RoofVent</string><bool name="CanQuery">false</bool><Color3uint8 name="Color3uint8">4292006615</Color3uint8><CoordinateFrame name="CFrame"><X>0</X><Y>7.845000000000001</Y><Z>3.8</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><token name="Material">272</token><Vector3 name="size"><X>1.6000</X><Y>0.2100</Y><Z>1.6000</Z></Vector3><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="Massless">true</bool><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties><Item class="Weld" referent="RBXD106583"><Properties><string name="Name">W</string><Ref name="Part1">RBXD106582</Ref><CoordinateFrame name="C0"><X>0</X><Y>5.6450000000000005</Y><Z>3.8</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Ref name="Part0">RBXD106247</Ref></Properties></Item></Item></Item></Item></Item></Item>
<Item class="ServerScriptService" referent="RBXSS"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBXSSB_Server"><Properties><string name="Name">SB_Server</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[--[[
	SB_Server | ServerScriptService (Script)
	SUNSET BAY is single player for now: the whole world (cars, traffic, people, jobs) runs on each
	player's own computer so there is no lag. Every server holds up to 6 players, but they never see
	or touch each other - each one plays alone in their own copy of the city.

	The server only does what must be safe and saved:
	  * loads / saves each player's progress (cash, cars, properties, stats, settings) with DataStore
	  * puts all characters in a collision group that does not collide with itself
	  * removes the Baseplate and SpawnLocation (players are placed by code)

	NOTE: set the server size to 6 in Game Settings > Places (Max Players), or in the place's settings on the website.
]]
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local DSS = game:GetService("DataStoreService")
local PhysicsService = game:GetService("PhysicsService")
local Http = game:GetService("HttpService")

-- SPLIT FILES: the game ships in 3 files (GitHub limit). If BGR_Buildings.rbxmx / BGR_Cars2.rbxmx were
-- inserted into Workspace, move their contents to the right place (better: move them once in Studio and save).
do
	local city = workspace:FindFirstChild("City")
	local loose = workspace:FindFirstChild("Buildings")
	if city and loose and loose:IsA("Folder") and not city:FindFirstChild("Buildings") then loose.Parent = city end
	local cars2 = workspace:FindFirstChild("Cars2")
	local sb = RS:FindFirstChild("SunsetBay")
	local cars = sb and sb:FindFirstChild("Cars")
	if cars2 and cars then
		for _, m in ipairs(cars2:GetChildren()) do m.Parent = cars end
		cars2:Destroy()
	end
end
for _, x in ipairs(workspace:GetChildren()) do
	if x.Name == "Baseplate" or x:IsA("SpawnLocation") then x:Destroy() end
end

local SB = RS:WaitForChild("SunsetBay")
local C = require(SB:WaitForChild("Config"))

-- remotes
local remotes = SB:FindFirstChild("Remotes") or Instance.new("Folder")
remotes.Name = "Remotes"
remotes.Parent = SB
local function remote(class, name)
	local r = remotes:FindFirstChild(name)
	if not r then r = Instance.new(class) r.Name = name r.Parent = remotes end
	return r
end
local GetData = remote("RemoteFunction", "GetData")
local SaveData = remote("RemoteEvent", "SaveData")

-- players never collide with each other (they are invisible to each other on the clients)
pcall(function() PhysicsService:RegisterCollisionGroup("SB_Players") end)
pcall(function() PhysicsService:CollisionGroupSetCollidable("SB_Players", "SB_Players", false) end)
local function group(ch)
	for _, p in ipairs(ch:GetDescendants()) do if p:IsA("BasePart") then p.CollisionGroup = "SB_Players" end end
	ch.DescendantAdded:Connect(function(p) if p:IsA("BasePart") then p.CollisionGroup = "SB_Players" end end)
end

-- DATA
local okStore, store = pcall(function() return DSS:GetDataStore("SunsetBay_v1") end)
if not okStore then store = nil end
local data, loaded = {}, {}
local function fresh()
	return {
		cash = C.START_CASH,
		cars = {{key = C.START_CAR, color = 1, health = C.MAX_HEALTH}},
		props = {}, packages = {}, stunts = {}, stats = {}, settings = {}, story = 0, time = C.START_TIME, pos = nil, played = 0,
	}
end
-- clean what a client sends (single player, but keep values sane)
local function clean(d, old)
	if type(d) ~= "table" then return old end
	local out = old or fresh()
	if type(d.cash) == "number" and d.cash == d.cash then out.cash = math.clamp(math.floor(d.cash), 0, 1e9) end
	if type(d.cars) == "table" and #d.cars <= 40 then
		local cars = {}
		for _, c in ipairs(d.cars) do
			if type(c) == "table" and C.CARS[c.key] then
				cars[#cars + 1] = {key = c.key, color = math.clamp(tonumber(c.color) or 1, 1, 12), health = math.clamp(tonumber(c.health) or C.MAX_HEALTH, 0, C.MAX_HEALTH)}
			end
		end
		if #cars > 0 then out.cars = cars end
	end
	for _, k in ipairs({"props", "packages", "stunts", "stats", "settings"}) do
		if type(d[k]) == "table" then
			local ok, s = pcall(function() return Http:JSONEncode(d[k]) end)
			if ok and #s < 8000 then out[k] = d[k] end
		end
	end
	if type(d.story) == "number" then out.story = math.clamp(math.floor(d.story), 0, 1000) end
	if type(d.time) == "number" then out.time = d.time % 24 end
	if typeof(d.pos) == "Vector3" then out.pos = {d.pos.X, d.pos.Y, d.pos.Z} elseif type(d.pos) == "table" then out.pos = d.pos end
	if type(d.played) == "number" then out.played = math.max(0, d.played) end
	return out
end
local function save(p)
	local d = data[p]
	if d and store and loaded[p] then
		pcall(function() store:SetAsync("u" .. p.UserId, d) end)
	end
end
Players.PlayerAdded:Connect(function(p)
	local d
	if store then
		local ok, v = pcall(function() return store:GetAsync("u" .. p.UserId) end)
		if ok and type(v) == "table" then d = v end
	end
	data[p] = clean(d or {}, fresh())
	loaded[p] = true
	p.CharacterAdded:Connect(group)
	if p.Character then group(p.Character) end
end)
Players.PlayerRemoving:Connect(function(p)
	save(p)
	data[p], loaded[p] = nil, nil
end)
game:BindToClose(function() for p in pairs(data) do save(p) end end)
GetData.OnServerInvoke = function(p)
	for _ = 1, 50 do if loaded[p] then break end task.wait(0.1) end
	return data[p] or fresh()
end
SaveData.OnServerEvent:Connect(function(p, d, now)
	data[p] = clean(d, data[p])
	if now then save(p) end
end)
task.spawn(function() while true do task.wait(90) for p in pairs(data) do save(p) end end end)
]]></ProtectedString></Properties></Item></Item>
