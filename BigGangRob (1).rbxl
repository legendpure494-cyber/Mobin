156862745098 0.023529411764705882 0.11764705882352941 0 1 0.11764705882352941 0.047058823529411764 0.23529411764705882 0 </ColorSequence></Properties></Item><Item class="Frame" referent="RBXD107016"><Properties><string name="Name">Canvas</string><Vector2 name="AnchorPoint"><X>0.5</X><Y>0.5</Y></Vector2><int name="BorderSizePixel">0</int><UDim2 name="Size"><XS>0</XS><XO>900</XO><YS>0</YS><YO>700</YO></UDim2><bool name="ClipsDescendants">true</bool><UDim2 name="Position"><XS>0.5</XS><XO>0</XO><YS>0.54</YS><YO>0</YO></UDim2><Color3 name="BackgroundColor3"><R>0.06275</R><G>0.13333</G><B>0.30588</B></Color3></Properties><Item class="UICorner" referent="RBXD107017"><Properties><string name="Name">UICorner</string><UDim name="CornerRadius"><S>0</S><O>18</O></UDim></Properties></Item><Item class="UIStroke" referent="RBXD107018"><Properties><string name="Name">UIStroke</string><Color3 name="Color"><R>1.0</R><G>1.0</G><B>1.0</B></Color3><token name="ApplyStrokeMode">1</token><float name="Thickness">3</float></Properties><Item class="UIGradient" referent="RBXD107019"><Properties><string name="Name">UIGradient</string><float name="Rotation">20</float><ColorSequence name="Color">0 1 0.1803921568627451 0.592156862745098 0 0.5 0.5490196078431373 0.27450980392156865 1 0 1 0 0.9019607843137255 1 0 </ColorSequence></Properties></Item></Item><Item class="UIScale" referent="RBXD107020"><Properties><string name="Name">VS:x:h760:w940:c1</string></Properties></Item></Item><Item class="TextLabel" referent="RBXD107021"><Properties><string name="Name">Header</string><UDim2 name="Size"><XS>0</XS><XO>150</XO><YS>0</YS><YO>30</YO></UDim2><token name="TextXAlignment">0</token><string name="Text">MAP</string><Font name="FontFace"><Family><url>rbxasset://fonts/families/Michroma.json</url></Family><Weight>400</Weight><Style>Normal</Style></Font><float name="BackgroundTransparency">1</float><UDim2 name="Position"><XS>0</XS><XO>20</XO><YS>0</YS><YO>12</YO></UDim2><Color3 name="TextColor3"><R>1.0</R><G>1.0</G><B>1.0</B></Color3><bool name="TextScaled">true</bool></Properties><Item class="UIStroke" referent="RBXD107022"><Properties><string name="Name">UIStroke</string><Color3 name="Color"><R>0.07843</R><G>0.0</G><B>0.15686</B></Color3><float name="Thickness">2</float></Properties></Item><Item class="UIGradient" referent="RBXD107023"><Properties><string name="Name">UIGradient</string><ColorSequence name="Color">0 1 0.1803921568627451 0.592156862745098 0 1 0 0.9019607843137255 1 0 </ColorSequence></Properties></Item><Item class="UIScale" referent="RBXD107024"><Properties><string name="Name">VS</string></Properties></Item></Item><Item class="TextLabel" referent="RBXD107025"><Properties><string name="Name">Legend</string><Vector2 name="AnchorPoint"><X>0</X><Y>1</Y></Vector2><int name="TextSize">12</int><UDim2 name="Size"><XS>0</XS><XO>600</XO><YS>0</YS><YO>20</YO></UDim2><token name="TextXAlignment">0</token><string name="Text">You  /  Jobs  /  Shops  /  Safehouse  /  Packages  -  tap the map to set a waypoint</string><Font name="FontFace"><Family><url>rbxasset://fonts/families/GothamSSm.json</url></Family><Weight>700</Weight><Style>Normal</Style></Font><float name="BackgroundTransparency">1</float><UDim2 name="Position"><XS>0</XS><XO>20</XO><YS>1</YS><YO>-14</YO></UDim2><Color3 name="TextColor3"><R>0.88235</R><G>0.84314</G><B>0.98039</B></Color3></Properties><Item class="UIScale" referent="RBXD107026"><Properties><string name="Name">VS</string></Properties></Item></Item><Item class="TextButton" referent="RBXD107027"><Properties><string name="Name">Close</string><int name="TextSize">13</int><Vector2 name="AnchorPoint"><X>1</X><Y>0</Y></Vector2><int name="BorderSizePixel">0</int><UDim2 name="Size"><XS>0</XS><XO>120</XO><YS>0</YS><YO>46</YO></UDim2><string name="Text">CLOSE</string><bool name="AutoButtonColor">false</bool><Font name="FontFace"><Family><url>rbxasset://fonts/families/Michroma.json</url></Family><Weight>400</Weight><Style>Normal</Style></Font><float name="BackgroundTransparency">0.1</float><UDim2 name="Position"><XS>1</XS><XO>-20</XO><YS>0</YS><YO>12</YO></UDim2><Color3 name="TextColor3"><R>1.0</R><G>1.0</G><B>1.0</B></Color3><Color3 name="BackgroundColor3"><R>0.08627</R><G>0.0549</G><B>0.19608</B></Color3></Properties><Item class="UICorner" referent="RBXD107028"><Properties><string name="Name">UICorner</string><UDim name="CornerRadius"><S>0</S><O>23</O></UDim></Properties></Item><Item class="UIStroke" referent="RBXD107029"><Properties><string name="Name">UIStroke</string><Color3 name="Color"><R>1.0</R><G>1.0</G><B>1.0</B></Color3><token name="ApplyStrokeMode">1</token><float name="Thickness">1.8</float></Properties><Item class="UIGradient" referent="RBXD107030"><Properties><string name="Name">UIGradient</string><float name="Rotation">20</float><ColorSequence name="Color">0 1 0.1803921568627451 0.592156862745098 0 0.5 0.5490196078431373 0.27450980392156865 1 0 1 0 0.9019607843137255 1 0 </ColorSequence></Properties></Item></Item><Item class="UIScale" referent="RBXD107031"><Properties><string name="Name">VS</string></Properties></Item></Item></Item></Item></Item>
<Item class="StarterPlayer" referent="RBXP"><Properties><string name="Name">StarterPlayer</string><bool name="EnableMouseLockOption">false</bool></Properties><Item class="StarterPlayerScripts" referent="RBXPS"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBXSSB_Client"><Properties><string name="Name">SB_Client</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[--[[
	SB_Client | StarterPlayerScripts (LocalScript)
	Starts SUNSET BAY on this computer. The game is made of modules (StarterPlayerScripts.SB):
	  Core      shared state, saving, money, sounds, input, hides other players
	  Graphics  lighting by time of day, weather, city lights at night, water, far-object culling
	  Effects   headlight beams, speed blur, sun flare, rain on the lens, wet reflections
	  Life      planes, a tour helicopter, boats, seagulls, the night blimp
	  World     traffic signals, ambience, hidden packages, stunt jumps, street names
	  Vehicles  your cars: spawning, garage, getting in / out, dealership, paint & repair
	  Drive     car physics, camera, lights, skids, nitro, damage, engine sound
	  Traffic   AI cars on the road network
	  Peds      people on the sidewalks and the beach
	  Police    heat / wanted level and police chases
	  Missions  taxi, delivery, street races, story jobs
	  Audio     radio stations and city ambience
	  HUD       minimap, cash, speed, location, notifications, big banners
	  Phone     the phone and its apps, full screen map
	  Menu      loading screen and title menu (shown first)
	  Cinematic intro, mission cut-ins, photo mode
	Each module returns a table with init(S) and (optionally) start(S).
]]
local Players = game:GetService("Players")
local lp = Players.LocalPlayer
local folder = script.Parent:WaitForChild("SB")
local ORDER = {"Core", "Graphics", "Effects", "World", "Life", "Audio", "Vehicles", "Drive", "Traffic", "Peds", "Police", "Missions", "HUD", "Phone", "Tuning", "Boats", "Body", "Interiors", "Extras", "Cinematic", "Menu"}
local S = {}
_G.SunsetBay = S -- handy for debugging in the console
local mods = {}
for _, name in ipairs(ORDER) do
	local m = folder:FindFirstChild(name)
	if m then
		local ok, res = pcall(require, m)
		if ok and type(res) == "table" then
			mods[name] = res
			S[name] = res
		else
			warn("[SunsetBay] could not load " .. name .. ": " .. tostring(res))
		end
	end
end
for _, name in ipairs(ORDER) do
	local m = mods[name]
	if m and m.init then
		local ok, err = pcall(m.init, S)
		if not ok then warn("[SunsetBay] " .. name .. ".init: " .. tostring(err)) end
	end
end
for _, name in ipairs(ORDER) do
	local m = mods[name]
	if m and m.start then
		task.spawn(function()
			local ok, err = pcall(m.start, S)
			if not ok then warn("[SunsetBay] " .. name .. ".start: " .. tostring(err)) end
		end)
	end
end
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBXSBF"><Properties><string name="Name">SB</string></Properties><Item class="ModuleScript" referent="RBXSAudio"><Properties><string name="Name">Audio</string><ProtectedString name="Source"><![CDATA[--[[
	Audio | StarterPlayerScripts.SB (ModuleScript)
	Car radio and music:
	  * stations from Config.RADIO (name, colour, list of song IDs you uploaded / have the rights to)
	  * the radio plays only inside a car; R switches station (with a little static), the HUD shows the name
	  * each station keeps "playing" while you are away: you join a song somewhere in the middle, like real radio
	  * songs are muffled a bit when you open the phone; music volume from the settings
	  * stations without songs show their name and stay quiet
	  * outside a car: soft menu music on the title screen if Config.SOUNDS.MenuMusic is set
]]
local Au = {}
local Run = game:GetService("RunService")
local TS = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")
local C3 = Color3.fromRGB

local station = 1
local sound
local eq
local playing = {} -- station -> {song index, start clock}
local static

local function id(x)
	x = tostring(x)
	if x:match("^%d+$") then return "rbxassetid://" .. x end
	return x
end

function Au.init(S)
	sound = Instance.new("Sound")
	sound.Name, sound.Volume, sound.Looped = "SB_Radio", 0, false
	pcall(function() sound.SoundGroup = S.musicGroup end)
	sound.Parent = SoundService
	eq = Instance.new("EqualizerSoundEffect")
	eq.HighGain, eq.MidGain, eq.LowGain, eq.Enabled = 0, 0, 0, true
	eq.Parent = sound
	station = (S.settings.station or 1)
	S.radioStation = function() return station end
end

-- which song a station is on right now, and how far into it
local function now(S, i)
	local st = S.C.RADIO[i]
	if not st or #st.songs == 0 then return nil end
	local p = playing[i]
	if not p then
		p = {song = math.random(#st.songs), start = os.clock() - math.random() * 90}
		playing[i] = p
	end
	return st, p
end
local function tune(S, i, announce)
	station = i
	S.settings.station = i
	local st = S.C.RADIO[i]
	if announce then
		S.fire("radioName", st and st.name or "RADIO OFF", st and st.color or C3(200, 200, 200))
		S.play("Click", {PlaybackSpeed = 0.6, Volume = 0.4})
	end
	sound:Stop()
	if not st then return end
	local s, p = now(S, i)
	if not s then return end
	sound.SoundId = id(s.songs[p.song])
	sound.TimePosition = 0
	sound:Play()
	-- jump into the middle of the song (after it loads)
	task.spawn(function()
		for _ = 1, 30 do
			local len = 0
			pcall(function() len = sound.TimeLength end)
			if len > 0 then
				local into = (os.clock() - p.start) % len
				pcall(function() sound.TimePosition = into end)
				break
			end
			task.wait(0.1)
		end
	end)
end

function Au.start(S)
	-- next song when one ends
	local okEnded, ended = pcall(function() return sound.Ended end)
	if okEnded then ended:Connect(function()
		local st, p = now(S, station)
		if st then
			p.song = p.song % #st.songs + 1
			p.start = os.clock()
			sound.SoundId = id(st.songs[p.song])
			sound.TimePosition = 0
			sound:Play()
		end
	end) end
	S.on("enterCar", function()
		if station > 0 then tune(S, station, true) end
	end)
	S.on("exitCar", function() sound:Stop() end)
	S.on("radioSet", function(i)
		if i == 0 then station = 0 sound:Stop() S.fire("radioName", "RADIO OFF", C3(200, 200, 200)) return end
		tune(S, i, true)
	end)
	S.on("action", function(a)
		if a ~= "radio" or not S.inCar or S.mode ~= "play" then return end
		local n = #S.C.RADIO
		local nxt = (station % (n + 1)) + 1 -- cycles 1..n, then n+1 = off
		if nxt > n then
			station = 0
			sound:Stop()
			S.fire("radioName", "RADIO OFF", C3(200, 200, 200))
		else
			tune(S, nxt, true)
		end
	end)
	-- volume: music setting, quieter with the phone open, muffled in the menu
	Run.Heartbeat:Connect(function(dt)
		local want = S.inCar and station > 0 and 0.7 or 0
		if S.phoneOpen then want *= 0.4 end
		sound.Volume += (want - sound.Volume) * math.min(1, dt * 3)
		local muffle = (S.phoneOpen or S.mode ~= "play") and -12 or 0
		eq.HighGain += (muffle - eq.HighGain) * math.min(1, dt * 3)
	end)
	-- title music (optional id in Config.SOUNDS.MenuMusic)
	local mid = S.C.SOUNDS.MenuMusic
	if mid and mid ~= "" then
		local mm = Instance.new("Sound")
		mm.SoundId, mm.Looped, mm.Volume = id(mid), true, 0.5
		pcall(function() mm.SoundGroup = S.musicGroup end)
		mm.Parent = SoundService
		mm:Play()
		S.on("play", function() TS:Create(mm, TweenInfo.new(2), {Volume = 0}):Play() task.delay(2.2, function() mm:Stop() end) end)
	end
end
return Au
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXSBoats"><Properties><string name="Name">Boats</string><ProtectedString name="Source"><![CDATA[--[[
	Boats | StarterPlayerScripts.SB (ModuleScript)
	Speedboats at the Bay Marina (south of the pier):
	  * walk onto the marina marker and press E to take a boat (free), or use a boat already waiting
	  * boats glide on the sea: throttle, reverse, turning that leans the hull, bouncing on the waves,
	    spray and a white wake, faster on calm water; they stop at the shore and the pier
	  * a boat camera that rolls with the waves, wind sound
	  * get out at the marina dock (E); out on the open sea you jump in and swim (Swim module)
]]
local Bo = {}
local Run = game:GetService("RunService")
local C3, V3, CF, A, rad = Color3.fromRGB, Vector3.new, CFrame.new, CFrame.Angles, math.rad

local folder
local boats = {}
local riding -- the boat being driven

local function part(m, name, size, cf, col, mat, shape)
	local p = Instance.new("Part")
	p.Name, p.Size, p.Color, p.Material = name, size, col, mat or Enum.Material.SmoothPlastic
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
	if shape then p.Shape = shape end
	p.Parent = m
	return p, cf
end
-- a speedboat built from parts (offsets from the boat's centre)
local COLORS = {C3(255, 60, 170), C3(0, 200, 255), C3(255, 160, 40), C3(120, 230, 160)}
local function build(color)
	local m = Instance.new("Model")
	m.Name = "Speedboat"
	local o = {}
	local function add(...) local p, cf = part(m, ...) o[p] = cf return p end
	local hull = add("Hull", V3(7, 2.6, 20), CF(0, 0, 0), C3(250, 250, 250))
	hull.CanCollide = true
	add("Nose", V3(7, 2.6, 7), CF(0, 0, -13.5) * A(0, math.pi, 0), C3(250, 250, 250))
	add("Stripe", V3(7.05, 0.7, 20), CF(0, 0.4, 0), color)
	add("Deck", V3(6.4, 0.3, 16), CF(0, 1.45, 1), C3(170, 130, 90), Enum.Material.WoodPlanks)
	add("Screen", V3(5.6, 1.8, 0.25), CF(0, 2.4, -4) * A(rad(-30), 0, 0), C3(60, 100, 130), Enum.Material.Glass)
	add("Dash", V3(5, 0.9, 1.2), CF(0, 1.9, -3), C3(30, 30, 35))
	add("Wheel", V3(0.15, 1, 1), CF(-1.4, 2.6, -2.4) * A(rad(-30), rad(90), 0), C3(20, 20, 20), nil, Enum.PartType.Cylinder)
	add("Seat", V3(2.4, 1, 2.4), CF(-1.4, 2.1, 0), C3(240, 240, 240))
	add("Seat2", V3(2.4, 1, 2.4), CF(1.4, 2.1, 0), C3(240, 240, 240))
	add("Bench", V3(6, 1, 2.4), CF(0, 2.1, 6), C3(240, 240, 240))
	add("Motor", V3(2, 3, 2), CF(0, 0.8, 11), C3(30, 30, 35))
	local nav1 = add("NavRed", V3(0.4, 0.4, 0.4), CF(-3.4, 1.6, -9), C3(255, 40, 40), Enum.Material.Neon, Enum.PartType.Ball)
	local nav2 = add("NavGreen", V3(0.4, 0.4, 0.4), CF(3.4, 1.6, -9), C3(40, 255, 90), Enum.Material.Neon, Enum.PartType.Ball)
	local wake = add("Wake", V3(8, 0.2, 30), CF(0, -1.0, 26), C3(255, 255, 255))
	wake.Transparency = 1
	local spray1 = add("SprayL", V3(0.5, 2, 4), CF(-3.8, 0.4, -9) * A(0, 0, rad(30)), C3(240, 250, 255))
	local spray2 = add("SprayR", V3(0.5, 2, 4), CF(3.8, 0.4, -9) * A(0, 0, rad(-30)), C3(240, 250, 255))
	spray1.Transparency, spray2.Transparency = 1, 1
	m.PrimaryPart = hull
	return m, o, {wake = wake, spray = {spray1, spray2}, seat = o, hull = hull}
end

function Bo.init(S)
	folder = Instance.new("Folder")
	folder.Name = "SB_Boats"
	folder.Parent = workspace
	S.boats = boats
end

local rpLand = RaycastParams.new()
rpLand.FilterType = Enum.RaycastFilterType.Include
local function spawnBoat(S, cf)
	local m, o, extra = build(COLORS[math.random(#COLORS)])
	local b = {m = m, o = o, x = extra, pos = cf.Position, yaw = select(2, cf:ToEulerAnglesYXZ()), speed = 0, roll = 0, pitch = 0}
	m.Parent = folder
	table.insert(boats, b)
	return b
end
local function draw(S, b, t)
	local wave = math.sin(t * 1.6 + b.pos.X * 0.05) * 0.35 + math.sin(t * 2.3 + b.pos.Z * 0.07) * 0.25
	local y = S.C.MAP.SEA_Y + 1.1 + wave + math.clamp(b.speed / 60, 0, 1) * 0.6
	local cf = CF(b.pos.X, y, b.pos.Z) * A(0, b.yaw, 0) * A(b.pitch + math.sin(t * 1.9 + b.pos.Z * 0.1) * 0.03, 0, b.roll + math.sin(t * 1.3) * 0.03)
	b.cf = cf
	for p, off in pairs(b.o) do p.CFrame = cf * off end
	local fast = math.clamp(b.speed / 50, 0, 1)
	b.x.wake.Transparency = 1 - fast * 0.55
	for _, s in ipairs(b.x.spray) do s.Transparency = 1 - fast * 0.5 end
end

function Bo.start(S)
	local M = S.C.MAP
	local beach = S.city and S.city:FindFirstChild("Beach")
	local marina = beach and beach:FindFirstChild("Marina")
	rpLand.FilterDescendantsInstances = {S.city and S.city:FindFirstChild("Ground"), S.city and S.city:FindFirstChild("Beach"), S.city and S.city:FindFirstChild("StarIsland"), S.city and S.city:FindFirstChild("Docks")}
	local spots = {}
	if marina then for _, p in ipairs(marina:GetDescendants()) do if p:IsA("BasePart") and p:GetAttribute("BoatSpot") then table.insert(spots, p) end end end
	local places = S.city and S.city:FindFirstChild("Places")
	local mk = places and places:FindFirstChild("Boats")
	local mkPos = mk and mk:GetPivot().Position
	-- keep 2 boats waiting at the marina
	task.spawn(function()
		while true do
			task.wait(3)
			if S.mode ~= "menu" and #spots > 0 then
				local waiting = 0
				for _, b in ipairs(boats) do if b ~= riding and (b.pos - spots[1].Position).Magnitude < 160 then waiting += 1 end end
				if waiting < 2 then
					local spot = spots[math.random(#spots)]
					local free = true
					for _, b in ipairs(boats) do if (b.pos - spot.Position).Magnitude < 10 then free = false end end
					if free then spawnBoat(S, CF(spot.Position) * A(0, math.pi, 0)) end
				end
			end
		end
	end)
	-- help text near a boat
	task.spawn(function()
		while true do
			task.wait(0.2)
			if S.mode == "play" and not S.inCar and not riding then
				local ch, hrp = S.char()
				local near
				if hrp then for _, b in ipairs(boats) do if b.cf and (b.cf.Position - hrp.Position).Magnitude < 12 then near = b end end end
				Bo.near = near
				S.fire("help", near and "Press E to drive the boat." or nil, "boat")
			elseif riding then
				local p = riding.pos
				local dock = mkPos and ((p - mkPos) * V3(1, 0, 1)).Magnitude < 45
				S.fire("help", dock and "Press E to get out at the dock." or nil, "boat")
			end
		end
	end)
	local weld
	local function enter(b)
		local ch, hrp, hum = S.char()
		if not hrp then return end
		riding = b
		S.riding = b
		hum.Sit = true
		for _, p in ipairs(ch:GetDescendants()) do if p:IsA("BasePart") then p.Massless = true end end
		weld = Instance.new("Weld")
		weld.Part0, weld.Part1, weld.C0 = b.x.hull, hrp, CF(-1.4, 4.2, 0)
		weld.Parent = b.x.hull
		S.fire("enterBoat", b)
		S.wind = S.sound("Wind", b.x.hull, {Looped = true, Volume = 0.2})
		if S.wind then S.wind:Play() end
	end
	local function exit(toDock)
		local b = riding
		if not b then return end
		riding = nil
		S.riding = nil
		if weld then weld:Destroy() weld = nil end
		if S.wind then S.wind:Destroy() S.wind = nil end
		local ch, hrp, hum = S.char()
		if ch then for _, p in ipairs(ch:GetDescendants()) do if p:IsA("BasePart") then p.Massless = false end end end
		if hum then hum.Sit = false end
		if toDock and mkPos then S.placeChar(CF(mkPos + V3(0, 4, 0)))
		elseif hrp then S.placeChar(b.cf * CF(5, 2, 0)) end
		S.cam.CameraType = Enum.CameraType.Custom
		S.fire("exitBoat", b)
	end
	S.on("action", function(a)
		if a ~= "use" or S.mode ~= "play" then return end
		if riding then
			local dock = mkPos and ((riding.pos - mkPos) * V3(1, 0, 1)).Magnitude < 45
			if dock then exit(true) elseif riding.speed < 6 then exit(false) S.fire("notify", "Splash", "You jumped into the sea. Swim to the shore!") end
		elseif Bo.near and not S.inCar then
			enter(Bo.near)
		end
	end)
	-- drive + camera
	local camPos
	Run.Heartbeat:Connect(function(dt)
		local t = os.clock()
		for _, b in ipairs(boats) do
			if b ~= riding then
				b.speed *= (1 - dt * 0.8)
				b.pos += A(0, b.yaw, 0).LookVector * b.speed * dt
			end
			if b.cf == nil or b == riding or (b.pos - S.cam.CFrame.Position).Magnitude < 400 then draw(S, b, t) end
		end
		local b = riding
		if not b or S.mode ~= "play" then return end
		local I = S.input
		local top = 75
		local thr = I.throttle - I.brake * 0.6
		b.speed += (thr * top - b.speed) * dt * (thr ~= 0 and 0.6 or 0.4)
		local turn = -I.steer * 0.9 * math.clamp(math.abs(b.speed) / 20, 0.2, 1) * (b.speed >= 0 and 1 or -1)
		b.yaw += turn * dt
		b.roll += ((I.steer * 0.25 * math.clamp(b.speed / 50, 0, 1)) - b.roll) * dt * 3
		b.pitch += ((-math.clamp(b.speed / 75, 0, 1) * 0.12) - b.pitch) * dt * 2
		local dir = A(0, b.yaw, 0).LookVector
		local np = b.pos + dir * b.speed * dt
		-- land ahead? stop
		local hit = workspace:Raycast(V3(np.X, M.SEA_Y + 6, np.Z) + dir * 10, V3(0, -12, 0), rpLand)
		if hit and hit.Position.Y > M.SEA_Y - 0.5 then
			b.speed = -b.speed * 0.3
			S.play("Crash", {Volume = 0.4, PlaybackSpeed = 0.7}, np)
		else
			b.pos = np
		end
		S.speed = math.abs(b.speed)
		-- camera
		local cam = S.cam
		cam.CameraType = Enum.CameraType.Scriptable
		local cf = b.cf or CF(b.pos)
		local target = cf.Position + V3(0, 4, 0)
		local want = target - dir * 26 + V3(0, 9, 0)
		camPos = camPos and camPos:Lerp(want, math.min(1, dt * 4)) or want
		cam.CFrame = CF(camPos, target) * A(0, 0, b.roll * 0.4)
		cam.FieldOfView = 70 + math.clamp(b.speed / 5, 0, 12)
		if S.wind then S.wind.Volume = 0.1 + math.clamp(b.speed / 80, 0, 0.5) S.wind.PlaybackSpeed = 0.8 + b.speed / 120 end
	end)
	S.boatExit = exit
end
return Bo
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXSBody"><Properties><string name="Name">Body</string><ProtectedString name="Source"><![CDATA[--[[
	Body | StarterPlayerScripts.SB (ModuleScript)
	Your character on foot:
	  * SPRINT: hold SHIFT (on foot) to run faster; a stamina bar drains and refills
	  * SWIM: the sea is real water for you - jump in from the beach or a boat and you float and swim
	    (WASD), with splashes and a slow breaststroke bob; walk out onto the sand when you reach the shore
	  * OUTFITS: change clothes at the safehouse wardrobe (80s styles). Only you see your look - this is
	    a single player world, so it is applied on your computer only.
]]
local Bd = {}
local Run = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local TS = game:GetService("TweenService")
local C3, V3, CF, A, U2 = Color3.fromRGB, Vector3.new, CFrame.new, CFrame.Angles, UDim2.new

local OUTFITS = {
	{name = "Your own look", colors = nil},
	{name = "Miami Suit", colors = {torso = C3(250, 250, 245), arms = C3(250, 250, 245), legs = C3(250, 250, 245), shirt = C3(120, 220, 255)}},
	{name = "Hawaiian", colors = {torso = C3(255, 120, 60), arms = C3(234, 184, 146), legs = C3(240, 230, 200), shirt = C3(255, 120, 60)}},
	{name = "Neon Runner", colors = {torso = C3(255, 40, 170), arms = C3(255, 40, 170), legs = C3(20, 20, 30), shirt = C3(255, 40, 170)}},
	{name = "Beach Day", colors = {torso = C3(234, 184, 146), arms = C3(234, 184, 146), legs = C3(0, 200, 255), shirt = nil}},
	{name = "Night Out", colors = {torso = C3(25, 25, 30), arms = C3(25, 25, 30), legs = C3(25, 25, 30), shirt = C3(170, 70, 255)}},
	{name = "Cabbie", colors = {torso = C3(255, 200, 20), arms = C3(234, 184, 146), legs = C3(40, 50, 90), shirt = C3(255, 200, 20)}},
}

local stamina = 1
local swimming = false
local barGui, bar
function Bd.init(S)
	S.outfits = OUTFITS
	barGui = Instance.new("ScreenGui")
	barGui.Name, barGui.ResetOnSpawn, barGui.IgnoreGuiInset, barGui.DisplayOrder = "SB_Stamina", false, true, 4
	barGui.Parent = S.pg
	local back = Instance.new("Frame")
	back.AnchorPoint, back.Position, back.Size, back.BackgroundColor3, back.BackgroundTransparency, back.BorderSizePixel = Vector2.new(0, 1), U2(0, 24, 1, -6), U2(0, 280, 0, 5), C3(20, 20, 30), 0.3, 0
	back.Visible = false
	back.Parent = barGui
	bar = Instance.new("Frame")
	bar.Size, bar.BackgroundColor3, bar.BorderSizePixel = U2(1, 0, 1, 0), C3(255, 220, 90), 0
	bar.Parent = back
end

----------------------------------------------------------------------------------------------------
-- OUTFITS (recolour the character on this computer)
----------------------------------------------------------------------------------------------------
local original = {}
local function applyOutfit(S, i)
	local ch = S.lp.Character
	if not ch then return end
	local o = OUTFITS[i] or OUTFITS[1]
	for _, p in ipairs(ch:GetChildren()) do
		if p:IsA("BasePart") then
			if not original[p.Name] then original[p.Name] = p.Color end
			local c = o.colors
			local n = p.Name
			local col
			if c then
				if n == "Torso" or n == "UpperTorso" or n == "LowerTorso" then col = c.torso
				elseif n:find("Arm") or n:find("Hand") then col = c.arms
				elseif n:find("Leg") or n:find("Foot") then col = c.legs end
			end
			p.Color = col or original[n] or p.Color
		elseif p:IsA("Shirt") or p:IsA("Pants") or p:IsA("ShirtGraphic") then
			-- clothes textures hide colours: switch them off for custom outfits (only on this computer)
			if o.colors then p:SetAttribute("SBHidden", true) p.Parent = nil end
		end
	end
	S.settings.outfit = i
	S.markDirty()
end
Bd.applyOutfit = applyOutfit

----------------------------------------------------------------------------------------------------
-- SWIMMING (custom: the sea is a glass part, not terrain water)
----------------------------------------------------------------------------------------------------
local swimForce, swimAlign, swimAtt
local function setSwim(S, on)
	if on == swimming then return end
	swimming = on
	S.swimming = on
	local ch, hrp, hum = S.char()
	if not hrp then return end
	if on then
		swimAtt = Instance.new("Attachment") swimAtt.Parent = hrp
		swimForce = Instance.new("LinearVelocity")
		swimForce.Attachment0, swimForce.MaxForce, swimForce.VectorVelocity = swimAtt, 1e6, V3()
		swimForce.Parent = hrp
		swimAlign = Instance.new("AlignOrientation")
		swimAlign.Mode, swimAlign.Attachment0, swimAlign.Responsiveness, swimAlign.MaxTorque = Enum.OrientationAlignmentMode.OneAttachment, swimAtt, 12, 1e7
		swimAlign.Parent = hrp
		if hum then hum.PlatformStand = true end
		S.play("Ocean", {Volume = 0.6, PlaybackSpeed = 1.2}, hrp.Position)
	else
		for _, x in ipairs({swimForce, swimAlign, swimAtt}) do if x then x:Destroy() end end
		swimForce, swimAlign, swimAtt = nil, nil, nil
		if hum then hum.PlatformStand = false hum:ChangeState(Enum.HumanoidStateType.GettingUp) end
	end
end
local rpFloor = RaycastParams.new()
rpFloor.FilterType = Enum.RaycastFilterType.Include

function Bd.start(S)
	local M = S.C.MAP
	rpFloor.FilterDescendantsInstances = {S.city and S.city:FindFirstChild("Beach"), S.city and S.city:FindFirstChild("Ground"), S.city and S.city:FindFirstChild("StarIsland"), S.city and S.city:FindFirstChild("Docks")}
	-- outfit on spawn
	S.lp.CharacterAdded:Connect(function() task.wait(1) original = {} if (S.settings.outfit or 1) > 1 then applyOutfit(S, S.settings.outfit) end end)
	S.on("play", function() if (S.settings.outfit or 1) > 1 then applyOutfit(S, S.settings.outfit) end end)
	S.on("wardrobe", function()
		local i = (S.settings.outfit or 1) % #OUTFITS + 1
		applyOutfit(S, i)
		S.fire("notify", "Wardrobe", "Outfit: " .. OUTFITS[i].name, C3(255, 120, 200))
	end)
	local t = 0
	Run.Heartbeat:Connect(function(dt)
		t += dt
		local ch, hrp, hum = S.char()
		if not hrp or not hum or S.mode ~= "play" then return end
		-- SPRINT
		local onFoot = not S.inCar and not S.riding and not swimming
		local wantSprint = onFoot and UIS:IsKeyDown(Enum.KeyCode.LeftShift) and hum.MoveDirection.Magnitude > 0.1
		if wantSprint and stamina > 0 then
			hum.WalkSpeed = 26
			stamina = math.max(0, stamina - dt / 7)
		else
			hum.WalkSpeed = onFoot and 16 or hum.WalkSpeed
			stamina = math.min(1, stamina + dt / 5)
		end
		bar.Size = U2(stamina, 0, 1, 0)
		bar.Parent.Visible = onFoot and stamina < 0.99
		-- SWIM: below sea level, over water (no ground under the feet)
		local p = hrp.Position
		local inSea = p.Y < M.SEA_Y + 1.2 and not S.inCar and not S.riding and (p.X > M.SEA_X - 10 or p.Z > M.DOCKS_Z - 5 or (V3(p.X, 0, p.Z) - V3(M.ISLAND.cx, 0, M.ISLAND.cz)).Magnitude > M.ISLAND.r + 10)
		local floor = workspace:Raycast(p + V3(0, 2, 0), V3(0, -6, 0), rpFloor)
		if floor and floor.Position.Y > M.SEA_Y - 0.6 then inSea = false end
		setSwim(S, inSea)
		if swimming and swimForce then
			local md = hum.MoveDirection
			local bob = math.sin(t * 3) * 0.6
			local wantY = (M.SEA_Y - 1.4 - p.Y) * 4 + bob
			swimForce.VectorVelocity = V3(md.X * 12, wantY, md.Z * 12)
			local look = md.Magnitude > 0.1 and md or hrp.CFrame.LookVector
			look = V3(look.X, 0, look.Z)
			if look.Magnitude > 0.01 then
				-- lie forward a bit while swimming
				swimAlign.CFrame = CF(V3(), look.Unit) * A(md.Magnitude > 0.1 and -1.1 or -0.3, 0, 0)
			end
			if md.Magnitude > 0.1 and math.random() < dt * 2 then S.play("Ocean", {Volume = 0.25, PlaybackSpeed = 1.6}, p) end
		end
	end)
	S.applyOutfit = function(i) applyOutfit(S, i) end
end
return Bd
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXSCinematic"><Properties><string name="Name">Cinematic</string><ProtectedString name="Source"><![CDATA[--[[
	Cinematic | StarterPlayerScripts.SB (ModuleScript)
	The movie bits:
	  * INTRO: the first time you start Story Mode - letterbox bars, slow camera moves along the beach and
	    the neon hotels, subtitles from Rico, then the camera drops behind you
	  * PHONE CALLS: the caller's name slides in at the top, the words type out as subtitles
	  * MISSION TITLES: the job name fades in big in the middle of the screen
	  * PHOTO MODE (P or phone > Camera): free camera (WASD + mouse, Q/E up/down, SHIFT faster),
	    filters (F): Natural, Vice Neon, Golden Hour, Noir, Vintage; hides the HUD, depth of field
	  * WASTED: when your car burns with you inside
]]
local Ci = {}
local Run = game:GetService("RunService")
local TS = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")
local Lighting = game:GetService("Lighting")
local C3, V3, CF, U2, V2, A = Color3.fromRGB, Vector3.new, CFrame.new, UDim2.new, Vector2.new, CFrame.Angles

local gui, top, bottom, sub, callBox, title
local function label(par, props)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency, l.TextColor3, l.Font, l.TextScaled = 1, C3(255, 255, 255), Enum.Font.GothamBold, true
	for k, v in pairs(props) do l[k] = v end
	l.Parent = par
	return l
end
function Ci.init(S)
	gui = Instance.new("ScreenGui")
	gui.Name, gui.IgnoreGuiInset, gui.ResetOnSpawn, gui.DisplayOrder = "SB_Cine", true, false, 30
	gui.Parent = S.pg
	top = Instance.new("Frame")
	top.Size, top.Position, top.BackgroundColor3, top.BorderSizePixel = U2(1, 0, 0.12, 0), U2(0, 0, -0.12, 0), C3(0, 0, 0), 0
	top.Parent = gui
	bottom = top:Clone()
	bottom.Position = U2(0, 0, 1, 0)
	bottom.Parent = gui
	sub = label(gui, {AnchorPoint = V2(0.5, 1), Position = U2(0.5, 0, 1, -40), Size = U2(0.7, 0, 0, 26), Text = "", ZIndex = 5})
	local st = Instance.new("UIStroke") st.Thickness = 2 st.Parent = sub
	callBox = Instance.new("Frame")
	callBox.AnchorPoint, callBox.Position, callBox.Size, callBox.BackgroundColor3, callBox.BackgroundTransparency = V2(0.5, 0), U2(0.5, 0, 0, -90), U2(0, 300, 0, 60), C3(16, 10, 40), 0.1
	local cr = Instance.new("UICorner") cr.CornerRadius = UDim.new(0, 12) cr.Parent = callBox
	local cs = Instance.new("UIStroke") cs.Color, cs.Thickness = C3(255, 46, 151), 1.5 cs.Parent = callBox
	local cg = Instance.new("UIGradient") cg.Color = ColorSequence.new(C3(255, 46, 151), C3(0, 230, 255)) cg.Parent = cs
	local cvs = Instance.new("UIScale") cvs.Name = "VS" cvs.Parent = callBox -- responsive scale (Core.scaleGui)
	callBox.Parent = gui
	label(callBox, {Name = "Who", Position = U2(0, 62, 0, 6), Size = U2(1, -72, 0, 26), Text = "", TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.GothamBlack})
	label(callBox, {Name = "State", Position = U2(0, 62, 0, 34), Size = U2(1, -72, 0, 18), Text = "Incoming call...", TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C3(255, 120, 200)})
	local av = label(callBox, {Name = "Avatar", Position = U2(0, 8, 0.5, -22), Size = U2(0, 44, 0, 44), Text = "☎", BackgroundTransparency = 0, BackgroundColor3 = C3(255, 60, 170)})
	local ac = Instance.new("UICorner") ac.CornerRadius = UDim.new(1, 0) ac.Parent = av
	title = label(gui, {AnchorPoint = V2(0.5, 0.5), Position = U2(0.5, 0, 0.42, 0), Size = U2(0.8, 0, 0, 56), Text = "", Font = Enum.Font.Michroma, TextColor3 = C3(255, 220, 120), TextTransparency = 1})
	local ts = Instance.new("UIStroke") ts.Thickness, ts.Transparency = 2.5, 1 ts.Parent = title
	if S.scaleGui then S.scaleGui(gui) end
end

local function bars(on, time)
	TS:Create(top, TweenInfo.new(time or 0.6), {Position = on and U2(0, 0, 0, 0) or U2(0, 0, -0.12, 0)}):Play()
	TS:Create(bottom, TweenInfo.new(time or 0.6), {Position = on and U2(0, 0, 0.88, 0) or U2(0, 0, 1, 0)}):Play()
end
local subId = 0
local function say(text, seconds)
	subId += 1
	local my = subId
	sub.Text = ""
	for i = 1, #text do
		if subId ~= my then return end
		sub.Text = text:sub(1, i)
		task.wait(0.022)
	end
	task.delay(seconds or 3, function() if subId == my then sub.Text = "" end end)
end
Ci.say = say

----------------------------------------------------------------------------------------------------
-- INTRO
----------------------------------------------------------------------------------------------------
local function intro(S)
	if S.data.stats.intro then return end
	S.data.stats.intro = 1
	local prev = S.mode
	S.mode = "cutscene"
	S.gui.SB_HUD.Enabled = false
	bars(true)
	local cam = S.cam
	cam.CameraType = Enum.CameraType.Scriptable
	local shots = {
		{V3(820, 14, 380), V3(820, 18, 100), V3(600, 12, 240), "Rico: Sunset Bay. Sun, sand, neon... and money, if you know where to look."},
		{V3(470, 9, 200), V3(500, 12, 330), V3(420, 30, 260), "Rico: You got off the bus with nothing. That's okay. Everybody here started with nothing."},
		{V3(300, 140, -300), V3(150, 160, -600), V3(-120, 100, -480), "Rico: Drive. Work. Make a name. The city pays the ones who move fast."},
	}
	for _, s in ipairs(shots) do
		local t0, dur = os.clock(), 6
		task.spawn(say, s[4], 3.5)
		while os.clock() - t0 < dur do
			local k = (os.clock() - t0) / dur
			k = k * k * (3 - 2 * k)
			cam.CFrame = CF(s[1]:Lerp(s[2], k), s[3])
			cam.FieldOfView = 50
			Run.RenderStepped:Wait()
		end
	end
	bars(false)
	sub.Text = ""
	cam.CameraType = Enum.CameraType.Custom
	cam.FieldOfView = 70
	S.gui.SB_HUD.Enabled = true
	S.mode = "play"
	S.markDirty()
	S.fire("notify", "Rico Vega", "Call me when you're ready. Phone > Jobs > Story.", C3(255, 60, 170))
end

----------------------------------------------------------------------------------------------------
-- PHOTO MODE
----------------------------------------------------------------------------------------------------
local FILTERS = {
	{name = "Natural", tint = C3(255, 255, 255), sat = 0, contrast = 0, bright = 0},
	{name = "Vice Neon", tint = C3(255, 190, 240), sat = 0.45, contrast = 0.2, bright = 0.02},
	{name = "Golden Hour", tint = C3(255, 205, 150), sat = 0.25, contrast = 0.12, bright = 0.04},
	{name = "Noir", tint = C3(255, 255, 255), sat = -1, contrast = 0.35, bright = -0.02},
	{name = "Vintage", tint = C3(255, 230, 190), sat = -0.35, contrast = -0.05, bright = 0.05},
}
local photoCC
local function photo(S, on)
	if on and S.mode ~= "play" then return end
	S.photo = on
	if on then
		S.mode = "photo"
		S.gui.SB_HUD.Enabled = false
		photoCC = Instance.new("ColorCorrectionEffect")
		photoCC.Name = "SB_PhotoFilter"
		photoCC.Parent = Lighting
		local fi = 1
		local cam = S.cam
		cam.CameraType = Enum.CameraType.Scriptable
		local pos = cam.CFrame.Position
		local yaw, pitch = 0, 0
		do local lx, ly = cam.CFrame:ToEulerAnglesYXZ() pitch, yaw = lx, ly end
		task.spawn(say, "PHOTO MODE  ·  WASD move · right mouse look · Q/E up/down · F filter · P exit", 4)
		local con
		con = Run.RenderStepped:Connect(function(dt)
			if not S.photo then con:Disconnect() return end
			local spd = UIS:IsKeyDown(Enum.KeyCode.LeftShift) and 60 or 18
			local mv = V3((UIS:IsKeyDown(Enum.KeyCode.D) and 1 or 0) - (UIS:IsKeyDown(Enum.KeyCode.A) and 1 or 0), (UIS:IsKeyDown(Enum.KeyCode.E) and 1 or 0) - (UIS:IsKeyDown(Enum.KeyCode.Q) and 1 or 0), (UIS:IsKeyDown(Enum.KeyCode.S) and 1 or 0) - (UIS:IsKeyDown(Enum.KeyCode.W) and 1 or 0))
			if UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
				UIS.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
				local d = UIS:GetMouseDelta()
				yaw -= d.X * 0.004
				pitch = math.clamp(pitch - d.Y * 0.004, -1.4, 1.4)
			else
				UIS.MouseBehavior = Enum.MouseBehavior.Default
			end
			local rot = A(0, yaw, 0) * A(pitch, 0, 0)
			pos += (rot * CF(mv * spd * dt)).Position
			cam.CFrame = CF(pos) * rot
		end)
		local fcon
		fcon = UIS.InputBegan:Connect(function(i, gp)
			if gp then return end
			if not S.photo then fcon:Disconnect() return end
			if i.KeyCode == Enum.KeyCode.F then
				fi = fi % #FILTERS + 1
				local f = FILTERS[fi]
				photoCC.TintColor, photoCC.Saturation, photoCC.Contrast, photoCC.Brightness = f.tint, f.sat, f.contrast, f.bright
				task.spawn(say, "Filter: " .. f.name, 1.5)
			end
		end)
	else
		if photoCC then photoCC:Destroy() photoCC = nil end
		UIS.MouseBehavior = Enum.MouseBehavior.Default
		S.cam.CameraType = Enum.CameraType.Custom
		S.gui.SB_HUD.Enabled = true
		S.mode = "play"
	end
end

function Ci.start(S)
	S.on("storyStart", function() task.delay(1.5, intro, S) end)
	S.on("phoneCall", function(who, text) task.spawn(function()
		callBox.Who.Text = who
		callBox.State.Text = "Incoming call..."
		TS:Create(callBox, TweenInfo.new(0.4, Enum.EasingStyle.Back), {Position = U2(0.5, 0, 0, 20)}):Play()
		S.play("PhoneOpen", {PlaybackSpeed = 0.7})
		task.wait(0.8)
		callBox.State.Text = "On the line"
		say(who .. ": " .. text, 5)
		task.wait(math.min(8, 2 + #text * 0.035))
		TS:Create(callBox, TweenInfo.new(0.4), {Position = U2(0.5, 0, 0, -90)}):Play()
	end) end)
	S.on("missionTitle", function(name)
		title.Text = name
		local st = title:FindFirstChildOfClass("UIStroke")
		TS:Create(title, TweenInfo.new(0.6), {TextTransparency = 0}):Play()
		TS:Create(st, TweenInfo.new(0.6), {Transparency = 0}):Play()
		task.delay(2.6, function()
			TS:Create(title, TweenInfo.new(0.8), {TextTransparency = 1}):Play()
			TS:Create(st, TweenInfo.new(0.8), {Transparency = 1}):Play()
		end)
	end)
	S.on("photoMode", function(on) photo(S, on) end)
	S.on("action", function(a)
		if a == "photo" then photo(S, not S.photo)
		elseif a == "back" and S.photo then photo(S, false) end
	end)
	-- WASTED: your car is on fire with you inside for a few seconds
	task.spawn(function()
		local burning = 0
		while true do
			task.wait(0.5)
			if S.mode == "play" and S.inCar and S.car and S.car.health <= 0 then
				burning += 0.5
				if burning > 6 then
					burning = 0
					S.exitCar()
					S.fire("big", "WASTED", "Get out of burning cars!", C3(220, 40, 40))
					local cost = math.min(1500, math.floor(S.cash() * 0.05))
					if cost > 0 then S.addCash(-cost, "hospital") end
				end
			else
				burning = 0
			end
		end
	end)
	S.say = say
	S.cineBars = bars
end
return Ci
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXSCore"><Properties><string name="Name">Core</string><ProtectedString name="Source"><![CDATA[--[[
	Core | StarterPlayerScripts.SB (ModuleScript)
	Shared state for every module:
	  S.C (config), S.L (library), S.lp, S.gui, S.data (saved progress)
	  S.on(event, fn) / S.fire(event, ...)   simple event bus
	  S.cash(), S.addCash(n, why), S.spend(n) -> bool
	  S.sound(name, parent, props) -> Sound   (IDs from Config.SOUNDS, built-in fallback)
	  S.save(now)                             sends progress to the server
	  S.input                                  current driving input (keyboard, gamepad, touch)
	  S.mode                                   "menu", "play", "cutscene", "map", "shop"
	It also hides every other player (single player world) and keeps the character in a safe place.
]]
local Core = {}
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local Run = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")

function Core.init(S)
	local SB = RS:WaitForChild("SunsetBay")
	S.SB = SB
	S.C = require(SB:WaitForChild("Config"))
	S.L = require(SB:WaitForChild("Lib"))
	S.lp = Players.LocalPlayer
	S.cam = workspace.CurrentCamera
	S.pg = S.lp:WaitForChild("PlayerGui")
	S.gui = {}
	for _, n in ipairs({"SB_Menu", "SB_HUD", "SB_Phone", "SB_Shops", "SB_Map"}) do
		local g = S.pg:WaitForChild(n, 10)
		S.gui[n] = g
		if g then
			g.Enabled = false -- saved disabled in the place file; Menu / startPlaying switch the right ones on
			pcall(function() g.ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets end) -- stay clear of notches, ignore the top bar
		end
	end
	-- UI SCALE: every top level block has a UIScale named "VS[:x][:h<n>][:w<n>][:c<n>]" (see gen_ui.lua)
	function S.uiK()
		local vp = S.cam.ViewportSize
		if vp.X < 10 or vp.Y < 10 then return 1 end
		if UIS.TouchEnabled and not UIS.KeyboardEnabled then return math.clamp(vp.Y / 400, 0.85, 1.3) end
		return math.clamp(vp.Y / 1000, 0.8, 1.2)
	end
	local function scaleOne(u)
		local base = u:GetAttribute("base")
		if not base then base = u.Scale u:SetAttribute("base", base) end
		local vp = S.cam.ViewportSize
		if vp.X < 10 or vp.Y < 10 then return end
		local spec = u.Name
		local hd, wd, cap = tonumber(spec:match(":h(%d+)")), tonumber(spec:match(":w(%d+)")), tonumber(spec:match(":c([%d%.]+)"))
		local s
		if spec:find(":x", 1, true) then
			s = 1e9
			if hd then s = math.min(s, vp.Y * 0.92 / hd) end
			if wd then s = math.min(s, vp.X * 0.94 / wd) end
			if cap then s = math.min(s, (UIS.TouchEnabled and not UIS.KeyboardEnabled) and math.max(cap, 1.3) or cap) end
			if s == 1e9 then s = 1 end
			s = math.clamp(s * base, 0.3, 2)
		else
			s = S.uiK() * base
			-- never let a block be wider / taller than the screen
			if hd then s = math.min(s, vp.Y * 0.95 / hd) end
			if wd then s = math.min(s, vp.X * 0.95 / wd) end
		end
		u.Scale = s
	end
	function S.scaleGui(g)
		if not g then return end
		for _, d in ipairs(g:GetDescendants()) do
			if d:IsA("UIScale") and d.Name:sub(1, 2) == "VS" then scaleOne(d) end
		end
	end
	local function scaleAll() for _, g in pairs(S.gui) do S.scaleGui(g) end end
	scaleAll()
	S.cam:GetPropertyChangedSignal("ViewportSize"):Connect(scaleAll)
	S.mode = "menu"
	S.city = workspace:WaitForChild("City", 30)
	S.remotes = SB:WaitForChild("Remotes", 30)

	------------------------------------------------------------------------------------------------
	-- EVENTS
	------------------------------------------------------------------------------------------------
	local handlers = {}
	function S.on(ev, fn)
		handlers[ev] = handlers[ev] or {}
		table.insert(handlers[ev], fn)
		return function()
			local list = handlers[ev]
			local i = list and table.find(list, fn)
			if i then table.remove(list, i) end
		end
	end
	function S.fire(ev, ...)
		local list = handlers[ev]
		if not list then return end
		for _, fn in ipairs(table.clone(list)) do
			local ok, err = pcall(fn, ...)
			if not ok then warn("[SunsetBay] event " .. ev .. ": " .. tostring(err)) end
		end
	end

	------------------------------------------------------------------------------------------------
	-- DATA
	------------------------------------------------------------------------------------------------
	local ok, d = pcall(function() return S.remotes.GetData:InvokeServer() end)
	S.data = ok and type(d) == "table" and d or {cash = S.C.START_CASH, cars = {{key = S.C.START_CAR, color = 1, health = S.C.MAX_HEALTH}}, props = {}, packages = {}, stunts = {}, stats = {}, settings = {}, story = 0, time = S.C.START_TIME}
	for _, k in ipairs({"props", "packages", "stunts", "stats", "settings"}) do S.data[k] = S.data[k] or {} end
	S.settings = S.data.settings
	S.settings.quality = S.settings.quality or S.C.DEFAULT_QUALITY
	S.settings.music = S.settings.music or 0.7
	S.settings.sfx = S.settings.sfx or 0.8
	S.settings.camera = S.settings.camera or "Chase"
	S.settings.units = S.settings.units or "MPH"
	local dirty = false
	function S.save(now)
		dirty = false
		if S.getTime then S.data.time = S.getTime() end
		local ch = S.lp.Character
		local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
		if hrp and S.mode == "play" and not S.inCar then S.data.pos = hrp.Position end
		pcall(function() S.remotes.SaveData:FireServer(S.data, now) end)
	end
	function S.markDirty() dirty = true end
	task.spawn(function()
		while true do
			task.wait(20)
			if dirty or S.mode == "play" then S.save(false) end
		end
	end)
	function S.stat(name, n)
		S.data.stats[name] = (S.data.stats[name] or 0) + (n or 1)
		dirty = true
	end

	------------------------------------------------------------------------------------------------
	-- MONEY
	------------------------------------------------------------------------------------------------
	function S.cash() return S.data.cash or 0 end
	function S.addCash(n, why)
		n = math.floor(n)
		S.data.cash = math.max(0, (S.data.cash or 0) + n)
		if n > 0 then S.stat("earned", n) end
		dirty = true
		S.fire("cash", S.data.cash, n, why)
	end
	function S.spend(n)
		if (S.data.cash or 0) < n then
			S.fire("notify", "Not enough money", "You need " .. S.L.money(n) .. ".", Color3.fromRGB(255, 80, 80))
			return false
		end
		S.addCash(-n)
		return true
	end

	------------------------------------------------------------------------------------------------
	-- SOUNDS
	------------------------------------------------------------------------------------------------
	local sfxGroup = Instance.new("SoundGroup")
	sfxGroup.Name, sfxGroup.Volume, sfxGroup.Parent = "SB_SFX", S.settings.sfx, SoundService
	local musicGroup = Instance.new("SoundGroup")
	musicGroup.Name, musicGroup.Volume, musicGroup.Parent = "SB_Music", S.settings.music, SoundService
	S.sfxGroup, S.musicGroup = sfxGroup, musicGroup
	-- make a Sound from a config name; returns nil if there is no id at all
	function S.sound(name, parent, props)
		local id = S.L.soundId(name)
		if not id then return nil end
		local s = Instance.new("Sound")
		s.SoundId = id
		s.SoundGroup = sfxGroup
		for k, v in pairs(props or {}) do s[k] = v end
		s.Parent = parent or SoundService
		return s
	end
	-- fire and forget
	function S.play(name, props, at)
		local parent = SoundService
		local holder
		if at then
			holder = Instance.new("Attachment")
			holder.WorldPosition = at
			holder.Parent = workspace.Terrain
			parent = holder
		end
		local s = S.sound(name, parent, props)
		if not s then if holder then holder:Destroy() end return end
		s:Play()
		local len = 1
		pcall(function() len = s.TimeLength end)
		Debris:AddItem(holder or s, math.max(2, len + 1))
		return s
	end
	function S.applyVolumes()
		sfxGroup.Volume = S.settings.sfx
		musicGroup.Volume = S.settings.music
	end

	------------------------------------------------------------------------------------------------
	-- INPUT (keyboard / gamepad / touch) -> S.input
	------------------------------------------------------------------------------------------------
	S.input = {throttle = 0, steer = 0, brake = 0, handbrake = false, nitro = false, lookBack = false}
	S.touch = {gas = false, brake = false, left = false, right = false, nitro = false}
	S.isTouch = UIS.TouchEnabled and not UIS.KeyboardEnabled
	local pad = {lx = 0, rt = 0, lt = 0}
	UIS.InputChanged:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.Gamepad1 then
			if i.KeyCode == Enum.KeyCode.Thumbstick1 then pad.lx = math.abs(i.Position.X) > 0.15 and i.Position.X or 0
			elseif i.KeyCode == Enum.KeyCode.ButtonR2 then pad.rt = i.Position.Z
			elseif i.KeyCode == Enum.KeyCode.ButtonL2 then pad.lt = i.Position.Z end
		end
	end)
	local function key(k) return UIS:IsKeyDown(k) end
	local function padDown(k) local ok, v = pcall(function() return UIS:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, k) end) return ok and v end
	Run.RenderStepped:Connect(function()
		local typing = UIS:GetFocusedTextBox() ~= nil
		local I = S.input
		if typing or S.mode ~= "play" then
			I.throttle, I.steer, I.brake, I.handbrake, I.nitro = 0, 0, 0, false, false
			return
		end
		local up = (key(Enum.KeyCode.W) or key(Enum.KeyCode.Up) or S.touch.gas) and 1 or 0
		local down = (key(Enum.KeyCode.S) or key(Enum.KeyCode.Down) or S.touch.brake) and 1 or 0
		local left = (key(Enum.KeyCode.A) or key(Enum.KeyCode.Left) or S.touch.left) and 1 or 0
		local right = (key(Enum.KeyCode.D) or key(Enum.KeyCode.Right) or S.touch.right) and 1 or 0
		I.throttle = math.max(up, pad.rt)
		I.brake = math.max(down, pad.lt)
		I.steer = math.clamp(right - left + pad.lx, -1, 1)
		I.handbrake = key(Enum.KeyCode.Space) or padDown(Enum.KeyCode.ButtonX)
		I.nitro = key(Enum.KeyCode.LeftShift) or S.touch.nitro or padDown(Enum.KeyCode.ButtonA)
		I.lookBack = key(Enum.KeyCode.Q) or padDown(Enum.KeyCode.ButtonR3)
	end)
	-- action keys -> events ("action", name)
	local ACTIONS = {
		[Enum.KeyCode.E] = "use", [Enum.KeyCode.F] = "use", [Enum.KeyCode.ButtonY] = "use",
		[Enum.KeyCode.H] = "horn", [Enum.KeyCode.ButtonL3] = "horn",
		[Enum.KeyCode.L] = "lights", [Enum.KeyCode.C] = "camera", [Enum.KeyCode.ButtonR1] = "camera",
		[Enum.KeyCode.R] = "radio", [Enum.KeyCode.DPadRight] = "radio",
		[Enum.KeyCode.M] = "map", [Enum.KeyCode.Tab] = "phone", [Enum.KeyCode.ButtonSelect] = "map", [Enum.KeyCode.DPadUp] = "phone",
		[Enum.KeyCode.P] = "photo", [Enum.KeyCode.Backspace] = "back", [Enum.KeyCode.ButtonB] = "back",
		[Enum.KeyCode.Z] = "indicatorL", [Enum.KeyCode.X] = "indicatorR", [Enum.KeyCode.G] = "hazard",
	}
	UIS.InputBegan:Connect(function(i, gp)
		if gp or UIS:GetFocusedTextBox() then return end
		local a = ACTIONS[i.KeyCode]
		if a then S.fire("action", a) end
	end)

	------------------------------------------------------------------------------------------------
	-- SINGLE PLAYER: hide every other player on this computer
	------------------------------------------------------------------------------------------------
	local function hide(ch)
		for _, p in ipairs(ch:GetDescendants()) do
			if p:IsA("BasePart") then p.LocalTransparencyModifier = 1 p.CanCollide = false p.CanQuery = false
			elseif p:IsA("Decal") then p.Transparency = 1 end
		end
		ch.DescendantAdded:Connect(function(p)
			if p:IsA("BasePart") then p.LocalTransparencyModifier = 1 p.CanCollide = false p.CanQuery = false
			elseif p:IsA("Decal") then p.Transparency = 1 end
		end)
		local hum = ch:FindFirstChildOfClass("Humanoid") or ch:WaitForChild("Humanoid", 5)
		if hum then hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end
	end
	local function watch(p)
		if p == S.lp then return end
		p.CharacterAdded:Connect(function(ch) task.wait() hide(ch) end)
		if p.Character then hide(p.Character) end
	end
	for _, p in ipairs(Players:GetPlayers()) do watch(p) end
	Players.PlayerAdded:Connect(watch)
	-- keep our transparency modifier fresh (Roblox resets it each frame for some parts)
	Run.RenderStepped:Connect(function()
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= S.lp and p.Character then
				for _, x in ipairs(p.Character:GetChildren()) do
					if x:IsA("BasePart") then x.LocalTransparencyModifier = 1
					elseif x:IsA("Accessory") then local h = x:FindFirstChild("Handle") if h then h.LocalTransparencyModifier = 1 end end
				end
			end
		end
	end)

	------------------------------------------------------------------------------------------------
	-- CHARACTER helpers
	------------------------------------------------------------------------------------------------
	function S.char() local ch = S.lp.Character return ch, ch and ch:FindFirstChild("HumanoidRootPart"), ch and ch:FindFirstChildOfClass("Humanoid") end
	function S.placeChar(cf)
		local ch, hrp = S.char()
		if ch and hrp then ch:PivotTo(cf) hrp.AssemblyLinearVelocity = Vector3.zero end
	end
	function S.spawnPoint()
		local p = S.data.pos
		if type(p) == "table" and #p == 3 then return CFrame.new(p[1], p[2] + 3, p[3]) end
		return CFrame.new(S.C.MAP.SPAWN)
	end
	-- keep the player out of the menu world: freeze until the game starts
	S.lp.CharacterAdded:Connect(function(ch)
		local hrp = ch:WaitForChild("HumanoidRootPart", 10)
		if not hrp then return end
		task.wait()
		if S.mode == "menu" then
			hrp.Anchored = true
			ch:PivotTo(CFrame.new(S.C.MAP.SPAWN + Vector3.new(0, 500, 0)))
		else
			ch:PivotTo(S.respawnCF or S.spawnPoint())
		end
	end)
	function S.startPlaying()
		local ch, hrp = S.char()
		if hrp then hrp.Anchored = false end
		S.placeChar(S.spawnPoint())
		if S.freezeTime then S.freezeTime(nil) end
		S.mode = "play"
		for _, n in ipairs({"SB_HUD", "SB_Phone", "SB_Shops", "SB_Map"}) do -- guis are saved disabled
			if S.gui[n] then S.gui[n].Enabled = true end
		end
		S.fire("play")
	end
	-- falling into the sea far from land: put back on the road
	task.spawn(function()
		while true do
			task.wait(1)
			local ch, hrp = S.char()
			if hrp and S.mode == "play" and not S.inCar and hrp.Position.Y < S.C.MAP.SEA_Y - 30 then
				local p = S.L.nearestRoad(hrp.Position)
				S.placeChar(CFrame.new(p + Vector3.new(0, 4, 0)))
				S.fire("notify", "Back on land", "You were pulled out of the water.")
			end
		end
	end)
	S.clock0 = os.clock()
end
return Core
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXSDrive"><Properties><string name="Name">Drive</string><ProtectedString name="Source"><![CDATA[--[[
	Drive | StarterPlayerScripts.SB (ModuleScript)
	Arcade car physics that feel good and stay smooth (the car only exists on this computer):
	  * 4 ground rays (one per wheel): grounded check, ground normal, ramp jumps, gentle suspension bob
	  * throttle / brake / reverse, top speed and acceleration from Config.CARS, rolling drag
	  * grip: the sideways slide is removed a bit every frame - handbrake (SPACE) lowers grip = drifts
	  * steering gets softer at high speed; an AlignOrientation keeps the car upright and on the ground angle
	  * nitro (SHIFT) on cars with nitro: boost, wider FOV, blue exhaust flames, recharges
	  * damage: hard hits cost health, sparks + crash sound + camera shake; low health = smoke, 0 = fire, engine dead
	  * effects: wheels spin and steer (Motor6D), brake lights, headlights (L, and automatic at night),
	    indicators (Z / X / G hazards), horn (H), skid marks and tire smoke while drifting, exhaust puffs
	  * cameras (C): chase, far chase, bumper; Q looks back; FOV and shake grow with speed
	  * drift score and air time for stunts (events "drift" and "air")
	  * engine sound with gears (put your engine IDs in Config.SOUNDS)
]]
local D = {}
local Run = game:GetService("RunService")
local TS = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local C3, V3, CF, A = Color3.fromRGB, Vector3.new, CFrame.new, CFrame.Angles

local MPH = 0.626 -- 1 stud per second is about 0.626 mph
local fx -- folder for effects
local skidPool, skidIndex = {}, 0
local rp = RaycastParams.new()
rp.FilterType = Enum.RaycastFilterType.Exclude

-- state of the car being driven
local st = nil

local function wheels(car)
	local w = {}
	for _, m in ipairs(car.root:GetChildren()) do
		if m:IsA("Motor6D") and m.Name:sub(1, 6) == "Wheel_" then
			local id = m.Name:sub(7)
			w[id] = {motor = m, c0 = m.C0, hub = m.Part1, front = id:sub(1, 1) == "F", left = id:sub(2, 2) == "L"}
		end
	end
	return w
end
local function partsNamed(car, name)
	local out = {}
	for _, p in ipairs(car.model:GetDescendants()) do if p:IsA("BasePart") and p.Name == name then table.insert(out, p) end end
	return out
end
local function setLamp(list, on)
	for _, p in ipairs(list) do
		local onC = p:GetAttribute("OnColor")
		if on then
			if not p:GetAttribute("OffColor") then p:SetAttribute("OffColor", p.Color) end
			p.Material, p.Color = Enum.Material.Neon, onC or p.Color
		else
			local off = p:GetAttribute("OffColor")
			p.Material = Enum.Material.SmoothPlastic
			if off then p.Color = off end
		end
		for _, l in ipairs(p:GetChildren()) do if l:IsA("Light") then l.Enabled = on end end
	end
end
local function emitter(parent, props)
	local e = Instance.new("ParticleEmitter")
	for k, v in pairs(props) do e[k] = v end
	e.Parent = parent
	return e
end

function D.init(S)
	fx = Instance.new("Folder")
	fx.Name = "SB_DriveFX"
	fx.Parent = workspace
	-- skid mark pool
	for i = 1, 260 do
		local p = Instance.new("Part")
		p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
		p.Size, p.Color, p.Material, p.Transparency = V3(0.9, 0.04, 1.6), C3(20, 20, 22), Enum.Material.SmoothPlastic, 1
		p.Parent = fx
		skidPool[i] = p
	end
	S.camMode = S.settings.camera or "Chase"
	S.speed = 0
end

----------------------------------------------------------------------------------------------------
-- ENTER: set up the physics movers and effects for this car
----------------------------------------------------------------------------------------------------
local function setup(S, car)
	local root = car.root
	rp.FilterDescendantsInstances = {car.model, S.lp.Character, workspace:FindFirstChild("SB_Cars"), fx, workspace:FindFirstChild("SB_Rain"), workspace:FindFirstChild("SB_Traffic"), workspace:FindFirstChild("SB_Peds")}
	local att = root:FindFirstChild("SB_Att") or Instance.new("Attachment")
	att.Name, att.Parent = "SB_Att", root
	local align = Instance.new("AlignOrientation")
	align.Name, align.Mode, align.Attachment0, align.Responsiveness, align.MaxTorque = "SB_Align", Enum.OrientationAlignmentMode.OneAttachment, att, 18, 9e7
	align.Parent = root
	local _, yaw = root.CFrame:ToEulerAnglesYXZ()
	local s = {
		car = car, root = root, align = align, att = att, yaw = select(2, root.CFrame:ToEulerAnglesYXZ()), w = wheels(car),
		brake = partsNamed(car, "TailLight"), head = partsNamed(car, "HeadLight"), ind = partsNamed(car, "Indicator"), sirens = {},
		spin = 0, steer = 0, grounded = true, air = 0, airStart = nil, drift = 0, driftScore = 0, lastSpeed = 0, shake = 0,
		gear = 1, rpm = 0, nitroOn = false, lights = car.lights, indL = false, indR = false, hazard = false, horn = false,
		normal = V3(0, 1, 0), bob = 0,
	}
	for _, n in ipairs({"SirenRed", "SirenBlue"}) do for _, p in ipairs(partsNamed(car, n)) do table.insert(s.sirens, p) end end
	-- smoke / flames
	local rear = s.w.RL and s.w.RL.hub
	local rear2 = s.w.RR and s.w.RR.hub
	s.smoke = {}
	for _, h in ipairs({rear, rear2}) do
		if h then
			table.insert(s.smoke, emitter(h, {Texture = "rbxasset://textures/particles/smoke_main.dds", Color = ColorSequence.new(C3(230, 230, 235)), Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 1.5), NumberSequenceKeypoint.new(1, 6)}), Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1)}), Lifetime = NumberRange.new(0.8, 1.4), Rate = 0, Speed = NumberRange.new(1, 3), SpreadAngle = Vector2.new(30, 30), Acceleration = V3(0, 2, 0)}))
		end
	end
	local exhaust = car.model:FindFirstChild("ExhaustTip", true)
	if exhaust then
		s.flame = emitter(exhaust, {Texture = "rbxasset://textures/particles/fire_main.dds", Color = ColorSequence.new(C3(80, 160, 255), C3(255, 120, 255)), Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 0.1)}), Lifetime = NumberRange.new(0.12, 0.2), Rate = 0, Speed = NumberRange.new(14, 20), EmissionDirection = Enum.NormalId.Right, LightEmission = 1, LockedToPart = true})
		s.puff = emitter(exhaust, {Texture = "rbxasset://textures/particles/smoke_main.dds", Color = ColorSequence.new(C3(120, 120, 125)), Size = NumberSequence.new(0.5, 1.6), Transparency = NumberSequence.new(0.7, 1), Lifetime = NumberRange.new(0.6, 1), Rate = 3, Speed = NumberRange.new(1, 2), EmissionDirection = Enum.NormalId.Right})
	end
	local hood = car.model:FindFirstChild("Hood", true) or car.root
	s.damageSmoke = emitter(car.root, {Texture = "rbxasset://textures/particles/smoke_main.dds", Color = ColorSequence.new(C3(60, 60, 65)), Size = NumberSequence.new(1.5, 5), Transparency = NumberSequence.new(0.4, 1), Lifetime = NumberRange.new(1.5, 2.5), Rate = 0, Speed = NumberRange.new(3, 6), Acceleration = V3(0, 4, 0)})
	s.fire = emitter(car.root, {Texture = "rbxasset://textures/particles/fire_main.dds", Color = ColorSequence.new(C3(255, 180, 60), C3(255, 60, 20)), Size = NumberSequence.new(3, 0.5), Lifetime = NumberRange.new(0.5, 0.9), Rate = 0, Speed = NumberRange.new(4, 8), LightEmission = 0.8})
	s.sparks = emitter(car.root, {Texture = "rbxasset://textures/particles/sparkles_main.dds", Color = ColorSequence.new(C3(255, 200, 80)), Size = NumberSequence.new(0.4, 0.05), Lifetime = NumberRange.new(0.2, 0.4), Rate = 0, Speed = NumberRange.new(15, 25), SpreadAngle = Vector2.new(60, 60), LightEmission = 1})
	-- engine sound
	local class = car.cfg.class
	local engName = (class == "Super" or class == "Sports") and "EngineSuper" or (class == "Muscle" and "EngineMuscle" or "EngineSedan")
	s.engine = S.sound(engName, car.root, {Looped = true, Volume = 0.5, RollOffMaxDistance = 120})
	if s.engine then s.engine:Play() end
	s.skid = S.sound("Skid", car.root, {Looped = true, Volume = 0})
	if s.skid then s.skid:Play() end
	s.hornS = S.sound("Horn", car.root, {Looped = true, Volume = 0.7})
	return s
end
local function teardown(S)
	if not st then return end
	if st.align then st.align:Destroy() end
	for _, e in ipairs(st.smoke) do e:Destroy() end
	for _, k in ipairs({"flame", "puff", "damageSmoke", "fire", "sparks", "engine", "skid", "hornS"}) do if st[k] then st[k]:Destroy() end end
	setLamp(st.brake, false)
	setLamp(st.ind, false)
	-- keep headlights as they were (a parked car at night with lights on looks nice)
	for _, w in pairs(st.w) do w.motor.Transform = CFrame.identity end
	st.car.lights = st.lights
	st = nil
	S.cam.CameraType = Enum.CameraType.Custom
	S.cam.FieldOfView = 70
end

----------------------------------------------------------------------------------------------------
-- SKID MARKS
----------------------------------------------------------------------------------------------------
local function skid(pos, dir)
	skidIndex = skidIndex % #skidPool + 1
	local p = skidPool[skidIndex]
	p.CFrame = CF(pos + V3(0, 0.03, 0), pos + V3(0, 0.03, 0) + dir)
	p.Transparency = 0.25
	task.delay(6, function() if p.CFrame.Position == pos + V3(0, 0.03, 0) or true then TS:Create(p, TweenInfo.new(4), {Transparency = 1}):Play() end end)
end

----------------------------------------------------------------------------------------------------
-- PHYSICS STEP
----------------------------------------------------------------------------------------------------
local function step(S, dt)
	local s = st
	local car, root = s.car, s.root
	local cfg = S.carStats and S.carStats(car) or s.car.cfg
	local I = S.input
	if not root.Parent then S.exitCar() return end
	local cf = root.CFrame
	local look = cf.LookVector
	local right = cf.RightVector
	local up = cf.UpVector
	local vel = root.AssemblyLinearVelocity
	-- ground rays from the 4 wheel spots
	local size = root.Size
	local hits, normal, n = 0, V3(0, 0, 0), 0
	local groundY = -math.huge
	for _, o in ipairs({{-1, -1}, {1, -1}, {-1, 1}, {1, 1}}) do
		local origin = (cf * CF(o[1] * size.X * 0.4, 0, o[2] * size.Z * 0.38)).Position
		local r = workspace:Raycast(origin, -up * (size.Y / 2 + 2.6), rp)
		if r then
			hits += 1
			normal += r.Normal
			groundY = math.max(groundY, r.Position.Y)
		end
	end
	local grounded = hits >= 2
	if hits > 0 then normal = (normal / hits).Unit else normal = V3(0, 1, 0) end
	s.normal = s.normal:Lerp(normal, math.min(1, dt * 8))
	-- speeds
	local fwd = vel:Dot(look)
	local side = vel:Dot(right)
	local dead = car.health <= 0
	local top = cfg.speed
	local accel = cfg.accel
	-- nitro
	local nitroOn = false
	if cfg.nitro and I.nitro and car.nitro > 0 and grounded and not dead and I.throttle > 0.1 then
		nitroOn = true
		car.nitro = math.max(0, car.nitro - dt / (cfg.nitroTime or S.C.NITRO_TIME))
		top *= S.C.NITRO_BOOST
		accel *= 1.8
	elseif cfg.nitro then
		car.nitro = math.min(1, car.nitro + dt / (cfg.nitroRecharge or S.C.NITRO_RECHARGE))
	end
	if nitroOn ~= s.nitroOn then
		s.nitroOn = nitroOn
		if s.flame then s.flame.Rate = nitroOn and 120 or 0 end
		if nitroOn then S.play("Nitro", {Volume = 0.7}) end
	end
	if grounded then
		-- throttle / brake / reverse
		local thr = (dead or S.noFuel) and 0 or I.throttle
		local brk = I.brake
		if thr > 0 then
			if fwd < -2 then fwd += cfg.brake * dt * thr else fwd += accel * thr * dt * (1 - math.clamp(fwd / top, 0, 1) ^ 2.2) end
		end
		if brk > 0 then
			if fwd > 2 then fwd -= cfg.brake * brk * dt
			elseif not dead then fwd = math.max(fwd - accel * 0.6 * brk * dt, -top * 0.28) end
		end
		if thr == 0 and brk == 0 then fwd -= math.sign(fwd) * math.min(math.abs(fwd), (6 + math.abs(fwd) * 0.06) * dt) end
		if I.handbrake then fwd -= math.sign(fwd) * math.min(math.abs(fwd), 22 * dt) end
		-- grip: remove sideways slide (less with the handbrake = drift)
		local grip = cfg.grip
		if I.handbrake then grip *= 0.12 end
		if S.Graphics and S.Graphics.weather and S.Graphics.weather.wet > 0.5 then grip *= 0.82 end
		local keep = math.clamp(1 - grip * dt * 9, 0, 1)
		side *= keep
		-- slope gravity is handled by the physics engine; we only set the in-plane velocity
		local planeLook = (look - normal * look:Dot(normal)).Unit
		local planeRight = (right - normal * right:Dot(normal)).Unit
		local vUp = vel:Dot(normal)
		local newVel = planeLook * fwd + planeRight * side + normal * math.min(vUp, 0)
		root.AssemblyLinearVelocity = newVel + V3(0, math.min(vel.Y, 0) * 0, 0)
		-- steering (softer at speed, reversed when going backwards)
		local speedK = math.clamp(math.abs(fwd) / 18, 0, 1) * (1 - math.clamp(math.abs(fwd) / (top * 1.6), 0, 0.55))
		local steerIn = I.steer
		s.steer += (steerIn - s.steer) * math.min(1, dt * 7)
		local turn = s.steer * cfg.turn * 1.9 * speedK * (fwd >= 0 and 1 or -1)
		if I.handbrake then turn *= 1.35 end
		s.yaw -= turn * dt
		-- drift detection
		local slip = math.abs(side)
		if slip > 9 and math.abs(fwd) > 25 then
			s.drift += dt
			s.driftScore += slip * dt * 4
			if s.drift > 0.3 then
				for _, id in ipairs({"RL", "RR"}) do
					local w = s.w[id]
					if w then skid(w.hub.Position - V3(0, w.hub.Size.Y / 2, 0), look) end
				end
			end
		else
			if s.drift > 1.2 and s.driftScore > 40 then S.fire("drift", math.floor(s.driftScore)) end
			s.drift, s.driftScore = 0, 0
		end
		for _, e in ipairs(s.smoke) do e.Rate = (s.drift > 0.3 or (I.handbrake and math.abs(fwd) > 20) or (thr > 0.9 and math.abs(fwd) < 12 and I.brake > 0.5)) and 40 or 0 end
		if s.skid then s.skid.Volume = math.clamp((slip - 8) / 20, 0, 0.6) end
		-- air time ends
		if s.airStart then
			local t = os.clock() - s.airStart
			if t > 1.1 then S.fire("air", t, (root.Position - s.airPos).Magnitude) end
			s.airStart = nil
			s.shake = math.max(s.shake, 0.4)
		end
	else
		-- in the air: keep the yaw, let gravity work
		if not s.airStart then s.airStart, s.airPos = os.clock(), root.Position end
		for _, e in ipairs(s.smoke) do e.Rate = 0 end
		if s.skid then s.skid.Volume = 0 end
	end
	-- orientation: yaw from steering, tilt from the ground normal
	local yawCF = CFrame.Angles(0, s.yaw, 0)
	local f = yawCF.LookVector
	local nrm = grounded and s.normal or V3(0, 1, 0):Lerp(up, 0.6)
	local r = f:Cross(nrm).Unit
	local fwdOnPlane = nrm:Cross(r).Unit
	s.att.CFrame = CFrame.identity
	s.align.CFrame = CFrame.fromMatrix(Vector3.zero, r, nrm, -fwdOnPlane)
	s.align.Responsiveness = grounded and 22 or 6
	-- crash damage: big sudden loss of speed
	local speed = root.AssemblyLinearVelocity.Magnitude
	local lost = s.lastSpeed - speed
	if lost > 22 and os.clock() - (s.lastHit or 0) > 0.4 then
		s.lastHit = os.clock()
		local dmg = (lost - 18) * 6
		car.health = math.max(0, car.health - dmg)
		s.shake = math.max(s.shake, math.clamp(lost / 50, 0.3, 1.4))
		s.sparks:Emit(math.floor(math.clamp(lost, 10, 40)))
		S.play("Crash", {Volume = math.clamp(lost / 60, 0.3, 1), PlaybackSpeed = 0.9 + math.random() * 0.2}, root.Position)
		S.fire("crash", lost, car)
		if car.health <= 0 and not car.deadAt then car.deadAt = os.clock() S.fire("notify", "Wrecked", "The engine is dead. Get out!", C3(255, 80, 80)) end
	end
	s.lastSpeed = speed
	S.speed = math.abs(fwd)
	s.fwd = fwd
	-- damage visuals
	local hp = car.health / S.C.MAX_HEALTH
	s.damageSmoke.Rate = hp < 0.35 and (1 - hp / 0.35) * 18 or 0
	s.fire.Rate = car.health <= 0 and 30 or 0
	-- wheels: spin with speed, front wheels steer
	s.spin = (s.spin + fwd * dt / 1.3) % (math.pi * 2)
	for _, w in pairs(s.w) do
		local steer = w.front and -s.steer * 0.5 or 0
		w.motor.Transform = CFrame.Angles(0, steer, 0) * CFrame.Angles(-s.spin, 0, 0)
	end
	-- gears + engine pitch
	local frac = math.clamp(math.abs(fwd) / cfg.speed, 0, 1.5)
	local gears = 5
	local g = math.clamp(math.floor(frac * gears) + 1, 1, gears)
	if g ~= s.gear then s.gear = g S.play("Gear", {Volume = 0.3}) end
	local inGear = frac * gears - (g - 1)
	s.rpm = 0.25 + inGear * 0.75 * (I.throttle > 0 and 1 or 0.7)
	if s.engine then
		s.engine.PlaybackSpeed = 0.7 + s.rpm * 0.9 + (nitroOn and 0.2 or 0)
		s.engine.Volume = dead and 0 or (0.3 + I.throttle * 0.35)
	end
	S.gear = fwd < -1 and "R" or (math.abs(fwd) < 1 and "N" or tostring(g))
end

----------------------------------------------------------------------------------------------------
-- CAMERA
----------------------------------------------------------------------------------------------------
local camPos, camLook
local function camera(S, dt)
	local s = st
	local root = s.root
	local cam = S.cam
	cam.CameraType = Enum.CameraType.Scriptable
	local cf = root.CFrame
	local vel = root.AssemblyLinearVelocity
	local speed = vel.Magnitude
	local flatLook = V3(cf.LookVector.X, 0, cf.LookVector.Z)
	if flatLook.Magnitude < 0.1 then flatLook = V3(0, 0, -1) end
	flatLook = flatLook.Unit
	-- when moving fast the camera follows the travel direction (nice in drifts)
	local moveDir = V3(vel.X, 0, vel.Z)
	local dir = flatLook
	if moveDir.Magnitude > 20 and moveDir.Unit:Dot(flatLook) > 0.2 then dir = flatLook:Lerp(moveDir.Unit, 0.35).Unit end
	if S.input.lookBack then dir = -dir end
	local mode = S.camMode
	local dist, height = 18, 6.5
	if mode == "Far" then dist, height = 28, 10 end
	local target = root.Position + V3(0, 2.5, 0)
	local want
	if mode == "Bumper" then
		want = cf * CF(0, 1.6, -root.Size.Z / 2 - 0.5)
		camPos = want.Position
		camLook = want.Position + cf.LookVector * 30 * (S.input.lookBack and -1 or 1)
	else
		local behind = target - dir * (dist + math.clamp(speed / 14, 0, 6)) + V3(0, height, 0)
		camPos = camPos and camPos:Lerp(behind, math.min(1, dt * 7)) or behind
		camLook = camLook and camLook:Lerp(target + dir * 6, math.min(1, dt * 10)) or target
		-- keep the camera out of walls
		local rp2 = RaycastParams.new()
		rp2.FilterType = Enum.RaycastFilterType.Exclude
		rp2.FilterDescendantsInstances = {s.car.model, S.lp.Character, workspace:FindFirstChild("SB_Traffic"), workspace:FindFirstChild("SB_Peds"), workspace:FindFirstChild("SB_Rain"), fx}
		local hit = workspace:Raycast(target, camPos - target, rp2)
		if hit then camPos = hit.Position + (target - camPos).Unit * 1 end
	end
	-- shake
	s.shake = math.max(0, s.shake - dt * 1.8)
	local sh = s.shake + math.clamp((speed - 100) / 400, 0, 0.12) + (s.nitroOn and 0.08 or 0)
	local offset = V3(math.noise(os.clock() * 25, 1) * sh, math.noise(os.clock() * 25, 2) * sh, 0)
	cam.CFrame = CF(camPos + offset, camLook)
	local fovTarget = 70 + math.clamp(speed / 6, 0, 22) + (s.nitroOn and 10 or 0)
	cam.FieldOfView += (fovTarget - cam.FieldOfView) * math.min(1, dt * 4)
end

----------------------------------------------------------------------------------------------------
-- LIGHTS / HORN / INDICATORS
----------------------------------------------------------------------------------------------------
local function lights(S, dt)
	local s = st
	local I = S.input
	local braking = (I.brake > 0.1 and (s.fwd or 0) > 1) or I.handbrake
	if braking ~= s.braking then s.braking = braking setLamp(s.brake, braking or s.lights) end
	local night = S.isNight and S.isNight()
	local want = s.manualLights == nil and night or s.manualLights
	if want ~= s.lights then
		s.lights = want
		setLamp(s.head, want)
		setLamp(s.brake, braking or want)
		for _, p in ipairs(s.brake) do if not braking and want then p.Color = C3(170, 20, 25) end end
	end
	-- indicators blink
	local blink = (os.clock() % 0.8) < 0.4
	for _, p in ipairs(s.ind) do
		local l = p.Position
		local isLeft = s.root.CFrame:PointToObjectSpace(l).X < 0
		local on = blink and (s.hazard or (isLeft and s.indL) or (not isLeft and s.indR))
		if on ~= p:GetAttribute("Lit") then p:SetAttribute("Lit", on) setLamp({p}, on) end
	end
	-- sirens (police car)
	if #s.sirens > 0 then
		local phase = (os.clock() * 4) % 2 < 1
		for _, p in ipairs(s.sirens) do setLamp({p}, s.sirenOn and ((p.Name == "SirenRed") == phase)) end
	end
end

----------------------------------------------------------------------------------------------------
-- START
----------------------------------------------------------------------------------------------------
function D.start(S)
	S.on("enterCar", function(car)
		st = setup(S, car)
		camPos, camLook = nil, nil
	end)
	S.on("exitCar", function() teardown(S) end)
	S.on("repaired", function(car) if st and st.car == car then car.deadAt = nil end end)
	S.on("action", function(a)
		if not st or S.mode ~= "play" then return end
		if a == "horn" then
			if st.hornS then
				local stats = S.carStats and S.carStats(st.car)
				st.hornS.PlaybackSpeed = stats and stats.hornPitch or 1
				st.hornS:Play()
				task.delay(0.5, function() if st and st.hornS then st.hornS:Stop() end end)
			end
			S.fire("horn", st.root.Position)
		elseif a == "lights" then
			st.manualLights = not st.lights
		elseif a == "camera" then
			local list = {"Chase", "Far", "Bumper"}
			local i = table.find(list, S.camMode) or 1
			S.camMode = list[i % #list + 1]
			S.settings.camera = S.camMode
			S.fire("notify", "Camera", S.camMode)
		elseif a == "indicatorL" then st.indL, st.indR, st.hazard = not st.indL, false, false
		elseif a == "indicatorR" then st.indR, st.indL, st.hazard = not st.indR, false, false
		elseif a == "hazard" then st.hazard, st.indL, st.indR = not st.hazard, false, false
		end
	end)
	Run.Heartbeat:Connect(function(dt)
		if st then
			local ok, err = pcall(step, S, dt)
			if not ok then warn("[SunsetBay] drive: " .. tostring(err)) end
		end
	end)
	Run.RenderStepped:Connect(function(dt)
		if st and S.mode == "play" then
			camera(S, dt)
			lights(S, dt)
		end
	end)
	-- a car that falls in the sea: get the player out on the nearest road
	task.spawn(function()
		while true do
			task.wait(0.5)
			if st and st.root.Position.Y < S.C.MAP.SEA_Y - 1.5 then
				local car = st.car
				S.exitCar()
				local p = S.L.nearestRoad(car.root.Position)
				S.placeChar(CFrame.new(p + V3(0, 4, 0)))
				S.fire("notify", "Splash!", "Your car went into the sea.", C3(80, 180, 255))
				car.health = 0
			end
		end
	end)
	function S.speedText()
		local units = S.settings.units
		if units == "KMH" then return math.floor(S.speed * MPH * 1.609 + 0.5), "KM/H" end
		return math.floor(S.speed * MPH + 0.5), "MPH"
	end
	function S.driveState() return st end
end
return D
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXSEffects"><Properties><string name="Name">Effects</string><ProtectedString name="Source"><![CDATA[--[[
	Effects | StarterPlayerScripts.SB (ModuleScript)
	Screen and world effects on top of the lighting:
	  * headlight beams: soft see-through cones in front of cars at night (yours, traffic, police)
	  * speed blur: a light blur and dark edges (vignette) when you drive very fast or use nitro
	  * sun glare + lens flare: when the camera looks toward a low sun, rings and a soft glow slide across
	    the screen (hidden when the sun is behind a building)
	  * rain on the screen: drops appear on the "lens" in rain and slide down when you stand still
	  * neon reflections: at night on wet roads the street lamps leave long glowing reflections
	  * damage flash: the screen edges flash red when you crash hard
]]
local Ef = {}
local Run = game:GetService("RunService")
local TS = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local C3, V3, CF, U2, V2, A = Color3.fromRGB, Vector3.new, CFrame.new, UDim2.new, Vector2.new, CFrame.Angles

local gui, vignette, flareHolder, flares, drops, damage
local blur
local beams = {} -- car root -> cone parts

local function frame(par, props)
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	for k, v in pairs(props) do f[k] = v end
	f.Parent = par
	return f
end
function Ef.init(S)
	gui = Instance.new("ScreenGui")
	gui.Name, gui.IgnoreGuiInset, gui.ResetOnSpawn, gui.DisplayOrder = "SB_Effects", true, false, 2
	gui.Parent = S.pg
	-- vignette: four soft gradient edges
	vignette = frame(gui, {Name = "Vignette", Size = U2(1, 0, 1, 0), BackgroundTransparency = 1})
	for i, d in ipairs({{U2(0, 0, 0, 0), U2(1, 0, 0.25, 0), 90}, {U2(0, 0, 0.75, 0), U2(1, 0, 0.25, 0), 270}, {U2(0, 0, 0, 0), U2(0.2, 0, 1, 0), 0}, {U2(0.8, 0, 0, 0), U2(0.2, 0, 1, 0), 180}}) do
		local f = frame(vignette, {Position = d[1], Size = d[2], BackgroundColor3 = C3(0, 0, 0), BackgroundTransparency = 0})
		local g = Instance.new("UIGradient")
		g.Rotation = d[3]
		g.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1)})
		g.Parent = f
	end
	vignette.Visible = false
	-- damage edge flash
	damage = frame(gui, {Name = "Damage", Size = U2(1, 0, 1, 0), BackgroundTransparency = 1})
	for i, d in ipairs({{U2(0, 0, 0, 0), U2(1, 0, 0.3, 0), 90}, {U2(0, 0, 0.7, 0), U2(1, 0, 0.3, 0), 270}, {U2(0, 0, 0, 0), U2(0.25, 0, 1, 0), 0}, {U2(0.75, 0, 0, 0), U2(0.25, 0, 1, 0), 180}}) do
		local f = frame(damage, {Position = d[1], Size = d[2], BackgroundColor3 = C3(255, 0, 0), BackgroundTransparency = 0})
		local g = Instance.new("UIGradient")
		g.Rotation = d[3]
		g.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1)})
		g.Parent = f
	end
	damage.Visible = false
	-- lens flare: a glow + rings along the line from the sun through the screen centre
	flareHolder = frame(gui, {Name = "Flare", Size = U2(1, 0, 1, 0), BackgroundTransparency = 1})
	flares = {}
	local spec = {{0, 260, C3(255, 230, 190), 0.75}, {0.35, 50, C3(255, 120, 200), 0.85}, {0.6, 90, C3(120, 200, 255), 0.88}, {0.85, 30, C3(255, 220, 120), 0.8}, {1.2, 140, C3(255, 160, 220), 0.92}, {1.6, 60, C3(160, 255, 220), 0.9}}
	for i, s in ipairs(spec) do
		local f = frame(flareHolder, {AnchorPoint = V2(0.5, 0.5), Size = U2(0, s[2], 0, s[2]), BackgroundColor3 = s[3], BackgroundTransparency = s[4]})
		local c = Instance.new("UICorner") c.CornerRadius = UDim.new(1, 0) c.Parent = f
		if i == 1 then
			local g = Instance.new("UIGradient")
			g.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.2), NumberSequenceKeypoint.new(1, 1)})
			g.Parent = f
		end
		flares[i] = {f = f, k = s[1], base = s[4]}
	end
	flareHolder.Visible = false
	-- rain drops on the lens
	drops = {}
	for i = 1, 26 do
		local d = frame(gui, {AnchorPoint = V2(0.5, 0.5), Size = U2(0, 10, 0, 14), BackgroundColor3 = C3(220, 235, 255), BackgroundTransparency = 1})
		local c = Instance.new("UICorner") c.CornerRadius = UDim.new(1, 0) c.Parent = d
		local st = Instance.new("UIStroke") st.Color, st.Transparency, st.Thickness = C3(255, 255, 255), 1, 1 st.Parent = d
		drops[i] = {f = d, st = st, life = 0, x = 0, y = 0, v = 0}
	end
	local wf = Instance.new("Folder")
	wf.Name, wf.Parent = "SB_Effects", workspace
	blur = Lighting:FindFirstChild("SB_Blur") or Instance.new("BlurEffect")
	blur.Name, blur.Size = "SB_Blur", 0
	blur.Parent = Lighting
end

----------------------------------------------------------------------------------------------------
-- HEADLIGHT BEAMS
----------------------------------------------------------------------------------------------------
local function makeBeam(root, heads)
	local list = {}
	for _, h in ipairs(heads) do
		local p = Instance.new("Part")
		p.Name, p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = "Beam", true, false, false, false, false
		p.Material, p.Color, p.Transparency = Enum.Material.Neon, C3(255, 245, 210), 0.93
		p.Shape = Enum.PartType.Cylinder
		p.Size = V3(18, 3.2, 3.2)
		p.Parent = workspace:FindFirstChild("SB_Effects") or (function() local f = Instance.new("Folder") f.Name = "SB_Effects" f.Parent = workspace return f end)()
		table.insert(list, {p = p, h = h})
	end
	return list
end
local function updateBeams(S)
	local night = S.isNight and S.isNight()
	local cp = S.cam.CFrame.Position
	local want = {}
	if night then
		local function consider(model, root)
			if root and root.Parent and (root.Position - cp).Magnitude < 180 then
				want[root] = model
			end
		end
		if S.inCar and S.car then consider(S.car.model, S.car.root) end
		for _, c in ipairs(S.traffic or {}) do consider(c.model, c.root) end
	end
	for root, list in pairs(beams) do
		if not want[root] then for _, b in ipairs(list) do b.p:Destroy() end beams[root] = nil end
	end
	for root, model in pairs(want) do
		if not beams[root] then
			local heads = {}
			for _, p in ipairs(model:GetDescendants()) do if p:IsA("BasePart") and p.Name == "HeadLight" then table.insert(heads, p) end end
			beams[root] = makeBeam(root, heads)
		end
		for _, b in ipairs(beams[root]) do
			local h = b.h
			if h.Parent then
				local cf = h.CFrame * CF(0, -0.6, -9.2) * A(math.rad(4), 0, 0)
				b.p.CFrame = cf * A(0, math.rad(90), 0)
			end
		end
	end
end

----------------------------------------------------------------------------------------------------
-- SUN GLARE / FLARE
----------------------------------------------------------------------------------------------------
local rpSun = RaycastParams.new()
rpSun.FilterType = Enum.RaycastFilterType.Exclude
local function updateFlare(S)
	local cam = S.cam
	local okSun, sun = pcall(function() return Lighting:GetSunDirection() end)
	if not okSun then flareHolder.Visible = false return end
	local night = S.isNight and S.isNight()
	if night or sun.Y < -0.05 or S.mode == "menu" then flareHolder.Visible = false return end
	local look = cam.CFrame.LookVector
	local dot = look:Dot(sun)
	if dot < 0.55 then flareHolder.Visible = false return end
	-- blocked by a building?
	rpSun.FilterDescendantsInstances = {S.lp.Character, workspace:FindFirstChild("SB_Cars"), workspace:FindFirstChild("SB_Effects"), workspace:FindFirstChild("SB_Rain")}
	if workspace:Raycast(cam.CFrame.Position, sun * 900, rpSun) then flareHolder.Visible = false return end
	local sp, on = cam:WorldToViewportPoint(cam.CFrame.Position + sun * 1000)
	if not on then flareHolder.Visible = false return end
	flareHolder.Visible = true
	local vs = cam.ViewportSize
	local c = V2(vs.X / 2, vs.Y / 2)
	local s = V2(sp.X, sp.Y)
	local strength = math.clamp((dot - 0.55) / 0.4, 0, 1)
	-- low sun = warmer and stronger
	strength *= math.clamp(1.4 - sun.Y * 1.5, 0.4, 1.3)
	local clouds = S.Graphics and S.Graphics.weather and S.Graphics.weather.clouds or 0.4
	strength *= math.clamp(1.6 - clouds * 1.4, 0, 1)
	for _, f in ipairs(flares) do
		local p = s:Lerp(c * 2 - s, f.k)
		f.f.Position = U2(0, p.X, 0, p.Y)
		f.f.BackgroundTransparency = 1 - (1 - f.base) * strength
	end
end

----------------------------------------------------------------------------------------------------
-- WET ROAD REFLECTIONS: long glowing strips under the street lamps near the camera
----------------------------------------------------------------------------------------------------
local refl = {}
local lamps
local function updateReflections(S)
	local W = S.Graphics and S.Graphics.weather
	local on = W and W.wet > 0.4 and S.isNight and S.isNight()
	if not lamps then
		lamps = {}
		local f = S.city and S.city:FindFirstChild("StreetLights")
		if f then for _, m in ipairs(f:GetChildren()) do local l = m:FindFirstChild("Lamp") if l then table.insert(lamps, l) end end end
	end
	local cp = S.cam.CFrame.Position
	local near = {}
	if on then
		for _, l in ipairs(lamps) do
			if l.Parent and (l.Position - cp).Magnitude < 140 then table.insert(near, l) if #near >= 24 then break end end
		end
	end
	for i = 1, 24 do
		local l = near[i]
		local r = refl[i]
		if l then
			if not r then
				r = Instance.new("Part")
				r.Anchored, r.CanCollide, r.CanQuery, r.CanTouch, r.CastShadow = true, false, false, false, false
				r.Material, r.Size = Enum.Material.Neon, V3(1.2, 0.05, 14)
				r.Parent = workspace:FindFirstChild("SB_Effects")
				refl[i] = r
			end
			-- the reflection stretches toward the camera
			local base = V3(l.Position.X, 0.06, l.Position.Z)
			local toCam = V3(cp.X - base.X, 0, cp.Z - base.Z)
			local dir = toCam.Magnitude > 0.1 and toCam.Unit or V3(0, 0, 1)
			r.CFrame = CF(base + dir * 7, base + dir * 8)
			r.Color = l.Color
			r.Transparency = 0.55 + (1 - W.wet) * 0.4
		elseif r then
			r.Transparency = 1
		end
	end
end

----------------------------------------------------------------------------------------------------
-- START
----------------------------------------------------------------------------------------------------
function Ef.start(S)
	local t = 0
	local beamT = 0
	Run.RenderStepped:Connect(function(dt)
		t += dt
		local playing = S.mode == "play"
		-- speed blur + vignette
		local speed = (S.inCar and S.speed) or 0
		local st = S.driveState and S.driveState()
		local nitro = st and st.nitroOn
		local k = math.clamp((speed - 110) / 80, 0, 1)
		if nitro then k = math.max(k, 0.7) end
		blur.Size += ((playing and k * 4 or 0) - blur.Size) * math.min(1, dt * 4)
		vignette.Visible = playing and (k > 0.05 or S.photo == true)
		for _, f in ipairs(vignette:GetChildren()) do f.BackgroundTransparency = 1 - (S.photo and 0.6 or k * 0.7) end
		-- flare
		updateFlare(S)
		-- beams (a few times a second)
		beamT += dt
		if beamT > 0.05 then beamT = 0 updateBeams(S) updateReflections(S) end
		-- rain drops on the lens
		local rain = S.Graphics and S.Graphics.weather and S.Graphics.weather.rain or 0
		local covered = S.inCar and S.camMode == "Bumper"
		local vs = S.cam.ViewportSize
		for _, d in ipairs(drops) do
			if d.life > 0 then
				d.life -= dt
				-- drops slide down when slow, blow away when fast
				d.y += (speed > 40 and -1 or 1) * d.v * dt * (speed > 40 and 3 or 1)
				d.x += (speed > 40 and (d.x - vs.X / 2) * 0.8 * dt or 0)
				d.f.Position = U2(0, d.x, 0, d.y)
				local a = math.clamp(d.life / 2, 0, 1)
				d.f.BackgroundTransparency = 1 - a * 0.35
				d.st.Transparency = 1 - a * 0.6
			elseif rain > 0.2 and playing and not covered and math.random() < rain * dt * 6 then
				d.life = 1 + math.random() * 2.5
				d.x, d.y = math.random(0, vs.X), math.random(0, vs.Y)
				d.v = 10 + math.random() * 30
				local s = math.random(6, 16)
				d.f.Size = U2(0, s, 0, s * 1.3)
			else
				d.f.BackgroundTransparency, d.st.Transparency = 1, 1
			end
		end
	end)
	-- damage flash on hard crashes
	S.on("crash", function(force)
		if force < 30 then return end
		damage.Visible = true
		for _, f in ipairs(damage:GetChildren()) do
			f.BackgroundTransparency = 0.2
			TS:Create(f, TweenInfo.new(0.6), {BackgroundTransparency = 1}):Play()
		end
		task.delay(0.65, function() damage.Visible = false end)
	end)
end
return Ef
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXSExtras"><Properties><string name="Name">Extras</string><ProtectedString name="Source"><![CDATA[--[[
	Extras | StarterPlayerScripts.SB (ModuleScript)
	  * FUEL: every car has a tank. It drains while you drive (faster with nitro and high speed).
	    Pull up at a SUN GAS pump and press E to fill up ($1 per 2%). On empty the engine dies -
	    push... or call the garage (phone) for a new car.
	  * FERRIS WHEEL: the beach wheel turns slowly; cabins stay level.
]]
local Ex = {}
local Run = game:GetService("RunService")
local C3, V3, CF, A, U2 = Color3.fromRGB, Vector3.new, CFrame.new, CFrame.Angles, UDim2.new

local gui, bar, label
function Ex.init(S)
	S.noFuel = false
	gui = Instance.new("ScreenGui")
	gui.Name, gui.ResetOnSpawn, gui.IgnoreGuiInset, gui.DisplayOrder = "SB_Fuel", false, true, 4
	gui.Enabled = false
	gui.Parent = S.pg
	local back = Instance.new("Frame")
	back.AnchorPoint, back.Position, back.Size = Vector2.new(1, 1), U2(1, -24, 1, -150), U2(0, 150, 0, 8)
	back.BackgroundColor3, back.BackgroundTransparency, back.BorderSizePixel = C3(20, 20, 30), 0.3, 0
	back.Parent = gui
	Instance.new("UICorner", back).CornerRadius = UDim.new(1, 0)
	bar = Instance.new("Frame")
	bar.Size, bar.BackgroundColor3, bar.BorderSizePixel = U2(1, 0, 1, 0), C3(255, 200, 60), 0
	bar.Parent = back
	Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)
	label = Instance.new("TextLabel")
	label.AnchorPoint, label.Position, label.Size, label.BackgroundTransparency = Vector2.new(1, 1), U2(1, 0, 0, -2), U2(1, 0, 0, 16), 1
	label.Font, label.TextSize, label.TextColor3, label.TextXAlignment, label.Text = Enum.Font.GothamBold, 13, C3(255, 255, 255), Enum.TextXAlignment.Right, "FUEL"
	label.TextStrokeTransparency = 0.5
	label.Parent = back
end

function Ex.start(S)
	-- FUEL ------------------------------------------------------------------------------------------
	local pumps = {}
	if S.city then for _, p in ipairs(S.city:GetDescendants()) do if p:IsA("BasePart") and p:GetAttribute("Pump") then table.insert(pumps, p.Position) end end end
	local function nearPump()
		local car = S.car
		if not car or not car.root then return false end
		for _, p in ipairs(pumps) do if ((car.root.Position - p) * V3(1, 0, 1)).Magnitude < 12 then return true end end
		return false
	end
	local warned = false
	Run.Heartbeat:Connect(function(dt)
		local car = S.car
		gui.Enabled = S.inCar and car ~= nil and S.mode == "play"
		if not car then S.noFuel = false return end
		car.fuel = car.fuel or 1
		if S.mode == "play" and not S.mission then -- missions never run out (fair play)
			local sp = S.speed or 0
			car.fuel = math.max(0, car.fuel - dt * (sp / 60) / 420 * ((S.input and S.input.nitro) and 2.5 or 1))
		end
		S.noFuel = car.fuel <= 0
		bar.Size = U2(car.fuel, 0, 1, 0)
		bar.BackgroundColor3 = car.fuel < 0.15 and C3(255, 60, 60) or C3(255, 200, 60)
		label.Text = S.noFuel and "OUT OF FUEL" or ("FUEL " .. math.floor(car.fuel * 100) .. "%")
		if car.fuel < 0.15 and not warned then
			warned = true
			S.fire("notify", "Low fuel", "Find a SUN GAS station (yellow FUEL marker).", C3(255, 200, 60))
		elseif car.fuel > 0.3 then warned = false end
	end)
	task.spawn(function()
		while true do
			task.wait(0.25)
			if S.mode == "play" and S.inCar and S.car and (S.car.fuel or 1) < 0.98 and nearPump() then
				S.fire("help", "Press E to fill up ($" .. math.ceil((1 - S.car.fuel) * 50) .. ").", "fuel")
			else
				S.fire("help", nil, "fuel")
			end
		end
	end)
	S.on("action", function(a)
		if a ~= "use" or not S.inCar or not S.car or not nearPump() then return end
		local car = S.car
		local cost = math.ceil((1 - (car.fuel or 1)) * 50)
		if cost <= 0 then return end
		if S.spend(cost) then
			car.fuel = 1
			S.play("Click")
			S.fire("notify", "SUN GAS", "Tank full. -$" .. cost, C3(255, 200, 60))
		end
	end)

	-- FERRIS WHEEL ----------------------------------------------------------------------------------
	local fw = S.city and S.city:FindFirstChild("FerrisWheel", true)
	local wheel = fw and fw:FindFirstChild("Wheel")
	if wheel and wheel.PrimaryPart then
		local hubCF = wheel.PrimaryPart.CFrame
		local centre = hubCF.Position
		local parts = {}
		for _, p in ipairs(wheel:GetDescendants()) do
			if p:IsA("BasePart") then
				table.insert(parts, {p = p, off = CF(centre):ToObjectSpace(p.CFrame), cab = p:GetAttribute("Cabin")})
			end
		end
		local ang = 0
		local acc = 0
		Run.Heartbeat:Connect(function(dt)
			acc += dt
			if acc < 1 / 20 then return end -- 20 fps is plenty for a slow wheel
			local step = acc
			acc = 0
			if (S.cam.CFrame.Position - centre).Magnitude > 600 then return end
			ang += step * 0.08
			local rot = CF(centre) * A(0, 0, ang)
			for _, it in ipairs(parts) do
				if it.cab then
					-- cabins hang level: rotate the position only
					local pos = (rot * it.off).Position
					it.p.CFrame = CF(pos) * (it.off - it.off.Position)
				else
					it.p.CFrame = rot * it.off
				end
			end
		end)
	end
end
return Ex
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXSGraphics"><Properties><string name="Name">Graphics</string><ProtectedString name="Source"><![CDATA[--[[
	Graphics | StarterPlayerScripts.SB (ModuleScript)
	Everything that makes Sunset Bay look good, all on this computer:
	  * time of day: the in-game clock runs (Config.DAY_LENGTH), the sun moves, and the lighting blends
	    smoothly between the presets in Config.LIGHT (dawn, morning, noon, golden hour, sunset, dusk, night)
	  * post effects: Atmosphere, Bloom, ColorCorrection, SunRays, DepthOfField, Clouds
	  * city lights: at night building windows glow (each building picks its own lit windows), street lamps,
	    neon signs and pool lights switch on - only lights near the camera are enabled to keep FPS high
	  * blinking red beacons on towers and cranes, flickering neon
	  * the sea changes colour with the sky and gets a soft shimmer
	  * weather: clear, cloudy, rain and storms with lightning; roads get shiny when wet
	  * culling: far decorations (palms, benches, umbrellas ...) are taken out of the world and put back when you come near
	Quality (Low / Medium / High) changes distances and amounts.
]]
local G = {}
local Lighting = game:GetService("Lighting")
local Run = game:GetService("RunService")
local TS = game:GetService("TweenService")
local RS = game:GetService("ReplicatedStorage")

local C3, V3, CF = Color3.fromRGB, Vector3.new, CFrame.new
local function lerp(a, b, t) return a + (b - a) * t end
local function lerpC(a, b, t) return a:Lerp(b, t) end

function G.init(S)
	local C = S.C
	G.S = S
	------------------------------------------------------------------------------------------------
	-- EFFECTS (made on this computer so every player has their own)
	------------------------------------------------------------------------------------------------
	local function eff(class, name)
		local e = Lighting:FindFirstChild(name)
		if not e then e = Instance.new(class) e.Name = name e.Parent = Lighting end
		return e
	end
	G.atmo = eff("Atmosphere", "SB_Atmosphere")
	G.bloom = eff("BloomEffect", "SB_Bloom")
	G.cc = eff("ColorCorrectionEffect", "SB_Color")
	G.rays = eff("SunRaysEffect", "SB_SunRays")
	G.dof = eff("DepthOfFieldEffect", "SB_DOF")
	G.sky = Lighting:FindFirstChildOfClass("Sky") or eff("Sky", "SB_Sky")
	G.sky.SunAngularSize, G.sky.MoonAngularSize, G.sky.StarCount = 14, 9, 4000
	G.dof.FarIntensity, G.dof.FocusDistance, G.dof.InFocusRadius, G.dof.NearIntensity, G.dof.Enabled = 0.12, 120, 160, 0, true
	G.bloom.Threshold, G.bloom.Size = 1.2, 28
	G.rays.Spread = 0.6
	local terrain = workspace.Terrain
	G.clouds = terrain:FindFirstChildOfClass("Clouds")
	if not G.clouds then
		G.clouds = Instance.new("Clouds")
		G.clouds.Parent = terrain
	end
	G.clouds.Cover, G.clouds.Density, G.clouds.Color = 0.45, 0.6, C3(255, 255, 255)
	Lighting.GeographicLatitude = 26 -- sunny coast
	Lighting.EnvironmentDiffuseScale, Lighting.EnvironmentSpecularScale = 1, 1
	pcall(function() Lighting.ShadowSoftness = 0.25 end)

	------------------------------------------------------------------------------------------------
	-- CLOCK
	------------------------------------------------------------------------------------------------
	local t0 = os.clock()
	local startTime = S.data.time or C.START_TIME
	local timeScale = 24 / C.DAY_LENGTH -- in-game hours per real second
	local frozen = nil
	function S.getTime()
		if frozen then return frozen end
		return (startTime + (os.clock() - t0) * timeScale) % 24
	end
	function S.setTime(h)
		startTime, t0 = h % 24, os.clock()
	end
	function S.freezeTime(h) frozen = h end
	function S.isNight()
		local h = S.getTime()
		return h >= C.NIGHT_FROM or h < C.NIGHT_TO
	end
	G.weather = {name = "Clear", clouds = 0.45, rain = 0, fog = 0, wet = 0, lightning = false}
	G.target = table.clone(G.weather)
end

----------------------------------------------------------------------------------------------------
-- LIGHTING PRESET BLEND
----------------------------------------------------------------------------------------------------
local function presetAt(C, h)
	local list = C.LIGHT
	local n = #list
	-- sort by time once
	if not list.sorted then table.sort(list, function(a, b) return a.time < b.time end) list.sorted = true end
	local a, b
	for i = 1, n do
		local p, q = list[i], list[i % n + 1]
		local qt = q.time <= p.time and q.time + 24 or q.time
		local hh = h < p.time and h + 24 or h
		if hh >= p.time and hh < qt then a, b = p, q break end
	end
	a = a or list[n]
	b = b or list[1]
	local at, bt = a.time, b.time
	if bt <= at then bt += 24 end
	local hh = h < at and h + 24 or h
	local t = math.clamp((hh - at) / (bt - at), 0, 1)
	t = t * t * (3 - 2 * t) -- smooth
	return a, b, t
end
local function applyLight(S, h)
	local C = S.C
	local a, b, t = presetAt(C, h)
	local W = G.weather
	local gloom = math.clamp(W.clouds - 0.5, 0, 0.5) * 2 -- 0..1 when it's grey
	Lighting.ClockTime = h
	Lighting.Brightness = lerp(a.brightness, b.brightness, t) * (1 - gloom * 0.45)
	Lighting.Ambient = lerpC(a.ambient, b.ambient, t)
	Lighting.OutdoorAmbient = lerpC(lerpC(a.outdoor, b.outdoor, t), C3(120, 125, 135), gloom * 0.6)
	Lighting.ExposureCompensation = lerp(a.exposure, b.exposure, t)
	local cc = G.cc
	cc.TintColor = lerpC(lerpC(a.tint, b.tint, t), C3(220, 225, 235), gloom * 0.7)
	cc.Saturation = lerp(a.sat, b.sat, t) - gloom * 0.15
	cc.Contrast = lerp(a.contrast, b.contrast, t)
	cc.Brightness = 0.02
	local atmo = G.atmo
	atmo.Haze = lerp(a.haze, b.haze, t) + W.fog * 4
	atmo.Density = math.clamp(lerp(a.density, b.density, t) + W.fog * 0.35, 0, 0.8)
	atmo.Color = lerpC(lerpC(a.atmo, b.atmo, t), C3(170, 175, 185), gloom * 0.7)
	atmo.Decay = lerpC(a.decay, b.decay, t)
	atmo.Glare = lerp(1.2, 0.2, gloom) * (S.isNight() and 0.2 or 1)
	atmo.Offset = 0.12
	G.bloom.Intensity = lerp(a.bloom, b.bloom, t)
	G.rays.Intensity = lerp(a.rays, b.rays, t) * (1 - gloom)
	G.clouds.Cover = W.clouds
	G.clouds.Density = 0.5 + gloom * 0.4
	G.clouds.Color = lerpC(lerpC(a.atmo, C3(255, 255, 255), 0.6), C3(110, 115, 125), gloom)
	return a, b, t
end

----------------------------------------------------------------------------------------------------
-- CITY LIGHTS (windows, lamps, neon) + lights near the camera
----------------------------------------------------------------------------------------------------
local nightParts = {} -- {part, dayColor, dayMaterial, nightColor, lit (bool), group}
local lights = {} -- light instances with their world position
local beacons, neons = {}, {}
local nightOnly = {} -- club sky beams etc.: only visible at night
local function collect(S)
	local city = S.city
	if not city then return end
	local R = Random.new(7)
	for _, d in ipairs(city:GetDescendants()) do
		if d:IsA("BasePart") then
			local nc = d:GetAttribute("NightColor")
			if nc then
				-- some windows stay dark so buildings look lived in
				local lit = d.Name ~= "Windows" or R:NextNumber() < 0.72
				table.insert(nightParts, {d, d.Color, d.Material, nc, lit, d.Transparency})
			end
			if d:GetAttribute("Blink") then table.insert(beacons, d) end
			if d:GetAttribute("NightOnly") then table.insert(nightOnly, {d, d.Transparency}) d.Transparency = 1 end
			if d.Name == "Neon" and d.Material == Enum.Material.Neon then table.insert(neons, {d, d.Color}) end
		elseif d:IsA("Light") then
			local p = d.Parent
			if p and p:IsA("BasePart") then table.insert(lights, {d, p.Position}) end
		end
	end
end
local nightOn = nil
local nightIndex = 0
local function updateNight(S, night)
	-- flip a few hundred parts per frame so there is no hitch
	if night ~= nightOn then
		nightOn, nightIndex = night, 0
		for _, e in ipairs(nightOnly) do e[1].Transparency = night and e[2] or 1 end
	end
	if nightIndex > #nightParts then return end
	for _ = 1, 300 do
		nightIndex += 1
		local e = nightParts[nightIndex]
		if not e then break end
		local p = e[1]
		if p.Parent then
			if night and e[5] then
				p.Material = Enum.Material.Neon
				p.Color = e[4]:Lerp(C3(0, 0, 0), p.Name == "Windows" and 0.25 or 0)
				p.Transparency = 0
			else
				p.Material, p.Color, p.Transparency = e[3], e[2], e[6]
			end
		end
	end
end
local lightIndex = 0
local function updateLights(S, night, camPos)
	local q = S.C.QUALITY[S.settings.quality] or S.C.QUALITY.Medium
	local dist = q.lightDist
	for _ = 1, 120 do
		lightIndex += 1
		if lightIndex > #lights then lightIndex = 1 end
		local e = lights[lightIndex]
		if not e then break end
		local l = e[1]
		if l.Parent then
			local on = night and (e[2] - camPos).Magnitude < dist
			-- car lights are handled by the Drive module, skip lights inside cars
			if l.Enabled ~= on and not l:GetAttribute("Car") then l.Enabled = on end
		end
	end
end

----------------------------------------------------------------------------------------------------
-- CULLING: far decorations leave the world
----------------------------------------------------------------------------------------------------
local cullItems = {} -- {model, position, inWorld, parent}
local holder
local function collectCull(S)
	holder = Instance.new("Folder")
	holder.Name = "SB_Culled"
	holder.Parent = RS
	local city = S.city
	if not city then return end
	local function add(m, far)
		local ok, pv = pcall(function() return m:GetPivot().Position end)
		if ok then table.insert(cullItems, {m, pv, true, m.Parent, far}) end
	end
	for _, fname in ipairs({"Decor", "StreetLights", "Beach", "TrafficLights", "Docks"}) do
		local f = city:FindFirstChild(fname)
		if f then for _, m in ipairs(f:GetChildren()) do if m:IsA("Model") or (m:IsA("BasePart") and m.Size.Magnitude < 80) then add(m) end end end
	end
	-- the big areas: trees and small things are decorations, models (terminal, airliners, clubhouse) are buildings
	for _, fname in ipairs({"Airport", "Wetlands", "Golf"}) do
		local f = city:FindFirstChild(fname)
		if f then
			for _, m in ipairs(f:GetChildren()) do
				if m:IsA("Model") then add(m, m.Name ~= "Cypress")
				elseif m:IsA("BasePart") and m.Size.Magnitude < 60 then add(m) end
			end
		end
	end
	-- whole buildings leave the world when far away (the fog hides the edge); palms/benches sooner
	local b = city:FindFirstChild("Buildings")
	if b then
		for _, block in ipairs(b:GetChildren()) do
			for _, m in ipairs(block:GetChildren()) do
				if m.Name == "Palm" or m.Name == "Bench" or m.Name == "Bush" then add(m)
				elseif m:IsA("Model") then add(m, true)
				elseif m:IsA("BasePart") and m.Size.Magnitude < 40 then add(m) end
			end
		end
	end
end
local cullIndex = 0
local function updateCull(S, camPos)
	local q = S.C.QUALITY[S.settings.quality] or S.C.QUALITY.Medium
	local d2 = q.decorDist
	local d3 = q.buildDist or 1300
	for _ = 1, 400 do
		cullIndex += 1
		if cullIndex > #cullItems then cullIndex = 1 end
		local e = cullItems[cullIndex]
		if not e then break end
		local near = (e[2] - camPos).Magnitude < (e[5] and d3 or d2)
		if near ~= e[3] then
			e[3] = near
			e[1].Parent = near and e[4] or holder
		end
	end
end

----------------------------------------------------------------------------------------------------
-- WEATHER: rain drops (pooled parts around the camera), wet roads, lightning
----------------------------------------------------------------------------------------------------
local drops = {}
local rainFolder
local roadParts = {}
local function makeRain(S)
	rainFolder = Instance.new("Folder")
	rainFolder.Name = "SB_Rain"
	rainFolder.Parent = workspace
	for i = 1, 220 do
		local p = Instance.new("Part")
		p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
		p.Size, p.Material, p.Color, p.Transparency = V3(0.08, 2.4, 0.08), Enum.Material.Glass, C3(200, 215, 235), 1
		p.Parent = rainFolder
		drops[i] = {p = p, y = 0, x = 0, z = 0, v = 80 + math.random() * 40}
	end
	if S.city then
		local r = S.city:FindFirstChild("Roads")
		if r then for _, p in ipairs(r:GetChildren()) do if p:IsA("BasePart") then table.insert(roadParts, {p, p.Color}) end end end
	end
end
local wetShown = -1
local function updateRain(S, dt, camPos)
	local W = G.weather
	local q = S.C.QUALITY[S.settings.quality] or S.C.QUALITY.Medium
	local count = math.floor(q.rainDrops * math.clamp(W.rain, 0, 1.6) / 1.6)
	for i, d in ipairs(drops) do
		local p = d.p
		if i <= count then
			d.y -= d.v * dt
			if d.y < camPos.Y - 20 or (V3(d.x, 0, d.z) - V3(camPos.X, 0, camPos.Z)).Magnitude > 70 then
				d.x = camPos.X + math.random(-60, 60)
				d.z = camPos.Z + math.random(-60, 60)
				d.y = camPos.Y + math.random(20, 60)
			end
			p.Transparency = 0.45
			p.CFrame = CF(d.x, d.y, d.z) * CFrame.Angles(0.12, 0, 0.06)
		elseif p.Transparency < 1 then
			p.Transparency = 1
		end
	end
	-- wet roads: darker and shinier (changed slowly, a chunk at a time)
	local wet = math.floor(W.wet * 10 + 0.5) / 10
	if wet ~= wetShown then
		wetShown = wet
		for _, e in ipairs(roadParts) do
			if e[1].Parent then
				e[1].Reflectance = wet * 0.22
				e[1].Color = e[2]:Lerp(C3(25, 27, 32), wet * 0.6)
			end
		end
	end
end
local function lightning(S)
	local old = Lighting.Brightness
	task.spawn(function()
		for k = 1, 2 do
			Lighting.ExposureCompensation = 2.5
			G.cc.Brightness = 0.4
			task.wait(0.06)
			Lighting.ExposureCompensation = 0
			G.cc.Brightness = 0.02
			task.wait(0.09)
		end
		task.wait(0.6 + math.random() * 1.2)
		S.play("Thunder", {Volume = 0.8, PlaybackSpeed = 0.6 + math.random() * 0.2})
	end)
end
local function pickWeather(S)
	local list = S.C.WEATHER
	local total = 0
	for _, w in ipairs(list) do total += w.weight end
	local r = math.random() * total
	for _, w in ipairs(list) do
		r -= w.weight
		if r <= 0 then return w end
	end
	return list[1]
end
function G.setWeather(S, w)
	G.target = {name = w.name, clouds = w.clouds or 0.45, rain = w.rain or 0, fog = w.fog or 0, wet = w.wet and 1 or 0, lightning = w.lightning or false}
	G.weather.name = w.name
	G.weather.lightning = G.target.lightning
	S.fire("weather", w.name)
end

----------------------------------------------------------------------------------------------------
-- SEA
----------------------------------------------------------------------------------------------------
local seaParts = {}
local foamParts = {} -- shoreline foam: rolls in and out with the waves
local function collectSea(S)
	if not S.city then return end
	local w = S.city:FindFirstChild("Water")
	if w then for _, p in ipairs(w:GetChildren()) do if p.Name == "Sea" then table.insert(seaParts, p) end end end
	local beach = S.city:FindFirstChild("Beach")
	if beach then for _, p in ipairs(beach:GetChildren()) do if p.Name == "Foam" then table.insert(foamParts, {p, p.CFrame}) end end end
end
local function updateSea(S, h, t)
	local a, b, k = presetAt(S.C, h)
	local sky = lerpC(a.atmo, b.atmo, k)
	local night = S.isNight()
	local base = night and C3(10, 30, 60) or C3(25, 125, 155)
	local col = base:Lerp(sky, night and 0.15 or 0.28)
	local shimmer = math.sin(t * 0.8) * 0.03
	for _, p in ipairs(seaParts) do
		p.Color = col
		p.Reflectance = (night and 0.45 or 0.25) + shimmer + (G.weather.clouds > 0.8 and -0.1 or 0)
		p.Transparency = 0.22 + shimmer
	end
	-- waves: foam slides up the sand and fades as it runs back
	local wave = (t * 0.18) % 1
	local push = math.sin(wave * math.pi) * 7
	for _, e in ipairs(foamParts) do
		e[1].CFrame = e[2] * CFrame.new(-push, 0, 0)
		e[1].Transparency = 0.25 + wave * 0.6
	end
end

----------------------------------------------------------------------------------------------------
-- START
----------------------------------------------------------------------------------------------------
function G.start(S)
	collect(S)
	collectCull(S)
	collectSea(S)
	makeRain(S)
	-- weather changes every few minutes
	task.spawn(function()
		while true do
			task.wait(math.random(S.C.WEATHER_TIME[1], S.C.WEATHER_TIME[2]))
			if S.mode ~= "menu" then
				local w = pickWeather(S)
				G.setWeather(S, w)
				if w.name ~= "Clear" then S.fire("notify", "Weather", w.name == "Storm" and "A storm is rolling in over the bay." or (w.name == "Rain" and "Rain is coming." or "Clouds are gathering."), C3(150, 190, 255)) end
			end
		end
	end)
	-- beacons blink, neon flickers sometimes
	task.spawn(function()
		local on = true
		while true do
			task.wait(0.8)
			on = not on
			for _, b in ipairs(beacons) do if b.Parent then b.Transparency = on and 0 or 0.85 end end
			if #neons > 0 and math.random() < 0.35 then
				local e = neons[math.random(#neons)]
				local p = e[1]
				if p.Parent then
					task.spawn(function()
						for _ = 1, math.random(2, 5) do
							p.Color = e[2]:Lerp(C3(0, 0, 0), 0.7)
							task.wait(0.05 + math.random() * 0.08)
							p.Color = e[2]
							task.wait(0.04 + math.random() * 0.1)
						end
					end)
				end
			end
		end
	end)
	local nextBolt = os.clock() + 10
	local acc = 0
	Run.RenderStepped:Connect(function(dt)
		local h = S.getTime()
		local camPos = S.cam.CFrame.Position
		-- weather values move slowly toward the target
		local W, T = G.weather, G.target
		local k = math.min(1, dt * 0.15)
		W.clouds = lerp(W.clouds, T.clouds, k)
		W.rain = lerp(W.rain, T.rain, k * 1.5)
		W.fog = lerp(W.fog, T.fog, k)
		W.wet = lerp(W.wet, T.wet, k * (T.wet > W.wet and 0.6 or 0.25))
		applyLight(S, h)
		updateRain(S, dt, camPos)
		if W.lightning and os.clock() > nextBolt then
			nextBolt = os.clock() + 6 + math.random() * 14
			lightning(S)
		end
		acc += dt
		if acc > 0.1 then
			acc = 0
			local night = S.isNight()
			updateNight(S, night)
			updateLights(S, night, camPos)
			updateCull(S, camPos)
			updateSea(S, h, os.clock())
		end
		-- depth of field only in the menu and photo mode
		G.dof.Enabled = S.mode == "menu" or S.photo == true
		Lighting.GlobalShadows = (S.C.QUALITY[S.settings.quality] or {}).shadows ~= false
	end)
end
return G
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXSHUD"><Properties><string name="Name">HUD</string><ProtectedString name="Source"><![CDATA[--[[
	HUD | StarterPlayerScripts.SB (ModuleScript)
	The on-screen interface while playing (StarterGui.SB_HUD):
	  * MINIMAP (bottom left): roads drawn from the road network, the sea, the island, blips for jobs,
	    shops, your car, packages and mission targets; it turns with the camera like in GTA and zooms out at speed
	  * car health and nitro bars under the minimap
	  * cash (top right) with a +/- pop when it changes, wanted stars
	  * speedometer + gear, street / district name and the clock (bottom right)
	  * help box (top left) and the notification feed
	  * objective text, mission timer, big banners (MISSION PASSED, NEW CAR ...), drift / stunt score, radio name
	  * touch buttons on phones / tablets
	Other modules talk to it with events: "notify", "help", "objective", "timer", "big", "score", "blip", "radioName".
]]
local H = {}
local Run = game:GetService("RunService")
local TS = game:GetService("TweenService")
local C3, V3, U2, V2 = Color3.fromRGB, Vector3.new, UDim2.new, Vector2.new

local SCALE = 0.28 -- minimap pixels per stud (zoomed in)
local S_play
-- el.Name finds a HUD element anywhere inside SB_HUD (the blocks are nested in scaled containers)
local el = {}
function H.init(S)
	local g = S.gui.SB_HUD
	H.g = g
	el = setmetatable({}, {__index = function(t, k)
		local v = g:FindFirstChild(k, true)
		if v then rawset(t, k, v) end
		return v
	end})
	H.blips = {} -- id -> {frame, getPos (function), color, icon}
end

----------------------------------------------------------------------------------------------------
-- MINIMAP
----------------------------------------------------------------------------------------------------
local layer, roadsBuilt
local function buildMap(S)
	local g = H.g
	layer = el.Minimap.Layer
	-- the whole map is drawn once in "world pixels"; the layer is moved and turned every frame
	local function rect(name, x, z, w, d, col, rot, zi)
		local f = Instance.new("Frame")
		f.Name, f.AnchorPoint, f.BorderSizePixel = name, V2(0.5, 0.5), 0
		f.Position = U2(0, x * SCALE, 0, z * SCALE)
		f.Size = U2(0, math.max(1, w * SCALE), 0, math.max(1, d * SCALE))
		f.BackgroundColor3, f.Rotation, f.ZIndex = col, rot or 0, zi or 1
		f.Parent = layer
		return f
	end
	H.rect = rect
	local M = S.C.MAP
	-- land, beach, sea, island
	rect("Sea", 1300, 0, 2600, 3600, C3(16, 34, 78), 0, 0)
	rect("Land", (M.X[1] - 130 + M.SEA_X) / 2, (M.Z[1] - 130 + M.DOCKS_Z) / 2, M.SEA_X - M.X[1] + 130, M.DOCKS_Z - M.Z[1] + 130, C3(48, 42, 98), 0, 1)
	rect("Beach", (M.BEACH_X[1] + M.BEACH_X[2]) / 2 + 20, 0, M.BEACH_X[2] - M.BEACH_X[1] + 40, 1700, C3(222, 160, 160), 0, 1)
	local I = M.ISLAND
	local isl = rect("Island", I.cx, I.cz, I.r * 2, I.r * 2, C3(54, 78, 120), 0, 1)
	local cr = Instance.new("UICorner") cr.CornerRadius = UDim.new(1, 0) cr.Parent = isl
	-- districts tint
	for _, d in ipairs(S.C.DISTRICTS) do
		local col = d.kind == "towers" and C3(60, 62, 130) or d.kind == "deco" and C3(110, 54, 120) or d.kind == "houses" and C3(50, 72, 110) or C3(58, 60, 100)
		rect("District", (d.x[1] + d.x[2]) / 2, (d.z[1] + d.z[2]) / 2, d.x[2] - d.x[1], d.z[2] - d.z[1], col, 0, 1)
	end
	-- roads
	local G = S.L.graph()
	for _, r in ipairs(G.roads) do
		local a, b = G.nodes[r.a].pos, G.nodes[r.b].pos
		local mid = (a + b) / 2
		local len = (b - a).Magnitude
		local ang = math.deg(math.atan2(b.Z - a.Z, b.X - a.X))
		rect("Road", mid.X, mid.Z, len + 30, 30, r.kind == "boulevard" and C3(255, 120, 200) or C3(185, 195, 240), ang, 2)
	end
	roadsBuilt = true
end
-- a blip on the minimap: getPos returns a Vector3 (or nil to hide)
local function blipFrame(color, size, shape)
	local f = Instance.new("Frame")
	f.AnchorPoint, f.Size, f.BackgroundColor3, f.BorderSizePixel, f.ZIndex = V2(0.5, 0.5), U2(0, size, 0, size), color, 0, 4
	local cr = Instance.new("UICorner") cr.CornerRadius = UDim.new(shape == "square" and 0.2 or 1, 0) cr.Parent = f
	local st = Instance.new("UIStroke") st.Thickness, st.Color = 1.5, C3(0, 0, 0) st.Parent = f
	f.Parent = el.Minimap
	return f
end
function H.addBlip(id, getPos, color, size, shape, label)
	if H.blips[id] then H.blips[id].f:Destroy() end
	H.blips[id] = {f = blipFrame(color, size or 10, shape), get = getPos, color = color, label = label}
end
function H.removeBlip(id) if H.blips[id] then H.blips[id].f:Destroy() H.blips[id] = nil end end
local zoom = 1
local function updateMap(S, dt)
	if not roadsBuilt then return end
	local ch, hrp = S.char()
	local pos = (S.inCar and S.car and S.car.root.Position) or (hrp and hrp.Position)
	if not pos then return end
	local camLook = S.cam.CFrame.LookVector
	local heading = math.deg(math.atan2(camLook.X, -camLook.Z)) -- 0 = north (-Z)
	local want = S.inCar and (1 - math.clamp(S.speed / 200, 0, 0.45)) or 1.25
	zoom += (want - zoom) * math.min(1, dt * 2)
	local mm = el.Minimap
	-- move the layer so the player is in the centre, rotate around the centre
	local holder = mm.Layer
	holder.Rotation = -heading
	holder.Size = U2(0, 0, 0, 0)
	holder.Position = U2(0.5, 0, 0.5, 0)
	local ang = math.rad(-heading)
	local px, pz = pos.X * SCALE * zoom, pos.Z * SCALE * zoom
	-- offset of the player in rotated space
	local ox = px * math.cos(ang) - pz * math.sin(ang)
	local oz = px * math.sin(ang) + pz * math.cos(ang)
	holder.Position = U2(0.5, -ox, 0.5, -oz)
	local sc = holder:FindFirstChildOfClass("UIScale") or Instance.new("UIScale", holder)
	sc.Scale = zoom
	-- player arrow points the way the player / car faces
	local face = S.inCar and S.car.root.CFrame.LookVector or (hrp and hrp.CFrame.LookVector) or camLook
	local fh = math.deg(math.atan2(face.X, -face.Z))
	mm.Player.Rotation = fh - heading
	-- blips: placed relative to the player, clamped to the minimap edge
	local half = V2(mm.Size.X.Offset / 2 - 9, mm.Size.Y.Offset / 2 - 9) -- design pixels (the block is UIScaled)
	for id, b in pairs(H.blips) do
		local p = b.get()
		if p then
			local dx, dz = (p.X - pos.X) * SCALE * zoom, (p.Z - pos.Z) * SCALE * zoom
			local rx = dx * math.cos(ang) - dz * math.sin(ang)
			local rz = dx * math.sin(ang) + dz * math.cos(ang)
			local edge = math.abs(rx) > half.X or math.abs(rz) > half.Y
			if edge then
				local k = math.min(half.X / math.max(math.abs(rx), 1e-3), half.Y / math.max(math.abs(rz), 1e-3))
				rx, rz = rx * k, rz * k
			end
			b.f.Visible = true
			b.f.Position = U2(0.5, rx, 0.5, rz)
			b.f.BackgroundTransparency = edge and 0.25 or 0
		else
			b.f.Visible = false
		end
	end
end

----------------------------------------------------------------------------------------------------
-- NOTIFICATIONS / HELP / BANNERS
----------------------------------------------------------------------------------------------------
local noteN = 0
local function notify(title, text, color)
	local feed = el.Feed
	local tpl = feed.NoteTemplate
	noteN += 1
	local n = tpl:Clone()
	n.Name = "Note"
	n.Visible = true
	n.LayoutOrder = -noteN
	n.Title.Text = title or "BIG GANG ROB"
	n.Text.Text = text or ""
	if color then n.Accent.BackgroundColor3 = color n.Title.TextColor3 = color end
	n.Parent = feed
	n.Position = U2(-1, 0, 0, 0)
	-- keep at most 4
	local list = {}
	for _, c in ipairs(feed:GetChildren()) do if c.Name == "Note" then table.insert(list, c) end end
	table.sort(list, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
	for i = 5, #list do list[i]:Destroy() end
	task.delay(6, function()
		if n.Parent then
			TS:Create(n, TweenInfo.new(0.4), {BackgroundTransparency = 1}):Play()
			for _, l in ipairs({n.Title, n.Text}) do TS:Create(l, TweenInfo.new(0.4), {TextTransparency = 1}):Play() end
			task.wait(0.45)
			n:Destroy()
		end
	end)
end
local helpOwner
local function help(text, owner)
	local h = el.Help
	if text then
		helpOwner = owner
		h.Visible = true
		h.Text.Text = text
	elseif helpOwner == owner or owner == nil then
		h.Visible = false
	end
end
local bigBusy = false
local function big(title, sub, color, sound)
	local b = el.Big
	task.spawn(function()
		while bigBusy do task.wait(0.2) end
		bigBusy = true
		b.Title.Text = title
		b.Title.TextColor3 = color or C3(255, 200, 60)
		b.Sub.Text = sub or ""
		b.Visible = true
		b.Band.BackgroundTransparency = 1
		b.Title.TextTransparency, b.Sub.TextTransparency = 1, 1
		TS:Create(b.Band, TweenInfo.new(0.4), {BackgroundTransparency = 0.45}):Play()
		TS:Create(b.Title, TweenInfo.new(0.4), {TextTransparency = 0}):Play()
		TS:Create(b.Sub, TweenInfo.new(0.6), {TextTransparency = 0}):Play()
		local sc = b.Title:FindFirstChildOfClass("UIScale") -- the responsive scale; pop = start bigger, settle back
		if sc then
			local rest = sc.Scale
			sc.Scale = rest * 1.3
			TS:Create(sc, TweenInfo.new(0.5, Enum.EasingStyle.Back), {Scale = rest}):Play()
		end
		if sound then S_play(sound) end
		task.wait(3.4)
		TS:Create(b.Band, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
		TS:Create(b.Title, TweenInfo.new(0.5), {TextTransparency = 1}):Play()
		TS:Create(b.Sub, TweenInfo.new(0.5), {TextTransparency = 1}):Play()
		task.wait(0.55)
		b.Visible = false
		bigBusy = false
	end)
end

----------------------------------------------------------------------------------------------------
-- START
----------------------------------------------------------------------------------------------------
function H.start(S)
	local g = H.g
	S_play = function(n) S.play(n) end
	buildMap(S)
	S.on("notify", notify)
	S.on("help", help)
	S.on("big", function(t, sub, col, snd) big(t, sub, col, snd) end)
	S.on("objective", function(text) el.Objective.Text = text or "" end)
	S.on("timer", function(sec) el.Timer.Text = sec and string.format("%d:%02d", math.max(0, sec) // 60, math.max(0, sec) % 60) or "" end)
	S.on("score", function(text, color)
		el.Score.Text = text or ""
		if color then el.Score.TextColor3 = color end
		if text then
			local sc = el.Score:FindFirstChild("Pop") or Instance.new("UIScale", el.Score)
			sc.Name = "Pop"
			sc.Scale = 1.3
			TS:Create(sc, TweenInfo.new(0.3, Enum.EasingStyle.Back), {Scale = 1}):Play()
		end
	end)
	S.on("radioName", function(name, color)
		el.Radio.Text = name or ""
		el.Radio.TextColor3 = color or C3(255, 60, 170)
		el.Radio.TextTransparency = 0
		task.delay(2.5, function() if el.Radio.Text == name then TS:Create(el.Radio, TweenInfo.new(0.6), {TextTransparency = 1}):Play() end end)
	end)
	S.addBlip, S.removeBlip = H.addBlip, H.removeBlip
	S.on("blip", function(id, car) if id == "personal" and car then H.addBlip("personal", function() return car.model.Parent and car ~= S.car and car.root.Position or nil end, C3(255, 80, 160), 12, "square") end end)
	-- fixed blips: special places
	local places = S.city and S.city:FindFirstChild("Places")
	if places then
		local COL = {Dealership = C3(0, 230, 255), Repair = C3(255, 200, 40), Taxi = C3(255, 220, 60), Delivery = C3(120, 255, 120), Race = C3(255, 60, 170), Safehouse = C3(120, 200, 255), BuyCar = C3(0, 230, 255)}
		for _, m in ipairs(places:GetChildren()) do
			local kind = m:GetAttribute("Kind") or m.Name
			if COL[kind] and m.Name ~= "Dealership" then
				local p = m:GetPivot().Position
				H.addBlip("place_" .. m.Name, function() return p end, COL[kind], 11, "square")
			end
		end
	end
	-- cash pop
	local shown = S.cash()
	el.Cash.Text = S.L.money(shown)
	S.on("cash", function(now, delta)
		local from = shown
		shown = now
		el.CashDelta.Text = (delta >= 0 and "+" or "-") .. S.L.money(math.abs(delta)):gsub("%-", "")
		el.CashDelta.TextColor3 = delta >= 0 and C3(120, 255, 140) or C3(255, 90, 90)
		el.CashDelta.TextTransparency = 0
		task.delay(2, function() TS:Create(el.CashDelta, TweenInfo.new(0.5), {TextTransparency = 1}):Play() end)
		-- count up
		task.spawn(function()
			for k = 1, 12 do
				el.Cash.Text = S.L.money(from + (now - from) * k / 12)
				task.wait(0.03)
			end
			el.Cash.Text = S.L.money(now)
		end)
	end)
	-- tapping the minimap opens the full map (mouse and touch)
	el.Minimap.Hit.MouseButton1Click:Connect(function() if S.mode == "play" then S.fire("action", "map") end end)
	-- touch controls
	if S.isTouch then
		local T = el.Touch
		T.Visible = true
		local function hold(btn, key)
			btn.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.Touch then S.touch[key] = true end end)
			btn.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.Touch then S.touch[key] = false end end)
		end
		hold(T.Gas, "gas") hold(T.Brake, "brake") hold(T.Left, "left") hold(T.Right, "right") hold(T.Nitro, "nitro")
		T.Exit.MouseButton1Click:Connect(function() S.fire("action", "use") end)
		-- phone button (top right) and a layout that keeps the speedo / objective clear of the thumbs
		el.PhoneBtn.Visible = true
		el.PhoneBtn.MouseButton1Click:Connect(function() if S.mode == "play" then S.fire("action", "phone") end end)
		el.Speedo.Position = U2(1, -16, 1, -190)
		el.Objective.Position = U2(0.5, 0, 1, -100)
	end
	S.on("play", function() g.Enabled = true end) -- also done in Core.startPlaying (guis are saved disabled)
	-- every frame: speedometer, bars, location, clock, wanted, minimap
	local locT = 0
	Run.RenderStepped:Connect(function(dt)
		if not g.Enabled then return end
		updateMap(S, dt)
		local inCar = S.inCar and S.car
		el.Speedo.Visible = inCar and true or false
		el.Bars.Nitro.Visible = inCar and S.car.cfg.nitro or false
		el.Keys.Visible = inCar and not S.isTouch and (S.data.stats.driven or 0) < 3 or false
		if S.isTouch then for _, n in ipairs({"Gas", "Brake", "Left", "Right", "Nitro"}) do el.Touch[n].Visible = inCar and true or false end el.Touch.Exit.Visible = inCar and true or false end
		if inCar then
			local v, unit = S.speedText()
			el.Speedo.Speed.Text = tostring(v)
			el.Speedo.Unit.Text = unit
			el.Speedo.Gear.Text = S.gear or "N"
			local hp = math.clamp(S.car.health / S.C.MAX_HEALTH, 0, 1)
			el.Bars.Health.Fill.Size = U2(hp, 0, 1, 0)
			el.Bars.Health.Fill.BackgroundColor3 = hp > 0.5 and C3(90, 220, 90) or hp > 0.25 and C3(240, 200, 60) or C3(240, 70, 70)
			el.Bars.Nitro.Fill.Size = U2(S.car.nitro or 0, 0, 1, 0)
		else
			local ch, hrp, hum = S.char()
			if hum then el.Bars.Health.Fill.Size = U2(math.clamp(hum.Health / hum.MaxHealth, 0, 1), 0, 1, 0) el.Bars.Health.Fill.BackgroundColor3 = C3(90, 220, 90) end
		end
		locT += dt
		if locT > 0.5 then
			locT = 0
			local ch, hrp = S.char()
			local p = (inCar and S.car.root.Position) or (hrp and hrp.Position)
			if p then
				local d = S.L.district(p.X, p.Z)
				local street = S.World and S.World.streetName and S.World.streetName(p) or ""
				el.Location.Text = (street ~= "" and (street .. "  |  ") or "") .. d.name
			end
			local h = S.getTime and S.getTime() or 12
			el.Clock.Text = string.format("%02d:%02d", math.floor(h), math.floor((h % 1) * 60))
			local w = S.wanted or 0
			for i = 1, 5 do
				local s = el.Wanted["Star" .. i]
				s.TextColor3 = i <= w and C3(255, 255, 255) or C3(70, 70, 70)
				s.TextTransparency = (i <= w and S.wantedFlash and (os.clock() % 0.5 < 0.25)) and 0.6 or 0
			end
			el.Wanted.Visible = w > 0
		end
	end)
end
return H
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXSInteriors"><Properties><string name="Name">Interiors</string><ProtectedString name="Source"><![CDATA[--[[
	Interiors | StarterPlayerScripts.SB (ModuleScript)
	The beach apartment (your safehouse) has a real inside, built on this computer when you walk in:
	  * an 80s penthouse: white marble floor, pink and teal neon, a sofa, palm plants, a big window with
	    the sea view (sky backdrop), a TV with the Sunset Bay news ticker, a record player
	  * BED: save the game and sleep (until 8:00 or 19:00)
	  * WARDROBE: change outfit
	  * TV: watch the news (lines about your progress and the city)
	  * DOOR: back to Ocean Drive
	The room is placed far below the city so it never shows from outside.
]]
local In = {}
local Run = game:GetService("RunService")
local TS = game:GetService("TweenService")
local C3, V3, CF, A, rad = Color3.fromRGB, Vector3.new, CFrame.new, CFrame.Angles, math.rad

local ROOM = V3(549, -400, 300) -- origin of the room (far below the map)
local room
local inside = false
local spots = {}

local function P(m, name, size, cf, col, mat, o)
	o = o or {}
	local p = Instance.new(o.wedge and "WedgePart" or "Part")
	p.Name, p.Size, p.CFrame, p.Color, p.Material, p.Anchored = name, size, CF(ROOM) * cf, col, mat or Enum.Material.SmoothPlastic, true
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	if o.shape then p.Shape = o.shape end
	if o.tr then p.Transparency = o.tr end
	if o.refl then p.Reflectance = o.refl end
	if o.nocol then p.CanCollide = false end
	p.Parent = m
	return p
end
local function light(p, kind, col, range, bright, face)
	local l = Instance.new(kind)
	l.Color, l.Range, l.Brightness, l.Shadows = col, range, bright, false
	if face then l.Face = face end
	l.Parent = p
end
local function build()
	local m = Instance.new("Model")
	m.Name = "SB_Apartment"
	local W, D, H = 60, 44, 16
	local MARBLE, WALL = C3(245, 242, 238), C3(250, 236, 240)
	P(m, "Floor", V3(W, 1, D), CF(0, -0.5, 0), MARBLE, Enum.Material.Marble, {refl = 0.18})
	P(m, "Ceiling", V3(W, 1, D), CF(0, H + 0.5, 0), C3(255, 255, 255))
	P(m, "WallBack", V3(W, H, 1), CF(0, H / 2, D / 2 + 0.5), WALL)
	P(m, "WallLeft", V3(1, H, D), CF(-W / 2 - 0.5, H / 2, 0), WALL)
	P(m, "WallRight", V3(1, H, D), CF(W / 2 + 0.5, H / 2, 0), WALL)
	-- the big window wall with the sea view behind
	P(m, "WindowFrameTop", V3(W, 2, 1), CF(0, H - 1, -D / 2 - 0.5), C3(255, 255, 255))
	P(m, "WindowFrameLow", V3(W, 3, 1), CF(0, 1.5, -D / 2 - 0.5), C3(255, 255, 255))
	P(m, "Glass", V3(W, H - 5, 0.3), CF(0, H / 2 + 0.5, -D / 2 - 0.5), C3(200, 230, 255), Enum.Material.Glass, {tr = 0.75, refl = 0.2})
	for k = -2, 2 do P(m, "Mullion", V3(0.6, H - 5, 0.8), CF(k * (W / 5), H / 2 + 0.5, -D / 2 - 0.5), C3(255, 255, 255)) end
	-- the view: sunset sky gradient, sea, a few far towers
	local sky = P(m, "Sky", V3(W + 160, 90, 1), CF(0, 30, -D / 2 - 70), C3(255, 140, 120), Enum.Material.SmoothPlastic, {nocol = true})
	local g = Instance.new("SurfaceGui") g.Face, g.LightInfluence, g.Parent = Enum.NormalId.Back, 0, sky
	local f = Instance.new("Frame") f.Size, f.BorderSizePixel = UDim2.fromScale(1, 1), 0 f.Parent = g
	local gr = Instance.new("UIGradient") gr.Rotation = 90 gr.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, C3(80, 40, 140)), ColorSequenceKeypoint.new(0.5, C3(255, 90, 150)), ColorSequenceKeypoint.new(0.8, C3(255, 170, 110)), ColorSequenceKeypoint.new(1, C3(255, 220, 140))}) gr.Parent = f
	P(m, "SeaView", V3(W + 160, 1, 70), CF(0, -6, -D / 2 - 35), C3(40, 110, 160), Enum.Material.Glass, {nocol = true, refl = 0.4})
	P(m, "Sun", V3(14, 14, 1), CF(18, 2, -D / 2 - 68), C3(255, 230, 160), Enum.Material.Neon, {nocol = true, shape = Enum.PartType.Cylinder}).CFrame = CF(ROOM + V3(18, 2, -D / 2 - 68)) * A(0, rad(90), 0)
	-- balcony
	P(m, "Balcony", V3(W, 1, 10), CF(0, -0.5, -D / 2 - 6), MARBLE, Enum.Material.Marble)
	P(m, "Rail", V3(W, 0.4, 0.4), CF(0, 3.6, -D / 2 - 10.8), C3(255, 255, 255), Enum.Material.Metal)
	for k = -14, 14 do P(m, "Bar", V3(0.2, 3.6, 0.2), CF(k * 2, 1.8, -D / 2 - 10.8), C3(255, 255, 255), Enum.Material.Metal) end
	-- neon strips on the ceiling edge
	for _, s in ipairs({{V3(W - 2, 0.3, 0.3), CF(0, H - 0.4, D / 2 - 0.3), C3(255, 60, 170)}, {V3(0.3, 0.3, D - 2), CF(-W / 2 + 0.3, H - 0.4, 0), C3(0, 230, 255)}, {V3(0.3, 0.3, D - 2), CF(W / 2 - 0.3, H - 0.4, 0), C3(0, 230, 255)}}) do
		local n = P(m, "Neon", s[1], s[2], s[3], Enum.Material.Neon, {nocol = true})
		light(n, "PointLight", s[3], 18, 1.2)
	end
	local lamp = P(m, "CeilingLamp", V3(4, 0.4, 4), CF(0, H - 0.2, 0), C3(255, 250, 235), Enum.Material.Neon, {nocol = true})
	light(lamp, "PointLight", C3(255, 235, 210), 40, 1.6)
	-- sofa + coffee table + rug
	P(m, "Rug", V3(22, 0.1, 14), CF(-8, 0.05, -6), C3(0, 200, 220), Enum.Material.Fabric, {nocol = true})
	P(m, "SofaBase", V3(18, 2, 5), CF(-8, 1, 2), C3(255, 255, 255), Enum.Material.Fabric)
	P(m, "SofaBack", V3(18, 3, 1.5), CF(-8, 3.5, 3.75), C3(255, 255, 255), Enum.Material.Fabric)
	for s = -1, 1, 2 do P(m, "SofaArm", V3(1.5, 2.6, 5), CF(-8 + s * 9.75, 1.3, 2), C3(255, 255, 255), Enum.Material.Fabric) end
	for k = -1, 1 do P(m, "Cushion", V3(3, 2, 0.8), CF(-8 + k * 5, 3, 2.6), ({C3(255, 60, 170), C3(0, 220, 255), C3(255, 200, 60)})[k + 2], Enum.Material.Fabric) end
	P(m, "Table", V3(10, 0.4, 5), CF(-8, 1.8, -6), C3(200, 230, 240), Enum.Material.Glass, {tr = 0.4, refl = 0.3})
	for sx = -1, 1, 2 do for sz = -1, 1, 2 do P(m, "TableLeg", V3(0.3, 1.6, 0.3), CF(-8 + sx * 4.6, 0.8, -6 + sz * 2.2), C3(220, 220, 225), Enum.Material.Metal) end end
	-- TV wall unit
	P(m, "TVStand", V3(14, 2.4, 3), CF(-8, 1.2, -16), C3(30, 30, 35))
	local tv = P(m, "TV", V3(12, 7, 0.6), CF(-8, 7, -16.2), C3(10, 10, 12))
	local tvg = Instance.new("SurfaceGui") tvg.Face, tvg.LightInfluence, tvg.Brightness, tvg.SizingMode, tvg.PixelsPerStud, tvg.Parent = Enum.NormalId.Back, 0, 2, Enum.SurfaceGuiSizingMode.PixelsPerStud, 40, tv
	local screen = Instance.new("Frame") screen.Size, screen.BackgroundColor3, screen.BorderSizePixel, screen.Parent = UDim2.fromScale(1, 1), C3(20, 20, 60), 0, tvg
	local sg = Instance.new("UIGradient") sg.Color, sg.Rotation, sg.Parent = ColorSequence.new(C3(60, 20, 90), C3(10, 40, 90)), 45, screen
	local logo = Instance.new("TextLabel") logo.Size, logo.Position, logo.BackgroundTransparency, logo.Font, logo.TextScaled, logo.TextColor3, logo.Text, logo.Parent = UDim2.new(1, 0, 0.5, 0), UDim2.new(0, 0, 0.1, 0), 1, Enum.Font.Bangers, true, C3(255, 90, 180), "BAY NEWS 6", screen
	local ticker = Instance.new("TextLabel") ticker.Name, ticker.Size, ticker.Position, ticker.BackgroundColor3, ticker.Font, ticker.TextScaled, ticker.TextColor3, ticker.Text, ticker.Parent = "Ticker", UDim2.new(1, 0, 0.2, 0), UDim2.new(0, 0, 0.75, 0), C3(255, 60, 170), Enum.Font.GothamBold, true, C3(255, 255, 255), "", screen
	light(tv, "SurfaceLight", C3(120, 140, 255), 14, 1.5, Enum.NormalId.Back)
	-- bed
	P(m, "BedBase", V3(10, 2, 14), CF(20, 1, 12), C3(40, 40, 45))
	P(m, "Mattress", V3(9.6, 1, 13.6), CF(20, 2.5, 12), C3(255, 255, 255), Enum.Material.Fabric)
	P(m, "Blanket", V3(9.8, 0.4, 8), CF(20, 3.2, 9.6), C3(255, 120, 190), Enum.Material.Fabric)
	P(m, "Headboard", V3(10, 6, 1), CF(20, 3, 19.5), C3(0, 200, 220))
	for s = -1, 1, 2 do P(m, "Pillow", V3(3.6, 0.8, 2), CF(20 + s * 2.2, 3.4, 17.4), C3(250, 250, 250), Enum.Material.Fabric) end
	-- wardrobe
	P(m, "Wardrobe", V3(10, 12, 3), CF(26, 6, -4), C3(250, 250, 250))
	P(m, "WardrobeMirror", V3(3.6, 9, 0.1), CF(26 - 2.5, 6.5, -5.55), C3(220, 230, 240), Enum.Material.Glass, {refl = 0.6})
	P(m, "WardrobeHandle", V3(0.3, 2, 0.3), CF(26 + 0.6, 6, -5.65), C3(255, 200, 60), Enum.Material.Metal)
	-- plants + record player
	for _, pp in ipairs({V3(-27, 0, -18), V3(10, 0, -18), V3(-27, 0, 18)}) do
		P(m, "Pot", V3(3, 3, 3), CF(pp + V3(0, 1.5, 0)), C3(250, 250, 250), Enum.Material.SmoothPlastic, {shape = Enum.PartType.Cylinder}).CFrame = CF(ROOM + pp + V3(0, 1.5, 0)) * A(0, 0, rad(90))
		for k = 0, 5 do P(m, "Leaf", V3(1.2, 0.2, 5), CF(pp + V3(0, 4.2, 0)) * A(0, k * 1.05, 0) * A(rad(-35), 0, 0) * CF(0, 0, -2.2), C3(60, 150, 70), Enum.Material.Grass) end
	end
	P(m, "RecordTable", V3(4, 3, 3), CF(6, 1.5, 18), C3(160, 110, 70), Enum.Material.Wood)
	local disc = P(m, "Record", V3(0.15, 2.4, 2.4), CF(6, 3.1, 18) * A(0, 0, rad(90)), C3(20, 20, 20), nil, {shape = Enum.PartType.Cylinder})
	-- door back to the street
	local door = P(m, "Door", V3(6, 10, 0.4), CF(-20, 5, D / 2 + 0.1), C3(255, 255, 255))
	P(m, "DoorNeon", V3(6.6, 0.3, 0.3), CF(-20, 10.4, D / 2 - 0.2), C3(255, 60, 170), Enum.Material.Neon, {nocol = true})
	spots = {
		door = ROOM + V3(-20, 0, D / 2 - 3), bed = ROOM + V3(14, 0, 12), wardrobe = ROOM + V3(26, 0, -9), tv = ROOM + V3(-8, 0, -8), spawn = ROOM + V3(-20, 3, D / 2 - 6),
	}
	m.Parent = workspace
	return m, ticker, disc
end

function In.init(S)
	S.inInterior = false
end

function In.start(S)
	local places = S.city and S.city:FindFirstChild("Places")
	local safe = places and places:FindFirstChild("Safehouse")
	local safePos = safe and safe:GetPivot().Position
	local ticker, disc
	local NEWS = {
		"Weather: golden sunsets all week on the Bay.",
		"Police chief: 'Speeders on Ocean Drive will be stopped.'",
		"Star Island villa sells for a record price.",
		"Neon Customs reports the underglow craze is back.",
		"Hidden packages? Locals say they've seen glowing boxes all over town.",
		"Bay Express is hiring drivers - good pay, fast vans.",
		"Club Malibu reopens this weekend.",
	}
	local function news()
		local list = table.clone(NEWS)
		local found = 0
		for _ in pairs(S.data.packages) do found += 1 end
		table.insert(list, 1, string.format("Local driver has found %d hidden packages so far.", found))
		if (S.data.stats.races or 0) > 0 then table.insert(list, 1, "Street racer wins " .. S.data.stats.races .. " races - police 'concerned'.") end
		return list
	end
	local function goIn()
		if inside then return end
		local fade = S.gui.SB_Menu and S.gui.SB_Menu:FindFirstChild("Fade")
		S.mode = "cutscene"
		if fade then TS:Create(fade, TweenInfo.new(0.5), {BackgroundTransparency = 0}):Play() end
		task.wait(0.55)
		if not room then room, ticker, disc = build() end
		room.Parent = workspace
		S.placeChar(CF(spots.spawn) * A(0, math.pi, 0))
		inside = true
		S.inInterior = true
		task.wait(0.3)
		if fade then TS:Create(fade, TweenInfo.new(0.6), {BackgroundTransparency = 1}):Play() end
		S.mode = "play"
		S.fire("notify", "Safehouse", "Bed: save + sleep · Wardrobe: outfits · TV: news", C3(120, 200, 255))
		-- TV ticker + spinning record
		task.spawn(function()
			local i = 0
			while inside do
				local list = news()
				i = i % #list + 1
				ticker.Text = list[i]
				for k = 1, 50 do
					if not inside then break end
					disc.CFrame = disc.CFrame * A(0.12, 0, 0)
					task.wait(0.1)
				end
			end
		end)
	end
	local function goOut()
		if not inside then return end
		local fade = S.gui.SB_Menu and S.gui.SB_Menu:FindFirstChild("Fade")
		S.mode = "cutscene"
		if fade then TS:Create(fade, TweenInfo.new(0.5), {BackgroundTransparency = 0}):Play() end
		task.wait(0.55)
		inside = false
		S.inInterior = false
		S.placeChar(CF(safePos + V3(0, 3, -6)))
		room.Parent = nil
		task.wait(0.3)
		if fade then TS:Create(fade, TweenInfo.new(0.6), {BackgroundTransparency = 1}):Play() end
		S.mode = "play"
	end
	local function near(p, r) local ch, hrp = S.char() return hrp and ((hrp.Position - p) * V3(1, 0, 1)).Magnitude < (r or 6) end
	task.spawn(function()
		while true do
			task.wait(0.2)
			if S.mode == "play" and not S.inCar then
				local text
				if inside then
					if near(spots.door) then text = "Press E to go outside."
					elseif near(spots.bed, 7) then text = "Press E to save and sleep."
					elseif near(spots.wardrobe) then text = "Press E to change outfit."
					elseif near(spots.tv, 8) then text = "Bay News 6 is on."
					end
				elseif safePos and near(safePos, 8) then
					text = "Press E to go inside your apartment."
				end
				S.fire("help", text, "interior")
			end
		end
	end)
	S.on("action", function(a)
		if a ~= "use" or S.mode ~= "play" or S.inCar then return end
		task.spawn(function()
			if inside then
				if near(spots.door) then goOut()
				elseif near(spots.bed, 7) then S.sleep(safePos + V3(0, 2, -6))
				elseif near(spots.wardrobe) then S.fire("wardrobe") end
			elseif safePos and near(safePos, 8) then
				goIn()
			end
		end)
	end)
	-- the interior is far below the city: keep the city lighting / sky but hide the HUD minimap position glitch
	S.interiorExit = goOut
end
return In
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXSLife"><Properties><string name="Name">Life</string><ProtectedString name="Source"><![CDATA[--[[
	Life | StarterPlayerScripts.SB (ModuleScript)
	Things that make the bay feel alive (all local, very light):
	  * planes cross the sky high up (blinking red / green / white lights at night, contrails by day)
	  * a tour helicopter circles the skyline
	  * speedboats and a yacht cruise on the sea, with white wake behind them
	  * flocks of seagulls circle over the beach (they scatter when you drive close)
	  * a blimp with a neon ad floats over the city at night
	Everything is built in code from simple parts and moved with one CFrame per object.
]]
local Li = {}
local Run = game:GetService("RunService")
local C3, V3, CF, A, rad = Color3.fromRGB, Vector3.new, CFrame.new, CFrame.Angles, math.rad

local folder
local actors = {} -- {model, parts = {part = offsetCF}, update = function(self, t, dt) -> CFrame}
local function part(m, name, size, col, mat, shape)
	local p = Instance.new("Part")
	p.Name, p.Size, p.Color, p.Material = name, size, col, mat or Enum.Material.SmoothPlastic
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	if shape then p.Shape = shape end
	p.Parent = m
	return p
end
local function actor(m, offsets, update)
	local a = {m = m, off = offsets, update = update, cf = CF()}
	m.Parent = folder
	table.insert(actors, a)
	return a
end
local function place(a, cf)
	a.cf = cf
	for p, off in pairs(a.off) do p.CFrame = cf * off end
end

----------------------------------------------------------------------------------------------------
-- MODELS
----------------------------------------------------------------------------------------------------
local function plane()
	local m = Instance.new("Model") m.Name = "Plane"
	local o = {}
	local function add(n, s, cf, col, mat, sh) local p = part(m, n, s, col, mat, sh) o[p] = cf return p end
	add("Body", V3(5, 5, 44), CF(), C3(240, 240, 245))
	add("Nose", V3(5, 4, 4), CF(0, -0.3, -24) * A(rad(-10), 0, 0), C3(240, 240, 245))
	add("Wing", V3(56, 0.6, 9), CF(0, -1, 2), C3(220, 220, 230))
	add("TailWing", V3(18, 0.5, 5), CF(0, 1, 20), C3(220, 220, 230))
	add("Fin", V3(0.6, 9, 6), CF(0, 5.5, 20), C3(255, 60, 170))
	add("Stripe", V3(5.05, 0.8, 40), CF(0, 0.6, 0), C3(0, 200, 255))
	for s = -1, 1, 2 do add("Engine", V3(2.6, 2.6, 6), CF(s * 11, -2.8, 0), C3(200, 200, 210)) end
	local l1 = add("LightL", V3(0.8, 0.8, 0.8), CF(-28, -1, 2), C3(255, 40, 40), Enum.Material.Neon, Enum.PartType.Ball)
	local l2 = add("LightR", V3(0.8, 0.8, 0.8), CF(28, -1, 2), C3(40, 255, 80), Enum.Material.Neon, Enum.PartType.Ball)
	local l3 = add("Strobe", V3(0.8, 0.8, 0.8), CF(0, 9.5, 21), C3(255, 255, 255), Enum.Material.Neon, Enum.PartType.Ball)
	local trail = add("Contrail", V3(1.2, 1.2, 160), CF(0, 0, 105), C3(255, 255, 255), Enum.Material.SmoothPlastic)
	trail.Transparency = 0.6
	return m, o, {l1, l2, l3}, trail
end
local function heli()
	local m = Instance.new("Model") m.Name = "TourHeli"
	local o = {}
	local function add(n, s, cf, col, mat, sh) local p = part(m, n, s, col, mat, sh) o[p] = cf return p end
	add("Body", V3(4.5, 4, 8), CF(), C3(255, 120, 40))
	add("Glass", V3(4, 2.6, 2.4), CF(0, 0.3, -4.2), C3(70, 110, 140), Enum.Material.Glass)
	add("Tail", V3(1, 1, 9), CF(0, 0.6, 8), C3(255, 120, 40))
	add("Fin", V3(0.3, 2.6, 1.8), CF(0, 2, 12.2), C3(250, 250, 250))
	local rotor = add("Rotor", V3(24, 0.2, 1), CF(0, 3, 0), C3(30, 30, 30))
	for s = -1, 1, 2 do add("Skid", V3(0.3, 0.3, 8), CF(s * 2, -3, 0), C3(60, 60, 65)) end
	return m, o, rotor
end
local function boat(big)
	local m = Instance.new("Model") m.Name = big and "Yacht" or "Speedboat"
	local o = {}
	local function add(n, s, cf, col, mat, sh) local p = part(m, n, s, col, mat, sh) o[p] = cf return p end
	if big then
		add("Hull", V3(16, 6, 60), CF(0, 0, 0), C3(250, 250, 250))
		add("Bow", V3(16, 6, 12), CF(0, 0, -36) * A(0, math.pi, 0), C3(250, 250, 250), nil)
		add("Deck1", V3(13, 5, 34), CF(0, 5.5, 4), C3(245, 245, 245))
		add("Glass1", V3(13.2, 2, 30), CF(0, 5.8, 4), C3(40, 60, 80), Enum.Material.Glass)
		add("Deck2", V3(10, 4, 18), CF(0, 10, 8), C3(245, 245, 245))
		add("Stripe", V3(16.1, 1, 60), CF(0, -1, 0), C3(20, 40, 90))
		local l = add("Lights", V3(13.4, 0.4, 32), CF(0, 8.2, 4), C3(255, 220, 160), Enum.Material.Neon)
	else
		add("Hull", V3(6, 2.4, 18), CF(0, 0, 0), C3(250, 250, 250))
		add("Nose", V3(6, 2.4, 6), CF(0, 0, -12) * A(0, math.pi, 0), C3(250, 250, 250))
		add("Stripe", V3(6.05, 0.6, 18), CF(0, 0.3, 0), ({C3(255, 60, 170), C3(0, 200, 255), C3(255, 160, 40)})[math.random(3)])
		add("Screen", V3(5, 1.6, 0.3), CF(0, 1.8, -3) * A(rad(-30), 0, 0), C3(60, 90, 120), Enum.Material.Glass)
		add("Seat", V3(4, 1, 3), CF(0, 1.7, 1), C3(240, 240, 240))
		add("Motor", V3(1.6, 2.4, 1.6), CF(0, 0.4, 9.6), C3(30, 30, 35))
	end
	local wake = add("Wake", V3(big and 18 or 7, 0.2, big and 50 or 26), CF(0, -2.8 + (big and -0.2 or 1.6), big and 50 or 24), C3(255, 255, 255))
	wake.Transparency = 0.45
	return m, o, wake
end
local function bird()
	local m = Instance.new("Model") m.Name = "Gull"
	local o = {}
	local function add(n, s, cf, col) local p = part(m, n, s, col) o[p] = cf return p end
	add("Body", V3(0.5, 0.5, 1.4), CF(), C3(245, 245, 245))
	local wl = add("WingL", V3(1.8, 0.1, 0.6), CF(-1.1, 0, 0), C3(230, 230, 235))
	local wr = add("WingR", V3(1.8, 0.1, 0.6), CF(1.1, 0, 0), C3(230, 230, 235))
	add("Beak", V3(0.15, 0.15, 0.4), CF(0, 0, -0.85), C3(255, 190, 40))
	return m, o, wl, wr
end
local function blimp()
	local m = Instance.new("Model") m.Name = "Blimp"
	local o = {}
	local function add(n, s, cf, col, mat, sh) local p = part(m, n, s, col, mat, sh) o[p] = cf return p end
	add("Body", V3(70, 22, 22), CF() * A(0, rad(90), 0), C3(230, 230, 235), nil, Enum.PartType.Cylinder)
	for k = -1, 1, 2 do add("Cap", V3(22, 22, 22), CF(0, 0, k * 35), C3(230, 230, 235), nil, Enum.PartType.Ball) end
	add("Cabin", V3(6, 4, 14), CF(0, -12.5, 0), C3(60, 60, 70))
	local ad = add("Ad", V3(0.4, 10, 40), CF(11.2, 0, 0), C3(20, 20, 25))
	local g = Instance.new("SurfaceGui") g.Face, g.LightInfluence, g.Brightness, g.Parent = Enum.NormalId.Right, 0, 3, ad
	local t = Instance.new("TextLabel") t.Size, t.BackgroundTransparency, t.TextScaled, t.Font, t.TextColor3, t.Text, t.Parent = UDim2.fromScale(1, 1), 1, true, Enum.Font.Michroma, C3(255, 60, 170), "VISIT SUNSET BAY", g
	for k = -1, 1, 2 do add("Fin", V3(0.5, 10, 8), CF(0, k * 8, 40), C3(255, 60, 170)) end
	return m, o
end

function Li.init(S)
	folder = Instance.new("Folder")
	folder.Name = "SB_Life"
	folder.Parent = workspace
end

-- airport runway (centre line x, from the north end to the south end; ground y)
-- north is the -Z end, so landings come in from -Z and take-offs climb out towards -Z
local RUNWAY_X, RUNWAY_NORTH, RUNWAY_SOUTH = -2893, -2463, -1377
local RUNWAY_Y = 0.3 + 4.5 -- plane origin height when its wheels touch the runway

-- position and heading on a polyline of {p = Vector3, t = seconds} points (nil when finished)
local function alongPath(pts, s)
	for i = 2, #pts do
		if s <= pts[i].t then
			local a, b = pts[i - 1], pts[i]
			local k = (s - a.t) / (b.t - a.t)
			return a.p:Lerp(b.p, k), (b.p - a.p).Unit
		end
	end
	return nil
end

function Li.start(S)
	local M = S.C.MAP
	local night = function() return S.isNight and S.isNight() end
	-- navigation lights: on at night, dim by day; the strobe blinks at night
	local function setLights(lights, trail, t)
		local on = night()
		lights[1].Transparency = on and 0 or 0.5
		lights[2].Transparency = on and 0 or 0.5
		lights[3].Transparency = (on and t % 1.2 < 0.1) and 0 or 1
		trail.Transparency = on and 1 or 0.6
	end
	-- PLANES: a new one every 40-70 s, crossing the whole sky
	task.spawn(function()
		while true do
			task.wait(math.random(40, 70))
			if S.mode ~= "menu" then
				local m, o, lights, trail = plane()
				local z = math.random(-900, 600)
				local from, to = V3(-2600, 520, z), V3(3200, 560, z + math.random(-500, 500))
				if math.random() < 0.5 then from, to = to, from end
				local t0 = os.clock()
				local dur = 75
				actor(m, o, function(a, t)
					local k = (t - t0) / dur
					if k > 1 then return false end
					local p = from:Lerp(to, k)
					setLights(lights, trail, t)
					return CF(p, p + (to - from).Unit)
				end)
			end
		end
	end)
	-- AIRPORT: one plane at a time lands or takes off on the runway (low, no contrail)
	local function airportFlight(landing)
		local m, o, lights, trail = plane()
		local x = RUNWAY_X
		local pts
		if landing then
			-- glide in from the north, touch down near the north end, roll south and leave
			pts = {
				{p = V3(x, 150, RUNWAY_NORTH - 1200), t = 0},
				{p = V3(x, RUNWAY_Y, RUNWAY_NORTH + 120), t = 18},
				{p = V3(x, RUNWAY_Y, RUNWAY_SOUTH + 150), t = 34},
			}
		else
			-- roll north along the runway from the south end, lift off and climb out to the north
			pts = {
				{p = V3(x, RUNWAY_Y, RUNWAY_SOUTH - 40), t = 0},
				{p = V3(x, RUNWAY_Y, RUNWAY_NORTH + 200), t = 17},
				{p = V3(x, 140, RUNWAY_NORTH - 500), t = 25},
				{p = V3(x, 420, RUNWAY_NORTH - 1400), t = 33},
			}
		end
		local t0 = os.clock()
		actor(m, o, function(a, t)
			local p, dir = alongPath(pts, t - t0)
			if not p then return false end
			setLights(lights, trail, t)
			trail.Transparency = 1 -- too low for a contrail
			return CF(p, p + dir)
		end)
	end
	task.spawn(function()
		while true do
			task.wait(math.random(90, 150))
			if S.mode ~= "menu" then airportFlight(math.random() < 0.5) end
		end
	end)
	-- TOUR HELICOPTER around downtown
	do
		local m, o, rotor = heli()
		local center = V3(-120, 0, -480)
		actor(m, o, function(a, t)
			local ang = t * 0.12
			local p = center + V3(math.cos(ang) * 420, 190 + math.sin(t * 0.3) * 15, math.sin(ang) * 420)
			local nxt = center + V3(math.cos(ang + 0.05) * 420, 190, math.sin(ang + 0.05) * 420)
			o[rotor] = CF(0, 3, 0) * A(0, t * 22, 0)
			return CF(p, nxt) * A(rad(-6), 0, rad(-12))
		end)
	end
	-- BOATS
	for i = 1, 4 do
		local big = i == 1
		local m, o, wake = boat(big)
		local lane = M.SEA_X + 120 + i * 110
		local speed = big and 0.004 or (0.012 + i * 0.003)
		local ph = math.random() * 6
		actor(m, o, function(a, t)
			local k = (math.sin(t * speed * 2 + ph) + 1) / 2
			local z = -1000 + k * 2000
			local dir = math.cos(t * speed * 2 + ph) >= 0 and 1 or -1
			local p = V3(lane + math.sin(t * 0.2 + i) * 30, M.SEA_Y + (big and 2.6 or 1.0) + math.sin(t * 1.5 + i) * 0.25, z)
			return CF(p, p + V3(0, 0, dir)) * A(math.sin(t * 1.3 + i) * 0.03, 0, math.sin(t + i) * 0.04)
		end)
	end
	-- SEAGULLS over the beach
	for f = 1, 3 do
		local center = V3(M.BEACH_X[1] + 60 + f * 30, 0, -500 + f * 350)
		for b = 1, 7 do
			local m, o, wl, wr = bird()
			local r = 18 + math.random() * 22
			local h = 26 + math.random() * 18
			local ph = math.random() * 6
			local sp = 0.5 + math.random() * 0.3
			local scatter = 0
			actor(m, o, function(a, t)
				local ch, hrp = S.char()
				local pp = (S.inCar and S.car and S.car.root.Position) or (hrp and hrp.Position)
				if pp and (pp - center).Magnitude < 50 then scatter = math.min(1, scatter + 0.02) else scatter = math.max(0, scatter - 0.004) end
				local ang = t * sp + ph
				local rr = r + scatter * 60
				local p = center + V3(math.cos(ang) * rr, h + scatter * 30 + math.sin(t * 2 + ph) * 2, math.sin(ang) * rr)
				local nxt = center + V3(math.cos(ang + 0.1) * rr, h, math.sin(ang + 0.1) * rr)
				local flap = math.sin(t * 9 + ph) * 0.5
				o[wl] = CF(-0.2, 0, 0) * A(0, 0, flap) * CF(-0.9, 0, 0)
				o[wr] = CF(0.2, 0, 0) * A(0, 0, -flap) * CF(0.9, 0, 0)
				return CF(p, nxt) * A(0, 0, rad(-20))
			end)
		end
	end
	-- BLIMP (night only, slow loop over the city)
	do
		local m, o = blimp()
		actor(m, o, function(a, t)
			local on = night()
			if (m.Parent ~= nil) ~= on then m.Parent = on and folder or nil end
			if not on then return a.cf end
			local ang = t * 0.015
			local p = V3(-150 + math.cos(ang) * 500, 260, -200 + math.sin(ang) * 500)
			local nxt = V3(-150 + math.cos(ang + 0.02) * 500, 260, -200 + math.sin(ang + 0.02) * 500)
			return CF(p, nxt) * A(0, rad(90), 0)
		end)
	end
	-- move everything (actors far away update less often)
	local frame = 0
	Run.RenderStepped:Connect(function(dt)
		if S.mode == "menu" and frame % 2 == 1 then frame += 1 return end
		frame += 1
		local t = os.clock()
		local cp = S.cam.CFrame.Position
		for i = #actors, 1, -1 do
			local a = actors[i]
			local far = (a.cf.Position - cp).Magnitude > 700
			if not far or (frame + i) % 6 == 0 then
				local cf = a.update(a, t, dt)
				if cf == false then
					a.m:Destroy()
					table.remove(actors, i)
				elseif cf then
					place(a, cf)
				end
			end
		end
	end)
end
return Li
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXSMenu"><Properties><string name="Name">Menu</string><ProtectedString name="Source"><![CDATA[--[[
	Menu | StarterPlayerScripts.SB (ModuleScript)
	The first thing you see (GTA style, Miami 80s look):
	  1) LOADING: the BIG GANG ROB logo over slow camera flights through the city (beach at sunset,
	     neon hotels, downtown towers, the causeway), tips at the bottom, a loading bar
	  2) TITLE MENU: Story Mode / Free Roam / Online (coming soon) / Settings / Credits,
	     mouse, keyboard (W/S/Enter) or gamepad; the flights keep playing behind it
	  3) start: fade to black, you appear at your safehouse (or where you saved), the HUD comes in
]]
local Menu = {}
local Run = game:GetService("RunService")
local TS = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")
local CP = game:GetService("ContentProvider")
local C3, V3, CF, U2 = Color3.fromRGB, Vector3.new, CFrame.new, UDim2.new

local TIPS = {
	"Hold SHIFT for nitro. It refills on its own.",
	"Handbrake in a turn to drift. Long drifts pay cash.",
	"Your phone has Garage, Jobs, Map and more.",
	"Green glow = hidden package. Find them all.",
	"Fly off the white ramps for stunt bonuses.",
	"Sleep at your safehouse to save and skip the night.",
	"Neon looks best after sunset. Cruise Ocean Drive.",
	"Taxi and delivery runs pay steady cash.",
	"Change the car camera with C. Look back with Q.",
	"Fresh paint at Paint & Fix cools the heat.",
}
-- camera flights: from -> to (world positions), looking at a point, seconds
local SHOTS = {
	{from = V3(760, 18, -500), to = V3(760, 22, 300), look = V3(560, 10, -100), t = 9}, -- along the beach
	{from = V3(400, 12, -760), to = V3(430, 14, -360), look = V3(470, 30, -560), t = 8}, -- neon hotels
	{from = V3(-200, 260, -900), to = V3(40, 220, -500), look = V3(-120, 120, -480), t = 9}, -- over downtown
	{from = V3(640, 30, -170), to = V3(1000, 34, -80), look = V3(1180, 10, -120), t = 9}, -- the causeway
	{from = V3(900, 120, 300), to = V3(700, 90, -200), look = V3(300, 40, -200), t = 9}, -- sea view of the skyline
}

function Menu.init(S)
	Menu.g = S.gui.SB_Menu
end

local flying = true
local function flights(S)
	local cam = S.cam
	cam.CameraType = Enum.CameraType.Scriptable
	local fade = Menu.g.Fade
	task.spawn(function()
		local i = 0
		while flying do
			i = i % #SHOTS + 1
			local s = SHOTS[i]
			local t0 = os.clock()
			TS:Create(fade, TweenInfo.new(0.8), {BackgroundTransparency = 1}):Play()
			while flying and os.clock() - t0 < s.t do
				local k = (os.clock() - t0) / s.t
				local e = k * k * (3 - 2 * k)
				local p = s.from:Lerp(s.to, e)
				cam.CFrame = CF(p, s.look + V3(math.sin(os.clock() * 0.3) * 4, 0, 0))
				cam.FieldOfView = 55
				Run.RenderStepped:Wait()
			end
			if flying then
				TS:Create(fade, TweenInfo.new(0.6), {BackgroundTransparency = 0}):Play()
				task.wait(0.6)
			end
		end
	end)
end

function Menu.start(S)
	local g = Menu.g
	if not g then S.startPlaying() return end
	S.mode = "menu"
	S.gui.SB_HUD.Enabled = false
	g.Enabled = true
	S.freezeTime(18.6) -- the menu always shows the golden sunset
	g.Fade.BackgroundTransparency = 0
	flights(S)
	-- LOADING
	local L = g.Loading
	L.Visible, g.Title.Visible = true, false
	local logo = L.Center.Logo
	local fill = L.Bottom.Bar.Fill
	local tipI = math.random(#TIPS)
	L.Bottom.Tip.Text = "TIP  " .. TIPS[tipI]
	local tipLoop = true
	task.spawn(function()
		while tipLoop do
			task.wait(5)
			tipI = tipI % #TIPS + 1
			L.Bottom.Tip.Text = "TIP  " .. TIPS[tipI]
		end
	end)
	-- neon shimmer: the logo gradient slides back and forth
	local grad = logo:FindFirstChildOfClass("UIGradient")
	task.spawn(function()
		while L.Visible and grad do
			pcall(function() TS:Create(grad, TweenInfo.new(2.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Offset = Vector2.new(0.25, 0)}):Play() end)
			task.wait(2.2)
			pcall(function() TS:Create(grad, TweenInfo.new(2.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Offset = Vector2.new(-0.25, 0)}):Play() end)
			task.wait(2.2)
		end
	end)
	-- real loading: city parts and the car models
	local total, done = 1, 0
	local list = {}
	if S.city then for _, f in ipairs(S.city:GetChildren()) do table.insert(list, f) end end
	table.insert(list, S.SB:WaitForChild("Cars"))
	total = #list
	for _, f in ipairs(list) do
		pcall(function() CP:PreloadAsync({f}) end)
		done += 1
		TS:Create(fill, TweenInfo.new(0.3), {Size = U2(done / total, 0, 1, 0)}):Play()
		L.Bottom.Status.Text = "LOADING  " .. math.floor(done / total * 100) .. "%"
	end
	task.wait(1.2)
	L.Bottom.Status.Text = S.isTouch and "TAP TO START" or "PRESS ANY KEY"
	-- wait for a key / click (or 4 s)
	local pressed = false
	local con = UIS.InputBegan:Connect(function(i) if i.UserInputType ~= Enum.UserInputType.MouseMovement then pressed = true end end)
	local t0 = os.clock()
	while not pressed and os.clock() - t0 < 4 do task.wait(0.05) end
	con:Disconnect()
	tipLoop = false
	TS:Create(logo, TweenInfo.new(0.4), {TextTransparency = 1}):Play()
	task.wait(0.4)
	L.Visible = false
	-- TITLE MENU
	local T = g.Title
	T.Visible = true
	local opts = {"Story", "FreeRoam", "Online", "Settings", "Credits"}
	local INFO = {Story = "Follow Rico and make a name.", FreeRoam = "No rules. Drive, earn, explore.", Online = "Play with friends. Coming soon.", Settings = "Graphics, sound, camera.", Credits = "Who made this."}
	local OPT = T.Menu.Options
	-- short pop-up message
	local toastId = 0
	local function toast(text)
		toastId += 1
		local my = toastId
		g.Toast.Text.Text = text
		g.Toast.Visible = true
		task.delay(2, function() if toastId == my then g.Toast.Visible = false end end)
	end
	local sel = 1
	local function highlight()
		for i, n in ipairs(opts) do
			local b = OPT:FindFirstChild(n)
			if b then
				local locked = n == "Online"
				b.Bar.Visible = i == sel
				b.BackgroundTransparency = locked and 0.5 or (i == sel and 0.05 or 0.3)
				b.TextColor3 = locked and C3(150, 140, 175) or (i == sel and C3(255, 255, 255) or C3(215, 205, 240))
			end
		end
		T.Info.Text.Text = INFO[opts[sel]] or ""
	end
	highlight()
	local started = false
	local function startGame(story)
		if started then return end
		started = true
		S.play("Click")
		TS:Create(g.Fade, TweenInfo.new(0.8), {BackgroundTransparency = 0}):Play()
		task.wait(0.9)
		flying = false
		T.Visible = false
		g.Shade.Visible = false
		S.freezeTime(nil)
		S.storyMode = story
		S.cam.CameraType = Enum.CameraType.Custom
		S.cam.FieldOfView = 70
		S.startPlaying()
		task.wait(0.4)
		TS:Create(g.Fade, TweenInfo.new(1.2), {BackgroundTransparency = 1}):Play()
		task.delay(1.3, function() g.Enabled = true end)
		S.fire("notify", "BIG GANG ROB", S.storyMode and (S.isTouch and "Tap the phone icon > Jobs > Story." or "TAB > Jobs > Story to begin.") or (S.isTouch and "The city is yours. Tap the phone icon." or "The city is yours. TAB for your phone."), C3(255, 46, 151))
		if S.storyMode and S.fire then S.fire("storyStart") end
	end
	local function choose(n)
		if n == "Story" then startGame(true)
		elseif n == "FreeRoam" then startGame(false)
		elseif n == "Online" then toast("Online is coming soon.") S.play("Click")
		elseif n == "Settings" then g.Settings.Visible = true Menu.refreshSettings(S)
		elseif n == "Credits" then g.Credits.Visible = true end
	end
	for i, n in ipairs(opts) do
		local b = OPT:FindFirstChild(n)
		if b then
			b.MouseEnter:Connect(function() sel = i highlight() end)
			b.MouseButton1Click:Connect(function() choose(n) end)
		end
	end
	UIS.InputBegan:Connect(function(i)
		if started or not T.Visible or g.Settings.Visible or g.Credits.Visible then return end
		local k = i.KeyCode
		if k == Enum.KeyCode.W or k == Enum.KeyCode.Up or k == Enum.KeyCode.DPadUp then sel = (sel - 2) % #opts + 1 highlight() S.play("Click")
		elseif k == Enum.KeyCode.S or k == Enum.KeyCode.Down or k == Enum.KeyCode.DPadDown then sel = sel % #opts + 1 highlight() S.play("Click")
		elseif k == Enum.KeyCode.Return or k == Enum.KeyCode.ButtonA then choose(opts[sel]) end
	end)
	g.Settings.Close.MouseButton1Click:Connect(function() g.Settings.Visible = false S.markDirty() end)
	g.Credits.Close.MouseButton1Click:Connect(function() g.Credits.Visible = false end)
	-- settings rows cycle values
	local SETS = {
		Quality = {key = "quality", values = {"Low", "Medium", "High"}},
		Music = {key = "music", values = {0, 0.3, 0.5, 0.7, 1}},
		Sfx = {key = "sfx", values = {0, 0.3, 0.5, 0.8, 1}},
		Camera = {key = "camera", values = {"Chase", "Far", "Bumper"}},
		Units = {key = "units", values = {"MPH", "KMH"}},
	}
	function Menu.refreshSettings()
		for row, s in pairs(SETS) do
			local r = g.Settings.List:FindFirstChild(row)
			if r then
				local v = S.settings[s.key]
				r.Value.Text = "< " .. (type(v) == "number" and (math.floor(v * 100) .. "%") or tostring(v)) .. " >"
			end
		end
	end
	for row, s in pairs(SETS) do
		local r = g.Settings.List:FindFirstChild(row)
		if r then
			r.Value.MouseButton1Click:Connect(function()
				local i = table.find(s.values, S.settings[s.key]) or 1
				S.settings[s.key] = s.values[i % #s.values + 1]
				if s.key == "camera" then S.camMode = S.settings.camera end
				S.applyVolumes()
				Menu.refreshSettings()
				S.play("Click")
			end)
		end
	end
	TS:Create(g.Fade, TweenInfo.new(0.6), {BackgroundTransparency = 1}):Play()
end
return Menu
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXSMissions"><Properties><string name="Name">Missions</string><ProtectedString name="Source"><![CDATA[--[[
	Missions | StarterPlayerScripts.SB (ModuleScript)
	Jobs and the story (all single player):
	  * TAXI: drive a Cabbie, pick up fares on the sidewalk, take them across town before the meter runs out
	  * DELIVERY: drive the Bay Express van to a list of drops
	  * STREET RACES: 3 routes with checkpoints, 3 rival drivers, countdown, live position, prize money
	  * STORY: short missions with phone calls from the people of Sunset Bay (saved progress)
	  * PROPERTIES: places you buy pay you every in-game morning
	  * GPS: a route line on the minimap to the current target, big glowing markers in the world
	Start jobs from the phone (Jobs) or by driving into the job markers.
]]
local Mi = {}
local Run = game:GetService("RunService")
local TS = game:GetService("TweenService")
local C3, V3, CF, A, rad = Color3.fromRGB, Vector3.new, CFrame.new, CFrame.Angles, math.rad

local folder
local current -- the running mission table
local function money(S, n) return S.L.money(n) end

----------------------------------------------------------------------------------------------------
-- WORLD MARKERS (glowing rings + light beam) and the GPS line on the minimap
----------------------------------------------------------------------------------------------------
local function marker(pos, color, size)
	local m = Instance.new("Model")
	m.Name = "Marker"
	local ring = Instance.new("Part")
	ring.Name, ring.Shape, ring.Size, ring.Anchored, ring.CanCollide, ring.CanQuery, ring.CastShadow = "Ring", Enum.PartType.Cylinder, V3(0.3, size or 12, size or 12), true, false, false, false
	ring.Material, ring.Color, ring.Transparency = Enum.Material.Neon, color, 0.35
	ring.CFrame = CF(pos + V3(0, 0.3, 0)) * A(0, 0, rad(90))
	ring.Parent = m
	local beam = Instance.new("Part")
	beam.Name, beam.Size, beam.Anchored, beam.CanCollide, beam.CanQuery, beam.CastShadow = "Beam", V3(size and size * 0.6 or 7, 60, size and size * 0.6 or 7), true, false, false, false
	beam.Material, beam.Color, beam.Transparency, beam.Shape = Enum.Material.Neon, color, 0.82, Enum.PartType.Cylinder
	beam.CFrame = CF(pos + V3(0, 30, 0)) * A(0, 0, rad(90))
	beam.Size = V3(60, size and size * 0.6 or 7, size and size * 0.6 or 7)
	beam.Parent = m
	local l = Instance.new("PointLight")
	l.Color, l.Range, l.Brightness, l.Shadows = color, 20, 2, false
	l.Parent = ring
	m.PrimaryPart = ring
	m.Parent = folder
	-- gentle pulse
	task.spawn(function()
		local t0 = os.clock()
		while m.Parent do
			local k = (math.sin((os.clock() - t0) * 3) + 1) / 2
			ring.Transparency = 0.25 + k * 0.3
			beam.Transparency = 0.78 + k * 0.1
			task.wait(0.05)
		end
	end)
	return m
end
local gpsFrames = {}
local function clearGPS()
	for _, f in ipairs(gpsFrames) do f:Destroy() end
	gpsFrames = {}
end
local function gps(S, target, color)
	clearGPS()
	if not target then return end
	local H = S.HUD
	if not H or not H.rect then return end
	local g = S.L.graph()
	local ch, hrp = S.char()
	local from = (S.inCar and S.car and S.car.root.Position) or (hrp and hrp.Position)
	if not from then return end
	local route = S.L.route(S.L.nearestNode(from), S.L.nearestNode(target))
	local pts = {from}
	for _, n in ipairs(route) do table.insert(pts, g.nodes[n].pos) end
	table.insert(pts, target)
	for i = 2, #pts do
		local a, b = pts[i - 1], pts[i]
		local mid = (a + b) / 2
		local f = H.rect("GPS", mid.X, mid.Z, (b - a).Magnitude + 10, 14, color or C3(180, 80, 255), math.deg(math.atan2(b.Z - a.Z, b.X - a.X)), 3)
		table.insert(gpsFrames, f)
	end
end

----------------------------------------------------------------------------------------------------
-- HELPERS
----------------------------------------------------------------------------------------------------
local function pos(S)
	local ch, hrp = S.char()
	return (S.inCar and S.car and S.car.root.Position) or (hrp and hrp.Position)
end
-- a random sidewalk spot between min and max studs away (for fares / drops)
local function spotAway(S, from, minD, maxD)
	local g = S.L.graph()
	for _ = 1, 40 do
		local r = g.roads[math.random(#g.roads)]
		if r.kind == "street" or r.kind == "boulevard" then
			local a, b = g.nodes[r.a].pos, g.nodes[r.b].pos
			local dir = (b - a).Unit
			local right = V3(-dir.Z, 0, dir.X)
			local p = a:Lerp(b, 0.3 + math.random() * 0.4) + right * (S.C.MAP.ROAD_W / 2 - 3)
			local d = ((p - from) * V3(1, 0, 1)).Magnitude
			if d > minD and d < maxD then return p, dir end
		end
	end
	return from + V3(minD, 0, 0)
end
local function inCarKey(S, key) return S.inCar and S.car and S.car.key == key end
local function stopped(S) return S.inCar and S.car and S.car.root.AssemblyLinearVelocity.Magnitude < 6 end
local function finish(S, ok, title, sub, pay)
	if not current then return end
	local m = current
	current = nil
	S.mission = nil
	if m.cleanup then pcall(m.cleanup) end
	for _, x in ipairs(m.markers or {}) do if x.Parent then x:Destroy() end end
	clearGPS()
	S.fire("objective", nil)
	S.fire("timer", nil)
	S.removeBlip("mission")
	if ok then
		if pay and pay > 0 then S.addCash(pay, m.name) end
		S.stat("jobs")
		S.fire("big", title or "MISSION PASSED", sub or (pay and ("+" .. money(S, pay)) or ""), C3(255, 200, 60))
		S.play("MissionPassed")
	else
		S.fire("big", title or "MISSION FAILED", sub or "", C3(255, 70, 70))
		S.play("MissionFailed")
	end
	S.save(true)
	S.fire("missionEnd", m, ok)
end
Mi.finish = finish
local function begin(S, m)
	if current then finish(S, false, "JOB ENDED", "You started something else.") end
	m.markers = {}
	current = m
	S.mission = m
	S.fire("missionStart", m)
end
local function setTarget(S, m, p, color, text)
	for _, x in ipairs(m.markers) do if x.Parent then x:Destroy() end end
	m.markers = {}
	if p then
		table.insert(m.markers, marker(p, color or C3(255, 220, 60)))
		S.addBlip("mission", function() return p end, color or C3(255, 220, 60), 13)
		gps(S, p, color)
		m.target = p
	end
	if text then S.fire("objective", text) end
end

----------------------------------------------------------------------------------------------------
-- TAXI
----------------------------------------------------------------------------------------------------
local function taxi(S)
	local C = S.C.TAXI
	local m = {name = "Taxi", kind = "taxi", fares = 0, earned = 0}
	begin(S, m)
	if not inCarKey(S, "Cabbie") then
		-- a cab is waiting at the depot / next to you
		local p = pos(S)
		local spot, dir = spotAway(S, p, 10, 60)
		local car = S.spawnCar("Cabbie", CF(spot, spot + (dir or V3(0, 0, -1))), 1, nil)
		m.cab = car
		setTarget(S, m, car and car.root.Position, C3(255, 220, 60), "Get in the ~yellow~ taxi.")
		S.fire("objective", "Get in the taxi.")
	end
	m.step = "cab"
	local passenger
	m.cleanup = function() if passenger then S.removePed(passenger) end end
	m.update = function(dt)
		if m.step == "cab" then
			if inCarKey(S, "Cabbie") then
				m.step = "find"
			elseif m.cab and m.cab.model.Parent then
				setTarget(S, m, nil)
				m.target = m.cab.root.Position
			end
		elseif m.step == "find" then
			local p = pos(S)
			local spot = spotAway(S, p, 150, 500)
			m.pickup = spot
			passenger = S.spawnPed(spot + V3(0, S.C.MAP.CURB, 0), "street")
			passenger.state = "idle"
			passenger.walk = nil
			setTarget(S, m, spot, C3(80, 200, 255), "Pick up the fare (blue marker).")
			m.step = "pickup"
		elseif m.step == "pickup" then
			if not inCarKey(S, "Cabbie") then S.fire("objective", "Get back in the taxi.") return end
			local p = pos(S)
			if ((p - m.pickup) * V3(1, 0, 1)).Magnitude < 12 and stopped(S) then
				-- passenger walks to the car and gets in
				if passenger then S.removePed(passenger) passenger = nil end
				local drop = spotAway(S, p, 350, 900)
				m.drop = drop
				local dist = (drop - p).Magnitude
				m.pay = math.floor(C.payBase + dist * C.payPerStud)
				m.timeLeft = math.max(C.minTime, dist * C.timePerStud)
				setTarget(S, m, drop, C3(255, 220, 60), "Take the passenger to the yellow marker.")
				S.fire("notify", "Fare", "\"" .. ({"Ocean Drive, fast!", "To the club, I'm late!", "Take me home, please.", "Downtown. Step on it!", "The pier. Make it quick."})[math.random(5)] .. "\"", C3(255, 220, 60))
				m.step = "drive"
			end
		elseif m.step == "drive" then
			m.timeLeft -= dt
			S.fire("timer", math.ceil(m.timeLeft))
			if m.timeLeft <= 0 then
				S.fire("notify", "Taxi", "The passenger left without paying.", C3(255, 80, 80))
				S.fire("timer", nil)
				m.step = "find"
				return
			end
			local p = pos(S)
			if ((p - m.drop) * V3(1, 0, 1)).Magnitude < 14 and stopped(S) then
				local tip = math.floor(m.timeLeft * 3)
				S.addCash(m.pay + tip, "taxi")
				m.earned += m.pay + tip
				m.fares += 1
				S.fire("timer", nil)
				S.fire("notify", "Fare " .. m.fares .. " / " .. C.fares, "+" .. money(S, m.pay) .. "  tip " .. money(S, tip), C3(120, 255, 140))
				if m.fares >= C.fares then finish(S, true, "TAXI SHIFT DONE", "Earned " .. money(S, m.earned), 500) else m.step = "find" end
			end
		end
		if m.cab and m.cab.health <= 0 then finish(S, false, "TAXI WRECKED") end
	end
end

----------------------------------------------------------------------------------------------------
-- DELIVERY
----------------------------------------------------------------------------------------------------
local function delivery(S)
	local C = S.C.DELIVERY
	local m = {name = "Delivery", kind = "delivery", drops = 0, earned = 0}
	begin(S, m)
	if not inCarKey(S, "Van") then
		local places = S.city and S.city:FindFirstChild("Places")
		local depot = places and places:FindFirstChild("DeliveryJob")
		local p = depot and depot:GetPivot().Position or pos(S)
		local spot, dir = spotAway(S, p, 5, 80)
		m.van = S.spawnCar("Van", CF(spot, spot + (dir or V3(0, 0, -1))), 1, nil)
		setTarget(S, m, m.van and m.van.root.Position, C3(120, 255, 120), "Get in the delivery van.")
	end
	m.step = "van"
	m.update = function(dt)
		if m.step == "van" then
			if inCarKey(S, "Van") then m.step = "next" end
		elseif m.step == "next" then
			local p = pos(S)
			local drop = spotAway(S, p, 250, 700)
			local dist = (drop - p).Magnitude
			m.drop, m.pay, m.timeLeft = drop, math.floor(C.payBase + dist * C.payPerStud), math.max(C.minTime, dist * C.timePerStud)
			setTarget(S, m, drop, C3(120, 255, 120), "Deliver parcel " .. (m.drops + 1) .. " of " .. C.drops .. ".")
			m.step = "drive"
		elseif m.step == "drive" then
			if not inCarKey(S, "Van") then S.fire("objective", "Get back in the van.") return end
			m.timeLeft -= dt
			S.fire("timer", math.ceil(m.timeLeft))
			if m.timeLeft <= 0 then finish(S, false, "DELIVERY FAILED", "Too slow.") return end
			local p = pos(S)
			if ((p - m.drop) * V3(1, 0, 1)).Magnitude < 14 and stopped(S) then
				m.drops += 1
				local bonus = math.floor(m.timeLeft * 4)
				S.addCash(m.pay + bonus, "delivery")
				m.earned += m.pay + bonus
				S.fire("notify", "Delivered", "+" .. money(S, m.pay) .. "  fast bonus " .. money(S, bonus), C3(120, 255, 140))
				if m.drops >= C.drops then finish(S, true, "ALL PARCELS DELIVERED", "Earned " .. money(S, m.earned), 750) else m.step = "next" end
			end
		end
		if m.van and m.van.health <= 0 then finish(S, false, "VAN WRECKED") end
	end
end

----------------------------------------------------------------------------------------------------
-- STREET RACES (checkpoints along road nodes, rival drivers use the traffic driver)
----------------------------------------------------------------------------------------------------
local RACES = {
	{name = "Ocean Sprint", prize = 4000, nodes = {{520, -840}, {520, -600}, {520, -360}, {520, -120}, {520, 120}, {520, 360}, {520, 600}}},
	{name = "Downtown Loop", prize = 5000, nodes = {{-360, -600}, {-120, -600}, {120, -600}, {120, -360}, {-120, -360}, {-120, -120}, {-360, -120}, {-360, -360}, {-360, -600}}},
	{name = "Island Run", prize = 7000, nodes = {{360, -120}, {520, -120}, {1010, -120}, {1180, -290}, {1350, -120}, {1180, 50}, {1010, -120}, {520, -120}}},
}
local function race(S, idx)
	local R = RACES[idx or 1]
	local g = S.L.graph()
	local cps = {}
	for _, n in ipairs(R.nodes) do
		local id = g.byKey[n[1] .. "," .. n[2]]
		if id then table.insert(cps, {node = id, pos = g.nodes[id].pos}) else table.insert(cps, {pos = V3(n[1], 0, n[2])}) end
	end
	local m = {name = R.name, kind = "race", cp = 2}
	begin(S, m)
	if not S.inCar then finish(S, false, "RACE", "You need a car to race.") return end
	-- teleport to the start line, rivals beside you
	local start, nextP = cps[1].pos, cps[2].pos
	local dir = (nextP - start).Unit
	local right = V3(-dir.Z, 0, dir.X)
	local car = S.car
	car.root.CFrame = CF(start + right * 4 + V3(0, 3, 0), start + right * 4 + V3(0, 3, 0) + dir)
	car.root.AssemblyLinearVelocity = V3()
	local dd = S.driveState and S.driveState()
	if dd then dd.yaw = math.atan2(-dir.X, -dir.Z) end
	S.fire("clearTraffic")
	m.rivals = {}
	local keys = {"Vortex", "Stallion", "Coastline"}
	for i = 1, 3 do
		local a, b = cps[1].node, cps[2].node
		if a and b then
			local c = S.trafficSpawn(keys[i], a, b, 2 + i * 7, i % 2 == 0 and 1 or 2, {keep = true, police = true, ignoreLights = true, cruise = 0, rival = true})
			if c then
				c.cp = 2
				c.chooseNext = function(cc)
					local target = cps[cc.cp] and cps[cc.cp].node
					if not target then return g.nodes[cc.b].links[1] end
					if cc.b == target then cc.cp += 1 target = cps[cc.cp] and cps[cc.cp].node end
					if not target then return g.nodes[cc.b].links[1] end
					local route = S.L.route(cc.b, target)
					return route[2] or g.nodes[cc.b].links[1]
				end
				table.insert(m.rivals, c)
			end
		end
	end
	m.cleanup = function() for _, c in ipairs(m.rivals) do S.trafficRemove(c) end end
	-- countdown
	m.step = "count"
	m.t = 0
	S.mode = "cutscene"
	task.spawn(function()
		for i = 3, 1, -1 do
			S.fire("score", tostring(i), C3(255, 220, 60))
			S.play("Checkpoint", {PlaybackSpeed = 0.8})
			if S.car then S.car.root.AssemblyLinearVelocity = V3() end
			task.wait(1)
		end
		S.fire("score", "GO!", C3(80, 255, 120))
		S.play("Checkpoint", {PlaybackSpeed = 1.4})
		S.mode = "play"
		m.step = "race"
		m.t0 = os.clock()
		for k, c in ipairs(m.rivals) do c.cruise = 90 + k * 8 end
		task.delay(1, function() S.fire("score", nil) end)
		setTarget(S, m, cps[2].pos, C3(255, 60, 170), "Race! Checkpoint 1 of " .. (#cps - 1))
	end)
	m.update = function(dt)
		if m.step ~= "race" then return end
		-- rivals (moved here, the traffic loop skips them)
		for _, c in ipairs(m.rivals) do
			S.trafficDrive(c, dt)
			c.root.CFrame = CF(c.pos + V3(0, c.lift, 0), c.pos + V3(0, c.lift, 0) + c.dir)
			c.spin = ((c.spin or 0) + c.speed * dt / 1.3) % (math.pi * 2)
			for _, w in ipairs(c.wheels) do w.m.Transform = CFrame.Angles(-c.spin, 0, 0) end
			if c.cp > #cps and not c.done then c.done = os.clock() end
		end
		local p = pos(S)
		local cp = cps[m.cp]
		if cp and ((p - cp.pos) * V3(1, 0, 1)).Magnitude < 24 then
			m.cp += 1
			S.play("Checkpoint")
			if m.cp > #cps then
				-- finished: place = 1 + rivals already done
				local place = 1
				for _, c in ipairs(m.rivals) do if c.done then place += 1 end end
				local t = os.clock() - m.t0
				local prize = place == 1 and R.prize or (place == 2 and math.floor(R.prize * 0.4) or 0)
				if place == 1 then S.stat("races") end
				finish(S, place <= 2, place == 1 and "YOU WIN!" or ("FINISHED " .. place .. ({"ST", "ND", "RD", "TH"})[math.min(place, 4)]), string.format("Time %d:%04.1f", t // 60, t % 60) .. (prize > 0 and ("   +" .. money(S, prize)) or ""), prize)
				return
			end
			setTarget(S, m, cps[m.cp].pos, C3(255, 60, 170), "Checkpoint " .. (m.cp - 1) .. " of " .. (#cps - 1))
		end
		-- live position
		local myProgress = m.cp + (cp and (1 - math.clamp(((p - cp.pos) * V3(1, 0, 1)).Magnitude / 400, 0, 1)) or 0)
		local place = 1
		for _, c in ipairs(m.rivals) do
			local ccp = cps[c.cp]
			local prog = c.cp + (ccp and (1 - math.clamp((c.pos - ccp.pos).Magnitude / 400, 0, 1)) or 1)
			if prog > myProgress then place += 1 end
		end
		S.fire("timer", math.floor(os.clock() - m.t0))
		if m.lastPlace ~= place then m.lastPlace = place S.fire("objective", "Position " .. place .. " / 4   ·   Checkpoint " .. (m.cp - 1) .. " of " .. (#cps - 1)) end
		if not S.inCar then finish(S, false, "RACE LOST", "You left your car.") end
	end
end

----------------------------------------------------------------------------------------------------
-- STORY
----------------------------------------------------------------------------------------------------
local STORY = {
	{name = "Welcome to the Bay", caller = "Rico Vega", call = "Hey, new kid! Rico here. Come see me at the beach apartment on Ocean Drive. Bring a car, it's a long walk in this heat.",
		run = function(S, m)
			local safe = S.city and S.city.Places:FindFirstChild("Safehouse")
			local p = safe and safe:GetPivot().Position or V3(549, 0, 300)
			setTarget(S, m, p, C3(120, 200, 255), "Drive to Rico at the safehouse.")
			m.update = function()
				local q = pos(S)
				if q and ((q - p) * V3(1, 0, 1)).Magnitude < 14 then finish(S, true, "MISSION PASSED", "Welcome to Sunset Bay   +$1,500", 1500) end
			end
		end},
	{name = "Special Delivery", caller = "Rico Vega", call = "I've got a package at the docks that needs to get to the Flamingo Palms hotel. Quick and quiet - 90 seconds.",
		run = function(S, m)
			local docks = V3(-300, 0, 700)
			setTarget(S, m, docks, C3(255, 220, 60), "Pick up the package at the docks.")
			m.step = "pick"
			m.update = function(dt)
				local q = pos(S)
				if not q then return end
				if m.step == "pick" and ((q - docks) * V3(1, 0, 1)).Magnitude < 16 then
					m.step = "drop"
					m.timeLeft = 90
					m.drop = V3(549, 0, -770)
					setTarget(S, m, m.drop, C3(255, 60, 170), "Take it to the Flamingo Palms on Ocean Drive.")
				elseif m.step == "drop" then
					m.timeLeft -= dt
					S.fire("timer", math.ceil(m.timeLeft))
					if m.timeLeft <= 0 then finish(S, false, "MISSION FAILED", "Rico wanted it fast.") return end
					if ((q - m.drop) * V3(1, 0, 1)).Magnitude < 16 then finish(S, true, "MISSION PASSED", "+$4,000", 4000) end
				end
			end
		end},
	{name = "Midnight Run", caller = "Lola Cruz", call = "Rico says you can drive. Prove it - race me down Ocean Drive. Winner takes $8,000.",
		run = function(S, m)
			finish(S, true, "STORY", "Win the Ocean Sprint race to continue.", 0)
			task.delay(4, function() if not current then race(S, 1) end end)
		end},
	{name = "Hot Property", caller = "Lola Cruz", call = "A Vortex GT is parked on Star Island. Bring it to the Paint & Fix garage before the police catch you.",
		run = function(S, m)
			local I = S.C.MAP.ISLAND
			local spot = V3(I.cx, 0, I.cz + I.r - 60)
			local car = S.spawnCar("Vortex", CF(spot, spot + V3(1, 0, 0)), 3, nil)
			m.car = car
			setTarget(S, m, spot, C3(255, 60, 170), "Steal the Vortex GT on Star Island.")
			m.step = "steal"
			local repair = S.city.Places:FindFirstChild("Repair")
			local rp = repair and repair:GetPivot().Position or V3(-240, 0, 214)
			m.update = function()
				if not car or not car.model.Parent or car.health <= 0 then finish(S, false, "MISSION FAILED", "The Vortex is gone.") return end
				if m.step == "steal" and S.car == car then
					m.step = "bring"
					S.setWanted(2, "Car theft!")
					setTarget(S, m, rp, C3(255, 200, 40), "Lose the police and bring the car to Paint & Fix.")
				elseif m.step == "bring" then
					local q = car.root.Position
					if S.car == car and ((q - rp) * V3(1, 0, 1)).Magnitude < 16 then
						if (S.wanted or 0) > 0 then S.fire("objective", "Lose the police first!") return end
						table.insert(S.data.cars, {key = "Vortex", color = 3, health = car.health})
						finish(S, true, "MISSION PASSED", "The Vortex GT is yours!   +$10,000", 10000)
					end
				end
			end
		end},
	{name = "The Big Score", caller = "Rico Vega", call = "Last job, partner. Deliver five parcels for Bay Express without a scratch and the city is yours.",
		run = function(S, m)
			finish(S, true, "STORY", "Finish a full delivery job to complete the story.", 0)
			task.delay(4, function() if not current then delivery(S) end end)
		end},
}
local function story(S)
	local i = (S.data.story or 0) + 1
	local st = STORY[i]
	if not st then S.fire("notify", "Story", "You finished the story! More chapters soon.", C3(255, 60, 170)) return end
	local m = {name = st.name, kind = "story", chapter = i}
	begin(S, m)
	S.fire("phoneCall", st.caller, st.call)
	S.fire("missionTitle", st.name)
	task.wait(2.5)
	if current ~= m then return end
	st.run(S, m)
end

----------------------------------------------------------------------------------------------------
-- PROPERTIES
----------------------------------------------------------------------------------------------------
local PROPERTIES = {
	{id = "diner", name = "Sunset Diner", price = 25000, income = 1200},
	{id = "carwash", name = "Neon Car Wash", price = 40000, income = 2000},
	{id = "club", name = "Club Malibu", price = 120000, income = 6500},
	{id = "boat", name = "Marina Boathouse", price = 75000, income = 3800},
	{id = "penthouse", name = "Downtown Penthouse", price = 250000, income = 9000},
	{id = "villa", name = "Star Island Villa", price = 500000, income = 15000},
}

----------------------------------------------------------------------------------------------------
-- START
----------------------------------------------------------------------------------------------------
function Mi.init(S)
	folder = Instance.new("Folder")
	folder.Name = "SB_Missions"
	folder.Parent = workspace
	S.PROPERTIES = PROPERTIES
	S.RACES = RACES
end
function Mi.start(S)
	S.on("startJob", function(kind, arg)
		if S.mode ~= "play" then return end
		if kind == "taxi" then taxi(S)
		elseif kind == "delivery" then delivery(S)
		elseif kind == "race" then race(S, arg)
		elseif kind == "story" then task.spawn(story, S) end
	end)
	S.on("quitJob", function() if current then finish(S, false, "JOB ENDED", "") end end)
	-- story chapters advance when a story mission is passed (races / delivery count for their chapters)
	S.on("missionEnd", function(m, ok)
		if not ok then return end
		local ch = (S.data.story or 0) + 1
		local st = STORY[ch]
		if not st then return end
		if (m.kind == "story" and m.chapter == ch and m.name == st.name and st.name ~= "Midnight Run" and st.name ~= "The Big Score")
			or (st.name == "Midnight Run" and m.kind == "race" and m.name == "Ocean Sprint")
			or (st.name == "The Big Score" and m.kind == "delivery") then
			S.data.story = ch
			S.save(true)
			local nx = STORY[ch + 1]
			if nx then task.delay(6, function() S.fire("notify", nx.caller, "Call me when you're ready for the next job. (Phone > Jobs > Story)", C3(255, 60, 170)) end) end
		end
	end)
	-- driving into a job marker starts it
	local places = S.city and S.city:FindFirstChild("Places")
	task.spawn(function()
		while true do
			task.wait(0.3)
			if S.mode == "play" and not current and places then
				local p = pos(S)
				if p then
					for _, mk in ipairs(places:GetChildren()) do
						local kind = mk:GetAttribute("Kind")
						if kind == "Taxi" or kind == "Delivery" or kind == "Race" then
							local q = mk:GetPivot().Position
							if ((p - q) * V3(1, 0, 1)).Magnitude < 7 then
								S.fire("help", "Press E to start: " .. kind .. (kind == "Race" and " (Ocean Sprint)" or " job"), "job")
								mk:SetAttribute("Near", true)
							elseif mk:GetAttribute("Near") then
								mk:SetAttribute("Near", false)
								S.fire("help", nil, "job")
							end
						end
					end
				end
			end
		end
	end)
	S.on("action", function(a)
		if a ~= "use" or S.mode ~= "play" or current or not places then return end
		for _, mk in ipairs(places:GetChildren()) do
			if mk:GetAttribute("Near") then
				local kind = mk:GetAttribute("Kind")
				mk:SetAttribute("Near", false)
				S.fire("help", nil, "job")
				if kind == "Taxi" then taxi(S) elseif kind == "Delivery" then delivery(S) elseif kind == "Race" then race(S, 1) end
				return
			end
		end
	end)
	-- mission update + GPS refresh
	local gpsT = 0
	Run.Heartbeat:Connect(function(dt)
		if current and current.update and (S.mode == "play" or current.step == "count") then
			local ok, err = pcall(current.update, dt)
			if not ok then warn("[SunsetBay] mission: " .. tostring(err)) end
			gpsT += dt
			if gpsT > 3 and current and current.target then gpsT = 0 gps(S, current.target) end
		end
	end)
	-- properties pay every in-game morning (6:00)
	local lastDay
	task.spawn(function()
		while true do
			task.wait(2)
			if S.mode == "play" and S.getTime then
				local h = S.getTime()
				local day = math.floor((os.clock() + 0) / 1)
				if h >= 6 and h < 6.6 and lastDay ~= "paid" then
					lastDay = "paid"
					local total = 0
					for _, p in ipairs(PROPERTIES) do if S.data.props[p.id] then total += p.income end end
					if total > 0 then S.addCash(total, "properties") S.fire("notify", "Properties", "Your businesses earned " .. money(S, total) .. " today.", C3(120, 255, 140)) end
				elseif h >= 7 then lastDay = nil end
			end
		end
	end)
	-- busted / wasted while on a job ends it
	S.on("busted", function(fine)
		S.fire("big", "BUSTED", "Fine: " .. money(S, fine), C3(80, 140, 255))
		if current then finish(S, false, "JOB FAILED", "You were busted.") end
	end)
	S.missionTarget = function() return current and current.target end
end
return Mi
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXSPeds"><Properties><string name="Name">Peds</string><ProtectedString name="Source"><![CDATA[--[[
	Peds | StarterPlayerScripts.SB (ModuleScript)
	People of Sunset Bay (only on this computer):
	  * walkers on the sidewalks: they follow the sidewalk along each street and turn at the corners
	  * beach people: sunbathers, joggers on the promenade, people strolling on the sand
	  * every person is built from a few blocky parts in many outfits (80s colours: neon shirts,
	    tank tops, shorts, sunglasses, caps, hair styles) and animated in code (walk / run / idle)
	  * they react: a fast car coming at them makes them run away; a car that hits them sends them flying
	    (and the police notice: S.fire("crime", "ped"))
	  * amount and draw distance follow the quality setting
]]
local P = {}
local Run = game:GetService("RunService")
local C3, V3, CF, A, rad = Color3.fromRGB, Vector3.new, CFrame.new, CFrame.Angles, math.rad

local folder
local peds = {}
local SKIN = {C3(255, 220, 190), C3(234, 184, 146), C3(198, 140, 100), C3(150, 100, 70), C3(105, 70, 50)}
local SHIRT = {C3(255, 60, 170), C3(0, 220, 255), C3(255, 140, 60), C3(250, 250, 250), C3(170, 80, 255), C3(80, 220, 140), C3(255, 230, 80), C3(30, 30, 40), C3(255, 120, 180), C3(60, 120, 220)}
local PANTS = {C3(240, 240, 235), C3(40, 50, 90), C3(30, 30, 35), C3(200, 180, 140), C3(120, 200, 220), C3(255, 160, 200)}
local HAIR = {C3(30, 20, 15), C3(90, 60, 30), C3(220, 190, 110), C3(160, 60, 30), C3(20, 20, 20), C3(240, 240, 240)}

----------------------------------------------------------------------------------------------------
-- BUILD a person (anchored parts moved in code). Returns a table with the parts and their rest offsets.
----------------------------------------------------------------------------------------------------
local function part(m, name, size, col, mat)
	local p = Instance.new("Part")
	p.Name, p.Size, p.Color, p.Material = name, size, col, mat or Enum.Material.SmoothPlastic
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, true
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	p.Parent = m
	return p
end
local function build(style)
	local m = Instance.new("Model")
	m.Name = "Ped"
	local s = style
	local skin = SKIN[math.random(#SKIN)]
	local shirt = SHIRT[math.random(#SHIRT)]
	local pants = PANTS[math.random(#PANTS)]
	local hair = HAIR[math.random(#HAIR)]
	local swim = s == "beach" and math.random() < 0.6
	local parts = {}
	local function add(name, size, col, off, limb, mat)
		local p = part(m, name, size, col, mat)
		table.insert(parts, {p = p, off = off, limb = limb})
		return p
	end
	-- body (y = 0 at the feet). Slightly slimmer than a Roblox character.
	add("Torso", V3(1.8, 1.9, 0.9), swim and skin or shirt, CF(0, 2.95, 0))
	add("Head", V3(1.1, 1.1, 1.1), skin, CF(0, 4.5, 0))
	add("LegL", V3(0.85, 2, 0.85), swim and skin or pants, CF(-0.47, 1, 0), "legL")
	add("LegR", V3(0.85, 2, 0.85), swim and skin or pants, CF(0.47, 1, 0), "legR")
	add("ArmL", V3(0.75, 1.9, 0.75), (s == "beach" or math.random() < 0.4) and skin or shirt, CF(-1.3, 2.95, 0), "armL")
	add("ArmR", V3(0.75, 1.9, 0.75), (s == "beach" or math.random() < 0.4) and skin or shirt, CF(1.3, 2.95, 0), "armR")
	if swim then
		add("Shorts", V3(1.82, 0.6, 0.92), SHIRT[math.random(#SHIRT)], CF(0, 2.3, 0))
	end
	-- face: eyes or sunglasses
	if math.random() < 0.45 then
		add("Shades", V3(0.95, 0.25, 0.08), C3(20, 20, 25), CF(0, 4.6, -0.59), nil, Enum.Material.Glass)
	else
		add("EyeL", V3(0.14, 0.18, 0.04), C3(20, 20, 25), CF(-0.22, 4.6, -0.57))
		add("EyeR", V3(0.14, 0.18, 0.04), C3(20, 20, 25), CF(0.22, 4.6, -0.57))
	end
	-- hair / cap
	local r = math.random()
	if r < 0.25 then
		add("Cap", V3(1.2, 0.35, 1.2), SHIRT[math.random(#SHIRT)], CF(0, 5.22, 0))
		add("Brim", V3(1.0, 0.1, 0.5), SHIRT[math.random(#SHIRT)], CF(0, 5.1, -0.82))
	elseif r < 0.85 then
		add("Hair", V3(1.18, 0.3, 1.18), hair, CF(0, 5.2, 0))
		add("HairBack", V3(1.18, math.random() < 0.4 and 1.2 or 0.6, 0.2), hair, CF(0, 4.75, 0.64))
	end
	-- shoes
	add("ShoeL", V3(0.85, 0.3, 0.3), C3(240, 240, 240), CF(-0.47, 0.15, -0.55), "legL")
	add("ShoeR", V3(0.85, 0.3, 0.3), C3(240, 240, 240), CF(0.47, 0.15, -0.55), "legR")
	-- extras
	if s ~= "beach" and math.random() < 0.2 then add("Bag", V3(0.8, 1, 0.4), C3(120, 80, 50), CF(-1.3, 2.2, 0.55), "armL") end
	return m, parts
end

----------------------------------------------------------------------------------------------------
-- SIDEWALK PATHS: each street has two sidewalk lines; peds walk along one and turn at the ends
----------------------------------------------------------------------------------------------------
local walks = {}
local function buildWalks(S)
	local g = S.L.graph()
	local M = S.C.MAP
	local off = M.ROAD_W / 2 + M.WALK_W / 2
	for _, r in ipairs(g.roads) do
		if r.kind == "street" or r.kind == "boulevard" then
			local a, b = g.nodes[r.a].pos, g.nodes[r.b].pos
			local dir = (b - a).Unit
			local right = V3(-dir.Z, 0, dir.X)
			for s = -1, 1, 2 do
				local trim = off + 1
				local p1 = a + dir * trim + right * s * off + V3(0, M.CURB, 0)
				local p2 = b - dir * trim + right * s * off + V3(0, M.CURB, 0)
				table.insert(walks, {a = p1, b = p2, len = (p2 - p1).Magnitude, r = r, side = s})
			end
		end
	end
end
local beachZone
local function nearestWalk(p)
	local best, bd = nil, math.huge
	for _, w in ipairs(walks) do
		local ab = w.b - w.a
		local t = math.clamp((p - w.a):Dot(ab) / ab:Dot(ab), 0, 1)
		local d = (p - (w.a + ab * t)).Magnitude
		if d < bd then best, bd = w, d end
	end
	return best, bd
end

----------------------------------------------------------------------------------------------------
-- PED LOGIC
----------------------------------------------------------------------------------------------------
-- ped = {m, parts, pos, dir, speed, state = "walk"/"run"/"idle"/"lie"/"fly", walk = segment, t, phase, ...}
local function place(e, cf, t)
	-- animation by state
	local sw, armSw, bob = 0, 0, 0
	if e.state == "walk" then sw = math.sin(t * 6 + e.phase) * 0.6 armSw = sw * 0.8 bob = math.abs(math.cos(t * 6 + e.phase)) * 0.08
	elseif e.state == "run" then sw = math.sin(t * 11 + e.phase) * 1.0 armSw = sw bob = math.abs(math.cos(t * 11 + e.phase)) * 0.2
	elseif e.state == "idle" then armSw = math.sin(t * 1.5 + e.phase) * 0.05 end
	for _, x in ipairs(e.parts) do
		local off = x.off
		local l = x.limb
		local c
		if l == "legL" or l == "legR" then
			local a = (l == "legL" and sw or -sw)
			c = cf * CF(off.X, 2, 0) * A(a, 0, 0) * CF(0, off.Y - 2, off.Z)
		elseif l == "armL" or l == "armR" then
			local a = (l == "armL" and -armSw or armSw)
			c = cf * CF(off.X, 3.85, 0) * A(a, 0, 0) * CF(0, off.Y - 3.85, off.Z)
		else
			c = cf * off
		end
		x.p.CFrame = c + V3(0, bob, 0)
	end
end
local function lie(e, cf)
	-- lying on the ground (after being hit)
	local base = cf * CF(0, 0.5, 0) * A(rad(-90), 0, 0) * CF(0, -0.5, 0)
	for _, x in ipairs(e.parts) do x.p.CFrame = base * x.off end
end
local function spawnPed(S, at, style, walk)
	local m, parts = build(style)
	local e = {m = m, parts = parts, pos = at, dir = V3(1, 0, 0), speed = 4 + math.random() * 1.5, state = "walk", phase = math.random() * 6, style = style, born = os.clock()}
	if walk then
		e.walk = walk
		local ab = walk.b - walk.a
		e.t = math.clamp((at - walk.a):Dot(ab) / ab:Dot(ab), 0, 1)
		e.fwd = math.random() < 0.5
	end
	if style == "beach" then
		e.state = math.random() < 0.35 and "idle" or "walk"
		e.target = at
		if math.random() < 0.25 then e.state = "sun" end -- sunbather
	end
	m.Parent = folder
	table.insert(peds, e)
	return e
end
local function removePed(e)
	local i = table.find(peds, e)
	if i then table.remove(peds, i) end
	e.m:Destroy()
end

function P.init(S)
	folder = Instance.new("Folder")
	folder.Name = "SB_Peds"
	folder.Parent = workspace
	S.peds = peds
	buildWalks(S)
	local M = S.C.MAP
	beachZone = {x1 = M.BEACH_X[1] + 15, x2 = M.BEACH_X[2] - 10, z1 = M.Z[1] - 80, z2 = M.Z[#M.Z] + 100}
end

function P.start(S)
	local M = S.C.MAP
	-- spawn / despawn around the camera
	task.spawn(function()
		while true do
			task.wait(0.6)
			if S.mode ~= "menu" then
				local q = S.C.QUALITY[S.settings.quality] or S.C.QUALITY.Medium
				local cp = S.cam.CFrame.Position
				for i = #peds, 1, -1 do
					local e = peds[i]
					if (e.pos - cp).Magnitude > 260 or (e.state == "lie" and os.clock() - (e.hitAt or 0) > 20) then removePed(peds[i]) end
				end
				local tries = 0
				while #peds < q.peds and tries < 8 do
					tries += 1
					local nearBeach = math.abs(cp.X - (M.BEACH_X[1] + 60)) < 220
					if nearBeach and math.random() < 0.55 then
						local p = V3(math.random(beachZone.x1, beachZone.x2), 0.1, math.clamp(cp.Z + math.random(-180, 180), beachZone.z1, beachZone.z2))
						if (p - cp).Magnitude > 50 then spawnPed(S, p, "beach") end
					else
						local w = walks[math.random(#walks)]
						local p = w.a:Lerp(w.b, math.random())
						local d = (p - cp).Magnitude
						if d > 60 and d < 220 then spawnPed(S, p, "street", w) end
					end
				end
			end
		end
	end)
	-- move + animate
	local acc = 0
	Run.Heartbeat:Connect(function(dt)
		if S.mode == "menu" then return end
		local t = os.clock()
		local cp = S.cam.CFrame.Position
		local pcar = S.inCar and S.car
		local cpos = pcar and pcar.root.Position
		local cvel = pcar and pcar.root.AssemblyLinearVelocity or V3()
		for i = #peds, 1, -1 do
			local e = peds[i]
			if not e.m.Parent then table.remove(peds, i) continue end
			-- danger: a fast car coming
			if cpos and e.state ~= "lie" and e.state ~= "fly" then
				local rel = e.pos - cpos
				local dist = rel.Magnitude
				if dist < 4.5 and cvel.Magnitude > 18 then
					-- hit!
					e.state = "fly"
					e.flyV = cvel * 0.6 + V3(0, 22, 0)
					e.flyR = V3(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 12
					e.flyCF = CF(e.pos)
					e.hitAt = t
					S.fire("crime", "ped", e.pos)
					S.play("Crash", {Volume = 0.4, PlaybackSpeed = 1.4}, e.pos)
				elseif dist < 26 and cvel.Magnitude > 25 and cvel.Unit:Dot(rel.Unit) > 0.75 and e.state ~= "run" then
					e.state = "run"
					e.runUntil = t + 3
					local side = V3(-cvel.Z, 0, cvel.X).Unit
					if side:Dot(rel) < 0 then side = -side end
					e.dir = side
					e.speed = 12
				end
			end
			if e.state == "fly" then
				e.flyV += V3(0, -60, 0) * dt
				local np = e.flyCF.Position + e.flyV * dt
				if np.Y <= e.pos.Y and e.flyV.Y < 0 then
					e.state = "lie"
					e.pos = V3(np.X, e.pos.Y, np.Z)
					lie(e, CF(e.pos) * A(0, math.random() * 6, 0))
				else
					e.flyCF = CF(np) * (e.flyCF - e.flyCF.Position) * A(e.flyR.X * dt, e.flyR.Y * dt, e.flyR.Z * dt)
					for _, x in ipairs(e.parts) do x.p.CFrame = e.flyCF * CF(0, -2.5, 0) * x.off end
				end
				continue
			end
			if e.state == "lie" then continue end
			-- movement
			if e.state == "run" then
				e.pos += e.dir * e.speed * dt
				if t > (e.runUntil or 0) then
					e.state = "walk"
					e.speed = 4 + math.random() * 1.5
					if e.walk then
						local w = nearestWalk(e.pos)
						if w then e.walk = w local ab = w.b - w.a e.t = math.clamp((e.pos - w.a):Dot(ab) / ab:Dot(ab), 0, 1) end
					end
				end
			elseif e.walk and e.state == "walk" then
				local w = e.walk
				e.t += (e.fwd and 1 or -1) * e.speed * dt / math.max(w.len, 1)
				if e.t > 1 or e.t < 0 then
					-- end of this sidewalk: continue on a sidewalk that starts near here
					local endP = e.t > 1 and w.b or w.a
					local best, bd = nil, 30
					for _, o in ipairs(walks) do
						if o ~= w then
							local da, db = (o.a - endP).Magnitude, (o.b - endP).Magnitude
							if da < bd and math.random() < 0.7 then best, bd, e.fwd = o, da, true end
							if db < bd and math.random() < 0.7 then best, bd, e.fwd = o, db, false end
						end
					end
					if best then e.walk = best e.t = e.fwd and 0 or 1 else e.fwd = not e.fwd e.t = math.clamp(e.t, 0, 1) end
					w = e.walk
				end
				local np = w.a:Lerp(w.b, math.clamp(e.t, 0, 1))
				local d = np - e.pos
				if d.Magnitude > 0.01 then e.dir = V3(d.X, 0, d.Z).Unit end
				e.pos = np
			elseif e.style == "beach" then
				if e.state == "walk" then
					local d = e.target - e.pos
					if d.Magnitude < 1.5 then
						if math.random() < 0.3 then e.state = "idle" e.idleUntil = t + 3 + math.random() * 6 end
						e.target = V3(math.clamp(e.pos.X + math.random(-40, 40), beachZone.x1, beachZone.x2), 0.1, math.clamp(e.pos.Z + math.random(-60, 60), beachZone.z1, beachZone.z2))
					else
						e.dir = V3(d.X, 0, d.Z).Unit
						e.pos += e.dir * e.speed * 0.8 * dt
					end
				elseif e.state == "idle" and t > (e.idleUntil or 0) then
					e.state = "walk"
				end
			end
			-- draw (only near the camera, every frame; far ones every few frames)
			local dist = (e.pos - cp).Magnitude
			if dist < 140 or (i + math.floor(t * 10)) % 4 == 0 then
				if e.state == "sun" then
					lie(e, CF(e.pos) * A(0, e.phase, 0))
				else
					place(e, CF(e.pos, e.pos + e.dir), t)
				end
			end
		end
	end)
	S.pedCount = function() return #peds end
	S.spawnPed = function(at, style) return spawnPed(S, at, style or "street") end
	S.removePed = removePed
	S.placePed = function(e, cf) e.pos = cf.Position e.dir = cf.LookVector place(e, cf, os.clock()) end
end
return P
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXSPhone"><Properties><string name="Name">Phone</string><ProtectedString name="Source"><![CDATA[--[[
	Phone | StarterPlayerScripts.SB (ModuleScript)
	The phone (TAB / gamepad up / the PHONE button on touch screens) slides up from the bottom right.
Tap navigation only: app icons, big rows, a back button, the home bar (home, then close) and tapping outside closes it.
	  Garage    your cars: deliver one next to you, sell (60%)
	  Map       full screen map with roads, places, packages left, you; set a waypoint by clicking
	  Jobs      start a taxi / delivery job, see street races
	  Property  buy places that pay money every in-game day
	  Radio     pick a station / turn the radio off
	  Stats     money earned, distance, packages, stunts, play time
	  Camera    photo mode (hides the HUD, free camera with depth of field)
	  Settings  graphics quality, volumes, camera, speed units
	Also: the full screen map (M).
]]
local Ph = {}
local TS = game:GetService("TweenService")
local Run = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local C3, V3, U2, V2 = Color3.fromRGB, Vector3.new, UDim2.new, Vector2.new

local open = false
local page = nil
function Ph.init(S)
	Ph.g = S.gui.SB_Phone
	Ph.m = S.gui.SB_Map
end

local function rows(S, header, items)
	local P = Ph.g.Phone.Screen.Page
	P.Header.Text = header
	local list = P.List
	for _, c in ipairs(list:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
	for i, it in ipairs(items) do
		local r = P.RowTemplate:Clone()
		r.Name = "Row"
		r.Visible = true
		r.LayoutOrder = i
		r.Title.Text = it.title
		r.Sub.Text = it.sub or ""
		if it.color then r.BackgroundColor3 = it.color end
		r.Parent = list
		if it.click then r.MouseButton1Click:Connect(function() S.play("Click") it.click() end) end
	end
	Ph.g.Phone.Screen.Apps.Visible = false
	P.Visible = true
end
local function home()
	local scr = Ph.g.Phone.Screen
	scr.Page.Visible = false
	scr.Apps.Visible = true
	page = nil
end

----------------------------------------------------------------------------------------------------
-- APPS
----------------------------------------------------------------------------------------------------
local APPS = {}
APPS.Garage = function(S)
	page = "Garage"
	local items = {}
	for i, c in ipairs(S.data.cars) do
		local cfg = S.C.CARS[c.key]
		if cfg then
			local hp = math.floor((c.health or S.C.MAX_HEALTH) / S.C.MAX_HEALTH * 100)
			table.insert(items, {title = cfg.name, sub = cfg.class .. " · " .. hp .. "% · tap to deliver", click = function()
				if S.inCar then S.fire("notify", "Garage", "Get out of the car first.") return end
				S.deliverCar(i)
				Ph.toggle(S, false)
			end})
		end
	end
	table.insert(items, {title = "Sell a car", sub = "60% of the price", color = C3(90, 30, 40), click = function()
		local list = {}
		for i, c in ipairs(S.data.cars) do
			local cfg = S.C.CARS[c.key]
			table.insert(list, {title = "Sell " .. cfg.name, sub = S.L.money(math.floor(cfg.price * 0.6)), color = C3(90, 30, 40), click = function()
				if #S.data.cars <= 1 then S.fire("notify", "Garage", "Keep at least one car.") return end
				if S.personal and S.personal.owned == i then S.removeCar(S.personal) S.personal = nil end
				table.remove(S.data.cars, i)
				S.addCash(math.floor(cfg.price * 0.6), "sell")
				S.save(true)
				APPS.Garage(S)
			end})
		end
		rows(S, "Sell", list)
	end})
	rows(S, "Garage", items)
end
APPS.Jobs = function(S)
	page = "Jobs"
	local items = {
		{title = "Taxi", sub = "Pick up and drop off fares", click = function() Ph.toggle(S, false) S.fire("startJob", "taxi") end},
		{title = "Bay Express Delivery", sub = "Deliver parcels around town", click = function() Ph.toggle(S, false) S.fire("startJob", "delivery") end},
		{title = "Street Race: Ocean Sprint", sub = "Checkpoints along the coast", click = function() Ph.toggle(S, false) S.fire("startJob", "race", 1) end},
		{title = "Street Race: Downtown Loop", sub = "Tight turns between towers", click = function() Ph.toggle(S, false) S.fire("startJob", "race", 2) end},
		{title = "Street Race: Island Run", sub = "Cross the causeway and back", click = function() Ph.toggle(S, false) S.fire("startJob", "race", 3) end},
		{title = "Story", sub = "Continue the story", color = C3(110, 40, 90), click = function() Ph.toggle(S, false) S.fire("startJob", "story") end},
	}
	if S.mission then table.insert(items, 1, {title = "Quit current job", sub = S.mission.name or "", color = C3(110, 30, 40), click = function() Ph.toggle(S, false) S.fire("quitJob") end}) end
	rows(S, "Jobs", items)
end
APPS.Property = function(S)
	page = "Property"
	local items = {}
	for _, p in ipairs(S.PROPERTIES or {}) do
		local own = S.data.props[p.id]
		table.insert(items, {title = p.name, sub = own and ("Owned · pays " .. S.L.money(p.income) .. " a day") or (S.L.money(p.price) .. " · pays " .. S.L.money(p.income) .. " a day"), color = own and C3(30, 80, 50) or nil, click = function()
			if own then S.fire("notify", p.name, "You own this place.") return end
			if not S.spend(p.price) then return end
			S.data.props[p.id] = true
			S.save(true)
			S.fire("big", "PROPERTY BOUGHT", p.name, C3(120, 255, 140))
			APPS.Property(S)
		end})
	end
	if #items == 0 then items = {{title = "No properties yet", sub = "Coming soon"}} end
	rows(S, "Property", items)
end
APPS.Radio = function(S)
	page = "Radio"
	local items = {{title = "Radio Off", sub = "", click = function() S.fire("radioSet", 0) end}}
	for i, st in ipairs(S.C.RADIO) do
		table.insert(items, {title = st.name, sub = #st.songs > 0 and (#st.songs .. " songs") or "Add songs in SB_Config.RADIO", color = st.color:Lerp(C3(0, 0, 0), 0.6), click = function() S.fire("radioSet", i) end})
	end
	rows(S, "Radio", items)
end
APPS.Stats = function(S)
	page = "Stats"
	local st = S.data.stats
	local found = 0
	for _ in pairs(S.data.packages) do found += 1 end
	local stunts = 0
	for _ in pairs(S.data.stunts) do stunts += 1 end
	rows(S, "Stats", {
		{title = "Money earned", sub = S.L.money(st.earned or 0)},
		{title = "Distance driven", sub = string.format("%.1f miles", (st.distance or 0) * 0.000174)},
		{title = "Hidden packages", sub = found .. " / " .. (S.World and S.World.totalPackages or 16)},
		{title = "Unique stunts", sub = tostring(stunts)},
		{title = "Jobs done", sub = tostring(st.jobs or 0)},
		{title = "Races won", sub = tostring(st.races or 0)},
		{title = "Cars owned", sub = tostring(#S.data.cars)},
		{title = "Time played", sub = string.format("%d min", math.floor((st.time or 0) / 60))},
	})
end
APPS.Settings = function(S)
	page = "Settings"
	local q = {"Low", "Medium", "High"}
	rows(S, "Settings", {
		{title = "Graphics: " .. S.settings.quality, sub = "tap to change", click = function()
			local i = table.find(q, S.settings.quality) or 2
			S.settings.quality = q[i % 3 + 1]
			S.markDirty()
			APPS.Settings(S)
		end},
		{title = "Radio volume: " .. math.floor(S.settings.music * 100) .. "%", sub = "tap to change", click = function()
			S.settings.music = (math.floor(S.settings.music * 10 + 0.5) % 10 + 1) / 10
			S.applyVolumes() S.markDirty() APPS.Settings(S)
		end},
		{title = "Effects volume: " .. math.floor(S.settings.sfx * 100) .. "%", sub = "tap to change", click = function()
			S.settings.sfx = (math.floor(S.settings.sfx * 10 + 0.5) % 10 + 1) / 10
			S.applyVolumes() S.markDirty() APPS.Settings(S)
		end},
		{title = "Speed: " .. S.settings.units, sub = "tap to change", click = function()
			S.settings.units = S.settings.units == "MPH" and "KMH" or "MPH"
			S.markDirty() APPS.Settings(S)
		end},
		{title = "Save game now", sub = "", click = function() S.save(true) S.fire("notify", "Saved", "Your progress is saved.") end},
	})
end
APPS.Camera = function(S)
	Ph.toggle(S, false)
	S.fire("photoMode", true)
end

----------------------------------------------------------------------------------------------------
-- FULL MAP
----------------------------------------------------------------------------------------------------
local mapBuilt = false
local mapScale
local waypoint
local function buildFullMap(S)
	local canvas = Ph.m.Map.Canvas
	local M = S.C.MAP
	local minX, maxX, minZ, maxZ = M.X[1] - 200, M.ISLAND.cx + M.ISLAND.r + 60, M.Z[1] - 200, M.DOCKS_Z + 120
	local w, h = maxX - minX, maxZ - minZ
	mapScale = math.min(900 / w, 700 / h)
	canvas.Size = U2(0, w * mapScale, 0, h * mapScale)
	local function px(x, z) return (x - minX) * mapScale, (z - minZ) * mapScale end
	Ph.mapPx = px
	local function rect(x, z, sw, sd, col, rot, zi, round)
		local f = Instance.new("Frame")
		local a, b = px(x, z)
		f.AnchorPoint, f.Position, f.Size, f.BackgroundColor3, f.BorderSizePixel, f.Rotation, f.ZIndex = V2(0.5, 0.5), U2(0, a, 0, b), U2(0, math.max(2, sw * mapScale), 0, math.max(2, sd * mapScale)), col, 0, rot or 0, zi or 1
		if round then local c = Instance.new("UICorner") c.CornerRadius = UDim.new(1, 0) c.Parent = f end
		f.Parent = canvas
		return f
	end
	rect((M.X[1] - 130 + M.SEA_X) / 2, (M.Z[1] - 130 + M.DOCKS_Z) / 2, M.SEA_X - M.X[1] + 130, M.DOCKS_Z - M.Z[1] + 130, C3(48, 42, 98), 0, 1)
	rect((M.BEACH_X[1] + M.BEACH_X[2]) / 2 + 20, 0, M.BEACH_X[2] - M.BEACH_X[1] + 40, 1700, C3(222, 160, 160), 0, 1)
	rect(M.ISLAND.cx, M.ISLAND.cz, M.ISLAND.r * 2, M.ISLAND.r * 2, C3(54, 78, 120), 0, 1, true)
	local G = S.L.graph()
	for _, r in ipairs(G.roads) do
		local a, b = G.nodes[r.a].pos, G.nodes[r.b].pos
		local mid = (a + b) / 2
		rect(mid.X, mid.Z, (b - a).Magnitude + 30, 26, r.kind == "boulevard" and C3(255, 120, 200) or C3(185, 195, 240), math.deg(math.atan2(b.Z - a.Z, b.X - a.X)), 2)
	end
	-- places
	local places = S.city and S.city:FindFirstChild("Places")
	if places then
		for _, m in ipairs(places:GetChildren()) do
			local p = m:GetPivot().Position
			local f = rect(p.X, p.Z, 22 / mapScale, 22 / mapScale, C3(0, 230, 255), 0, 4, true)
				local fs = Instance.new("UIStroke") fs.Thickness, fs.Color = 2, C3(255, 255, 255) fs.Parent = f
			local t = Instance.new("TextLabel")
			t.Size, t.Position, t.BackgroundTransparency, t.Text, t.TextColor3, t.Font, t.TextSize = U2(0, 140, 0, 18), U2(0.5, -70, 1, 2), 1, (m:GetAttribute("Kind") or m.Name), C3(255, 255, 255), Enum.Font.GothamBold, 11
			local st = Instance.new("UIStroke") st.Thickness = 1.5 st.Parent = t
			t.Parent = f
		end
	end
	local you = rect(0, 0, 26 / mapScale, 26 / mapScale, C3(255, 46, 151), 0, 6, true)
	local ys = Instance.new("UIStroke") ys.Thickness, ys.Color = 2.5, C3(255, 255, 255) ys.Parent = you
	you.Name = "You"
	mapBuilt = true
	-- click to set a waypoint
	canvas.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			-- the canvas is UIScaled to fit the screen: convert screen pixels back to design pixels
			local us = (canvas.AbsoluteSize.X > 0 and canvas.Size.X.Offset > 0) and canvas.AbsoluteSize.X / canvas.Size.X.Offset or 1
			local rel = (V2(i.Position.X, i.Position.Y) - canvas.AbsolutePosition) / us
			local x = rel.X / mapScale + minX
			local z = rel.Y / mapScale + minZ
			local p = S.L.nearestRoad(V3(x, 0, z))
			waypoint = p
			S.waypoint = p
			if Ph.wpFrame then Ph.wpFrame:Destroy() end
			Ph.wpFrame = rect(p.X, p.Z, 16 / mapScale, 16 / mapScale, C3(255, 220, 60), 45, 5)
			S.addBlip("waypoint", function() return S.waypoint end, C3(255, 220, 60), 12, "square")
			S.fire("notify", "Waypoint", "Waypoint set. Follow the yellow marker.", C3(255, 220, 60))
		end
	end)
end
function Ph.toggleMap(S, on)
	local m = Ph.m.Map
	if on == nil then on = not m.Visible end
	if on and S.mode ~= "play" then return end
	if on and open then Ph.toggle(S, false) end
	if not mapBuilt then buildFullMap(S) end
	m.Visible = on
	if on then
		local ch, hrp = S.char()
		local p = (S.inCar and S.car and S.car.root.Position) or (hrp and hrp.Position) or V3()
		local a, b = Ph.mapPx(p.X, p.Z)
		m.Canvas.You.Position = U2(0, a, 0, b)
	end
end

----------------------------------------------------------------------------------------------------
-- PHONE OPEN / CLOSE
----------------------------------------------------------------------------------------------------
local shownId = 0
function Ph.toggle(S, on)
	if on == nil then on = not open end
	if on and S.mode ~= "play" then return end
	open = on
	shownId += 1
	local my = shownId
	local phone, back = Ph.g.Phone, Ph.g.Backdrop
	if on then
		phone.Visible = true
		back.Visible = true
		back.BackgroundTransparency = S.isTouch and 0.55 or 0.8
	end
	TS:Create(phone, TweenInfo.new(0.35, Enum.EasingStyle.Quart), {Position = on and U2(1, -16, 1, -16) or U2(1, -16, 1, 560)}):Play()
	if on then S.play("PhoneOpen") home() else
		back.Visible = false
		task.delay(0.4, function() if shownId == my and not open then phone.Visible = false end end)
	end
	S.phoneOpen = on
end
function Ph.start(S)
	local apps = Ph.g.Phone.Screen.Apps
	for name, fn in pairs(APPS) do
		local b = apps:FindFirstChild(name)
		if b then b.MouseButton1Click:Connect(function() S.play("Click") fn(S) end) end
	end
	local mapBtn = apps:FindFirstChild("Map")
	if mapBtn then mapBtn.MouseButton1Click:Connect(function() Ph.toggle(S, false) Ph.toggleMap(S, true) end) end
	Ph.g.Phone.Screen.Page.Back.MouseButton1Click:Connect(function() S.play("Click") home() end)
	-- home bar: back to the home screen, tap again to close; tapping outside closes too
	Ph.g.Phone.Home.MouseButton1Click:Connect(function() S.play("Click") if page then home() else Ph.toggle(S, false) end end)
	Ph.g.Backdrop.MouseButton1Click:Connect(function() Ph.toggle(S, false) end)
	Ph.m.Map.Close.MouseButton1Click:Connect(function() Ph.toggleMap(S, false) end)
	S.on("action", function(a)
		if a == "phone" then Ph.toggle(S)
		elseif a == "map" then Ph.toggleMap(S)
		elseif a == "back" then
			if Ph.m.Map.Visible then Ph.toggleMap(S, false) elseif page then home() elseif open then Ph.toggle(S, false) end
		end
	end)
	-- phone clock
	task.spawn(function()
		while true do
			local h = S.getTime and S.getTime() or 12
			local t = string.format("%02d:%02d", math.floor(h), math.floor((h % 1) * 60))
				Ph.g.Phone.Time.Text = t
				Ph.g.Phone.Screen.Widget.WTime.Text = t
			task.wait(1)
		end
	end)
	-- distance + play time stats
	local last
	task.spawn(function()
		while true do
			task.wait(1)
			if S.mode == "play" then
				S.data.stats.time = (S.data.stats.time or 0) + 1
				if S.inCar and S.car then
					local p = S.car.root.Position
					if last then S.data.stats.distance = (S.data.stats.distance or 0) + (p - last).Magnitude end
					last = p
				else last = nil end
			end
		end
	end)
	-- arriving at the waypoint clears it
	task.spawn(function()
		while true do
			task.wait(0.5)
			if S.waypoint then
				local ch, hrp = S.char()
				local p = (S.inCar and S.car and S.car.root.Position) or (hrp and hrp.Position)
				if p and ((p - S.waypoint) * V3(1, 0, 1)).Magnitude < 25 then
					S.waypoint = nil
					S.removeBlip("waypoint")
					if Ph.wpFrame then Ph.wpFrame:Destroy() Ph.wpFrame = nil end
				end
			end
		end
	end)
	S.togglePhone = function(on) Ph.toggle(S, on) end
end
return Ph
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXSPolice"><Properties><string name="Name">Police</string><ProtectedString name="Source"><![CDATA[--[[
	Police | StarterPlayerScripts.SB (ModuleScript)
	Heat and chases (single player, all on this computer).
	  * you get stars (S.wanted 0..5) for crimes: hitting people, smashing police cars, ramming traffic
	    in front of a cop, driving very fast past a police car, running red lights in front of police
	  * police cars (Interceptor) come from the road network: they drive the roads toward you, then chase
	    you directly when close, with flashing lights and sirens; more stars = more cars, faster, harder hits
	  * 4+ stars: a police helicopter with a searchlight hovers over you
	  * lose them: get out of their sight (no police car within 240 studs) - the stars flash, and when the
	    timer runs out they are gone; a new paint job or sleeping also clears them
	  * BUSTED: standing still next to a police car for a few seconds -> you lose some cash
]]
local Pol = {}
local Run = game:GetService("RunService")
local TS = game:GetService("TweenService")
local C3, V3, CF, A, rad = Color3.fromRGB, Vector3.new, CFrame.new, CFrame.Angles, math.rad

local cops = {}
local heli
local folder
local wanted, lastSeen, escapeStart = 0, 0, nil
local SIGHT = 240
local ESCAPE = {0, 12, 18, 25, 32, 40} -- seconds out of sight to lose each level

function Pol.init(S)
	folder = Instance.new("Folder")
	folder.Name = "SB_Police"
	folder.Parent = workspace
	S.wanted = 0
	S.extraBlockers = cops
end

local function setWanted(S, n, why)
	n = math.clamp(n, 0, 5)
	if n == wanted then return end
	local up = n > wanted
	wanted = n
	S.wanted = n
	lastSeen = os.clock()
	escapeStart = nil
	S.wantedFlash = false
	if up then S.fire("notify", "Police", (why or "The police are after you!") .. "  " .. string.rep("★", n), C3(80, 140, 255)) end
	S.fire("wantedChanged", n)
end
Pol.setWanted = setWanted

----------------------------------------------------------------------------------------------------
-- POLICE CARS
----------------------------------------------------------------------------------------------------
local rpGround = RaycastParams.new()
rpGround.FilterType = Enum.RaycastFilterType.Include
local function groundY(p)
	local hit = workspace:Raycast(p + V3(0, 15, 0), V3(0, -40, 0), rpGround)
	return hit and hit.Position.Y or 0
end
local function spawnCop(S)
	local g = S.L.graph()
	local ch, hrp = S.char()
	local pp = (S.inCar and S.car and S.car.root.Position) or (hrp and hrp.Position)
	if not pp then return end
	-- a road node 220-380 studs away
	local cands = {}
	for i, n in ipairs(g.nodes) do
		local d = ((n.pos - pp) * V3(1, 0, 1)).Magnitude
		if d > 220 and d < 380 then table.insert(cands, i) end
	end
	if #cands == 0 then return end
	local a = cands[math.random(#cands)]
	local b = g.nodes[a].links[math.random(#g.nodes[a].links)]
	local c = S.trafficSpawn("Interceptor", a, b, 25, 1, {police = true, keep = true, ignoreLights = true, cruise = 70})
	if not c then return end
	c.sirens = {}
	for _, p in ipairs(c.model:GetDescendants()) do
		if p:IsA("BasePart") and (p.Name == "SirenRed" or p.Name == "SirenBlue") then table.insert(c.sirens, p) end
		if p:IsA("PointLight") and p.Parent and (p.Parent.Name == "SirenRed" or p.Parent.Name == "SirenBlue") then p.Enabled = true end
	end
	c.siren = S.sound("Siren", c.root, {Looped = true, Volume = 0.7, RollOffMaxDistance = 300})
	if c.siren then c.siren:Play() end
	-- follow the shortest route to the player while far away
	c.chooseNext = function(cc)
		local node = S.L.nearestNode(pp)
		local route = S.L.route(cc.b, node)
		return route[2] or g.nodes[cc.b].links[math.random(#g.nodes[cc.b].links)]
	end
	c.mode = "road"
	table.insert(cops, c)
	return c
end
local function removeCop(S, c)
	local i = table.find(cops, c)
	if i then table.remove(cops, i) end
	S.trafficRemove(c)
end
local function updateCop(S, c, dt, pp, pvel)
	local dist = ((c.pos or c.root.Position) - pp).Magnitude
	if c.mode == "road" then
		c.cruise = 60 + wanted * 6
		S.trafficDrive(c, dt)
		c.root.CFrame = CF(c.pos + V3(0, c.lift, 0), c.pos + V3(0, c.lift, 0) + c.dir)
		if dist < 80 then
			c.mode = "chase"
			c.vel = c.dir * c.speed
		end
	elseif c.mode == "chase" then
		-- steer straight at where the player will be in a moment
		local aim = pp + pvel * 0.4
		local to = V3(aim.X - c.pos.X, 0, aim.Z - c.pos.Z)
		local want = to.Magnitude > 0.1 and to.Unit or c.dir
		local turnRate = 2.2 + wanted * 0.2
		local ang = math.acos(math.clamp(c.dir:Dot(want), -1, 1))
		local k = math.min(1, turnRate * dt / math.max(ang, 1e-3))
		c.dir = c.dir:Lerp(want, k).Unit
		local top = 85 + wanted * 10
		local wantSpeed = math.clamp(to.Magnitude * 2.2, 0, top)
		if to.Magnitude < 10 then wantSpeed = math.min(wantSpeed, pvel.Magnitude + 5) end
		c.speed += math.clamp(wantSpeed - c.speed, -60 * dt, 40 * dt)
		local np = c.pos + c.dir * c.speed * dt
		np = V3(np.X, groundY(np), np.Z)
		c.pos = np
		c.root.CFrame = CF(np + V3(0, c.lift, 0), np + V3(0, c.lift, 0) + c.dir)
		-- spin wheels
		c.spin = ((c.spin or 0) + c.speed * dt / 1.3) % (math.pi * 2)
		for _, w in ipairs(c.wheels) do w.m.Transform = CFrame.Angles(-c.spin, 0, 0) end
		-- ram: push the player's car
		if S.inCar and S.car and dist < 8 and c.speed > 15 and os.clock() - (c.lastRam or 0) > 1 then
			c.lastRam = os.clock()
			local push = (pp - c.pos).Unit * (10 + wanted * 4)
			S.car.root.AssemblyLinearVelocity += V3(push.X, 4, push.Z)
			c.speed *= 0.4
			S.play("Crash", {Volume = 0.6}, pp)
			S.car.health -= 25 + wanted * 10
		end
		if dist > 260 then c.mode = "road" c.turning = nil c.a, c.b, c.d = S.L.nearestNode(c.pos), nil, 0
			local g = S.L.graph()
			c.b = g.nodes[c.a].links[1]
		end
	end
	-- sirens flash
	local phase = (os.clock() * 5) % 2 < 1
	for _, p in ipairs(c.sirens or {}) do
		local on = (p.Name == "SirenRed") == phase
		p.Material = on and Enum.Material.Neon or Enum.Material.SmoothPlastic
		p.Color = on and (p:GetAttribute("OnColor") or p.Color) or (p.Name == "SirenRed" and C3(90, 20, 20) or C3(20, 30, 90))
	end
	return dist
end

----------------------------------------------------------------------------------------------------
-- HELICOPTER (4+ stars)
----------------------------------------------------------------------------------------------------
local function buildHeli()
	local m = Instance.new("Model")
	m.Name = "PoliceHeli"
	local function p(name, size, cf, col, mat, shape)
		local x = Instance.new("Part")
		x.Name, x.Size, x.CFrame, x.Color, x.Material, x.Anchored, x.CanCollide, x.CanQuery = name, size, cf, col, mat or Enum.Material.SmoothPlastic, true, false, false
		if shape then x.Shape = shape end
		x.Parent = m
		return x
	end
	local body = p("Body", V3(5, 4.5, 9), CF(), C3(25, 25, 30))
	p("Glass", V3(4.4, 3, 2.6), CF(0, 0.4, -4.6), C3(60, 90, 120), Enum.Material.Glass)
	p("Tail", V3(1.2, 1.2, 10), CF(0, 0.8, 9), C3(25, 25, 30))
	p("Fin", V3(0.3, 3, 2), CF(0, 2.4, 13.4), C3(240, 240, 240))
	p("Stripe", V3(5.05, 0.8, 7), CF(0, -0.6, 0), C3(240, 240, 240))
	for s = -1, 1, 2 do p("Skid", V3(0.4, 0.4, 9), CF(s * 2.2, -3.4, 0), C3(60, 60, 65), Enum.Material.Metal) end
	p("Mast", V3(0.6, 1.2, 0.6), CF(0, 2.85, 0), C3(60, 60, 65), Enum.Material.Metal)
	local rotor = p("Rotor", V3(26, 0.2, 1.2), CF(0, 3.5, 0), C3(30, 30, 30))
	local rotor2 = p("Rotor2", V3(1.2, 0.2, 26), CF(0, 3.5, 0), C3(30, 30, 30))
	local tailR = p("TailRotor", V3(0.2, 4, 0.5), CF(0.8, 1, 13.6), C3(30, 30, 30))
	local lamp = p("Searchlight", V3(1, 1, 1), CF(0, -2.6, -3), C3(255, 255, 230), Enum.Material.Neon, Enum.PartType.Ball)
	local sl = Instance.new("SpotLight")
	sl.Face, sl.Angle, sl.Range, sl.Brightness, sl.Color, sl.Shadows = Enum.NormalId.Bottom, 40, 120, 6, C3(255, 255, 235), false
	sl.Parent = lamp
	-- visible beam
	local beam = p("Beam", V3(0.2, 60, 0.2), CF(0, -32, -3), C3(255, 255, 220), Enum.Material.Neon)
	beam.Transparency = 0.85
	local bl = p("Blink", V3(0.5, 0.5, 0.5), CF(0, -2.4, 4), C3(255, 30, 30), Enum.Material.Neon, Enum.PartType.Ball)
	m.PrimaryPart = body
	return m, {body = body, rotor = rotor, rotor2 = rotor2, tailR = tailR, lamp = lamp, beam = beam, blink = bl}
end
local heliParts
local heliOffsets
local heliPos, heliYaw = nil, 0
local function updateHeli(S, dt, pp)
	if wanted >= 4 then
		if not heli then
			heli, heliParts = buildHeli()
			heli.Parent = folder
			heliPos = pp + V3(200, 120, 200)
			local rs = S.sound("Wind", heliParts.body, {Looped = true, Volume = 0.8, PlaybackSpeed = 0.5, RollOffMaxDistance = 400})
			if rs then rs:Play() end
		end
		local target = pp + V3(math.sin(os.clock() * 0.3) * 40, 70, math.cos(os.clock() * 0.3) * 40)
		heliPos = heliPos:Lerp(target, math.min(1, dt * 0.6))
		local look = V3(pp.X - heliPos.X, 0, pp.Z - heliPos.Z)
		local yaw = math.atan2(-look.X, -look.Z)
		heliYaw = heliYaw + (yaw - heliYaw) * math.min(1, dt * 1.5)
		local base = CF(heliPos) * A(0, heliYaw, 0) * A(rad(-8), 0, math.sin(os.clock()) * 0.05)
		local t = os.clock()
		local hp = heliParts
		hp.body.CFrame = base
		-- move every part with the body (they were built around the origin)
		if not heliOffsets then
			heliOffsets = {}
			for _, x in ipairs(heli:GetChildren()) do if x:IsA("BasePart") then heliOffsets[x] = x.CFrame end end
		end
		for x, off in pairs(heliOffsets) do
			if x == hp.rotor or x == hp.rotor2 then x.CFrame = base * off * A(0, t * 25, 0)
			elseif x == hp.tailR then x.CFrame = base * off * A(t * 30, 0, 0)
			elseif x == hp.beam or x == hp.lamp then
				-- the searchlight points at the player
				local lampW = (base * heliOffsets[hp.lamp]).Position
				local dir = (pp - lampW)
				if x == hp.lamp then x.CFrame = CF(lampW, pp) * A(rad(-90), 0, 0)
				else x.CFrame = CF(lampW + dir / 2, pp) * A(rad(90), 0, 0) x.Size = V3(1.5, dir.Magnitude, 1.5) end
			else x.CFrame = base * off end
		end
		hp.blink.Transparency = (t % 1 < 0.5) and 0 or 1
	elseif heli then
		heli:Destroy()
		heli, heliParts, heliOffsets = nil, nil, nil
	end
end

----------------------------------------------------------------------------------------------------
-- START
----------------------------------------------------------------------------------------------------
function Pol.start(S)
	rpGround.FilterDescendantsInstances = {S.city and S.city:FindFirstChild("Roads"), S.city and S.city:FindFirstChild("Ground"), S.city and S.city:FindFirstChild("Sidewalks"), S.city and S.city:FindFirstChild("Beach")}
	S.setWanted = function(n, why) setWanted(S, n, why) end
	S.on("crime", function(kind, pos)
		local seen = false
		for _, c in ipairs(cops) do if (c.pos - pos).Magnitude < SIGHT then seen = true end end
		if kind == "ped" then setWanted(S, math.max(wanted, 1) + (wanted >= 1 and (seen and 1 or 0) or 0), "Hit and run!")
		elseif kind == "cop" then setWanted(S, wanted + 1, "You hit a police car!")
		elseif kind == "speed" and wanted == 0 then setWanted(S, 1, "Speeding!")
		elseif kind == "redlight" and wanted == 0 then setWanted(S, 1, "You ran a red light!") end
	end)
	S.on("heat", function(what) if what == "clear" then setWanted(S, 0) for i = #cops, 1, -1 do removeCop(S, cops[i]) end end end)
	-- traffic hit in front of a cop / any cop car hit
	S.on("trafficHit", function(c, force)
		if c.police then S.fire("crime", "cop", c.pos) return end
		for _, k in ipairs(cops) do if (k.pos - c.pos).Magnitude < 120 then S.fire("crime", "speed", c.pos) break end end
	end)
	local busted = 0
	Run.Heartbeat:Connect(function(dt)
		if S.mode ~= "play" then return end
		local ch, hrp = S.char()
		local pcar = S.inCar and S.car
		local pp = (pcar and pcar.root.Position) or (hrp and hrp.Position)
		if not pp then return end
		local pvel = (pcar and pcar.root.AssemblyLinearVelocity) or (hrp and hrp.AssemblyLinearVelocity) or V3()
		-- how many police cars we want
		local want = ({0, 1, 2, 3, 4, 5})[wanted + 1]
		if #cops < want and math.random() < dt * 0.6 then spawnCop(S) end
		while #cops > want do removeCop(S, cops[#cops]) end
		local closest = math.huge
		for i = #cops, 1, -1 do
			local c = cops[i]
			if not c.model.Parent then table.remove(cops, i) continue end
			local d = updateCop(S, c, dt, pp, pvel)
			closest = math.min(closest, d)
			if d > 600 then removeCop(S, c) end
		end
		updateHeli(S, dt, pp)
		if wanted > 0 then
			-- seen? (a cop near, or the helicopter)
			if closest < SIGHT or (heli and wanted >= 4 and math.random() < 0.5) then
				lastSeen = os.clock()
				escapeStart = nil
				S.wantedFlash = false
			else
				escapeStart = escapeStart or os.clock()
				S.wantedFlash = true
				if os.clock() - escapeStart > ESCAPE[wanted + 1] then
					setWanted(S, 0)
					S.fire("notify", "Police", "You lost them.", C3(80, 140, 255))
					S.stat("escapes")
				end
			end
			-- busted: still and next to a police car
			local speed = pvel.Magnitude
			if closest < 12 and speed < 4 then
				busted += dt
				if busted > 3 then
					busted = 0
					local fine = math.min(5000, math.floor(S.cash() * 0.1))
					S.addCash(-fine, "busted")
					setWanted(S, 0)
					for k = #cops, 1, -1 do removeCop(S, cops[k]) end
					S.fire("busted", fine)
				end
			else
				busted = math.max(0, busted - dt)
			end
		end
		-- speeding next to a police car (only when you are not wanted)
		if wanted == 0 and pcar and pvel.Magnitude > 120 then
			for _, c in ipairs(S.traffic or {}) do if c.key == "Interceptor" and (c.pos - pp).Magnitude < 60 then S.fire("crime", "speed", pp) break end end
		end
	end)
	-- a few police cars patrol as normal traffic (they notice speeding)
	task.spawn(function()
		while true do
			task.wait(20)
			if S.mode == "play" and wanted == 0 and math.random() < 0.6 then
				local g = S.L.graph()
				local r = g.roads[math.random(#g.roads)]
				local p = S.trafficLane(r.a, r.b, 40, 1)
				if (p - S.cam.CFrame.Position).Magnitude > 150 and (p - S.cam.CFrame.Position).Magnitude < 350 then
					local cnt = 0
					for _, c in ipairs(S.traffic) do if c.key == "Interceptor" then cnt += 1 end end
					if cnt < 2 then S.trafficSpawn("Interceptor", r.a, r.b, 40, 1) end
				end
			end
		end
	end)
	S.policeCount = function() return #cops end
end
return Pol
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXSTraffic"><Properties><string name="Name">Traffic</string><ProtectedString name="Source"><![CDATA[--[[
	Traffic | StarterPlayerScripts.SB (ModuleScript)
	AI cars that drive the road network around you (only on this computer, so they cost no network).
	  * cars appear on lanes 120-350 studs away and disappear beyond 460 (amount from the quality setting)
	  * they keep to the right lane, follow the road, and pick a new road at every crossing
	  * smooth curved turns at crossings (a little bezier curve through the corner)
	  * they stop at red lights, slow down behind other cars and for the player, and honk if you block them
	  * headlights and brake lights at night / when braking, wheels turn
	  * a hard hit from the player knocks the car loose: it becomes a real physics car you can push (and take)
	Cars are moved by their anchored chassis only (the rest is welded to it) = very cheap.
	S.traffic is the list; Police uses the same driving code (S.trafficDrive).
]]
local T = {}
local Run = game:GetService("RunService")
local C3, V3, CF, A = Color3.fromRGB, Vector3.new, CFrame.new, CFrame.Angles

local list = {}
local folder
local MODELS
local KEYS = {"Glide", "Glide", "Glide", "Cabbie", "Hauler", "Rancher", "Van", "Glide", "Stallion", "Coastline"}
local SPEED = {street = 42, boulevard = 36, bridge = 62, island = 34}

local function setLamp(list2, on)
	for _, p in ipairs(list2) do
		if on then
			if not p:GetAttribute("OffColor") then p:SetAttribute("OffColor", p.Color) end
			p.Material, p.Color = Enum.Material.Neon, p:GetAttribute("OnColor") or p.Color
		else
			p.Material = Enum.Material.SmoothPlastic
			local off = p:GetAttribute("OffColor")
			if off then p.Color = off end
		end
	end
end

function T.init(S)
	MODELS = S.SB:WaitForChild("Cars")
	folder = Instance.new("Folder")
	folder.Name = "SB_Traffic"
	folder.Parent = workspace
	S.traffic = list
	T.S = S
end

----------------------------------------------------------------------------------------------------
-- PATH: a car drives along road (a -> b) at distance d; at the end it takes a curve to the next road
----------------------------------------------------------------------------------------------------
local function roadLen(g, a, b) return (g.nodes[a].pos - g.nodes[b].pos).Magnitude end
local function pickNext(g, from, at, avoidBack)
	local links = g.nodes[at].links
	local options = {}
	for _, n in ipairs(links) do if n ~= from or #links == 1 then table.insert(options, n) end end
	if #options == 0 then return from end
	-- prefer going straight a bit more often
	local dirIn = (g.nodes[at].pos - g.nodes[from].pos).Unit
	local best = options[math.random(#options)]
	if math.random() < 0.45 then
		local bd = -2
		for _, n in ipairs(options) do
			local d = (g.nodes[n].pos - g.nodes[at].pos).Unit:Dot(dirIn)
			if d > bd then best, bd = n, d end
		end
	end
	return best
end
-- the lane point at distance d along road a->b (lane offset to the right)
local function lanePos(S, g, a, b, d, lane)
	local pa, pb = g.nodes[a].pos, g.nodes[b].pos
	local dir = (pb - pa).Unit
	local right = V3(-dir.Z, 0, dir.X)
	local off = lane == 2 and (S.C.MAP.LANE + 3) or (S.C.MAP.LANE - 3)
	return pa + dir * d + right * off, dir
end
local function bezier(p0, p1, p2, t)
	local a = p0:Lerp(p1, t)
	local b = p1:Lerp(p2, t)
	return a:Lerp(b, t)
end
-- how far before a crossing a car must stop (the stop line)
local function stopDist(S) return S.C.MAP.ROAD_W / 2 + S.C.MAP.WALK_W + 2 end

----------------------------------------------------------------------------------------------------
-- DRIVER: advance a traffic car (also used for police with a custom target)
----------------------------------------------------------------------------------------------------
-- c = {model, root, a, b, d, lane, speed, target, turning = {p0,p1,p2,t,len,next}, ...}
local function blocked(S, c, ahead)
	-- anything in front within 'ahead' studs on our lane?
	local pos = c.pos
	local fwd = c.dir
	local best = math.huge
	for _, o in ipairs(list) do
		if o ~= c and o.pos then
			local rel = o.pos - pos
			local along = rel:Dot(fwd)
			if along > 0 and along < ahead then
				local side = (rel - fwd * along).Magnitude
				if side < 4 then best = math.min(best, along) end
			end
		end
	end
	-- the player (car or on foot)
	local ch, hrp = S.char()
	local pp = (S.inCar and S.car and S.car.root.Position) or (hrp and hrp.Position)
	if pp then
		local rel = pp - pos
		local along = rel:Dot(fwd)
		if along > 0 and along < ahead then
			local side = (V3(rel.X, 0, rel.Z) - fwd * along).Magnitude
			if side < 5 then best = math.min(best, along) c.playerBlock = true else c.playerBlock = false end
		end
	end
	-- police / other drivers registered in S.extraBlockers
	for _, o in ipairs(S.extraBlockers or {}) do
		if o ~= c and o.pos then
			local rel = o.pos - pos
			local along = rel:Dot(fwd)
			if along > 0 and along < ahead and (rel - fwd * along).Magnitude < 4 then best = math.min(best, along) end
		end
	end
	return best
end
local function drive(S, c, dt)
	local g = S.L.graph()
	if not c.pos then c.pos, c.dir = lanePos(S, g, c.a, c.b, c.d, c.lane) end
	local cruise = c.cruise or SPEED[c.kind] or 40
	local want = cruise
	-- traffic lights: before the stop line of a 4-way crossing
	local len = roadLen(g, c.a, c.b)
	if not c.turning and not c.ignoreLights then
		local toEnd = len - c.d
		local node = g.nodes[c.b]
		if #node.links == 4 and toEnd < stopDist(S) + 14 and toEnd > stopDist(S) - 2 then
			local dir = (node.pos - g.nodes[c.a].pos)
			local axis = math.abs(dir.X) > math.abs(dir.Z) and "X" or "Z"
			local stl = S.signalState(c.b, axis)
			if stl == "red" or (stl == "yellow" and toEnd > stopDist(S) + 6) then
				want = math.min(want, math.max(0, (toEnd - stopDist(S)) * 2.2))
			end
		end
	end
	-- something in front
	local gap = blocked(S, c, 26)
	if gap < 26 then want = math.min(want, math.max(0, (gap - 8) * 2.5)) end
	if c.playerBlock and gap < 12 then
		c.blockedFor = (c.blockedFor or 0) + dt
		if c.blockedFor > 2.5 and not c.honked then c.honked = true S.fire("trafficHorn", c) end
	else c.blockedFor, c.honked = 0, false end
	-- accelerate / brake
	local acc = want > c.speed and 14 or 36
	c.speed += math.clamp(want - c.speed, -acc * dt, acc * dt)
	c.braking = want < c.speed - 2 or (want < 2)
	local move = c.speed * dt
	if c.turning then
		local tn = c.turning
		tn.t += move / math.max(tn.len, 1)
		if tn.t >= 1 then
			c.a, c.b, c.d, c.turning = tn.from, tn.to, stopDist(S) - 1, nil
			c.kind = tn.kind
		else
			local p = bezier(tn.p0, tn.p1, tn.p2, tn.t)
			local q = bezier(tn.p0, tn.p1, tn.p2, math.min(1, tn.t + 0.05))
			c.pos, c.dir = p, (q - p).Magnitude > 0.01 and (q - p).Unit or c.dir
		end
	end
	if not c.turning then
		c.d += move
		if c.d >= len - stopDist(S) + 1 then
			-- start a curve to the next road
			local nxt = c.chooseNext and c.chooseNext(c) or pickNext(g, c.a, c.b)
			local p0 = lanePos(S, g, c.a, c.b, len - stopDist(S) + 1, c.lane)
			local nlen = roadLen(g, c.b, nxt)
			local p2 = lanePos(S, g, c.b, nxt, math.min(stopDist(S) - 1, nlen * 0.5), c.lane)
			local corner = g.nodes[c.b].pos
			-- control point: where the two lane lines would meet (keeps right turns tight, left turns wide)
			local d1 = (corner - g.nodes[c.a].pos).Unit
			local d2 = (g.nodes[nxt].pos - corner).Unit
			local p1 = (p0 + p2) / 2
			if math.abs(d1:Dot(d2)) < 0.5 then
				local r1 = V3(-d1.Z, 0, d1.X)
				local r2 = V3(-d2.Z, 0, d2.X)
				local off = c.lane == 2 and (S.C.MAP.LANE + 3) or (S.C.MAP.LANE - 3)
				p1 = corner + r1 * off + r2 * off
			elseif d1:Dot(d2) < -0.5 then
				p1 = corner + d1 * 6 -- U-turn at a dead end
			end
			local kind = "street"
			for _, r in ipairs(g.roads) do if (r.a == c.b and r.b == nxt) or (r.b == c.b and r.a == nxt) then kind = r.kind break end end
			c.turning = {p0 = p0, p1 = p1, p2 = p2, t = 0, len = (p1 - p0).Magnitude + (p2 - p1).Magnitude, from = c.b, to = nxt, kind = kind}
			c.pos, c.dir = p0, d1
		else
			c.pos, c.dir = lanePos(S, g, c.a, c.b, c.d, c.lane)
		end
	end
	return c
end
T.drive = drive

----------------------------------------------------------------------------------------------------
-- SPAWN / REMOVE
----------------------------------------------------------------------------------------------------
local function makeModel(S, key, color)
	-- traffic, police and race rivals use the cheap low-detail "<Key>_Lite" model (the full one is swapped in when the player takes the car)
	local tpl = MODELS:FindFirstChild(key .. "_Lite") or MODELS:FindFirstChild(key)
	if not tpl then return nil end
	local m = tpl:Clone()
	for _, p in ipairs(m:GetDescendants()) do
		if p:IsA("BasePart") then
			if p.Name == "Paint" and p:GetAttribute("Panel") ~= "Door" and color then p.Color = color end
			if p.Name == "Contact" then p.CanCollide = false end
		elseif p:IsA("Light") then
			p.Enabled = false
			p:SetAttribute("Car", true)
		end
	end
	local root = m.PrimaryPart
	root.Anchored = true
	local cf, size = m:GetBoundingBox()
	local lift = root.Position.Y - (cf.Position.Y - size.Y / 2)
	return m, root, lift
end
function T.spawn(S, key, a, b, d, lane, opts)
	local cfg = S.C.CARS[key]
	if not cfg then return end
	local col = cfg.colours[math.random(#cfg.colours)]
	local m, root, lift = makeModel(S, key, (opts and opts.color) or col)
	if not m then return end
	local g = S.L.graph()
	local kind = "street"
	for _, r in ipairs(g.roads) do if (r.a == a and r.b == b) or (r.a == b and r.b == a) then kind = r.kind break end end
	local c = {model = m, root = root, key = key, a = a, b = b, d = d, lane = lane or 1, speed = (SPEED[kind] or 40) * 0.8, kind = kind, lift = lift,
		color = (opts and opts.color) or col, lite = m.Name ~= key or nil,
		brakes = {}, heads = {}, wheels = {}, spin = 0, nightOn = nil, born = os.clock()}
	for _, p in ipairs(m:GetDescendants()) do
		if p:IsA("BasePart") then
			if p.Name == "TailLight" then table.insert(c.brakes, p) elseif p.Name == "HeadLight" then table.insert(c.heads, p) end
		elseif p:IsA("Motor6D") and p.Name:sub(1, 6) == "Wheel_" then table.insert(c.wheels, {m = p, front = p.Name:sub(7, 7) == "F"}) end
	end
	for k, v in pairs(opts or {}) do c[k] = v end
	drive(S, c, 0)
	root.CFrame = CF(c.pos + V3(0, lift, 0), c.pos + V3(0, lift, 0) + c.dir)
	m.Parent = folder
	table.insert(list, c)
	return c
end
function T.remove(c)
	local i = table.find(list, c)
	if i then table.remove(list, i) end
	if c.model then c.model:Destroy() end
end

----------------------------------------------------------------------------------------------------
-- KNOCK LOOSE: a traffic car hit hard becomes a real physics car
----------------------------------------------------------------------------------------------------
local function loosen(S, c, push)
	local i = table.find(list, c)
	if i then table.remove(list, i) end
	c.root.Anchored = false
	for _, p in ipairs(c.model:GetDescendants()) do if p:IsA("BasePart") and p.Name == "Contact" then p.CanCollide = true end end
	c.root.AssemblyLinearVelocity = push
	c.root.AssemblyAngularVelocity = V3(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 2
	-- hand it over to the Vehicles module so the player can drive it
	if S.cars then
		local car = {model = c.model, key = c.key, cfg = S.C.CARS[c.key], root = c.root, health = S.C.MAX_HEALTH * 0.7, nitro = 1, lights = false, born = os.clock(), lite = c.lite, color = c.color}
		car.seat = c.model:FindFirstChild("DriverSeat", true)
		table.insert(S.cars, car)
		c.model.Parent = workspace:FindFirstChild("SB_Cars") or c.model.Parent
	end
	S.fire("trafficHit", c, push.Magnitude)
end

----------------------------------------------------------------------------------------------------
-- START: spawn loop + per-frame update
----------------------------------------------------------------------------------------------------
function T.start(S)
	local g = S.L.graph()
	local roads = {}
	for _, r in ipairs(g.roads) do table.insert(roads, r) end
	-- spawn / despawn
	task.spawn(function()
		while true do
			task.wait(0.5)
			if S.mode ~= "menu" then
				local q = S.C.QUALITY[S.settings.quality] or S.C.QUALITY.Medium
				local center = S.cam.CFrame.Position
				for i = #list, 1, -1 do
					local c = list[i]
					if c.pos and (c.pos - center).Magnitude > 460 and not c.keep then T.remove(c) end
				end
				local tries = 0
				while #list < q.trafficCars and tries < 6 do
					tries += 1
					local r = roads[math.random(#roads)]
					local forward = math.random() < 0.5
					local a, b = r.a, r.b
					if not forward then a, b = b, a end
					local len = roadLen(g, a, b)
					local d = math.random() * math.max(1, len - 60) + 30
					local p = lanePos(S, g, a, b, d, 1)
					local dist = (p - center).Magnitude
					if dist > 120 and dist < 350 then
						-- not on top of another car
						local free = true
						for _, o in ipairs(list) do if o.pos and (o.pos - p).Magnitude < 20 then free = false break end end
						if free then T.spawn(S, KEYS[math.random(#KEYS)], a, b, d, math.random() < 0.7 and 1 or 2) end
					end
				end
			end
		end
	end)
	-- move every frame
	Run.Heartbeat:Connect(function(dt)
		if S.mode == "menu" then return end
		local night = S.isNight and S.isNight()
		local cp = S.cam.CFrame.Position
		local pcar = S.inCar and S.car
		for i = #list, 1, -1 do
			local c = list[i]
			if not c.model.Parent then table.remove(list, i) continue end
			if c.police then continue end -- police cars are moved by the Police module
			drive(S, c, dt)
			local cf = CF(c.pos + V3(0, c.lift, 0), c.pos + V3(0, c.lift, 0) + c.dir)
			c.root.CFrame = cf
			local near = (c.pos - cp).Magnitude < 160
			-- lights
			local lightsOn = night
			if c.nightOn ~= lightsOn then c.nightOn = lightsOn setLamp(c.heads, lightsOn) end
			local brake = c.braking or lightsOn
			if c.brakeOn ~= brake then c.brakeOn = brake setLamp(c.brakes, brake) end
			-- wheels (only near the camera)
			if near then
				c.spin = (c.spin + c.speed * dt / 1.3) % (math.pi * 2)
				for _, w in ipairs(c.wheels) do w.m.Transform = CFrame.Angles(-c.spin, 0, 0) end
			end
			-- the player rams it
			if pcar and pcar.root.Parent then
				local rel = pcar.root.Position - c.pos
				if rel.Magnitude < 9 then
					local v = pcar.root.AssemblyLinearVelocity
					local closing = (v - c.dir * c.speed):Dot(-rel.Unit)
					if closing > 18 then loosen(S, c, v * 0.7 + V3(0, 6, 0)) end
				end
			end
		end
	end)
	S.on("trafficHorn", function(c) S.play("Horn", {Volume = 0.6, PlaybackSpeed = 0.85 + math.random() * 0.2}, c.pos) end)
	-- clear all traffic when a cutscene asks for it
	S.on("clearTraffic", function() for i = #list, 1, -1 do if not list[i].keep then T.remove(list[i]) end end end)
	S.trafficSpawn = function(...) return T.spawn(S, ...) end
	S.trafficRemove = T.remove
	S.trafficDrive = function(c, dt) return drive(S, c, dt) end
	S.trafficLane = function(a, b, d, lane) return lanePos(S, S.L.graph(), a, b, d, lane) end
end
return T
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXSTuning"><Properties><string name="Name">Tuning</string><ProtectedString name="Source"><![CDATA[--[[
	Tuning | StarterPlayerScripts.SB (ModuleScript)
	NEON CUSTOMS - drive in and make your car yours. Upgrades are saved per owned car.
	  * Engine (top speed + acceleration), Brakes, Grip (handling), Nitro (lasts longer, refills faster)
	  * Underglow neon (8 colours, glows on the road at night), window tint, rim colour, smoked lights
	  * Horn (4 tones), number plate text style
	The menu is built here: a slick list on the left, the car turns on a lift, the camera circles it.
	Stats: S.carStats(car) returns the tuned numbers that Drive uses.
]]
local Tu = {}
local Run = game:GetService("RunService")
local TS = game:GetService("TweenService")
local C3, V3, CF, U2, V2, A = Color3.fromRGB, Vector3.new, CFrame.new, UDim2.new, Vector2.new, CFrame.Angles

local UP = {
	{key = "engine", name = "Engine", levels = {0, 6000, 14000, 30000}, desc = "More top speed and acceleration"},
	{key = "brakes", name = "Brakes", levels = {0, 3000, 7000, 15000}, desc = "Stop faster"},
	{key = "grip", name = "Tires", levels = {0, 4000, 9000, 18000}, desc = "More grip in corners"},
	{key = "nitro", name = "Nitro", levels = {0, 8000, 16000, 32000}, desc = "Nitro lasts longer and refills faster"},
}
local GLOW = {{"None", nil}, {"Pink", C3(255, 40, 170)}, {"Cyan", C3(0, 230, 255)}, {"Purple", C3(170, 70, 255)}, {"Green", C3(60, 255, 120)}, {"Orange", C3(255, 140, 40)}, {"White", C3(255, 255, 255)}, {"Red", C3(255, 40, 40)}, {"Blue", C3(40, 90, 255)}}
local TINT = {{"None", 0.35}, {"Light", 0.15}, {"Dark", 0.05}, {"Limo", 0}}
local RIMS = {{"Chrome", C3(210, 215, 222)}, {"Black", C3(30, 30, 35)}, {"Gold", C3(255, 200, 60)}, {"White", C3(250, 250, 250)}, {"Neon Pink", C3(255, 60, 170)}, {"Cyan", C3(0, 220, 255)}}
local HORNS = {{"Classic", 1}, {"Truck", 0.6}, {"Sport", 1.3}, {"Toy", 1.8}}
local PRICE = {glow = 2500, tint = 1200, rims = 1800, horn = 600}

-- tuning table for an owned car entry (S.data.cars[i].tune)
local function tuneOf(S, car)
	if not car then return {} end
	local entry = car.owned and S.data.cars[car.owned]
	if entry then entry.tune = entry.tune or {} return entry.tune end
	car.tune = car.tune or {}
	return car.tune
end

function Tu.init(S)
	Tu.S = S
	-- tuned stats used by Drive
	function S.carStats(car)
		local cfg = car.cfg
		local t = tuneOf(S, car)
		local e, b, g = t.engine or 1, t.brakes or 1, t.grip or 1
		return {
			speed = cfg.speed * (1 + (e - 1) * 0.07), accel = cfg.accel * (1 + (e - 1) * 0.12),
			brake = cfg.brake * (1 + (b - 1) * 0.15), grip = math.min(0.98, cfg.grip * (1 + (g - 1) * 0.06)),
			turn = cfg.turn * (1 + (g - 1) * 0.04), nitro = cfg.nitro or (t.nitro or 1) > 1,
			nitroTime = S.C.NITRO_TIME * (1 + ((t.nitro or 1) - 1) * 0.35), nitroRecharge = S.C.NITRO_RECHARGE * (1 - ((t.nitro or 1) - 1) * 0.2),
			hornPitch = (HORNS[t.horn or 1] or HORNS[1])[2],
		}
	end
end

----------------------------------------------------------------------------------------------------
-- LOOKS: underglow, tint, rims (applied whenever a car spawns)
----------------------------------------------------------------------------------------------------
local function applyLooks(S, car)
	if not car or not car.model.Parent then return end
	local t = tuneOf(S, car)
	-- underglow: a neon strip under the car + a light pointing down
	local old = car.model:FindFirstChild("Underglow")
	if old then old:Destroy() end
	local glow = GLOW[t.glow or 1]
	if glow and glow[2] then
		local root = car.root
		local g = Instance.new("Part")
		g.Name, g.Material, g.Color, g.Transparency = "Underglow", Enum.Material.Neon, glow[2], 0.2
		g.Size = V3(root.Size.X - 1.4, 0.15, root.Size.Z - 3)
		g.CanCollide, g.CanQuery, g.CanTouch, g.Massless, g.CastShadow = false, false, false, true, false
		g.CFrame = root.CFrame * CF(0, -root.Size.Y / 2 + 0.05, 0)
		local w = Instance.new("Weld")
		w.Part0, w.Part1, w.C0 = root, g, root.CFrame:Inverse() * g.CFrame
		w.Parent = g
		local l = Instance.new("SurfaceLight")
		l.Face, l.Color, l.Range, l.Brightness, l.Angle, l.Shadows = Enum.NormalId.Bottom, glow[2], 10, 3, 140, false
		l:SetAttribute("Car", true)
		l.Parent = g
		g.Parent = car.model
	end
	-- window tint
	local tint = TINT[t.tint or 1]
	for _, p in ipairs(car.model:GetDescendants()) do
		if p:IsA("BasePart") then
			if p.Name == "Windshield" or p.Name == "SideWindow" or p.Name == "RearWindow" then
				p.Transparency = tint[2]
				p.Color = (t.tint or 1) > 2 and C3(12, 14, 18) or C3(30, 40, 50)
			elseif (p.Name == "Rim" or p.Name == "Spoke") and t.rims then
				p.Color = RIMS[t.rims][2]
			end
		end
	end
end
Tu.applyLooks = applyLooks

----------------------------------------------------------------------------------------------------
-- MENU (built in code)
----------------------------------------------------------------------------------------------------
local gui, list, header, info
local open = false
local function makeGui(S)
	gui = Instance.new("ScreenGui")
	gui.Name, gui.IgnoreGuiInset, gui.ResetOnSpawn, gui.DisplayOrder, gui.Enabled = "SB_Tuning", true, false, 13, false
	gui.Parent = S.pg
	local panel = Instance.new("Frame")
	panel.Position, panel.Size, panel.BackgroundColor3, panel.BackgroundTransparency, panel.BorderSizePixel = U2(0, 40, 0, 120), U2(0, 380, 1, -200), C3(8, 8, 14), 0.15, 0
	local cr = Instance.new("UICorner") cr.CornerRadius = UDim.new(0, 10) cr.Parent = panel
	local st = Instance.new("UIStroke") st.Color, st.Thickness = C3(0, 230, 255), 2 st.Parent = panel
	panel.Parent = gui
	header = Instance.new("TextLabel")
	header.Position, header.Size, header.BackgroundTransparency, header.Font, header.TextScaled, header.TextColor3, header.TextXAlignment = U2(0, 40, 0, 40), U2(0, 600, 0, 64), 1, Enum.Font.Bangers, true, C3(0, 230, 255), Enum.TextXAlignment.Left
	header.Text = "NEON CUSTOMS"
	local hs = Instance.new("UIStroke") hs.Thickness = 3 hs.Parent = header
	header.Parent = gui
	list = Instance.new("ScrollingFrame")
	list.Position, list.Size, list.BackgroundTransparency, list.BorderSizePixel, list.ScrollBarThickness, list.AutomaticCanvasSize, list.CanvasSize = U2(0, 10, 0, 10), U2(1, -20, 1, -70), 1, 0, 4, Enum.AutomaticSize.Y, U2()
	local ll = Instance.new("UIListLayout") ll.Padding, ll.SortOrder = UDim.new(0, 6), Enum.SortOrder.LayoutOrder ll.Parent = list
	list.Parent = panel
	info = Instance.new("TextLabel")
	info.AnchorPoint, info.Position, info.Size, info.BackgroundTransparency, info.Font, info.TextSize, info.TextColor3, info.TextXAlignment = V2(0, 1), U2(0, 14, 1, -10), U2(1, -28, 0, 44), 1, Enum.Font.GothamBold, 15, C3(200, 200, 220), Enum.TextXAlignment.Left
	info.TextWrapped = true
	info.Parent = panel
	local close = Instance.new("TextButton")
	close.AnchorPoint, close.Position, close.Size, close.BackgroundColor3, close.Text, close.Font, close.TextSize, close.TextColor3 = V2(1, 0), U2(1, -40, 0, 50), U2(0, 140, 0, 44), C3(220, 60, 60), "LEAVE", Enum.Font.GothamBlack, 18, C3(255, 255, 255)
	local cc = Instance.new("UICorner") cc.CornerRadius = UDim.new(0, 8) cc.Parent = close
	close.Parent = gui
	close.MouseButton1Click:Connect(function() Tu.close(S) end)
end
local function row(text, sub, color, click, order)
	local b = Instance.new("TextButton")
	b.Size, b.BackgroundColor3, b.BackgroundTransparency, b.Text, b.AutoButtonColor, b.LayoutOrder = U2(1, 0, 0, 52), color or C3(30, 30, 45), 0.1, "", true, order or 0
	local cr = Instance.new("UICorner") cr.CornerRadius = UDim.new(0, 8) cr.Parent = b
	local t = Instance.new("TextLabel")
	t.Position, t.Size, t.BackgroundTransparency, t.Font, t.TextSize, t.TextColor3, t.TextXAlignment, t.Text = U2(0, 12, 0, 4), U2(1, -24, 0, 24), 1, Enum.Font.GothamBlack, 18, C3(255, 255, 255), Enum.TextXAlignment.Left, text
	t.Parent = b
	local s = Instance.new("TextLabel")
	s.Position, s.Size, s.BackgroundTransparency, s.Font, s.TextSize, s.TextColor3, s.TextXAlignment, s.Text = U2(0, 12, 0, 28), U2(1, -24, 0, 20), 1, Enum.Font.GothamBold, 14, C3(190, 200, 230), Enum.TextXAlignment.Left, sub or ""
	s.Parent = b
	b.Parent = list
	if click then b.MouseButton1Click:Connect(click) end
	return b
end
local function clear() for _, c in ipairs(list:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end end
local page
local function mainPage(S)
	clear()
	local car = S.car
	local t = tuneOf(S, car)
	info.Text = car.owned and "Upgrades stay on this car." or "This car isn't yours - upgrades are lost when you leave it. Buy cars at Sunset Motors."
	for i, u in ipairs(UP) do
		local lv = t[u.key] or 1
		local nextP = u.levels[lv + 1]
		row(u.name .. "  " .. string.rep("■", lv) .. string.rep("□", #u.levels - lv), nextP and ("Level " .. (lv + 1) .. " · " .. S.L.money(nextP) .. " · " .. u.desc) or "MAX", nil, function()
			if not nextP then return end
			if not S.spend(nextP) then return end
			t[u.key] = lv + 1
			S.play("Cash")
			S.save(true)
			mainPage(S)
		end, i)
	end
	local function cycle(key, opts, price, label, order)
		local cur = t[key] or 1
		row(label .. ": " .. opts[cur][1], "Tap to change · " .. S.L.money(price), C3(40, 25, 60), function()
			if not S.spend(price) then return end
			t[key] = cur % #opts + 1
			applyLooks(S, car)
			S.play("Click")
			S.save(true)
			mainPage(S)
		end, order)
	end
	cycle("glow", GLOW, PRICE.glow, "Underglow", 10)
	cycle("tint", TINT, PRICE.tint, "Window tint", 11)
	cycle("rims", RIMS, PRICE.rims, "Rims", 12)
	cycle("horn", HORNS, PRICE.horn, "Horn", 13)
end
local spin
function Tu.open(S)
	if open or not S.car then return end
	open = true
	S.mode = "shop"
	S.gui.SB_HUD.Enabled = false
	gui.Enabled = true
	local car = S.car
	car.root.AssemblyLinearVelocity = V3()
	local base = car.root.CFrame
	local a = 0
	S.cam.CameraType = Enum.CameraType.Scriptable
	spin = Run.RenderStepped:Connect(function(dt)
		a += dt * 0.4
		local p = base.Position
		S.cam.CFrame = S.cam.CFrame:Lerp(CF(p + V3(math.cos(a) * 18, 6, math.sin(a) * 18), p + V3(0, 1.5, 0)), math.min(1, dt * 3))
		S.cam.FieldOfView = 55
		car.root.AssemblyLinearVelocity = V3()
	end)
	mainPage(S)
end
function Tu.close(S)
	if not open then return end
	open = false
	gui.Enabled = false
	if spin then spin:Disconnect() spin = nil end
	S.cam.CameraType = Enum.CameraType.Custom
	S.gui.SB_HUD.Enabled = true
	S.mode = "play"
end

function Tu.start(S)
	makeGui(S)
	S.on("carSpawned", function(car) if not car.lite then task.defer(applyLooks, S, car) end end) -- Lite cars get their looks when they are upgraded and entered
	S.on("enterCar", function(car) applyLooks(S, car) end)
	local places = S.city and S.city:FindFirstChild("Places")
	local mk = places and places:FindFirstChild("Tuning")
	local mp = mk and mk:GetPivot().Position
	task.spawn(function()
		while true do
			task.wait(0.25)
			if S.mode == "play" and mp and S.inCar and S.car then
				local near = ((S.car.root.Position - mp) * V3(1, 0, 1)).Magnitude < 12
				S.fire("help", near and "Press E for Neon Customs." or nil, "tuning")
			end
		end
	end)
	S.on("action", function(a)
		-- "use" is handled by Vehicles (so getting out of the car never fires at the same time)
		if a == "back" and open then Tu.close(S) end
	end)
end
return Tu
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXSVehicles"><Properties><string name="Name">Vehicles</string><ProtectedString name="Source"><![CDATA[--[[
	Vehicles | StarterPlayerScripts.SB (ModuleScript)
	All cars live only on this computer (no lag, single player).
	  * your garage: the cars you own (saved), "Deliver" one from the phone and it is parked next to you
	  * parked cars around you that you can take (they disappear when you are far away)
	  * getting in / out (E / F), the help box shows when you stand near a door
	  * dealership: a showroom with turning cars, a camera that looks at them, buy and pick a colour
	  * paint & repair shop
	  * wrecks: a car with 0 health smokes and burns, then disappears
	API: S.spawnCar(key, cf, colorIndex, owned) -> car table · S.enterCar(car) · S.exitCar() · S.car (current car) · S.inCar
]]
local V = {}
local RS = game:GetService("ReplicatedStorage")
local Run = game:GetService("RunService")
local TS = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")
local C3, V3, CF, A = Color3.fromRGB, Vector3.new, CFrame.new, CFrame.Angles

local cars = {} -- list of car tables
local folder
local MODELS

-- recolour every paint panel (some panels keep their own colour, like police doors)
local function paint(m, col)
	for _, p in ipairs(m:GetDescendants()) do
		if p:IsA("BasePart") and p.Name == "Paint" and p:GetAttribute("Panel") ~= "Door" then p.Color = col end
	end
end
local function lift(m)
	-- distance from the pivot (chassis centre) down to the bottom of the tires
	local cf, size = m:GetBoundingBox()
	return m:GetPivot().Position.Y - (cf.Position.Y - size.Y / 2)
end

function V.init(S)
	MODELS = S.SB:WaitForChild("Cars")
	folder = Instance.new("Folder")
	folder.Name = "SB_Cars"
	folder.Parent = workspace
	S.cars = cars
	S.inCar, S.car = false, nil

	------------------------------------------------------------------------------------------------
	-- SPAWN / REMOVE
	------------------------------------------------------------------------------------------------
	function S.spawnCar(key, cf, colorIndex, owned, opts)
		local cfg = S.C.CARS[key]
		-- parked cars use the cheap <Key>_Lite model; the full model is swapped in when the player gets in (see S.upgradeCar)
		local lite = (opts and opts.lite ~= nil) and opts.lite or (opts and opts.parked) or false
		local tpl = (lite and MODELS:FindFirstChild(key .. "_Lite")) or MODELS:FindFirstChild(key)
		if not cfg or not tpl then return nil end
		lite = tpl.Name ~= key
		local m = tpl:Clone()
		local col = cfg.colours[colorIndex or 1] or cfg.colours[1]
		if opts and opts.color then col = opts.color end
		paint(m, col)
		-- ground the car on whatever is under cf
		-- only the ground counts (not lamps or palm trees above the road)
		local rp = RaycastParams.new()
		rp.FilterType = Enum.RaycastFilterType.Include
		local list = {}
		for _, n in ipairs({"Roads", "Ground", "Sidewalks", "Beach", "StarIsland", "Docks", "Places"}) do local f = S.city and S.city:FindFirstChild(n) if f then table.insert(list, f) end end
		rp.FilterDescendantsInstances = list
		local hit = workspace:Raycast(cf.Position + V3(0, 20, 0), V3(0, -80, 0), rp)
		local y = hit and hit.Position.Y or cf.Position.Y
		m:PivotTo(CF(cf.Position.X, y + lift(m) + 0.15, cf.Position.Z) * (cf - cf.Position))
		for _, p in ipairs(m:GetDescendants()) do
			if p:IsA("Light") then p:SetAttribute("Car", true) end
		end
		m.Parent = folder
		local car = {
			model = m, key = key, cfg = cfg, root = m.PrimaryPart, owned = owned, colorIndex = colorIndex or 1, color = col,
			health = (opts and opts.health) or S.C.MAX_HEALTH, nitro = 1, lights = false, born = os.clock(), parked = opts and opts.parked, lite = lite or nil,
		}
		car.seat = m:FindFirstChild("DriverSeat", true)
		table.insert(cars, car)
		S.fire("carSpawned", car)
		return car
	end
	function S.removeCar(car)
		if not car then return end
		if S.car == car then S.exitCar() end
		local i = table.find(cars, car)
		if i then table.remove(cars, i) end
		if car.model then car.model:Destroy() end
		S.fire("carRemoved", car)
	end
	-- the player's own personal car (only one delivered at a time)
	function S.deliverCar(index)
		local entry = S.data.cars[index]
		if not entry then return end
		if S.personal then S.removeCar(S.personal) end
		local ch, hrp = S.char()
		if not hrp then return end
		local p, road = S.L.nearestRoad(hrp.Position)
		local g = S.L.graph()
		local a, b = g.nodes[road.a].pos, g.nodes[road.b].pos
		local dir = (b - a).Unit
		local right = V3(-dir.Z, 0, dir.X)
		local spot = p + right * (S.C.MAP.ROAD_W / 2 - 3)
		local car = S.spawnCar(entry.key, CF(spot, spot + dir), entry.color, index, {health = entry.health})
		S.personal = car
		if car then S.fire("notify", "Garage", "Your " .. car.cfg.name .. " is parked nearby.", C3(255, 80, 160)) S.fire("blip", "personal", car) end
		return car
	end

	------------------------------------------------------------------------------------------------
	-- LITE -> FULL: a parked / traffic car (Lite model) gets the full detailed model at the same place when the player takes it
	------------------------------------------------------------------------------------------------
	function S.upgradeCar(car)
		if not car or not car.lite or not car.model or not car.model.Parent then return end
		local tpl = MODELS:FindFirstChild(car.key)
		if not tpl then car.lite = nil return end
		local old = car.model
		local oldRoot = car.root
		-- the paint colour: from the car table, or read from the old model (traffic cars keep it only on their paint panels)
		local col = car.color
		if not col then
			for _, p in ipairs(old:GetDescendants()) do
				if p:IsA("BasePart") and p.Name == "Paint" and p:GetAttribute("Panel") ~= "Door" then col = p.Color break end
			end
		end
		local m = tpl:Clone()
		if col then paint(m, col) car.color = col end
		for _, p in ipairs(m:GetDescendants()) do
			if p:IsA("Light") then p:SetAttribute("Car", true) end
		end
		m:PivotTo(old:GetPivot())
		local lin, ang = oldRoot.AssemblyLinearVelocity, oldRoot.AssemblyAngularVelocity
		local anchored = oldRoot.Anchored
		m.Parent = old.Parent
		local root = m.PrimaryPart
		root.Anchored = anchored
		root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = lin, ang
		car.model, car.root = m, root
		car.seat = m:FindFirstChild("DriverSeat", true)
		car.lite = nil
		old:Destroy()
		S.fire("carUpgraded", car)
	end

	------------------------------------------------------------------------------------------------
	-- ENTER / EXIT
	------------------------------------------------------------------------------------------------
	local seatWeld
	function S.enterCar(car)
		if S.inCar or not car or not car.model.Parent then return end
		if car.lite then S.upgradeCar(car) end
		if car.health <= 0 then S.fire("notify", "Wrecked", "This car is wrecked.", C3(255, 80, 80)) return end
		local ch, hrp, hum = S.char()
		if not hrp or not hum then return end
		S.play("DoorOpen", {Volume = 0.5}, car.root.Position)
		hum.Sit = true
		hum:ChangeState(Enum.HumanoidStateType.Seated)
		local seat = car.seat or car.root
		ch:PivotTo(seat.CFrame * CF(0, 2.2, 0))
		seatWeld = Instance.new("Weld")
		seatWeld.Name = "SB_SeatWeld"
		seatWeld.Part0, seatWeld.Part1 = seat, hrp
		seatWeld.C0 = CF(0, 1.9, 0)
		seatWeld.Parent = seat
		for _, p in ipairs(ch:GetDescendants()) do if p:IsA("BasePart") then p.Massless = true end end
		S.inCar, S.car = true, car
		car.lastDriven = os.clock()
		S.fire("enterCar", car)
	end
	function S.exitCar(force)
		if not S.inCar then return end
		local car = S.car
		local ch, hrp, hum = S.char()
		if seatWeld then seatWeld:Destroy() seatWeld = nil end
		if ch then for _, p in ipairs(ch:GetDescendants()) do if p:IsA("BasePart") then p.Massless = false end end end
		if hum then hum.Sit = false hum:ChangeState(Enum.HumanoidStateType.GettingUp) end
		if car and car.model.Parent and hrp then
			-- step out on the driver side (left), or the other side if blocked
			local root = car.root
			local out = root.CFrame * CF(-(root.Size.X / 2 + 2.5), 1, -1)
			local rp = RaycastParams.new()
			rp.FilterType = Enum.RaycastFilterType.Exclude
			rp.FilterDescendantsInstances = {folder, ch}
			if workspace:Raycast(root.Position, out.Position - root.Position, rp) then out = root.CFrame * CF(root.Size.X / 2 + 2.5, 1, -1) end
			ch:PivotTo(CF(out.Position) * (root.CFrame - root.CFrame.Position))
			hrp.AssemblyLinearVelocity = car.root.AssemblyLinearVelocity * 0.3
			S.play("DoorClose", {Volume = 0.5}, root.Position)
		end
		S.inCar, S.car = false, nil
		S.fire("exitCar", car)
	end

	------------------------------------------------------------------------------------------------
	-- PARKED CARS around the player (GTA style: you can take them)
	------------------------------------------------------------------------------------------------
	V.parkedSpots = {}
	local g = S.L.graph()
	for _, r in ipairs(g.roads) do
		if r.kind == "street" or r.kind == "boulevard" then
			local a, b = g.nodes[r.a].pos, g.nodes[r.b].pos
			local dir = (b - a).Unit
			local right = V3(-dir.Z, 0, dir.X)
			for t = 0.25, 0.75, 0.25 do
				local p = a:Lerp(b, t) + right * (S.C.MAP.ROAD_W / 2 - 2.6)
				table.insert(V.parkedSpots, {pos = p, dir = dir, car = nil})
			end
		end
	end
end

----------------------------------------------------------------------------------------------------
-- DEALERSHIP + PAINT SHOP
----------------------------------------------------------------------------------------------------
local function dealership(S)
	local gui = S.gui.SB_Shops
	local D = gui and gui:FindFirstChild("Dealer")
	if not D then return end
	local shop = S.city and S.city:FindFirstChild("Places") and S.city.Places:FindFirstChild("Dealership")
	if not shop then return end
	local order = S.C.CAR_ORDER
	local index, colorI = 1, 1
	local show -- the car on display
	local turn = shop:FindFirstChild("Showcase1")
	local spin
	local function display()
		if show then show:Destroy() show = nil end
		local key = order[index]
		local cfg = S.C.CARS[key]
		local tpl = MODELS:FindFirstChild(key)
		if not tpl or not turn then return end
		show = tpl:Clone()
		for _, p in ipairs(show:GetDescendants()) do if p:IsA("BasePart") then p.Anchored = true end end
		paint(show, cfg.colours[colorI] or cfg.colours[1])
		show.Parent = folder
		local card = D.Card
		card.CarName.Text = cfg.name
		card.Class.Text = cfg.class:upper()
		card.Price.Text = S.L.money(cfg.price)
		local owned = false
		for _, c in ipairs(S.data.cars) do if c.key == key then owned = true end end
		card.Buy.Text = owned and "BUY ANOTHER" or "BUY"
		local function bar(n, v) card[n].Fill.Size = UDim2.new(math.clamp(v, 0.05, 1), 0, 1, 0) end
		bar("Speed", cfg.speed / 170)
		bar("Acceleration", cfg.accel / 65)
		bar("Handling", (cfg.turn * cfg.grip) / 1.0)
		bar("Braking", cfg.brake / 125)
		-- colour swatches
		local cols = D.Colours
		for _, c in ipairs(cols:GetChildren()) do if c:IsA("GuiButton") then c:Destroy() end end
		for i, col in ipairs(cfg.colours) do
			local b = Instance.new("TextButton")
			b.Size, b.BackgroundColor3, b.Text, b.AutoButtonColor = UDim2.new(0, 34, 0, 34), col, "", false
			local cr = Instance.new("UICorner") cr.CornerRadius = UDim.new(1, 0) cr.Parent = b
			local st = Instance.new("UIStroke") st.Thickness, st.Color = i == colorI and 3 or 1, C3(255, 255, 255) st.Parent = b
			b.Parent = cols
			b.MouseButton1Click:Connect(function() colorI = i display() end)
		end
	end
	local open = false
	local camCF
	local function close()
		if not open then return end
		open = false
		D.Visible = false
		if spin then spin:Disconnect() spin = nil end
		if show then show:Destroy() show = nil end
		S.mode = "play"
		S.cam.CameraType = Enum.CameraType.Custom
		S.gui.SB_HUD.Enabled = true
	end
	function S.openDealer()
		if open or S.inCar then return end
		open = true
		index, colorI = 1, 1
		S.mode = "shop"
		S.gui.SB_HUD.Enabled = false
		D.Visible = true
		display()
		local base = turn.Position
		local a = 0
		S.cam.CameraType = Enum.CameraType.Scriptable
		spin = Run.RenderStepped:Connect(function(dt)
			a += dt * 0.35
			if show then show:PivotTo(CF(base + V3(0, lift(show) + 0.6, 0)) * A(0, a, 0)) end
			local target = base + V3(0, 3, 0)
			S.cam.CFrame = S.cam.CFrame:Lerp(CF(target + V3(-14, 6, -16), target), math.min(1, dt * 3))
			S.cam.FieldOfView = 50
		end)
	end
	D.Prev.MouseButton1Click:Connect(function() index = (index - 2) % #order + 1 colorI = 1 display() S.play("Click") end)
	D.Next.MouseButton1Click:Connect(function() index = index % #order + 1 colorI = 1 display() S.play("Click") end)
	D.Close.MouseButton1Click:Connect(close)
	D.Card.Buy.MouseButton1Click:Connect(function()
		local key = order[index]
		local cfg = S.C.CARS[key]
		if #S.data.cars >= S.C.GARAGE_SIZE then S.fire("notify", "Garage full", "Your garage holds " .. S.C.GARAGE_SIZE .. " cars. Sell one in the phone.", C3(255, 80, 80)) return end
		if not S.spend(cfg.price) then return end
		table.insert(S.data.cars, {key = key, color = colorI, health = S.C.MAX_HEALTH})
		S.save(true)
		S.play("Cash")
		S.fire("big", "NEW CAR", cfg.name .. " added to your garage")
		close()
		-- park it outside the showroom
		local car = S.deliverCar(#S.data.cars)
	end)
	S.closeDealer = close
end
local function paintShop(S)
	local gui = S.gui.SB_Shops
	local P = gui and gui:FindFirstChild("Paint")
	if not P then return end
	local open = false
	local function close() open = false P.Visible = false S.mode = "play" end
	function S.openPaint()
		if open then return end
		local car = S.car
		if not car then S.fire("notify", "Paint & Fix", "Drive a car in here.") return end
		open = true
		S.mode = "shop"
		P.Visible = true
		local sw = P.Swatches
		for _, c in ipairs(sw:GetChildren()) do if c:IsA("GuiButton") then c:Destroy() end end
		local palette = {C3(255, 40, 120), C3(0, 200, 255), C3(255, 200, 0), C3(250, 250, 250), C3(20, 20, 25), C3(200, 20, 30), C3(30, 60, 160), C3(120, 230, 220), C3(255, 120, 180), C3(255, 140, 0), C3(60, 160, 80), C3(150, 90, 220)}
		for _, col in ipairs(palette) do
			local b = Instance.new("TextButton")
			b.BackgroundColor3, b.Text, b.AutoButtonColor = col, "", false
			local cr = Instance.new("UICorner") cr.CornerRadius = UDim.new(1, 0) cr.Parent = b
			b.Parent = sw
			b.MouseButton1Click:Connect(function()
				if not S.car then return end
				if not S.spend(S.C.PAINT_PRICE) then return end
				paint(S.car.model, col)
				S.car.color = col
				S.fire("heat", "clear") -- a new paint job loses the police
				S.play("Cash")
			end)
		end
		P.Repair.Text = "REPAIR  " .. S.L.money(S.C.REPAIR_PRICE)
	end
	P.Repair.MouseButton1Click:Connect(function()
		local car = S.car
		if not car then return end
		if car.health >= S.C.MAX_HEALTH then S.fire("notify", "Paint & Fix", "Your car is already perfect.") return end
		if not S.spend(S.C.REPAIR_PRICE) then return end
		car.health = S.C.MAX_HEALTH
		S.fire("repaired", car)
		S.play("Cash")
	end)
	P.Close.MouseButton1Click:Connect(close)
end

----------------------------------------------------------------------------------------------------
-- START: help box, parked cars, marker use
----------------------------------------------------------------------------------------------------
function V.start(S)
	dealership(S)
	paintShop(S)
	local places = S.city and S.city:FindFirstChild("Places")
	local function markerPos(name)
		local m = places and places:FindFirstChild(name)
		return m and m:GetPivot().Position
	end
	local buyPos, repairPos, tunePos = markerPos("BuyCar"), markerPos("Repair"), markerPos("Tuning")
	S.nearCar = nil
	-- what is the player near? (car door, shop markers) -> help text + "use"
	local function nearest()
		local ch, hrp = S.char()
		if not hrp then return nil end
		local best, bd = nil, 9
		for _, car in ipairs(cars) do
			if car.model.Parent then
				local d = (car.root.Position - hrp.Position).Magnitude
				if d < bd then best, bd = car, d end
			end
		end
		return best
	end
	task.spawn(function()
		while true do
			task.wait(0.15)
			if S.mode == "play" then
				local ch, hrp = S.char()
				local text
				if S.inCar then
					local p = S.car.root.Position
					if repairPos and (p - repairPos).Magnitude < 10 then text = "Press E for Paint & Fix." end
				elseif hrp then
					S.nearCar = nearest()
					if S.nearCar then text = "Press E to get in the " .. S.nearCar.cfg.name .. "."
					elseif buyPos and (hrp.Position - buyPos).Magnitude < 8 then text = "Press E to browse cars."
					end
				end
				S.fire("help", text, "vehicle")
			end
		end
	end)
	S.on("action", function(a)
		if S.mode ~= "play" then
			if a == "back" and S.closeDealer then S.closeDealer() end
			return
		end
		if a ~= "use" then return end
		local ch, hrp = S.char()
		if S.inCar then
			local p = S.car.root.Position
			if repairPos and (p - repairPos).Magnitude < 10 and S.car.root.AssemblyLinearVelocity.Magnitude < 8 then S.openPaint() return end
			if tunePos and ((p - tunePos) * V3(1, 0, 1)).Magnitude < 12 and S.car.root.AssemblyLinearVelocity.Magnitude < 10 and S.Tuning then S.Tuning.open(S) return end
			if S.car.root.AssemblyLinearVelocity.Magnitude < 25 then S.exitCar() end
			return
		end
		if S.nearCar then S.enterCar(S.nearCar) return end
		if hrp and buyPos and (hrp.Position - buyPos).Magnitude < 8 then S.openDealer() end
	end)
	-- parked cars appear near the player and vanish far away
	local KEYS = {"Glide", "Glide", "Hauler", "Rancher", "Stallion", "Coastline", "Glide", "Vortex"}
	task.spawn(function()
		while true do
			task.wait(1)
			if S.mode ~= "menu" then
				local ch, hrp = S.char()
				local pos = (S.inCar and S.car and S.car.root.Position) or (hrp and hrp.Position)
				if pos then
					local n = 0
					for _, spot in ipairs(V.parkedSpots) do
						local d = (spot.pos - pos).Magnitude
						if spot.car and (not spot.car.model.Parent or d > 420) then
							if spot.car ~= S.car and spot.car ~= S.personal then S.removeCar(spot.car) end
							spot.car = nil
						elseif not spot.car and d < 300 and d > 120 and n < 3 and math.random() < 0.15 then
							local key = KEYS[math.random(#KEYS)]
							if key == "Vortex" and math.random() < 0.7 then key = "Glide" end
							local cfg = S.C.CARS[key]
							spot.car = S.spawnCar(key, CF(spot.pos, spot.pos + spot.dir), math.random(#cfg.colours), nil, {parked = true})
							n += 1
						end
						if spot.car and spot.car.lastDriven then spot.car = nil end -- taken by the player: not a parked car any more
					end
				end
			end
		end
	end)
	-- wrecks and lost cars
	task.spawn(function()
		while true do
			task.wait(2)
			local ch, hrp = S.char()
			for _, car in ipairs(table.clone(cars)) do
				if car ~= S.car and car.model.Parent then
					local far = hrp and (car.root.Position - hrp.Position).Magnitude > 700
					local sunk = car.root.Position.Y < S.C.MAP.SEA_Y - 15
					local dead = car.health <= 0 and car.deadAt and os.clock() - car.deadAt > 25
					if (far and not car.parked and car ~= S.personal) or sunk or dead then
						if car == S.personal and sunk then S.personal = nil S.fire("notify", "Garage", "Your car sank. Deliver it again from the phone (fixed for free).") end
						S.removeCar(car)
					end
				end
			end
		end
	end)
end
return V
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXSWorld"><Properties><string name="Name">World</string><ProtectedString name="Source"><![CDATA[--[[
	World | StarterPlayerScripts.SB (ModuleScript)
	The living city around you:
	  * traffic signals: every 4-way crossing cycles green / yellow / red for each direction
	    (Traffic reads S.signalState(nodeId, axis) so AI cars stop at red)
	  * street names for the HUD (each grid line has a name, Ocean Drive is the beach boulevard)
	  * hidden packages: glowing boxes all over the map, $ for each and a bonus for all of them
	  * stunt jumps: fly off a ramp far enough for a bonus (each ramp once)
	  * S.sleep(): save the game and sleep until morning / evening (the safehouse bed calls it)
	  * ambience: ocean waves near the beach, wind, seagulls by day, crickets at night (your IDs)
]]
local W = {}
local Run = game:GetService("RunService")
local TS = game:GetService("TweenService")
local C3, V3, CF = Color3.fromRGB, Vector3.new, CFrame.new

-- one name per grid line, same order as C.MAP.X / C.MAP.Z (15 X lines, 14 Z lines)
local NAMES_X = {
	"Pastel Boulevard", -- -3000
	"Ibiza Avenue", -- -2760
	"Marlin Street", -- -2520
	"Chrome Drive", -- -2280
	"Neon Avenue", -- -2040
	"Mirage Avenue", -- -1800
	"Lagoon Drive", -- -1560
	"Seabreeze Boulevard", -- -1320
	"Sapphire Street", -- -1080
	"Palm Avenue", -- -840
	"Havana Street", -- -600
	"Collins Avenue", -- -360
	"Washington Ave", -- -120
	"Biscayne Blvd", -- 120
	"Flamingo Drive", -- 360
}
local NAMES_Z = {
	"Marina Way", -- -2520
	"Regatta Road", -- -2280
	"Cabana Street", -- -2040
	"Cruise Court", -- -1800
	"Palmetto Lane", -- -1560
	"Sunburst Road", -- -1320
	"Riptide Road", -- -1080
	"1st Street", -- -840
	"Lincoln Road", -- -600
	"Espanola Way", -- -360
	"Bay Road", -- -120
	"Sunset Drive", -- 120
	"Coral Way", -- 360
	"Harbor Street", -- 600
}

function W.init(S)
	S.World = W
	local M = S.C.MAP
	-- street name: the closest grid line within the road width
	function W.streetName(p)
		local half = M.ROAD_W / 2 + M.WALK_W
		if math.abs(p.X - M.OCEAN_DRIVE) < half then return "Ocean Drive" end
		if math.abs(p.Z - M.BRIDGE.z) < half and p.X > M.OCEAN_DRIVE then return "Star Island Causeway" end
		for i, x in ipairs(M.X) do if math.abs(p.X - x) < half then return NAMES_X[i] or "" end end
		for i, z in ipairs(M.Z) do if math.abs(p.Z - z) < half then return NAMES_Z[i] or "" end end
		return ""
	end
	-- traffic signal phase: a 24 s cycle, X roads first, Z roads second
	local CYCLE, GREEN, YELLOW = 24, 9, 3
	function S.signalState(nodeId, axis)
		local t = (os.clock() + (nodeId % 5) * 2.3) % CYCLE
		local half = CYCLE / 2
		local mine = axis == "X" and t or (t + half) % CYCLE
		if mine < GREEN then return "green" elseif mine < GREEN + YELLOW then return "yellow" end
		return "red"
	end
end

----------------------------------------------------------------------------------------------------
-- SIGNALS: colour the traffic light models
----------------------------------------------------------------------------------------------------
local signals = {}
local function collectSignals(S)
	local f = S.city and S.city:FindFirstChild("TrafficLights")
	if not f then return end
	for _, m in ipairs(f:GetChildren()) do
		local pole = m.PrimaryPart or m:FindFirstChild("Pole")
		if pole then
			local node = S.L.nearestNode(pole.Position)
			table.insert(signals, {m = m, node = node, axis = m:GetAttribute("Axis") or "X", r = m:FindFirstChild("Red"), y = m:FindFirstChild("Yellow"), g = m:FindFirstChild("Green"), state = nil, pos = pole.Position})
		end
	end
end
local function lamp(p, on)
	if not p then return end
	p.Color = on and (p:GetAttribute("On") or p.Color) or (p:GetAttribute("Off") or p.Color)
	p.Material = on and Enum.Material.Neon or Enum.Material.SmoothPlastic
end

----------------------------------------------------------------------------------------------------
-- START
----------------------------------------------------------------------------------------------------
function W.start(S)
	collectSignals(S)
	local C = S.C
	-- signals update (only near the camera)
	task.spawn(function()
		while true do
			task.wait(0.25)
			local cp = S.cam.CFrame.Position
			for _, s in ipairs(signals) do
				if s.m.Parent and (s.pos - cp).Magnitude < 400 then
					local st = S.signalState(s.node, s.axis)
					if st ~= s.state then
						s.state = st
						lamp(s.r, st == "red") lamp(s.y, st == "yellow") lamp(s.g, st == "green")
					end
				end
			end
		end
	end)

	------------------------------------------------------------------------------------------------
	-- HIDDEN PACKAGES
	------------------------------------------------------------------------------------------------
	local pkgF = S.city and S.city:FindFirstChild("Packages")
	local packages = {}
	if pkgF then
		for _, p in ipairs(pkgF:GetChildren()) do
			local id = p:GetAttribute("Package")
			if id then
				if S.data.packages[tostring(id)] then p.Parent = nil else table.insert(packages, {part = p, id = id, base = p.CFrame}) end
			end
		end
	end
	W.packages = packages
	W.totalPackages = pkgF and #pkgF:GetChildren() or 0
	local function foundCount() local n = 0 for _ in pairs(S.data.packages) do n += 1 end return n end
	Run.RenderStepped:Connect(function()
		local t = os.clock()
		for _, e in ipairs(packages) do
			if e.part.Parent then e.part.CFrame = e.base * CFrame.Angles(0, t * 2, 0) + V3(0, math.sin(t * 3) * 0.4, 0) end
		end
	end)
	task.spawn(function()
		while true do
			task.wait(0.2)
			if S.mode == "play" then
				local ch, hrp = S.char()
				local p = (S.inCar and S.car and S.car.root.Position) or (hrp and hrp.Position)
				if p then
					for i = #packages, 1, -1 do
						local e = packages[i]
						if (e.part.Position - p).Magnitude < 6 then
							table.remove(packages, i)
							e.part.Parent = nil
							S.data.packages[tostring(e.id)] = true
							S.addCash(C.PACKAGE_PAY, "package")
							local n = foundCount()
							S.play("Package")
							S.fire("big", "HIDDEN PACKAGE", n .. " of " .. W.totalPackages .. "   +" .. S.L.money(C.PACKAGE_PAY), C3(80, 255, 140))
							if n >= W.totalPackages then
								S.addCash(C.PACKAGE_BONUS, "packages")
								S.fire("notify", "All packages!", "You found every hidden package. Bonus " .. S.L.money(C.PACKAGE_BONUS) .. "!", C3(80, 255, 140))
							end
							S.save(true)
						end
					end
				end
			end
		end
	end)

	------------------------------------------------------------------------------------------------
	-- STUNT JUMPS (Drive fires "air" when a jump ends)
	------------------------------------------------------------------------------------------------
	local ramps = {}
	local sf = S.city and S.city:FindFirstChild("Stunts")
	if sf then for i, m in ipairs(sf:GetChildren()) do table.insert(ramps, {m = m, id = i, pos = m:GetPivot().Position}) end end
	local lastRamp
	task.spawn(function()
		while true do
			task.wait(0.1)
			if S.inCar and S.car then
				local p = S.car.root.Position
				for _, r in ipairs(ramps) do if (r.pos - p).Magnitude < 16 then lastRamp = {r = r, t = os.clock()} end end
			end
		end
	end)
	S.on("air", function(seconds, dist)
		if lastRamp and os.clock() - lastRamp.t < 4 and seconds > 1.2 then
			local r = lastRamp.r
			lastRamp = nil
			local key = tostring(r.id)
			if not S.data.stunts[key] then
				S.data.stunts[key] = true
				S.addCash(C.STUNT_PAY, "stunt")
				S.fire("big", "UNIQUE STUNT BONUS!", string.format("%.1f s in the air  ·  %d ft   +%s", seconds, math.floor(dist * 0.92), S.L.money(C.STUNT_PAY)), C3(0, 225, 255))
				S.play("Stunt")
				S.save(true)
			else
				S.fire("score", string.format("STUNT  %.1fs", seconds), C3(0, 225, 255))
				task.delay(2, function() S.fire("score", nil) end)
			end
		elseif seconds > 1.6 then
			S.fire("score", string.format("AIR  %.1fs", seconds), C3(0, 225, 255))
			task.delay(2, function() S.fire("score", nil) end)
		end
	end)
	-- drift score pays a little
	S.on("drift", function(score)
		local cash = math.floor(score / 10)
		S.fire("score", "DRIFT  " .. score, C3(255, 60, 170))
		if cash > 0 then S.addCash(cash, "drift") end
		task.delay(2, function() S.fire("score", nil) end)
	end)

	------------------------------------------------------------------------------------------------
	-- SAFEHOUSE: save + sleep
	------------------------------------------------------------------------------------------------
	-- sleeping (used by the safehouse bed in the Interiors module): fade, skip time, save
	function S.sleep(where)
		local h = S.getTime()
		local wake = (h >= 6 and h < 18) and 19 or 8
		local fade = S.gui.SB_Menu and S.gui.SB_Menu:FindFirstChild("Fade")
		S.mode = "cutscene"
		if fade then TS:Create(fade, TweenInfo.new(0.8), {BackgroundTransparency = 0}):Play() end
		task.wait(1)
		S.setTime(wake)
		if where then S.data.pos = where end
		S.save(true)
		if S.wanted and S.wanted > 0 then S.fire("heat", "clear") end
		task.wait(0.8)
		if fade then TS:Create(fade, TweenInfo.new(0.8), {BackgroundTransparency = 1}):Play() end
		S.mode = "play"
		S.fire("notify", "Game saved", "You slept until " .. string.format("%02d:00", wake) .. ".", C3(120, 200, 255))
	end

	------------------------------------------------------------------------------------------------
	-- AMBIENCE (only plays when you put IDs in Config.SOUNDS, except the built-in wind)
	------------------------------------------------------------------------------------------------
	local amb = {}
	for _, n in ipairs({"Ocean", "CityDay", "CityNight", "Wind", "Seagulls", "Crickets", "Rain"}) do
		local s = S.sound(n, nil, {Looped = true, Volume = 0})
		if s then s:Play() amb[n] = s end
	end
	-- the built-in ocean fallback is a one-shot splash; don't loop it as ambience
	if amb.Ocean and S.C.SOUNDS.Ocean == "" then amb.Ocean:Destroy() amb.Ocean = nil end
	Run.Heartbeat:Connect(function(dt)
		if S.mode == "menu" then for _, s in pairs(amb) do s.Volume = 0 end return end
		local p = S.cam.CFrame.Position
		local beach = math.clamp(1 - math.abs(p.X - (C.MAP.SEA_X + 20)) / 180, 0, 1)
		local night = S.isNight and S.isNight()
		local rain = S.Graphics and S.Graphics.weather and S.Graphics.weather.rain or 0
		local function set(n, v) local s = amb[n] if s then s.Volume += (v - s.Volume) * math.min(1, dt * 1.5) end end
		set("Ocean", beach * 0.6)
		set("Seagulls", beach * (night and 0 or 0.35))
		set("CityDay", (1 - beach) * (night and 0 or 0.3))
		set("CityNight", (1 - beach) * (night and 0.3 or 0))
		set("Crickets", night and 0.25 or 0)
		set("Rain", math.clamp(rain, 0, 1) * 0.6)
		set("Wind", math.clamp((p.Y - 60) / 200, 0, 0.4) + (S.inCar and math.clamp(S.speed / 400, 0, 0.25) or 0))
	end)
end
return W
]]></ProtectedString></Properties></Item></Item></Item></Item>
</roblox>