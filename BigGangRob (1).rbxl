]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXSLib"><Properties><string name="Name">Lib</string><ProtectedString name="Source"><![CDATA[--[[
	SB_Lib | ReplicatedStorage.SunsetBay (ModuleScript)
	Shared helpers: the road network (nodes + roads) built from Config.MAP, lane positions for traffic,
	district lookup, nearest road, money formatting, sound helper.
]]
local L = {}
local C = require(script.Parent:WaitForChild("Config"))
local V3 = Vector3.new

----------------------------------------------------------------------------------------------------
-- ROAD NETWORK
----------------------------------------------------------------------------------------------------
-- nodes: {id, pos = Vector3, links = {nodeId, ...}}; roads: {a = id, b = id, len}
local graph
function L.graph()
	if graph then return graph end
	local M = C.MAP
	local nodes, byKey, roads = {}, {}, {}
	local function node(x, z)
		for _, h in ipairs(M.NO_ROAD or {}) do
			if x > h.x[1] and x < h.x[2] and z > h.z[1] and z < h.z[2] then return nil end
		end
		local k = x .. "," .. z
		if byKey[k] then return byKey[k] end
		local n = {id = #nodes + 1, pos = V3(x, 0, z), links = {}}
		nodes[n.id] = n
		byKey[k] = n.id
		return n.id
	end
	local function road(a, b, kind)
		if a == nil or b == nil or a == b then return end
		for _, r in ipairs(roads) do if (r.a == a and r.b == b) or (r.a == b and r.b == a) then return end end
		local r = {a = a, b = b, len = (nodes[a].pos - nodes[b].pos).Magnitude, kind = kind or "street", id = #roads + 1}
		roads[#roads + 1] = r
		table.insert(nodes[a].links, b)
		table.insert(nodes[b].links, a)
	end
	local xs = table.clone(M.X)
	table.insert(xs, M.OCEAN_DRIVE)
	-- grid: every X line crossing every Z line
	for _, x in ipairs(xs) do for _, z in ipairs(M.Z) do node(x, z) end end
	-- an edge road between two corners of a no-road area that would cut through it is skipped
	local function crosses(a, b)
		if not a or not b then return false end
		local m = (nodes[a].pos + nodes[b].pos) / 2
		for _, h in ipairs(M.NO_ROAD or {}) do
			if m.X > h.x[1] and m.X < h.x[2] and m.Z > h.z[1] and m.Z < h.z[2] then return true end
		end
		return false
	end
	local road0 = road
	road = function(a, b, kind) if not crosses(a, b) then road0(a, b, kind) end end
	for _, x in ipairs(xs) do
		for j = 2, #M.Z do road(node(x, M.Z[j - 1]), node(x, M.Z[j]), x == M.OCEAN_DRIVE and "boulevard" or "street") end
	end
	for _, z in ipairs(M.Z) do
		for i = 2, #xs do road(node(xs[i - 1], z), node(xs[i], z)) end
	end
	-- bridge + island ring
	local B, I = M.BRIDGE, M.ISLAND
	local ring = {}
	local N = 10
	for k = 0, N - 1 do
		local a = math.pi + k / N * math.pi * 2
		ring[k + 1] = node(math.floor(I.cx + math.cos(a) * (I.r - 60) + 0.5), math.floor(I.cz + math.sin(a) * (I.r - 60) + 0.5))
	end
	for k = 1, N do road(ring[k], ring[k % N + 1], "island") end
	local bridgeEnd = ring[1]
	road(node(B.x1, B.z), node(B.x2, B.z), "bridge")
	road(node(B.x2, B.z), bridgeEnd, "island")
	graph = {nodes = nodes, roads = roads, byKey = byKey}
	return graph
end
-- a point on a lane: from node a to node b, t = 0..1, side = +1 right-hand lane, lane = 1 or 2 (outer)
function L.lane(a, b, t, lane)
	local g = L.graph()
	local pa, pb = g.nodes[a].pos, g.nodes[b].pos
	local dir = (pb - pa).Unit
	local right = V3(-dir.Z, 0, dir.X) -- right of travel direction (screen: x right, z down)
	local off = (lane == 2 and C.MAP.LANE + 4 or C.MAP.LANE - 3)
	return pa:Lerp(pb, t) + right * off, dir
end
-- nearest road point to a position: returns point, road
function L.nearestRoad(p)
	local g = L.graph()
	local best, bd, br = nil, math.huge, nil
	local q = V3(p.X, 0, p.Z)
	for _, r in ipairs(g.roads) do
		local a, b = g.nodes[r.a].pos, g.nodes[r.b].pos
		local ab = b - a
		local t = math.clamp((q - a):Dot(ab) / ab:Dot(ab), 0, 1)
		local c = a + ab * t
		local d = (q - c).Magnitude
		if d < bd then best, bd, br = c, d, r end
	end
	return best, br, bd
end
-- shortest path between two nodes (Dijkstra, small graph) -> list of node ids
function L.route(from, to)
	local g = L.graph()
	local dist, prev, done = {}, {}, {}
	for i in ipairs(g.nodes) do dist[i] = math.huge end
	dist[from] = 0
	while true do
		local u, ud = nil, math.huge
		for i, d in pairs(dist) do if not done[i] and d < ud then u, ud = i, d end end
		if not u or u == to then break end
		done[u] = true
		for _, v in ipairs(g.nodes[u].links) do
			local nd = ud + (g.nodes[u].pos - g.nodes[v].pos).Magnitude
			if nd < dist[v] then dist[v], prev[v] = nd, u end
		end
	end
	local path, n = {}, to
	while n do table.insert(path, 1, n) n = prev[n] end
	if path[1] ~= from then return {} end
	return path
end
function L.nearestNode(p)
	local g = L.graph()
	local best, bd = 1, math.huge
	for i, n in ipairs(g.nodes) do
		local d = ((n.pos - p) * V3(1, 0, 1)).Magnitude
		if d < bd then best, bd = i, d end
	end
	return best, bd
end

----------------------------------------------------------------------------------------------------
-- DISTRICTS
----------------------------------------------------------------------------------------------------
function L.district(x, z)
	local I = C.MAP.ISLAND
	if (V3(x, 0, z) - V3(I.cx, 0, I.cz)).Magnitude < I.r then return {name = "Star Island", kind = "villas"} end
	if x > C.MAP.OCEAN_DRIVE + 20 then return {name = "Sunset Beach", kind = "beach"} end
	if z > C.MAP.Z[#C.MAP.Z] then return {name = "Port Bay Docks", kind = "docks"} end
	for _, h in ipairs(C.MAP.NO_ROAD or {}) do
		if x >= h.x[1] and x <= h.x[2] and z >= h.z[1] and z <= h.z[2] then return h end
	end
	for _, d in ipairs(C.DISTRICTS) do
		if x >= d.x[1] and x <= d.x[2] and z >= d.z[1] and z <= d.z[2] then return d end
	end
	return {name = "Sunset Bay", kind = "shops"}
end

----------------------------------------------------------------------------------------------------
-- SMALL HELPERS
----------------------------------------------------------------------------------------------------
function L.money(n)
	n = math.floor(n or 0)
	local s = tostring(math.abs(n))
	while true do
		local k
		s, k = s:gsub("^(%d+)(%d%d%d)", "%1,%2")
		if k == 0 then break end
	end
	return (n < 0 and "-$" or "$") .. s
end
-- sound id from the config (user id first, then the built-in fallback)
function L.soundId(name)
	local id = C.SOUNDS[name]
	if id and id ~= "" then
		id = tostring(id)
		if id:match("^%d+$") then id = "rbxassetid://" .. id end
		return id
	end
	local f = C.SOUND_FALLBACK[name]
	return f ~= "" and f or nil
end
function L.lerpColor(a, b, t) return a:Lerp(b, math.clamp(t, 0, 1)) end
return L
