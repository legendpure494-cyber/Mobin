<Item class="ReplicatedStorage" referent="RBX3"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">PL_Data</string><ProtectedString name="Source"><![CDATA[local D={}D.RAR={{n="Common",c=Color3.fromRGB(200,205,215)},{n="Uncommon",c=Color3.fromRGB(90,220,90)},{n="Rare",c=Color3.fromRGB(70,160,255)},{n="Epic",c=Color3.fromRGB(190,90,255)},{n="Legendary",c=Color3.fromRGB(255,190,40)},{n="Mythic",c=Color3.fromRGB(255,70,110)},}D.CHANCE={40,30,18,8,3.5,0.5}D.ZONES={{n="Sunny Meadow",g=Color3.fromRGB(110,205,90),a=Color3.fromRGB(255,220,90),gate=0,egg=100,mul=1},{n="Whisper Woods",g=Color3.fromRGB(60,150,70),a=Color3.fromRGB(150,100,60),gate=2500,egg=2000,mul=18},{n="Frost Peaks",g=Color3.fromRGB(225,240,255),a=Color3.fromRGB(120,200,255),gate=60000,egg=45000,mul=380},{n="Magma Core",g=Color3.fromRGB(70,50,50),a=Color3.fromRGB(255,110,30),gate=1500000,egg=1000000,mul=8000},}D.PETS={{{"dog","Doggy","c8a078","8c6446","flop"},{"cat","Kitty","f0f0f0","ffa040","point"},{"bunny","Bunny","ff8cb4","ffffff","long"},{"pig","Piggy","ffb4c8","ff7896","round"},{"fox","Foxy","ff8c32","ffffff","point"},{"unicorn","Unicorn","ffffff","ff78c8","horn"}},{{"bear","Bear","8c5a32","5a3c23","round"},{"deer","Fawn","c8915a","fff0dc","antler"},{"owl","Owl","a07850","ffdc8c","wing"},{"raccoon","Raccoon","8c8c96","323237","round"},{"wolf","Wolf","6e6e78","dcdce6","point"},{"spirit","Forest Spirit","78ffa0","ffffff","antler"}},{{"penguin","Penguin","323246","ffffff","wing"},{"pbear","Polar Bear","f5f8ff","c8dcf0","round"},{"seal","Seal","b4c8dc","ffffff","none"},{"sfox","Snow Fox","f0f8ff","a0d2ff","point"},{"yeti","Yeti","dcf0ff","6e96c8","horn"},{"idragon","Ice Dragon","8cdcff","ffffff","dragon"}},{{"sala","Salamander","ff6e32","ffd25a","none"},{"bat","Fire Bat","463c46","ff7828","wing"},{"golem","Magma Golem","503c3c","ff8c1e","horn"},{"phoenix","Phoenix","ff5a1e","ffdc32","wing"},{"ldragon","Lava Dragon","c8281e","ffaa1e","dragon"},{"demon","Shadow Demon","281e32","ff3264","horn"}},}D.BY={}for z,k in ipairs(D.PETS)do for r,p in ipairs(k)do D.BY[p[1]]={key=p[1],name=p[2],c=Color3.fromHex(p[3]),a=Color3.fromHex(p[4]),style=p[5],zone=z,rar=r,power=math.floor((2+r*r*1.6)*(z==1 and 1 or z==2 and 14 or z==3 and 260 or 5200))}end end D.MAXEQ=4 function D.build(j,i)local p=D.BY[j]local s=i or 1 local m=Instance.new("Model")m.Name=j local function a(n,o,q,f,y)local x=Instance.new("Part")x.Size,x.CFrame,x.Color,x.Material,x.Anchored,x.CanCollide,x.CanQuery,x.CanTouch,x.CastShadow=n*s,CFrame.new(o.Position*s)*o.Rotation,q,Enum.Material.SmoothPlastic,true,false,false,false,false x.TopSurface,x.BottomSurface,x.Name=Enum.SurfaceType.Smooth,Enum.SurfaceType.Smooth,y or"P"if f then x.Shape=f end x.Parent=m return x end local h=a(Vector3.new(2,1.9,2),CFrame.new(),p.c,nil,"Body")m.PrimaryPart=h local K=Color3.fromRGB(25,25,30)for b=-1,1,2 do a(Vector3.new(0.32,0.42,0.06),CFrame.new(b*0.45,0.15,-1.03),K)a(Vector3.new(0.12,0.12,0.04),CFrame.new(b*0.4,0.26,-1.08),Color3.new(1,1,1))a(Vector3.new(0.26,0.12,0.04),CFrame.new(b*0.68,-0.2,-1.02),Color3.fromRGB(255,150,170))local e=p.style if e=="point"then a(Vector3.new(0.5,0.55,0.3),CFrame.new(b*0.62,1.2,0)*CFrame.Angles(0,0,-b*0.25),p.c)elseif e=="round"then a(Vector3.new(0.6,0.6,0.6),CFrame.new(b*0.7,1.15,0),p.a,Enum.PartType.Ball)elseif e=="long"then a(Vector3.new(0.4,1.3,0.25),CFrame.new(b*0.45,1.55,0.1),p.c)a(Vector3.new(0.22,0.9,0.04),CFrame.new(b*0.45,1.5,-0.04),p.a)elseif e=="flop"then a(Vector3.new(0.35,0.9,0.6),CFrame.new(b*1.17,0.3,0),p.a)elseif e=="wing"or e=="dragon"then a(Vector3.new(0.15,1.1,1.4),CFrame.new(b*1.08,0.1,0.2)*CFrame.Angles(0,0,b*0.4),p.a,nil,"Wing")elseif e=="antler"then a(Vector3.new(0.14,0.8,0.14),CFrame.new(b*0.45,1.35,0.2)*CFrame.Angles(0,0,-b*0.3),p.a)a(Vector3.new(0.12,0.45,0.12),CFrame.new(b*0.75,1.55,0.2)*CFrame.Angles(0,0,-b*0.9),p.a)end end if p.style=="horn"then a(Vector3.new(0.3,0.8,0.3),CFrame.new(