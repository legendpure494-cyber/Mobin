<Item class="Lighting" referent="RBXL"><Properties><string name="Name">Lighting</string><token name="Technology">4</token><float name="ClockTime">17.6</float><float name="GeographicLatitude">26</float><float name="Brightness">2.6</float><Color3 name="OutdoorAmbient"><R>0.66</R><G>0.5</G><B>0.47</B></Color3><float name="EnvironmentDiffuseScale">1</float><float name="EnvironmentSpecularScale">1</float><bool name="GlobalShadows">true</bool></Properties><Item class="Atmosphere" referent="RBXAT"><Properties><string name="Name">Atmosphere</string><float name="Density">0.34</float><float name="Haze">2</float><Color3 name="Color"><R>1</R><G>0.7</G><B>0.52</B></Color3><Color3 name="Decay"><R>1</R><G>0.43</G><B>0.47</B></Color3><float name="Glare">1</float><float name="Offset">0.12</float></Properties></Item><Item class="BloomEffect" referent="RBXBL"><Properties><string name="Name">Bloom</string><float name="Intensity">0.9</float><float name="Size">28</float><float name="Threshold">1.2</float></Properties></Item><Item class="ColorCorrectionEffect" referent="RBXCC"><Properties><string name="Name">ColorCorrection</string><float name="Saturation">0.22</float><float name="Contrast">0.14</float><Color3 name="TintColor"><R>1</R><G>0.84</G><B>0.71</B></Color3></Properties></Item><Item class="SunRaysEffect" referent="RBXSR"><Properties><string name="Name">SunRays</string><float name="Intensity">0.2</float><float name="Spread">0.6</float></Properties></Item><Item class="Sky" referent="RBXSKY"><Properties><string name="Name">Sky</string><float name="SunAngularSize">14</float><int name="StarCount">4000</int></Properties></Item></Item>
<Item class="ReplicatedStorage" referent="RBXR"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBXSB"><Properties><string name="Name">SunsetBay</string></Properties><Item class="ModuleScript" referent="RBXSConfig"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[--[[
	SB_Config | ReplicatedStorage.SunsetBay (ModuleScript)
	SUNSET BAY - every setting of the game in one place.

	  * MAP: the street grid, districts, the bridge and the island (the generator and the traffic use the same numbers)
	  * CARS: name, price, speed, handling, colours (looks = models in ReplicatedStorage.SunsetBay.Cars)
	  * SOUNDS: put your own sound IDs here (leave "" to use the built-in Roblox sound or silence)
	  * GRAPHICS: lighting presets for sunrise / day / sunset / night, weather, quality levels
	  * JOBS: taxi, delivery, races, stunt jumps, hidden packages
	  * MONEY: start cash, properties, repair / paint prices
]]

local C = {}
local V3, C3 = Vector3.new, Color3.fromRGB

----------------------------------------------------------------------------------------------------
-- MAP
----------------------------------------------------------------------------------------------------
C.MAP = {
	-- street grid (centre lines). Roads run along these X and Z values.
	X = {-840, -600, -360, -120, 120, 360},
	Z = {-840, -600, -360, -120, 120, 360, 600},
	OCEAN_DRIVE = 520, -- the beach boulevard (runs north - south)
	ROAD_W = 30, -- road width (2 lanes each way)
	LANE = 7.5, -- distance of a lane centre from the road centre line (right hand traffic)
	WALK_W = 8, -- sidewalk width
	CURB = 0.5, -- sidewalk height
	BEACH_X = {560, 720}, -- sand from .. to
	SEA_X = 700, -- the ocean starts here (east)
	SEA_Y = -2.6, -- water surface height
	DOCKS_Z = 780, -- docks water south of this
	BRIDGE = {z = -120, x1 = 520, x2 = 1010, y = 0}, -- causeway to Star Island
	ISLAND = {cx = 1180, cz = -120, r = 230}, -- Star Island (round)
	SPAWN = V3(470, 3, 240), -- first spawn: in front of the beach apartment
}
-- districts (decides what the generator builds in a block). Checked in order, first match wins.
C.DISTRICTS = {
	{name = "Downtown", x = {-360, 120}, z = {-840, -120}, kind = "towers"},
	{name = "Ocean Beach", x = {360, 520}, z = {-840, 600}, kind = "deco"},
	{name = "Little Havana", x = {-840, -360}, z = {-840, 600}, kind = "houses"},
	{name = "Midtown", x = {-360, 360}, z = {-120, 600}, kind = "shops"},
	{name = "Vista Hills", x = {120, 360}, z = {-840, -120}, kind = "mid"},
}

----------------------------------------------------------------------------------------------------
-- CARS (looks: ReplicatedStorage.SunsetBay.Cars.<key>)
-- speed: top speed (studs/s) · accel: studs/s per second · brake · turn: steering strength · grip: 0..1 (low = drifts)
-- price: dealership price (0 = not for sale) · seats · colours: paint choices
----------------------------------------------------------------------------------------------------
C.CARS = {
	Vortex = {name = "Vortex GT", class = "Super", price = 120000, speed = 165, accel = 62, brake = 120, turn = 1.15, grip = 0.82, nitro = true,
		colours = {C3(255, 40, 120), C3(250, 250, 250), C3(20, 20, 25), C3(255, 200, 0), C3(0, 200, 255)}},
	Stallion = {name = "Stallion 86", class = "Muscle", price = 45000, speed = 140, accel = 50, brake = 95, turn = 0.95, grip = 0.7, nitro = true,
		colours = {C3(200, 20, 30), C3(20, 60, 160), C3(15, 15, 15), C3(255, 140, 0)}},
	Coastline = {name = "Coastline Roadster", class = "Sports", price = 70000, speed = 150, accel = 56, brake = 110, turn = 1.1, grip = 0.8, nitro = false,
		colours = {C3(120, 230, 220), C3(255, 120, 180), C3(255, 255, 255), C3(255, 210, 90)}},
	Rancher = {name = "Rancher XL", class = "SUV", price = 30000, speed = 115, accel = 40, brake = 85, turn = 0.85, grip = 0.85, nitro = false,
		colours = {C3(40, 40, 45), C3(240, 240, 240), C3(90, 110, 80), C3(130, 30, 30)}},
	Cabbie = {name = "Cabbie", class = "Sedan", price = 0, speed = 110, accel = 38, brake = 85, turn = 0.95, grip = 0.8, nitro = false,
		colours = {C3(255, 200, 20)}},
	Glide = {name = "Glide", class = "Sedan", price = 9000, speed = 105, accel = 36, brake = 80, turn = 0.95, grip = 0.8, nitro = false,
		colours = {C3(180, 185, 190), C3(60, 80, 120), C3(120, 20, 30), C3(250, 250, 250), C3(30, 90, 60)}},
	Hauler = {name = "Bayside Hauler", class = "Pickup", price = 15000, speed = 108, accel = 37, brake = 80, turn = 0.85, grip = 0.78, nitro = false,
		colours = {C3(200, 80, 30), C3(30, 70, 140), C3(230, 230, 220)}},
	Van = {name = "Bay Express Van", class = "Van", price = 0, speed = 95, accel = 32, brake = 75, turn = 0.8, grip = 0.82, nitro = false,
		colours = {C3(245, 245, 245)}},
	Interceptor = {name = "Interceptor", class = "Police", price = 0, speed = 150, accel = 55, brake = 110, turn = 1.05, grip = 0.82, nitro = false,
		colours = {C3(20, 20, 25)}},
}
C.CAR_ORDER = {"Glide", "Hauler", "Rancher", "Stallion", "Coastline", "Vortex"}
C.START_CAR = "Glide"
C.MAX_HEALTH = 1000 -- car health; crashes take some away; 0 = smoking wreck
C.NITRO_TIME = 3 -- seconds of nitro per charge
C.NITRO_RECHARGE = 12 -- seconds to refill
C.NITRO_BOOST = 1.45

----------------------------------------------------------------------------------------------------
-- SOUNDS - paste your IDs ("rbxassetid://123" or "123"). Empty = built-in Roblox sound (or silence if none).
----------------------------------------------------------------------------------------------------
C.SOUNDS = {
	-- engine loops (played faster when the car goes faster)
	EngineSuper = "", EngineMuscle = "", EngineSedan = "", EngineIdle = "",
	Horn = "", Skid = "", Crash = "", Nitro = "", DoorOpen = "", DoorClose = "", Gear = "", Siren = "",
	-- world ambience loops
	Ocean = "", CityDay = "", CityNight = "", Wind = "", Rain = "", Thunder = "", Seagulls = "", Crickets = "",
	-- interface
	Cash = "", MissionPassed = "", MissionFailed = "", Checkpoint = "", PhoneOpen = "", Click = "", Package = "", Stunt = "",
}
-- built-in sounds used when an ID above is empty (these ship with Roblox)
C.SOUND_FALLBACK = {
	EngineSuper = "", EngineMuscle = "", EngineSedan = "", Wind = "rbxasset://sounds/action_falling.mp3",
	Horn = "rbxasset://sounds/electronicpingshort.wav", Crash = "rbxasset://sounds/collide.wav", Nitro = "rbxasset://sounds/swoosh.wav",
	DoorOpen = "rbxasset://sounds/button.wav", DoorClose = "rbxasset://sounds/button.wav", Ocean = "rbxasset://sounds/impact_water.mp3",
	Cash = "rbxasset://sounds/electronicpingshort.wav", MissionPassed = "rbxasset://sounds/victory.wav", MissionFailed = "rbxasset://sounds/uuhhh.mp3",
	Checkpoint = "rbxasset://sounds/electronicpingshort.wav", PhoneOpen = "rbxasset://sounds/clickfast.wav", Click = "rbxasset://sounds/clickfast.wav",
	Package = "rbxasset://sounds/victory.wav", Stunt = "rbxasset://sounds/victory.wav", Thunder = "rbxasset://sounds/bass.wav", Skid = "",
}
-- RADIO stations: each has a list of song IDs (your own uploads / licensed audio). Empty list = the station is quiet.
C.RADIO = {
	{name = "Flash 86", color = C3(255, 60, 160), songs = {}},
	{name = "Wave Retro", color = C3(0, 220, 255), songs = {}},
	{name = "Emotion Bay", color = C3(255, 120, 60), songs = {}},
	{name = "Sunset Talk", color = C3(255, 220, 90), songs = {}},
}

----------------------------------------------------------------------------------------------------
-- GRAPHICS
----------------------------------------------------------------------------------------------------
C.DAY_LENGTH = 24 * 60 -- real seconds for a full in-game day (24 minutes)
C.START_TIME = 17.2 -- the game starts just before sunset
-- lighting presets (the graphics script blends between them by time of day)
C.LIGHT = {
	{time = 5.5, name = "Dawn", brightness = 1.6, ambient = C3(70, 60, 90), outdoor = C3(120, 100, 130), tint = C3(255, 200, 190), sat = 0.15, contrast = 0.12, haze = 2.2, density = 0.36, atmo = C3(255, 170, 160), decay = C3(110, 80, 140), bloom = 0.9, rays = 0.18, exposure = 0},
	{time = 9, name = "Morning", brightness = 3, ambient = C3(110, 110, 120), outdoor = C3(150, 150, 160), tint = C3(255, 250, 240), sat = 0.12, contrast = 0.1, haze = 1.2, density = 0.3, atmo = C3(200, 220, 255), decay = C3(140, 160, 200), bloom = 0.6, rays = 0.1, exposure = 0},
	{time = 13, name = "Noon", brightness = 3.4, ambient = C3(120, 120, 125), outdoor = C3(160, 160, 165), tint = C3(255, 255, 250), sat = 0.1, contrast = 0.08, haze = 1, density = 0.28, atmo = C3(200, 225, 255), decay = C3(150, 170, 210), bloom = 0.5, rays = 0.06, exposure = 0},
	{time = 17.5, name = "Golden", brightness = 2.6, ambient = C3(120, 90, 90), outdoor = C3(170, 130, 120), tint = C3(255, 215, 180), sat = 0.22, contrast = 0.14, haze = 2, density = 0.34, atmo = C3(255, 180, 130), decay = C3(255, 110, 120), bloom = 0.9, rays = 0.22, exposure = 0.05},
	{time = 19, name = "Sunset", brightness = 1.4, ambient = C3(100, 60, 110), outdoor = C3(150, 90, 140), tint = C3(255, 170, 200), sat = 0.32, contrast = 0.18, haze = 2.6, density = 0.4, atmo = C3(255, 120, 150), decay = C3(140, 60, 170), bloom = 1.3, rays = 0.25, exposure = 0.1},
	{time = 21, name = "Dusk", brightness = 0.6, ambient = C3(60, 40, 100), outdoor = C3(80, 60, 130), tint = C3(210, 170, 255), sat = 0.3, contrast = 0.2, haze = 1.8, density = 0.38, atmo = C3(120, 80, 200), decay = C3(60, 30, 120), bloom = 1.6, rays = 0.05, exposure = 0.15},
	{time = 1, name = "Night", brightness = 0.25, ambient = C3(40, 40, 80), outdoor = C3(50, 50, 100), tint = C3(190, 190, 255), sat = 0.25, contrast = 0.22, haze = 1.2, density = 0.34, atmo = C3(60, 50, 140), decay = C3(30, 20, 80), bloom = 1.8, rays = 0, exposure = 0.2},
}
C.NIGHT_FROM, C.NIGHT_TO = 19.2, 6.2 -- city lights on between these hours
-- weather: chance per in-game hour and how long it lasts (real seconds)
C.WEATHER = {
	{name = "Clear", weight = 70},
	{name = "Cloudy", weight = 15, clouds = 0.8, fog = 0.1},
	{name = "Rain", weight = 10, clouds = 0.95, rain = 1, fog = 0.2, wet = true},
	{name = "Storm", weight = 5, clouds = 1, rain = 1.6, fog = 0.3, wet = true, lightning = true},
}
C.WEATHER_TIME = {120, 300}
-- quality presets (players pick one in the phone settings)
C.QUALITY = {
	Low = {decorDist = 300, lightDist = 150, trafficCars = 10, peds = 10, rainDrops = 60, shadows = false},
	Medium = {decorDist = 550, lightDist = 260, trafficCars = 18, peds = 18, rainDrops = 120, shadows = true},
	High = {decorDist = 900, lightDist = 420, trafficCars = 26, peds = 28, rainDrops = 200, shadows = true},
}
C.DEFAULT_QUALITY = "Medium"

----------------------------------------------------------------------------------------------------
-- MONEY / SHOPS
----------------------------------------------------------------------------------------------------
C.START_CASH = 2500
C.REPAIR_PRICE = 500
C.PAINT_PRICE = 800
C.GARAGE_SIZE = 6

----------------------------------------------------------------------------------------------------
-- JOBS
----------------------------------------------------------------------------------------------------
C.TAXI = {fares = 6, payBase = 180, payPerStud = 0.45, timePerStud = 0.065, minTime = 25, car = "Cabbie"}
C.DELIVERY = {drops = 5, payBase = 260, payPerStud = 0.5, timePerStud = 0.06, minTime = 30, car = "Van"}
C.STUNT_PAY = 300
C.PACKAGE_PAY = 1000
C.PACKAGE_BONUS = 25000 -- all packages found
C.RACE_LAPS = 1
return C
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXSLib"><Properties><string name="Name">Lib</string><ProtectedString name="Source"><![CDATA[--[[
	SB_Lib | ReplicatedStorage.SunsetBay (ModuleScript)
	Shared helpers: the road network (nodes + roads) built from Config.MAP, lane positions for traffic,
	district lookup, nearest road, money formatting, sound helper.
]]
local L = {}
local C = require(script.Parent:WaitForChild("Config"))
local V3 = Vector3.new

----------------------------------------------------------------------------------------------------
-- ROAD NETWORK
----------------------------------------------------------------------------------------------------
-- nodes: {id, pos = Vector3, links = {nodeId, ...}}; roads: {a = id, b = id, len}
local graph
function L.graph()
	if graph then return graph end
	local M = C.MAP
	local nodes, byKey, roads = {}, {}, {}
	local function node(x, z)
		local k = x .. "," .. z
		if byKey[k] then return byKey[k] end
		local n = {id = #nodes + 1, pos = V3(x, 0, z), links = {}}
		nodes[n.id] = n
		byKey[k] = n.id
		return n.id
	end
	local function road(a, b, kind)
		if a == b then return end
		for _, r in ipairs(roads) do if (r.a == a and r.b == b) or (r.a == b and r.b == a) then return end end
		local r = {a = a, b = b, len = (nodes[a].pos - nodes[b].pos).Magnitude, kind = kind or "street", id = #roads + 1}
		roads[#roads + 1] = r
		table.insert(nodes[a].links, b)
		table.insert(nodes[b].links, a)
	end
	local xs = table.clone(M.X)
	table.insert(xs, M.OCEAN_DRIVE)
	-- grid: every X line crossing every Z line
	for _, x in ipairs(xs) do for _, z in ipairs(M.Z) do node(x, z) end end
	for _, x in ipairs(xs) do
		for j = 2, #M.Z do road(node(x, M.Z[j - 1]), node(x, M.Z[j]), x == M.OCEAN_DRIVE and "boulevard" or "street") end
	end
	for _, z in ipairs(M.Z) do
		for i = 2, #xs do road(node(xs[i - 1], z), node(xs[i], z)) end
	end
	-- bridge + island ring
	local B, I = M.BRIDGE, M.ISLAND
	local ring = {}
	local N = 10
	for k = 0, N - 1 do
		local a = math.pi + k / N * math.pi * 2
		ring[k + 1] = node(math.floor(I.cx + math.cos(a) * (I.r - 60) + 0.5), math.floor(I.cz + math.sin(a) * (I.r - 60) + 0.5))
	end
	for k = 1, N do road(ring[k], ring[k % N + 1], "island") end
	local bridgeEnd = ring[1]
	road(node(B.x1, B.z), node(B.x2, B.z), "bridge")
	road(node(B.x2, B.z), bridgeEnd, "island")
	graph = {nodes = nodes, roads = roads, byKey = byKey}
	return graph
end
-- a point on a lane: from node a to node b, t = 0..1, side = +1 right-hand lane, lane = 1 or 2 (outer)
function L.lane(a, b, t, lane)
	local g = L.graph()
	local pa, pb = g.nodes[a].pos, g.nodes[b].pos
	local dir = (pb - pa).Unit
	local right = V3(-dir.Z, 0, dir.X) -- right of travel direction (screen: x right, z down)
	local off = (lane == 2 and C.MAP.LANE + 4 or C.MAP.LANE - 3)
	return pa:Lerp(pb, t) + right * off, dir
end
-- nearest road point to a position: returns point, road
function L.nearestRoad(p)
	local g = L.graph()
	local best, bd, br = nil, math.huge, nil
	local q = V3(p.X, 0, p.Z)
	for _, r in ipairs(g.roads) do
		local a, b = g.nodes[r.a].pos, g.nodes[r.b].pos
		local ab = b - a
		local t = math.clamp((q - a):Dot(ab) / ab:Dot(ab), 0, 1)
		local c = a + ab * t
		local d = (q - c).Magnitude
		if d < bd then best, bd, br = c, d, r end
	end
	return best, br, bd
end
-- shortest path between two nodes (Dijkstra, small graph) -> list of node ids
function L.route(from, to)
	local g = L.graph()
	local dist, prev, done = {}, {}, {}
	for i in ipairs(g.nodes) do dist[i] = math.huge end
	dist[from] = 0
	while true do
		local u, ud = nil, math.huge
		for i, d in pairs(dist) do if not done[i] and d < ud then u, ud = i, d end end
		if not u or u == to then break end
		done[u] = true
		for _, v in ipairs(g.nodes[u].links) do
			local nd = ud + (g.nodes[u].pos - g.nodes[v].pos).Magnitude
			if nd < dist[v] then dist[v], prev[v] = nd, u end
		end
	end
	local path, n = {}, to
	while n do table.insert(path, 1, n) n = prev[n] end
	if path[1] ~= from then return {} end
	return path
end
function L.nearestNode(p)
	local g = L.graph()
	local best, bd = 1, math.huge
	for i, n in ipairs(g.nodes) do
		local d = ((n.pos - p) * V3(1, 0, 1)).Magnitude
		if d < bd then best, bd = i, d end
	end
	return best, bd
end

----------------------------------------------------------------------------------------------------
-- DISTRICTS
----------------------------------------------------------------------------------------------------
function L.district(x, z)
	local I = C.MAP.ISLAND
	if (V3(x, 0, z) - V3(I.cx, 0, I.cz)).Magnitude < I.r then return {name = "Star Island", kind = "villas"} end
	if x > C.MAP.OCEAN_DRIVE + 20 then return {name = "Sunset Beach", kind = "beach"} end
	if z > C.MAP.Z[#C.MAP.Z] then return {name = "Port Bay Docks", kind = "docks"} end
	for _, d in ipairs(C.DISTRICTS) do
		if x >= d.x[1] and x <= d.x[2] and z >= d.z[1] and z <= d.z[2] then return d end
	end
	return {name = "Sunset Bay", kind = "shops"}
end

----------------------------------------------------------------------------------------------------
-- SMALL HELPERS
----------------------------------------------------------------------------------------------------
function L.money(n)
	n = math.floor(n or 0)
	local s = tostring(math.abs(n))
	while true do
		local k
		s, k = s:gsub("^(%d+)(%d%d%d)", "%1,%2")
		if k == 0 then break end
	end
	return (n < 0 and "-$" or "$") .. s
end
-- sound id from the config (user id first, then the built-in fallback)
function L.soundId(name)
	local id = C.SOUNDS[name]
	if id and id ~= "" then
		id = tostring(id)
		if id:match("^%d+$") then id = "rbxassetid://" .. id end
		return id
	end
	local f = C.SOUND_FALLBACK[name]
	return f ~= "" and f or nil
end
function L.lerpColor(a, b, t) return a:Lerp(b, math.clamp(t, 0, 1)) end
return L
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBXD10153"><Properties><string name="Name">Cars</string></Properties><Item class="Model" referent="RBXD10154"><Properties><string name="Name">Vortex</string><OptionalCoordinateFrame name="WorldPivotData"><CFrame><X>0</X><Y>1.8</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CFrame></OptionalCoordinateFrame><Ref name="PrimaryPart">RBXD10155</Ref><BinaryString name="AttributesSerialize">AQAAAAMAAABDYXICBgAAAFZvcnRleA==</BinaryString></Properties><Item class="Part" referent="RBXD10155"><Properties><string name="Name">Chassis</string><Color3uint8 name="Color3uint8">4294901760</Color3uint8><CoordinateFrame name="CFrame"><X>0</X><Y>1.8</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><token name="Material">272</token><Vector3 name="size"><X>7.6000</X><Y>2.5000</Y><Z>16.0000</Z></Vector3><bool name="CanTouch">false</bool><float name="Transparency">1</float><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties><Item class="Motor6D" referent="RBXD10156"><Properties><string name="Name">Wheel_FL</string><CoordinateFrame name="C0"><X>-3.3</X><Y>-0.55</Y><Z>-5.4</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Ref name="Part1">RBXD10266</Ref><Ref name="Part0">RBXD10155</Ref></Properties></Item><Item class="Motor6D" referent="RBXD10157"><Properties><string name="Name">Wheel_FR</string><CoordinateFrame name="C0"><X>3.3</X><Y>-0.55</Y><Z>-5.4</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Ref name="Part1">RBXD10287</Ref><Ref name="Part0">RBXD10155</Ref></Properties></Item><Item class="Motor6D" referent="RBXD10158"><Properties><string name="Name">Wheel_RL</string>